@model IEnumerable<Eticaret.Core.Entities.Slider>

@{
    ViewData["Title"] = "Slider Yönetimi";
}

<div class="container-fluid">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 text-gray-800">
                <i class="fas fa-images me-2"></i> Slider Yönetimi
            </h1>
            <p class="text-muted mb-0">Ana sayfa slider'larını yönetin</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i> Yeni Slider
        </a>
    </div>

    <!-- TABLO -->
    <div class="card shadow">
        <div class="card-header d-flex justify-content-between">
            <h6 class="m-0 fw-bold text-primary">
                <i class="fas fa-list me-1"></i> Slider Listesi
            </h6>
            <div>
                <button id="btnActive" class="btn btn-sm btn-outline-success me-2">
                    Aktifler
                </button>
                <button id="btnAll" class="btn btn-sm btn-outline-secondary">
                    Tümü
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table id="sliderTable" class="table table-hover">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Görsel</th>
                            <th>Başlık</th>
                            <th>Alt Başlık</th>
                            <th>Durum</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             class="img-thumbnail"
                                             style="width:80px;height:60px;object-fit:cover;"
                                             onerror="this.src='/img/no-image.png'" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">Yok</span>
                                    }
                                </td>
                                <td>@item.Title</td>
                                <td>@item.SubTitle</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info me-1">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning me-1">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        table th {
            background: #f8f9fa;
            font-weight: 600;
        }

        table td {
            vertical-align: middle;
        }
    </style>
}

@section Scripts {

    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {

            var table = $('#sliderTable').DataTable({
                order: [[0, "desc"]],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.4/i18n/tr.json"
                },
                columnDefs: [
                    { orderable: false, targets: [1, 5] }
                ]
            });

            // SADECE AKTİFLER
            $('#btnActive').on('click', function () {
                table.column(4).search('Aktif').draw();
            });

            // TÜMÜ
            $('#btnAll').on('click', function () {
                table.column(4).search('').draw();
            });

        });
    </script>
}
