@model Eticaret.Core.Entities.Slider

@{
    ViewData["Title"] = "Slider Detayları";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card border-left-primary shadow mb-4">

                <!-- HEADER -->
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h6 class="mb-0">
                        <i class="fas fa-images me-2"></i> Slider Detayları
                    </h6>

                    <div>
                        <span class="badge bg-light text-primary me-2">
                            ID: @Model.Id
                        </span>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </div>
                </div>

                <div class="card-body">

                    <!-- ÖNİZLEME -->
                    <div class="row mb-5">
                        <div class="col-lg-8">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <strong>
                                        <i class="fas fa-eye me-2"></i> Slider Önizleme
                                    </strong>
                                </div>

                                <div class="card-body text-center">
                                    <div class="slider-preview-container p-4 rounded">

                                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                        {
                                            <img src="@Model.ImageUrl"
                                                 class="img-fluid rounded shadow mb-3"
                                                 style="max-height:300px"
                                                 alt="Slider Görseli"
                                                 onerror="this.src='/admin/img/no-image.png'" />
                                        }
                                        else
                                        {
                                            <div class="no-image-preview">
                                                <i class="fas fa-image fa-4x text-muted mb-2"></i>
                                                <p class="text-muted">Görsel Yok</p>
                                            </div>
                                        }

                                        <h3 class="fw-bold">@Model.Title</h3>

                                        @if (!string.IsNullOrEmpty(Model.SubTitle))
                                        {
                                            <p class="text-muted lead">@Model.SubTitle</p>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- BİLGİLER -->
                        <div class="col-lg-4 mt-4 mt-lg-0">
                            <div class="card h-100">
                                <div class="card-header bg-light">
                                    <strong>
                                        <i class="fas fa-info-circle me-2"></i> Bilgiler
                                    </strong>
                                </div>

                                <div class="card-body">
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item">
                                            <strong>Durum:</strong>
                                            <span class="ms-2 @(Model.IsActive ? "text-success" : "text-secondary")">
                                                @(Model.IsActive ? "Aktif" : "Pasif")
                                            </span>
                                        </li>

                                        <li class="list-group-item">
                                            <strong>Başlık:</strong><br />
                                            @Model.Title
                                        </li>

                                        <li class="list-group-item">
                                            <strong>Alt Başlık:</strong><br />
                                            @(string.IsNullOrEmpty(Model.SubTitle) ? "Yok" : Model.SubTitle)
                                        </li>

                                        <li class="list-group-item">
                                            <strong>Görsel URL:</strong>
                                            <input class="form-control mt-2" value="@Model.ImageUrl" readonly />
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- BUTONLAR -->
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-arrow-left me-2"></i> Listeye Dön
                        </a>

                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-lg me-2">
                                <i class="fas fa-edit me-2"></i> Düzenle
                            </a>

                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg">
                                <i class="fas fa-trash me-2"></i> Sil
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .border-left-primary {
            border-left: 5px solid #4e73df;
        }

        .slider-preview-container {
            border: 2px solid #e3e6f0;
            background: #f8f9fc;
        }

        .no-image-preview {
            height: 300px;
            border: 2px dashed #ced4da;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #fff;
        }
    </style>
}
