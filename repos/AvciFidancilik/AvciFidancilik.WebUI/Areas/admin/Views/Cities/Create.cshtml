@model Eticaret.Core.Entities.City

@{
    ViewData["Title"] = "Yeni Şehir Oluştur";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    <i class="fas fa-city me-2"></i>Yeni Şehir Ekle
                </h3>
                <div class="city-icon">
                    <i class="fas fa-map-marker-alt fa-2x"></i>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-8">
                    <form asp-action="Create" id="cityForm" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row mb-4">
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control"
                                           placeholder="Şehir Adı"
                                           required
                                           maxlength="100" />
                                    <label asp-for="Name" class="form-label">
                                        <i class="fas fa-tag me-1"></i>Şehir Adı
                                    </label>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                    <div class="form-text">
                                        <i class="fas fa-info-circle me-1"></i>Örnek: İstanbul, Ankara, İzmir
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="character-count mt-4 pt-3">
                                    <div class="progress" style="height: 8px;">
                                        <div class="progress-bar bg-info"
                                             id="nameLengthProgress"
                                             role="progressbar"
                                             style="width: 0%"></div>
                                    </div>
                                    <small class="text-muted">
                                        <span id="charCount">0</span>/100 karakter
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <div class="d-flex">
                                <div class="me-3">
                                    <i class="fas fa-lightbulb fa-2x text-info"></i>
                                </div>
                                <div>
                                    <h6 class="alert-heading">İpucu</h6>
                                    <p class="mb-0">
                                        Şehir isimlerini Türkçe karakterlerle yazın. Büyük harfle başlayın ve gereksiz boşluklardan kaçının.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-2"></i>Kaydet
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                            <button type="button" class="btn btn-outline-info ms-2" id="previewBtn">
                                <i class="fas fa-eye me-2"></i>Önizleme
                            </button>
                        </div>
                    </form>
                </div>

                <div class="col-lg-4">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0"><i class="fas fa-map me-2"></i>Şehir Önizlemesi</h6>
                        </div>
                        <div class="card-body text-center">
                            <div class="city-preview mb-4">
                                <div class="city-badge" id="previewCity">
                                    <i class="fas fa-map-marker-alt me-2"></i>
                                    <span id="previewName">Yeni Şehir</span>
                                </div>
                            </div>
                            <div class="city-stats">
                                <div class="row">
                                    <div class="col-6">
                                        <div class="stat-box">
                                            <div class="stat-value">TÜR</div>
                                            <div class="stat-label">Şehir</div>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="stat-box">
                                            <div class="stat-value" id="previewCharCount">0</div>
                                            <div class="stat-label">Karakter</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .city-icon {
            opacity: 0.8;
            animation: pulse 2s infinite;
        }

        @@keyframes pulse {
            0%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.1);
        }

        100% {
            transform: scale(1);
        }

        }

        .city-badge {
            display: inline-block;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 15px 30px;
            border-radius: 50px;
            font-size: 1.2rem;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            transition: all 0.3s ease;
        }

            .city-badge:hover {
                transform: translateY(-5px);
                box-shadow: 0 8px 25px rgba(0,0,0,0.3);
            }

        .city-preview {
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .stat-box {
            text-align: center;
            padding: 10px;
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            background: #f8f9fa;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: bold;
            color: #0d6efd;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #666;
            margin-top: 5px;
        }

        .character-count {
            text-align: center;
        }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #0d6efd;
            font-weight: 500;
        }

        .card {
            border-radius: 15px;
            overflow: hidden;
        }

        .card-header {
            border-bottom: none;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Form validation
            var form = document.getElementById('cityForm');
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);

            // Character count and progress
            function updateCharacterCount() {
                const name = $('#Name').val() || '';
                const charCount = name.length;
                const progress = Math.min((charCount / 100) * 100, 100);

                $('#charCount').text(charCount);
                $('#previewCharCount').text(charCount);
                $('#nameLengthProgress').css('width', progress + '%');

                // Color coding
                if (charCount > 80) {
                    $('#nameLengthProgress').removeClass('bg-info bg-warning').addClass('bg-danger');
                } else if (charCount > 50) {
                    $('#nameLengthProgress').removeClass('bg-info bg-danger').addClass('bg-warning');
                } else {
                    $('#nameLengthProgress').removeClass('bg-warning bg-danger').addClass('bg-info');
                }
            }

            // Update preview
            function updatePreview() {
                const name = $('#Name').val() || 'Yeni Şehir';
                $('#previewName').text(name);
            }

            // Real-time updates
            $('#Name').on('input', function() {
                updateCharacterCount();
                updatePreview();
            });

            // Preview button
            $('#previewBtn').click(function() {
                updatePreview();
                showToast('Önizleme güncellendi!', 'success');

                // Animation
                $('.city-badge').addClass('animate__animated animate__bounce');
                setTimeout(() => {
                    $('.city-badge').removeClass('animate__animated animate__bounce');
                }, 1000);
            });

            // Initialize
            updateCharacterCount();
            updatePreview();

            // Auto-capitalize first letter
            $('#Name').on('blur', function() {
                const value = $(this).val();
                if (value && value.length > 0) {
                    $(this).val(value.charAt(0).toUpperCase() + value.slice(1));
                    updatePreview();
                }
            });

            // Toast function
            function showToast(message, type) {
                const toast = $(`<div class="toast align-items-center text-white bg-${type} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`);

                $('#toastContainer').append(toast);
                const bsToast = new bootstrap.Toast(toast[0]);
                bsToast.show();

                toast.on('hidden.bs.toast', function() {
                    $(this).remove();
                });
            }

            // Add toast container if not exists
            if ($('#toastContainer').length === 0) {
                $('body').append('<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            }
        });
    </script>
}