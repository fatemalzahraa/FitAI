@model Eticaret.Core.Entities.City

@{
    ViewData["Title"] = "Şehir Düzenle";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0">
                    <i class="fas fa-edit me-2"></i>Şehir Düzenle
                </h3>
                <div class="edit-icon">
                    <i class="fas fa-pen-alt fa-2x"></i>
                </div>
            </div>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-8">
                    <form asp-action="Edit" id="editForm" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="current-city-info mb-4">
                            <div class="card border-info">
                                <div class="card-header bg-info text-white">
                                    <h6 class="mb-0">
                                        <i class="fas fa-history me-2"></i>Mevcut Bilgiler
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <div class="info-label">Kayıt ID</div>
                                                <div class="info-value">#@Model.Id</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <div class="info-label">Mevcut Şehir Adı</div>
                                                <div class="info-value">@Model.Name</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-8">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control"
                                           placeholder="Yeni Şehir Adı"
                                           required
                                           maxlength="100"
                                           id="cityNameInput" />
                                    <label asp-for="Name" class="form-label">
                                        <i class="fas fa-tag me-1"></i>Yeni Şehir Adı
                                    </label>
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="character-stats mt-4 pt-3">
                                    <div class="progress" style="height: 10px;">
                                        <div class="progress-bar bg-info"
                                             id="editLengthProgress"
                                             role="progressbar"
                                             style="width: 0%"></div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-2">
                                        <small class="text-muted">
                                            <span id="editCharCount">0</span>/100
                                        </small>
                                        <small class="text-muted">
                                            <span id="charChange">0</span> karakter değişti
                                        </small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="change-summary mb-4 d-none" id="changeSummary">
                            <div class="card border-warning">
                                <div class="card-header bg-warning text-dark">
                                    <h6 class="mb-0">
                                        <i class="fas fa-exchange-alt me-2"></i>Değişiklik Özeti
                                    </h6>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="change-item">
                                                <div class="change-label">Eski Değer</div>
                                                <div class="change-value old-value">@Model.Name</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="change-item">
                                                <div class="change-label">Yeni Değer</div>
                                                <div class="change-value new-value" id="newValue">@Model.Name</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-warning px-4" id="saveBtn">
                                <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info ms-2">
                                <i class="fas fa-eye me-2"></i>Detaylar
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                            <button type="button" class="btn btn-outline-danger ms-2" id="resetBtn">
                                <i class="fas fa-undo me-2"></i>Sıfırla
                            </button>
                        </div>
                    </form>
                </div>

                <div class="col-lg-4">
                    <div class="sticky-top" style="top: 20px;">
                        <div class="card border-primary">
                            <div class="card-header bg-primary text-white">
                                <h6 class="mb-0">
                                    <i class="fas fa-chart-line me-2"></i>Canlı İstatistikler
                                </h6>
                            </div>
                            <div class="card-body">
                                <div class="stat-item mb-3">
                                    <div class="stat-label">Değişiklik Durumu</div>
                                    <div class="stat-value" id="changeStatus">Değişiklik Yok</div>
                                </div>

                                <div class="stat-item mb-3">
                                    <div class="stat-label">Karakter Farkı</div>
                                    <div class="stat-value" id="charDifference">0</div>
                                </div>

                                <div class="stat-item mb-3">
                                    <div class="stat-label">Değişiklik Oranı</div>
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated"
                                             id="changeProgress"
                                             role="progressbar"
                                             style="width: 0%">
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <h6 class="text-muted mb-3">
                                        <i class="fas fa-bullseye me-2"></i>Hedefler
                                    </h6>
                                    <ul class="list-group list-group-flush">
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>Geçerli Şehir Adı</span>
                                            <span class="badge bg-primary rounded-pill" id="currentLength">@Model.Name.Length</span>
                                        </li>
                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                            <span>Maksimum Karakter</span>
                                            <span class="badge bg-secondary rounded-pill">100</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .edit-icon {
            opacity: 0.7;
            animation: rotate 3s linear infinite;
        }

        @@keyframes rotate {
            from

        {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }

        }

        .current-city-info .info-item {
            margin-bottom: 10px;
        }

        .info-label {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 5px;
        }

        .info-value {
            font-size: 1.1rem;
            font-weight: 600;
            color: #333;
        }

        .character-stats .progress-bar {
            transition: width 0.3s ease;
        }

        .change-summary .change-item {
            margin-bottom: 15px;
        }

        .change-label {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 5px;
        }

        .change-value {
            font-size: 1.1rem;
            font-weight: 600;
            padding: 8px 12px;
            border-radius: 5px;
            background: #f8f9fa;
        }

            .change-value.old-value {
                color: #dc3545;
                border-left: 4px solid #dc3545;
            }

            .change-value.new-value {
                color: #198754;
                border-left: 4px solid #198754;
            }

        .stat-item {
            margin-bottom: 15px;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 1.2rem;
            font-weight: bold;
            color: #0d6efd;
        }

        .progress-bar-animated {
            animation: progress-animation 1s linear infinite;
        }

        @@keyframes progress-animation {
            from

        {
            background-position: 1rem 0;
        }

        to {
            background-position: 0 0;
        }

        }

        .form-floating > .form-control:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Form validation
            var form = document.getElementById('editForm');
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);

            // Original values
            const originalName = '@Model.Name';
            const originalLength = originalName.length;

            // Update statistics
            function updateStatistics() {
                const newName = $('#cityNameInput').val() || '';
                const newLength = newName.length;
                const charDifference = Math.abs(newLength - originalLength);
                const changeProgress = Math.min((newLength / 100) * 100, 100);

                // Character count
                $('#editCharCount').text(newLength);
                $('#currentLength').text(newLength);
                $('#editLengthProgress').css('width', changeProgress + '%');

                // Character difference
                $('#charDifference').text(charDifference);
                $('#charChange').text(charDifference);

                // Color coding for progress bar
                if (newLength > 80) {
                    $('#editLengthProgress').removeClass('bg-info bg-warning').addClass('bg-danger');
                } else if (newLength > 50) {
                    $('#editLengthProgress').removeClass('bg-info bg-danger').addClass('bg-warning');
                } else {
                    $('#editLengthProgress').removeClass('bg-warning bg-danger').addClass('bg-info');
                }

                // Change status
                if (newName !== originalName) {
                    $('#changeStatus').text('Değişiklik Var');
                    $('#changeStatus').removeClass('text-muted').addClass('text-warning');
                    $('#changeSummary').removeClass('d-none');
                    $('#newValue').text(newName || '(boş)');

                    // Update change progress
                    const similarity = calculateSimilarity(originalName, newName);
                    const changePercentage = Math.round((1 - similarity) * 100);
                    $('#changeProgress').css('width', changePercentage + '%');

                    // Color code change progress
                    if (changePercentage > 50) {
                        $('#changeProgress').removeClass('bg-warning bg-info').addClass('bg-danger');
                    } else if (changePercentage > 20) {
                        $('#changeProgress').removeClass('bg-info bg-danger').addClass('bg-warning');
                    } else {
                        $('#changeProgress').removeClass('bg-warning bg-danger').addClass('bg-info');
                    }
                } else {
                    $('#changeStatus').text('Değişiklik Yok');
                    $('#changeStatus').removeClass('text-warning').addClass('text-muted');
                    $('#changeSummary').addClass('d-none');
                    $('#changeProgress').css('width', '0%');
                }
            }

            // Calculate string similarity (Levenshtein distance)
            function calculateSimilarity(str1, str2) {
                const len1 = str1.length;
                const len2 = str2.length;
                const maxLen = Math.max(len1, len2);

                if (maxLen === 0) return 1;

                const matrix = [];
                for (let i = 0; i <= len1; i++) {
                    matrix[i] = [i];
                }
                for (let j = 0; j <= len2; j++) {
                    matrix[0][j] = j;
                }

                for (let i = 1; i <= len1; i++) {
                    for (let j = 1; j <= len2; j++) {
                        const cost = str1[i - 1] === str2[j - 1] ? 0 : 1;
                        matrix[i][j] = Math.min(
                            matrix[i - 1][j] + 1,
                            matrix[i][j - 1] + 1,
                            matrix[i - 1][j - 1] + cost
                        );
                    }
                }

                const distance = matrix[len1][len2];
                return 1 - (distance / maxLen);
            }

            // Real-time updates
            $('#cityNameInput').on('input', updateStatistics);

            // Initialize statistics
            updateStatistics();

            // Reset button
            $('#resetBtn').click(function() {
                if (confirm('Tüm değişiklikleri sıfırlamak istediğinizden emin misiniz?')) {
                    $('#cityNameInput').val(originalName);
                    updateStatistics();
                    form.classList.remove('was-validated');
                    showToast('Değişiklikler sıfırlandı!', 'info');
                }
            });

            // Save button animation
            $('#saveBtn').click(function() {
                const newName = $('#cityNameInput').val();
                if (newName !== originalName) {
                    const btn = $(this);
                    const originalText = btn.html();
                    btn.prop('disabled', true);
                    btn.html('<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...');

                    setTimeout(() => {
                        btn.prop('disabled', false);
                        btn.html(originalText);
                        showToast('Değişiklikler başarıyla kaydedildi!', 'success');
                    }, 1500);
                }
            });

            // Auto-capitalize first letter
            $('#cityNameInput').on('blur', function() {
                const value = $(this).val();
                if (value && value.length > 0) {
                    const capitalized = value.charAt(0).toUpperCase() + value.slice(1);
                    if (value !== capitalized) {
                        $(this).val(capitalized);
                        updateStatistics();
                        showToast('İlk harf büyük harfe dönüştürüldü', 'info');
                    }
                }
            });

            // Toast function
            function showToast(message, type) {
                const toast = $(`<div class="toast align-items-center text-white bg-${type} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`);

                $('#toastContainer').append(toast);
                const bsToast = new bootstrap.Toast(toast[0]);
                bsToast.show();

                toast.on('hidden.bs.toast', function() {
                    $(this).remove();
                });
            }

            // Add toast container if not exists
            if ($('#toastContainer').length === 0) {
                $('body').append('<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            }
        });
    </script>
}