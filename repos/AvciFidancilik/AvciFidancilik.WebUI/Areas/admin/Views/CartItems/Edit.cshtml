@model Eticaret.Core.Entities.CartItem

@{
    ViewData["Title"] = "Sepet Öğesini Düzenle";
    // Ürün bilgilerini göstermek için
    var currentProductName = Model.Product?.Name ?? "Ürün";
    var currentQuantity = Model.Quantity;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0"><i class="fas fa-edit me-2"></i>Sepet Öğesi Düzenle</h4>
                            <small class="opacity-75">ID: @Model.Id</small>
                        </div>
                        <a asp-action="Index" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Listeye Dön
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row">
                        <!-- Sol Taraf: Düzenleme Formu -->
                        <div class="col-md-6">
                            <form asp-action="Edit" method="post" id="editForm">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="Id" />

                                <!-- Bilgilendirme -->
                                <div class="alert alert-info mb-4">
                                    <div class="d-flex">
                                        <i class="fas fa-info-circle fa-2x me-3"></i>
                                        <div>
                                            <h6 class="alert-heading">Düzenleme Modunda</h6>
                                            <p class="mb-0">Bu sepet öğesinin bilgilerini güncelleyebilirsiniz.</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sepet Seçimi -->
                                <div class="form-group mb-4">
                                    <label asp-for="CartId" class="form-label fw-bold">
                                        <i class="fas fa-shopping-cart me-1"></i>Sepet
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-id-card"></i>
                                        </span>
                                        <select asp-for="CartId" class="form-control form-control-lg"
                                                asp-items="ViewBag.CartId" id="cartSelect">
                                            <option value="">-- Sepet Seçin --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="CartId" class="text-danger small"></span>
                                    <div class="form-text">Ürünün ait olduğu sepeti seçin</div>
                                </div>

                                <!-- Ürün Seçimi -->
                                <div class="form-group mb-4">
                                    <label asp-for="ProductId" class="form-label fw-bold">
                                        <i class="fas fa-box me-1"></i>Ürün
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-box-open"></i>
                                        </span>
                                        <select asp-for="ProductId" class="form-control form-control-lg"
                                                asp-items="ViewBag.ProductId" id="productSelect">
                                            <option value="">-- Ürün Seçin --</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="ProductId" class="text-danger small"></span>
                                    <div class="form-text">Düzenlemek istediğiniz ürünü seçin</div>
                                </div>

                                <!-- Adet Düzenleme -->
                                <div class="form-group mb-4">
                                    <label asp-for="Quantity" class="form-label fw-bold">
                                        <i class="fas fa-hashtag me-1"></i>Adet
                                    </label>
                                    <div class="input-group input-group-lg mb-2">
                                        <button type="button" class="btn btn-outline-secondary" id="decreaseBtn">
                                            <i class="fas fa-minus"></i>
                                        </button>
                                        <input asp-for="Quantity" class="form-control text-center"
                                               value="@currentQuantity" min="1" id="quantityInput" />
                                        <button type="button" class="btn btn-outline-secondary" id="increaseBtn">
                                            <i class="fas fa-plus"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Quantity" class="text-danger small"></span>
                                    <div class="form-text">En az 1 adet olmalıdır</div>

                                    <!-- Adet Slider -->
                                    <div class="mt-3">
                                        <input type="range" class="form-range" id="quantitySlider"
                                               min="1" max="50" value="@currentQuantity">
                                        <div class="d-flex justify-content-between">
                                            <small>1</small>
                                            <small>25</small>
                                            <small>50</small>
                                        </div>
                                    </div>
                                </div>

                                <!-- Onay Paneli -->
                                <div class="card border-warning mb-4">
                                    <div class="card-header bg-warning bg-opacity-10">
                                        <h6 class="mb-0"><i class="fas fa-exclamation-circle me-2"></i>Değişiklikler</h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="confirmChanges" required>
                                            <label class="form-check-label" for="confirmChanges">
                                                <i class="fas fa-check me-1"></i>
                                                Yaptığım değişiklikleri onaylıyorum.
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- Butonlar -->
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <button type="button" class="btn btn-outline-secondary" id="resetBtn">
                                            <i class="fas fa-redo me-1"></i>Değişiklikleri İptal Et
                                        </button>
                                    </div>
                                    <div>
                                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-2" id="detailsBtn">
                                            <i class="fas fa-eye me-2"></i>Detaylara Dön
                                        </a>
                                        <button type="button" class="btn btn-success" id="saveBtn" disabled>
                                            <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- Sağ Taraf: Önizleme ve Bilgiler -->
                        <div class="col-md-6">
                            <!-- Güncel Durum -->
                            <div class="card mb-4">
                                <div class="card-header bg-info text-white">
                                    <h5 class="mb-0"><i class="fas fa-history me-2"></i>Mevcut Durum</h5>
                                </div>
                                <div class="card-body">
                                    <div class="current-info">
                                        <div class="info-row">
                                            <i class="fas fa-shopping-cart text-primary"></i>
                                            <div>
                                                <small>Mevcut Sepet</small>
                                                <p class="mb-0 fw-bold">ID: @Model.CartId</p>
                                            </div>
                                        </div>
                                        <div class="info-row">
                                            <i class="fas fa-box text-success"></i>
                                            <div>
                                                <small>Mevcut Ürün</small>
                                                <p class="mb-0 fw-bold">@currentProductName</p>
                                            </div>
                                        </div>
                                        <div class="info-row">
                                            <i class="fas fa-hashtag text-warning"></i>
                                            <div>
                                                <small>Mevcut Adet</small>
                                                <p class="mb-0 fw-bold">@currentQuantity adet</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Önizleme -->
                            <div class="card mb-4">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="fas fa-eye me-2"></i>Yeni Durum Önizleme</h5>
                                </div>
                                <div class="card-body">
                                    <div id="previewContent" class="text-center">
                                        <div class="preview-placeholder">
                                            <i class="fas fa-sync-alt fa-3x text-muted mb-3"></i>
                                            <p class="text-muted">Değişiklik yapın, önizleme burada görünecek</p>
                                        </div>

                                        <div id="changesPreview" class="d-none">
                                            <div class="change-item">
                                                <small class="text-muted">Sepet</small>
                                                <p class="mb-1">
                                                    <span class="text-decoration-line-through me-2" id="oldCart"></span>
                                                    <i class="fas fa-arrow-right text-primary mx-2"></i>
                                                    <span class="fw-bold" id="newCart"></span>
                                                </p>
                                            </div>
                                            <div class="change-item">
                                                <small class="text-muted">Ürün</small>
                                                <p class="mb-1">
                                                    <span class="text-decoration-line-through me-2" id="oldProduct"></span>
                                                    <i class="fas fa-arrow-right text-primary mx-2"></i>
                                                    <span class="fw-bold" id="newProduct"></span>
                                                </p>
                                            </div>
                                            <div class="change-item">
                                                <small class="text-muted">Adet</small>
                                                <p class="mb-1">
                                                    <span class="text-decoration-line-through me-2" id="oldQuantity"></span>
                                                    <i class="fas fa-arrow-right text-primary mx-2"></i>
                                                    <span class="fw-bold text-success" id="newQuantity"></span>
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Stok Bilgisi -->
                            <div class="card mb-4">
                                <div class="card-header bg-warning bg-opacity-10">
                                    <h6 class="mb-0"><i class="fas fa-boxes me-2"></i>Stok Durumu</h6>
                                </div>
                                <div class="card-body">
                                    <div id="stockInfo" class="text-center">
                                        <i class="fas fa-question-circle fa-2x text-muted mb-2"></i>
                                        <p class="text-muted small">Ürün seçin, stok bilgisi görünecek</p>
                                    </div>

                                    <div id="stockDetails" class="d-none">
                                        <div class="stock-meter mb-3">
                                            <div class="d-flex justify-content-between mb-1">
                                                <small>Stok Durumu</small>
                                                <small><span id="currentStock">0</span> adet</small>
                                            </div>
                                            <div class="progress" style="height: 10px;">
                                                <div id="stockProgress" class="progress-bar"
                                                     role="progressbar" style="width: 0%"></div>
                                            </div>
                                        </div>

                                        <div id="stockWarning" class="alert d-none">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            <span id="warningText"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Hızlı Erişim -->
                            <div class="card">
                                <div class="card-header bg-secondary bg-opacity-10">
                                    <h6 class="mb-0"><i class="fas fa-bolt me-2"></i>Hızlı Erişim</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-grid gap-2">
                                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-primary">
                                            <i class="fas fa-info-circle me-2"></i>Detayları Görüntüle
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                            <i class="fas fa-trash-alt me-2"></i>Bu Öğeyi Sil
                                        </a>
                                        <a asp-action="Index" class="btn btn-outline-secondary">
                                            <i class="fas fa-list me-2"></i>Tüm Sepet Öğeleri
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Ürün verileri (Controller'dan gelecek)
        var productData = {};
        var originalValues = {
            cartId: @Model.CartId,
            productId: @Model.ProductId,
            quantity: @Model.Quantity
        };

        $(document).ready(function() {
            // Form validation için
            initializeFormValidation();

            // Ürün verilerini yükle
            loadProductData();

            // Adet artırma/azaltma
            $('#increaseBtn').click(function() {
                var quantityInput = $('#quantityInput');
                var currentValue = parseInt(quantityInput.val());
                quantityInput.val(currentValue + 1);
                $('#quantitySlider').val(currentValue + 1);
                updatePreview();
                updateStockInfo();
            });

            $('#decreaseBtn').click(function() {
                var quantityInput = $('#quantityInput');
                var currentValue = parseInt(quantityInput.val());
                if (currentValue > 1) {
                    quantityInput.val(currentValue - 1);
                    $('#quantitySlider').val(currentValue - 1);
                    updatePreview();
                    updateStockInfo();
                }
            });

            // Slider değiştiğinde
            $('#quantitySlider').on('input', function() {
                var sliderValue = $(this).val();
                $('#quantityInput').val(sliderValue);
                updatePreview();
                updateStockInfo();
            });

            // Input değiştiğinde slider'ı güncelle
            $('#quantityInput').on('input', function() {
                var inputValue = $(this).val();
                $('#quantitySlider').val(inputValue);
                updatePreview();
                updateStockInfo();
            });

            // Ürün seçildiğinde
            $('#productSelect').change(function() {
                updatePreview();
                updateStockInfo();
            });

            // Sepet seçildiğinde
            $('#cartSelect').change(function() {
                updatePreview();
            });

            // Onay kutusu değiştiğinde
            $('#confirmChanges').change(function() {
                $('#saveBtn').prop('disabled', !$(this).is(':checked'));
            });

            // Reset butonu
            $('#resetBtn').click(function() {
                if (confirm('Yaptığınız tüm değişiklikler iptal edilecek. Emin misiniz?')) {
                    resetForm();
                }
            });

            // Kaydet butonu - GÜNCELLENDİ
            $('#saveBtn').click(function(e) {
                e.preventDefault();

                // Önce onay kutusunu kontrol et
                if (!$('#confirmChanges').is(':checked')) {
                    showAlert('Lütfen onay kutusunu işaretleyin!', 'warning');
                    return false;
                }

                // Form validasyonunu kontrol et
                if (!validateForm()) {
                    showAlert('Lütfen tüm zorunlu alanları doğru şekilde doldurun!', 'warning');
                    return false;
                }

                // Çift onay için modal göster
                showConfirmationModal();
            });

            // İptal butonları
            $('#detailsBtn').click(function(e) {
                e.preventDefault();
                if (confirm('Değişiklikleriniz kaydedilmeyecek. Detay sayfasına dönmek istediğinize emin misiniz?')) {
                    window.location.href = '@Url.Action("Details", new { id = Model.Id })';
                }
            });

            // Sayfa yüklendiğinde önizlemeyi güncelle
            updatePreview();
        });

        function initializeFormValidation() {
            // Form validasyon kuralları
            $('#editForm').validate({
                rules: {
                    CartId: {
                        required: true
                    },
                    ProductId: {
                        required: true
                    },
                    Quantity: {
                        required: true,
                        min: 1
                    }
                },
                messages: {
                    CartId: {
                        required: "Lütfen bir sepet seçin"
                    },
                    ProductId: {
                        required: "Lütfen bir ürün seçin"
                    },
                    Quantity: {
                        required: "Lütfen adet girin",
                        min: "Adet en az 1 olmalıdır"
                    }
                },
                errorElement: 'span',
                errorClass: 'text-danger small',
                highlight: function(element) {
                    $(element).addClass('is-invalid');
                },
                unhighlight: function(element) {
                    $(element).removeClass('is-invalid');
                }
            });
        }

        function validateForm() {
            var isValid = true;

            // Sepet kontrolü
            if (!$('#cartSelect').val()) {
                $('#cartSelect').addClass('is-invalid');
                isValid = false;
            } else {
                $('#cartSelect').removeClass('is-invalid');
            }

            // Ürün kontrolü
            if (!$('#productSelect').val()) {
                $('#productSelect').addClass('is-invalid');
                isValid = false;
            } else {
                $('#productSelect').removeClass('is-invalid');
            }

            // Adet kontrolü
            var quantity = parseInt($('#quantityInput').val());
            if (!quantity || quantity < 1) {
                $('#quantityInput').addClass('is-invalid');
                isValid = false;
            } else {
                $('#quantityInput').removeClass('is-invalid');
            }

            return isValid;
        }

        function loadProductData() {
            // Bu fonksiyon controller'dan ürün verilerini alacak
            // Örnek statik veri:
            productData = {
                "1": { name: "Ürün 1", price: 100, stock: 50 },
                "2": { name: "Ürün 2", price: 200, stock: 30 },
                "3": { name: "Ürün 3", price: 150, stock: 10 }
            };
        }

        function updatePreview() {
            var cartId = $('#cartSelect').val();
            var productId = $('#productSelect').val();
            var quantity = $('#quantityInput').val();

            // Değişiklik var mı kontrol et
            var hasChanges =
                cartId != originalValues.cartId ||
                productId != originalValues.productId ||
                quantity != originalValues.quantity;

            if (hasChanges) {
                $('#previewContent .preview-placeholder').addClass('d-none');
                $('#changesPreview').removeClass('d-none');

                // Eski değerleri göster
                $('#oldCart').text('Sepet ' + originalValues.cartId);
                $('#oldProduct').text('Ürün ' + originalValues.productId);
                $('#oldQuantity').text(originalValues.quantity + ' adet');

                // Yeni değerleri göster
                $('#newCart').text('Sepet ' + (cartId || originalValues.cartId));
                $('#newProduct').text('Ürün ' + (productId || originalValues.productId));
                $('#newQuantity').text(quantity + ' adet');
            } else {
                $('#previewContent .preview-placeholder').removeClass('d-none');
                $('#changesPreview').addClass('d-none');
            }
        }

        function updateStockInfo() {
            var productId = $('#productSelect').val();
            var quantity = parseInt($('#quantityInput').val()) || 0;

            if (productId && productData[productId]) {
                var product = productData[productId];
                var stock = product.stock;

                $('#stockInfo').addClass('d-none');
                $('#stockDetails').removeClass('d-none');
                $('#currentStock').text(stock);

                // Progress bar hesaplama
                var stockPercentage = Math.min((stock / 100) * 100, 100);
                var progressBar = $('#stockProgress');

                // Renk ayarla
                if (stockPercentage >= 50) {
                    progressBar.removeClass('bg-warning bg-danger').addClass('bg-success');
                } else if (stockPercentage >= 20) {
                    progressBar.removeClass('bg-success bg-danger').addClass('bg-warning');
                } else {
                    progressBar.removeClass('bg-success bg-warning').addClass('bg-danger');
                }

                progressBar.css('width', stockPercentage + '%');

                // Uyarı kontrolü
                var warningDiv = $('#stockWarning');
                if (quantity > stock) {
                    warningDiv.removeClass('d-none alert-success alert-warning').addClass('alert-danger');
                    $('#warningText').html('<strong>Stok yetersiz!</strong> Sadece ' + stock + ' adet kaldı.');
                    $('#saveBtn').prop('disabled', true);
                } else if (quantity > stock / 2) {
                    warningDiv.removeClass('d-none alert-danger alert-success').addClass('alert-warning');
                    $('#warningText').html('<strong>Stok azalıyor!</strong> Mevcut: ' + stock + ' adet');
                    if ($('#confirmChanges').is(':checked')) {
                        $('#saveBtn').prop('disabled', false);
                    }
                } else {
                    warningDiv.removeClass('d-none alert-danger alert-warning').addClass('alert-success');
                    $('#warningText').html('<strong>Stok yeterli.</strong> Mevcut: ' + stock + ' adet');
                    if ($('#confirmChanges').is(':checked')) {
                        $('#saveBtn').prop('disabled', false);
                    }
                }
            } else {
                $('#stockInfo').removeClass('d-none');
                $('#stockDetails').addClass('d-none');
                $('#stockWarning').addClass('d-none');
            }
        }

        function resetForm() {
            $('#cartSelect').val(originalValues.cartId);
            $('#productSelect').val(originalValues.productId);
            $('#quantityInput').val(originalValues.quantity);
            $('#quantitySlider').val(originalValues.quantity);
            $('#confirmChanges').prop('checked', false);
            $('#saveBtn').prop('disabled', true);

            // Form validasyonunu temizle
            $('.is-invalid').removeClass('is-invalid');

            updatePreview();
            updateStockInfo();
        }

        // Onay modalını göster
        function showConfirmationModal() {
            // Bootstrap modal oluştur
            var modalHtml = `
                <div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header bg-success text-white">
                                <h5 class="modal-title" id="confirmationModalLabel">
                                    <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                                </h5>
                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="text-center mb-4">
                                    <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
                                    <h4>Değişiklikleri kaydetmek istediğinize emin misiniz?</h4>
                                    <p class="text-muted">Bu sepet öğesinin bilgileri güncellenecektir.</p>
                                </div>
                                <div class="alert alert-info">
                                    <i class="fas fa-info-circle me-2"></i>
                                    <strong>Bilgi:</strong> Değişiklikler veritabanına kaydedilecektir.
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                    <i class="fas fa-times me-2"></i>Vazgeç
                                </button>
                                <button type="button" class="btn btn-success" id="confirmFinalSave">
                                    <i class="fas fa-check me-2"></i>Evet, Kaydet
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            // Modal'ı body'e ekle
            $('body').append(modalHtml);

            // Modal'ı göster
            var confirmationModal = new bootstrap.Modal(document.getElementById('confirmationModal'));
            confirmationModal.show();

            // Kaydetme onayı verildiğinde
            $('#confirmFinalSave').click(function() {
                // Butonu devre dışı bırak ve yükleniyor göstergesi ekle
                $('#saveBtn').prop('disabled', true);
                $('#saveBtn').html('<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Kaydediliyor...');

                // Modal'ı kapat
                confirmationModal.hide();

                // Formu submit et
                setTimeout(function() {
                    document.getElementById('editForm').submit();
                }, 500);
            });

            // Modal kapandığında temizle
            $('#confirmationModal').on('hidden.bs.modal', function () {
                $(this).remove();
            });
        }

        // Alert göster
        function showAlert(message, type) {
            var alertHtml = `
                <div class="alert alert-${type} alert-dismissible fade show position-fixed top-0 start-50 translate-middle-x mt-3"
                     role="alert" style="z-index: 9999; max-width: 500px;">
                    <i class="fas fa-${type === 'warning' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;

            $('body').append(alertHtml);

            // 5 saniye sonra alert'i kaldır
            setTimeout(function() {
                $('.alert').alert('close');
            }, 5000);
        }
    </script>

    <style>
        .card {
            border-radius: 12px;
            overflow: hidden;
        }

        .card-header {
            border-radius: 12px 12px 0 0 !important;
            padding: 1rem 1.5rem;
        }

        .form-control-lg {
            border-radius: 10px;
            border: 2px solid #e0e0e0;
            transition: all 0.3s ease;
        }

            .form-control-lg:focus {
                border-color: #0d6efd;
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
            }

            .form-control-lg.is-invalid {
                border-color: #dc3545;
            }

                .form-control-lg.is-invalid:focus {
                    border-color: #dc3545;
