@model Eticaret.Core.Entities.CartItem

@{
    ViewData["Title"] = "Sepet Öğesini Sil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0"><i class="fas fa-trash-alt me-2"></i>Sepet Öğesi Silme</h4>
                        <a asp-action="Index" class="btn btn-light btn-sm">
                            <i class="fas fa-arrow-left me-1"></i>Listeye Dön
                        </a>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Silme Uyarısı -->
                    <div class="alert alert-warning" role="alert">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="fas fa-exclamation-triangle fa-2x"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="alert-heading">Bu işlem geri alınamaz!</h5>
                                <p class="mb-0">Bu ürünü sepetten silmek istediğinizden emin misiniz?</p>
                            </div>
                        </div>
                    </div>

                    <!-- Silinecek Öğe Detayları -->
                    <div class="card border-warning mb-4">
                        <div class="card-header bg-warning bg-opacity-10">
                            <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Silinecek Sepet Öğesi</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <!-- Sol Taraf: Ürün Bilgileri -->
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <h6 class="text-muted mb-2"><i class="fas fa-shopping-cart me-1"></i> Sepet Bilgisi</h6>
                                        <div class="d-flex align-items-center">
                                            <div class="icon-circle bg-primary me-3">
                                                <i class="fas fa-cart-shopping text-white"></i>
                                            </div>
                                            <div>
                                                <p class="mb-0 fw-bold">Sepet ID: @Model.CartId</p>
                                                <small class="text-muted">@Model.Cart?.Id</small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <h6 class="text-muted mb-2"><i class="fas fa-box me-1"></i> Ürün Bilgisi</h6>
                                        <div class="d-flex align-items-center">
                                            <div class="icon-circle bg-success me-3">
                                                <i class="fas fa-box-open text-white"></i>
                                            </div>
                                            <div>
                                                <p class="mb-0 fw-bold">Ürün ID: @Model.ProductId</p>
                                                <small class="text-muted">@Model.Product?.Description</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Sağ Taraf: Detaylar -->
                                <div class="col-md-6">
                                    <div class="info-box mb-3">
                                        <div class="info-icon bg-info">
                                            <i class="fas fa-hashtag"></i>
                                        </div>
                                        <div class="info-content">
                                            <small>Adet</small>
                                            <h5 class="mb-0">@Model.Quantity adet</h5>
                                        </div>
                                    </div>

                                    <!-- Toplam Hesaplama -->
                                    <div class="info-box">
                                        <div class="info-icon bg-purple">
                                            <i class="fas fa-calculator"></i>
                                        </div>
                                        <div class="info-content">
                                            <small>Toplam Tutar (Tahmini)</small>
                                            <h5 class="mb-0 text-success">
                                                @{
                                                    var productPrice = Model.Product?.Price ?? 0;
                                                    var totalPrice = Model.Quantity * productPrice;
                                                }
                                                @totalPrice.ToString("C")
                                            </h5>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Silme Formu - BASİTLEŞTİRİLDİ -->
                    <form asp-action="Delete" method="post" id="deleteForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="border rounded p-3 bg-light mb-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" required
                                       onchange="document.getElementById('deleteBtn').disabled = !this.checked;">
                                <label class="form-check-label" for="confirmDelete">
                                    <i class="fas fa-check-circle me-1"></i>
                                    <strong>Bu işlemin geri alınamayacağını anladım ve onaylıyorum.</strong>
                                </label>
                            </div>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-times me-2"></i>İptal Et
                            </a>

                            <button type="submit" class="btn btn-danger btn-lg px-4" id="deleteBtn" disabled
                                    onclick="return confirm('Bu öğeyi silmek istediğinizden emin misiniz?\\nBu işlem geri alınamaz!')">
                                <i class="fas fa-trash-alt me-2"></i>Kalıcı Olarak Sil
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .card {
            border-radius: 15px;
            overflow: hidden;
        }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
            padding: 1.5rem;
        }

        .alert-warning {
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
            border: 2px solid #ffc107;
            border-radius: 10px;
            color: #856404;
        }

        .icon-circle {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bg-primary {
            background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
        }

        .bg-success {
            background: linear-gradient(135deg, #198754 0%, #20c997 100%);
        }

        .info-box {
            display: flex;
            align-items: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 10px;
            border: 1px solid #dee2e6;
        }

        .info-icon {
            width: 50px;
            height: 50px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            color: white;
            font-size: 1.2rem;
        }

        .bg-info {
            background: linear-gradient(135deg, #0dcaf0 0%, #17a2b8 100%);
        }

        .bg-purple {
            background: linear-gradient(135deg, #6f42c1 0%, #a370f7 100%);
        }

        .info-content small {
            color: #6c757d;
            font-size: 0.8rem;
            display: block;
        }

        .info-content h5 {
            margin: 0;
            font-weight: 600;
        }

        .stat-card {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            transition: all 0.3s ease;
        }

        .btn-lg {
            border-radius: 10px;
            padding: 0.75rem 1.5rem;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .btn-danger {
            background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
            border: none;
        }

            .btn-danger:not(:disabled):hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
            }

            .btn-danger:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .btn-outline-secondary {
            border: 2px solid #6c757d;
        }

            .btn-outline-secondary:hover {
                background-color: #6c757d;
                color: white;
            }

        .form-check-input:checked {
            background-color: #dc3545;
            border-color: #dc3545;
        }

        .form-check-input:focus {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }

        .bg-light {
            background-color: #f8f9fa !important;
        }

        .border-warning {
            border: 2px solid #ffc107 !important;
        }

        .bg-warning.bg-opacity-10 {
            background-color: rgba(255, 193, 7, 0.1) !important;
        }

        @@media (max-width: 768px) {
            .btn-lg {
                width: 100%;
                margin-bottom: 10px;
            }

            .d-flex.justify-content-between {
                flex-direction: column;
            }
        }
    </style>
}