@model Eticaret.Core.Entities.Cart

@{
    ViewData["Title"] = "Sepet Oluştur";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0"><i class="fas fa-shopping-cart me-2"></i>Yeni Sepet Oluştur</h3>
        </div>

        <div class="card-body">

            <!-- 🔥 TempData Hata Mesajı -->
            @if (TempData["CartError"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show mb-4" role="alert">
                    <i class="fas fa-exclamation-circle me-2"></i>
                    @TempData["CartError"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row">

                <!-- SOL TARAF: FORM -->
                <div class="col-md-6">
                    <form asp-action="Create" id="cartForm">

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- USER SEÇİMİ -->
                        <div class="mb-4">
                            <div class="form-floating">
                                <select asp-for="UserId" class="form-select" asp-items="ViewBag.UserId">
                                    <option value="">Lütfen kullanıcı seçiniz</option>
                                </select>
                                <label asp-for="UserId"></label>
                            </div>

                            <span asp-validation-for="UserId" class="text-danger small d-block mt-1"></span>

                            <div class="form-text mt-1">
                                <i class="fas fa-info-circle me-1"></i>
                                Sepet oluşturmak istediğiniz kullanıcıyı seçin.
                            </div>
                        </div>

                        <!-- BUTONLAR -->
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-plus-circle me-2"></i>Sepet Oluştur
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                        </div>

                    </form>
                </div>

                <!-- SAĞ TARAF: BİLGİ KARTI -->
                <div class="col-md-6">
                    <div class="info-card p-4 h-100">
                        <h5 class="text-info mb-3">
                            <i class="fas fa-lightbulb me-2"></i>Bilgilendirme
                        </h5>

                        <ul class="list-unstyled">
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Her kullanıcının yalnızca bir aktif sepeti olabilir.
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Sepet oluşturulduktan sonra ürün ekleyebilirsiniz.
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check-circle text-success me-2"></i>
                                Kullanıcı seçimi zorunludur.
                            </li>
                        </ul>

                        <div class="alert alert-info mt-3">
                            <small>
                                <i class="fas fa-exclamation-triangle me-1"></i>
                                Lütfen sepet oluşturmadan önce kullanıcının aktif bir sepeti olmadığını kontrol edin.
                            </small>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: #f8f9fa;
        }

        .card {
            border: none;
            border-radius: 10px;
            overflow: hidden;
        }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
            padding: 1.2rem 1.5rem;
        }

        .form-floating > .form-select {
            padding-top: 1.625rem;
            padding-bottom: 0.625rem;
        }

        .info-card {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 8px;
            border-left: 4px solid #0d6efd;
        }

        .btn-success {
            background: linear-gradient(to right, #198754, #157347);
            border: none;
            transition: 0.3s;
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(25, 135, 84, 0.3);
            }

        @@media (max-width: 768px) {
            .info-card

        {
            margin-top: 2rem;
        }

        .btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }

        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // Submit animasyonu
            $('#cartForm').on('submit', function () {
                const btn = $('button[type="submit"]');
                btn.prop('disabled', true);
                btn.html('<i class="fas fa-spinner fa-spin me-2"></i>Oluşturuluyor...');
            });

            // Select2 aktif
            $('select').select2({
                placeholder: "Kullanıcı seçiniz",
                allowClear: true,
                width: '100%',
                theme: 'bootstrap-5'
            });
        });
    </script>
}
