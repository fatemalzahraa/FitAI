@model Eticaret.Core.Entities.Cart

@{
    ViewData["Title"] = "Sepet Düzenle";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-warning text-dark py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0"><i class="fas fa-edit me-2"></i>Sepet Düzenle</h3>
                <span class="badge bg-dark fs-6">
                    <i class="fas fa-hashtag me-1"></i>ID: @Model.Id
                </span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <!-- FORM -->
                <div class="col-lg-6">
                    <div class="form-card p-4 rounded">

                        <div class="alert alert-info mb-4">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle fa-lg me-3"></i>
                                <div>
                                    <h6 class="alert-heading mb-1">Düzenleme İşlemi</h6>
                                    <p class="mb-0">Sepet bilgilerini güncelleyebilirsiniz. Kullanıcı değişikliği sepetin sahibini değiştirir.</p>
                                </div>
                            </div>
                        </div>

                        <form asp-action="Edit" id="editForm" method="post">
                            <input type="hidden" asp-for="Id" />

                            <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none" id="validationSummary">
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>

                            <div class="form-section mb-4">
                                <h5 class="section-title mb-3">
                                    <i class="fas fa-user-cog me-2"></i>Kullanıcı Bilgileri
                                </h5>

                                <div class="form-floating mb-3">
                                    <select asp-for="UserId" class="form-select select2-custom" asp-items="ViewBag.UserId">
                                        <option value="">Lütfen bir kullanıcı seçin</option>
                                    </select>
                                    <label asp-for="UserId">
                                        <i class="fas fa-user me-1"></i>Kullanıcı Seçimi
                                    </label>
                                    <span asp-validation-for="UserId" class="text-danger small d-block mt-1"></span>

                                    <div class="form-text">
                                        <i class="fas fa-lightbulb me-1"></i>Sepetin yeni sahibini seçin.
                                    </div>
                                </div>

                                <div class="current-user-info p-3 bg-light rounded mt-3">
                                    <h6 class="text-muted mb-2">
                                        <i class="fas fa-user-check me-1"></i>Mevcut Kullanıcı
                                    </h6>
                                    <div class="d-flex align-items-center">
                                        <i class="fas fa-user-circle fa-2x text-primary me-3"></i>
                                        <div>
                                            <strong>@Model.User?.Email</strong>
                                            <div class="text-muted small">
                                                <i class="fas fa-id-card me-1"></i>ID: @Model.UserId
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- NOT: CreatedDate / UpdatedDate kullanılmıyor — modelde yoksa hata vermez -->
                            <div class="form-section mb-4">
                                <h5 class="section-title mb-3">
                                    <i class="fas fa-info-circle me-2"></i>Bilgilendirme
                                </h5>
                                <div class="small text-muted">
                                    Bu sayfadan yalnızca sepetin sahibini değiştirebilirsiniz. Sepet içeriği korunur.
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-4 pt-3 border-top">
                                <button type="submit" class="btn btn-warning btn-lg px-4 flex-fill" id="submitBtn">
                                    <i class="fas fa-save me-2"></i>Kaydet
                                </button>

                                <button type="button" class="btn btn-outline-secondary btn-lg px-4 flex-fill" id="resetBtn">
                                    <i class="fas fa-undo me-2"></i>Sıfırla
                                </button>
                            </div>
                        </form>

                    </div>
                </div>

                <!-- SIDEBAR -->
                <div class="col-lg-6 mt-4 mt-lg-0">
                    <div class="info-sidebar h-100">

                        <div class="card border-warning mb-4">
                            <div class="card-header bg-transparent border-warning">
                                <h5 class="text-warning mb-0">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Önemli Uyarılar
                                </h5>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled mb-0">
                                    <li class="mb-3">
                                        <div class="d-flex">
                                            <i class="fas fa-exchange-alt text-warning me-2 mt-1"></i>
                                            <div>
                                                <strong>Kullanıcı Değişikliği</strong>
                                                <p class="small text-muted mb-0">Sepet tamamen yeni kullanıcıya geçer. Sepet içeriği korunur.</p>
                                            </div>
                                        </div>
                                    </li>

                                    <li class="mb-3">
                                        <div class="d-flex">
                                            <i class="fas fa-history text-warning me-2 mt-1"></i>
                                            <div>
                                                <strong>Güncellenme</strong>
                                                <p class="small text-muted mb-0">Güncelleme bilgisi modelde yoksa gösterilmez.</p>
                                            </div>
                                        </div>
                                    </li>

                                    <li>
                                        <div class="d-flex">
                                            <i class="fas fa-shopping-basket text-warning me-2 mt-1"></i>
                                            <div>
                                                <strong>Sepet İçeriği</strong>
                                                <p class="small text-muted mb-0">Ürünler değişmeden kalır.</p>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="card border-info mb-4">
                            <div class="card-header bg-transparent border-info">
                                <h5 class="text-info mb-0">
                                    <i class="fas fa-chart-line me-2"></i>Hızlı İşlemler
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="d-grid gap-2">
                                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                                        <i class="fas fa-eye me-2"></i>Detayları Gör
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                                        <i class="fas fa-trash-alt me-2"></i>Sil
                                    </a>

                                    <a asp-action="Index" class="btn btn-outline-secondary">
                                        <i class="fas fa-list me-2"></i>Listeye Dön
                                    </a>
                                </div>
                            </div>
                        </div>

                        <div class="card border-success">
                            <div class="card-header bg-transparent border-success">
                                <h5 class="text-success mb-0">
                                    <i class="fas fa-chart-pie me-2"></i>Sepet İstatistikleri
                                </h5>
                            </div>
                            <div class="card-body text-center">
                                <div class="row">
                                    <div class="col-6 mb-3">
                                        <div class="stat-number text-primary">0</div>
                                        <div class="stat-label text-muted small">Toplam Ürün</div>
                                    </div>
                                    <div class="col-6 mb-3">
                                        <div class="stat-number text-success">0₺</div>
                                        <div class="stat-label text-muted small">Toplam Tutar</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <!-- /SIDEBAR -->

            </div>
        </div>

        <div class="card-footer bg-light py-3">
            <div class="row">
                <div class="col-md-6">
                    <small class="text-muted">
                        <i class="fas fa-code-branch me-1"></i>
                        Model: Eticaret.Core.Entities.Cart
                    </small>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-muted">
                        <i class="fas fa-clock me-1"></i>
                        Son düzenleme: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>
            </div>
        </div>

    </div>
</div>

@section Styles {
    <style>
        body {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            min-height: 100vh;
        }

        .card {
            border-radius: 15px;
        }

        .form-card {
            background: #fff;
            border: 1px solid #e9ecef;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }

        .section-title {
            border-bottom: 2px solid #ffc107;
            position: relative;
            padding-bottom: .5rem;
        }

            .section-title:after {
                content: "";
                position: absolute;
                bottom: -2px;
                left: 0;
                width: 70px;
                height: 2px;
                background: #0dcaf0;
            }

        .form-select:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255,193,7,0.25);
        }

        .current-user-info {
            border-left: 4px solid #0dcaf0;
        }

        .time-info {
            border: 1px solid transparent;
        }

       
        @@media (max-width: 768px) {
            .info-sidebar

        {
            margin-top: 20px;
        }

        .d-flex {
            flex-direction: column !important;
        }

        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            // Select2 varsa başlat
            if ($.fn.select2) {
                $('.select2-custom').select2({
                    placeholder: "Kullanıcı seçiniz",
                    allowClear: true,
                    width: '100%',
                    theme: 'bootstrap-5',
                    dropdownParent: $('#editForm')
                });
            }

            // Form submit handler
            $('#editForm').on('submit', function (e) {
                // Basit client-side validation: kullanıcı seçili olmalı
                const userId = $('#UserId').val();
                if (!userId) {
                    e.preventDefault();
                    $('#validationSummary').removeClass('d-none').html('<div>Kullanıcı seçmelisiniz.</div>');
                    $('html, body').animate({ scrollTop: $('#validationSummary').offset().top - 100 }, 200);
                    return false;
                }

                // Butonu disable et, animasyon göster
                $('#submitBtn').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...');
                // Form submit devam eder
            });

            // Reset butonu
            $('#resetBtn').on('click', function () {
                if (confirm('Formdaki değişiklikleri sıfırlamak istiyor musunuz?')) {
                    // Reset native
                    $('#editForm')[0].reset();
                    // Select2 reset
                    if ($.fn.select2) {
                        $('.select2-custom').val(null).trigger('change');
                    }
                    // Temizle uyarı
                    $('#validationSummary').addClass('d-none').empty();
                }
            });

            // Değişiklik uyarısı
            let formChanged = false;
            $('#editForm').on('change', 'input, select, textarea', function () {
                formChanged = true;
            });

            $(window).on('beforeunload', function () {
                if (formChanged) {
                    return 'Kaydedilmemiş değişiklikler var. Sayfadan ayrılmak istediğinize emin misiniz?';
                }
            });

            $('#editForm').on('submit', function () { formChanged = false; });
        });
    </script>
}
