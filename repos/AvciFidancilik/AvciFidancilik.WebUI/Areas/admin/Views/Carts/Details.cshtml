@model Eticaret.Core.Entities.Cart

@{
    ViewData["Title"] = "Sepet Detayları";
}

<div class="container mt-4">
    <div class="card shadow-lg border-0">
        <div class="card-header bg-info text-white py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h3 class="mb-0">
                    <i class="fas fa-shopping-cart me-2"></i>Sepet Detayları
                </h3>
                <span class="badge bg-light text-dark fs-6">
                    <i class="fas fa-hashtag me-1"></i>ID: @Model.Id
                </span>
            </div>
        </div>

        <div class="card-body p-4">

            <!-- Temel Bilgiler -->
            <div class="info-card mb-4">
                <h5 class="card-title text-primary mb-3">
                    <i class="fas fa-info-circle me-2"></i>Temel Bilgiler
                </h5>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="detail-item p-3 rounded">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-user-circle fa-lg text-secondary me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Kullanıcı Email</small>
                                    <strong class="fs-5">@Model.User?.Email</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="detail-item p-3 rounded">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fas fa-user-tag fa-lg text-secondary me-3"></i>
                                <div>
                                    <small class="text-muted d-block">Kullanıcı Adı</small>
                                    <strong class="fs-5">@(!string.IsNullOrEmpty(Model.User?.UserName) ? Model.User.UserName : "Belirtilmemiş")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detay Tablosu -->
            <div class="card border-info mb-4">
                <div class="card-header bg-transparent border-info">
                    <h5 class="mb-0 text-info">
                        <i class="fas fa-clipboard-list me-2"></i>Detaylı Bilgiler
                    </h5>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <tbody>

                                <tr>
                                    <th class="text-nowrap" style="width:200px;">
                                        <i class="fas fa-id-card me-2 text-muted"></i>Sepet ID
                                    </th>
                                    <td><span class="badge bg-info">@Model.Id</span></td>
                                </tr>

                                <tr>
                                    <th><i class="fas fa-envelope me-2 text-muted"></i>Kullanıcı Email</th>
                                    <td>@Model.User?.Email</td>
                                </tr>

                                <tr>
                                    <th><i class="fas fa-user me-2 text-muted"></i>Kullanıcı ID</th>
                                    <td><span class="badge bg-secondary">@Model.User?.Id</span></td>
                                </tr>

                                <!-- Oluşturulma Tarihi -->
                                <tr>
                                    <th><i class="fas fa-calendar-alt me-2 text-muted"></i>Oluşturulma Tarihi</th>
                                    <td>
                                        <span class="text-muted">
                                            <i class="far fa-clock me-1"></i>
                                            @(
                                                                                        Model.GetType().GetProperty("CreatedDate") != null
                                                                                        ? (Model.GetType().GetProperty("CreatedDate")?.GetValue(Model) as DateTime?)?.ToString("dd.MM.yyyy HH:mm") ?? "Belirtilmemiş"
                                                                                        : "Belirtilmemiş"
                                                                                        )
                                        </span>
                                    </td>
                                </tr>

                                <!-- Güncellenme Tarihi -->
                                <tr>
                                    <th><i class="fas fa-sync-alt me-2 text-muted"></i>Güncellenme Tarihi</th>
                                    <td>
                                        <span class="text-muted">
                                            <i class="far fa-clock me-1"></i>
                                            @(
                                                                                        Model.GetType().GetProperty("UpdatedDate") != null
                                                                                        ? (Model.GetType().GetProperty("UpdatedDate")?.GetValue(Model) as DateTime?)?.ToString("dd.MM.yyyy HH:mm") ?? "Güncellenmemiş"
                                                                                        : "Güncellenmemiş"
                                                                                        )
                                        </span>
                                    </td>
                                </tr>

                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- İstatistik Kartları -->
            <div class="row mb-4">
                <div class="col-md-4 mb-3">
                    <div class="stat-card text-center p-3 rounded bg-success bg-opacity-10">
                        <i class="fas fa-box fa-2x text-success mb-2"></i>
                        <h4 class="text-success mb-1">0</h4>
                        <p class="text-muted mb-0">Toplam Ürün</p>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="stat-card text-center p-3 rounded bg-warning bg-opacity-10">
                        <i class="fas fa-money-bill-wave fa-2x text-warning mb-2"></i>
                        <h4 class="text-warning mb-1">0₺</h4>
                        <p class="text-muted mb-0">Toplam Tutar</p>
                    </div>
                </div>

                <div class="col-md-4 mb-3">
                    <div class="stat-card text-center p-3 rounded bg-primary bg-opacity-10">
                        <i class="fas fa-percentage fa-2x text-primary mb-2"></i>
                        <h4 class="text-primary mb-1">0</h4>
                        <p class="text-muted mb-0">İndirim</p>
                    </div>
                </div>
            </div>

            <!-- İşlem Butonları -->
            <div class="action-buttons mt-4 pt-4 border-top">
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Sepet Listesine Dön
                    </a>

                    <div class="btn-group">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-2"></i>Düzenle
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="fas fa-trash-alt me-2"></i>Sil
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer bg-light py-3">
            <div class="row">
                <div class="col-md-6">
                    <small class="text-muted">
                        <i class="fas fa-history me-1"></i>
                        Son görüntülenme: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>

                <div class="col-md-6 text-end">
                    <small class="text-muted">
                        <i class="fas fa-database me-1"></i>
                        Veri kaynağı: Eticaret.Core.Entities.Cart
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>
