@model Eticaret.Core.Entities.Category

@{
    ViewData["Title"] = "Kategori Sil";
}

<div class="container mt-4">
    <h2><i class="fas fa-trash me-2"></i>'@Model.Name' Kategorisini Sil</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow">
        <div class="card-body">
            <p>Bu kategori silindiğinde geri alınamaz.</p>

            @* Eğer kategori altında ürün varsa seçenekler sun *@
            @if ((int)(ViewBag.ProductCount ?? 0) > 0)
            {
                <div class="alert alert-warning">
                    Bu kategori altında <strong>@ViewBag.ProductCount</strong> adet ürün bulunuyor.
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label class="form-label">Silme İşlemi</label>
                        <select class="form-select" name="deleteOption" id="deleteOption" required>
                            <option value="" selected>Silme işlemini seçin</option>
                            <option value="all">Kategori ve tüm ürünleri sil</option>
                            <option value="move">Ürünleri başka bir kategoriye taşı ve bu kategoriyi sil</option>
                        </select>
                    </div>

                    <div class="mb-3" id="targetCategoryDiv" style="display:none;">
                        <label class="form-label">Hedef Kategori</label>
                        <select class="form-select" name="targetCategoryId">
                            <option value="">-- Seçin --</option>
                            @if (ViewBag.OtherCategories != null)
                            {
                                foreach (var cat in ViewBag.OtherCategories as List<Eticaret.Core.Entities.Category>)
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-danger">Sil</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </form>
            }
            else
            {
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">Sil</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </form>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteOption = document.getElementById('deleteOption');
        const targetDiv = document.getElementById('targetCategoryDiv');

        if (deleteOption) {
            deleteOption.addEventListener('change', function () {
                if (this.value === 'move') {
                    targetDiv.style.display = 'block';
                } else {
                    targetDiv.style.display = 'none';
                }
            });
        }
    </script>
}
