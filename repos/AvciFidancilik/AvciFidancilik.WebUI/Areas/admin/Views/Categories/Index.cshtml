@model IEnumerable<Eticaret.Core.Entities.Category>

@{
    ViewData["Title"] = "Kategori Yönetimi";
}

<div class="container-fluid px-4 py-4">
    <!-- Başlık ve Aksiyon Butonları -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-2">
                <i class="fas fa-layer-group text-primary me-2"></i>Kategori Yönetimi
            </h2>
            <p class="text-muted mb-0">Sistemdeki tüm kategorileri görüntüleyin ve yönetin</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus-circle me-2"></i>Yeni Kategori Ekle
        </a>
    </div>

    <!-- İstatistik Kartları -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-start border-primary border-4 shadow-sm h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs fw-bold text-primary text-uppercase mb-1">
                                Toplam Kategori
                            </div>
                            <div class="h5 mb-0 fw-bold text-gray-800">@Model.Count()</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-folder fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Kategori Tablosu -->
    <div class="card shadow border-0">
        <div class="card-header bg-white py-3 border-0">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-list-alt me-2"></i>Kategori Listesi
                </h5>
                <div class="d-flex gap-2">
                    <input type="text" id="searchInput" class="form-control form-control-sm"
                           placeholder="Kategori ara..." style="max-width: 200px;">
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="categoryTable">
                    <thead class="table-light">
                        <tr>
                            <th width="50">#</th>
                            <th>Kategori Adı</th>
                            <th width="150" class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int counter = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-muted">@counter</td>
                                    <td class="fw-bold">@item.Name</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-outline-info" title="Detaylar">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-outline-warning" title="Düzenle">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-outline-danger" title="Sil">
                                                <i class="fas fa-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                counter++;
                            }
                        }
                    </tbody>
                </table>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <div class="empty-state">
                            <i class="fas fa-folder-open fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Henüz kategori bulunmuyor</h5>
                            <p class="text-muted mb-4">İlk kategoriyi oluşturmak için aşağıdaki butonu kullanın</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="fas fa-plus-circle me-2"></i>Yeni Kategori Ekle
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function() {
            const filter = this.value.toLowerCase();
            const rows = document.querySelectorAll('#categoryTable tbody tr');
            rows.forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}

<style>
    .card {
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .table th, .table td {
        vertical-align: middle;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13,110,253,0.05);
    }

    .btn-group .btn {
        border-radius: 6px !important;
        margin: 0 2px;
        transition: all 0.2s;
    }
</style>
