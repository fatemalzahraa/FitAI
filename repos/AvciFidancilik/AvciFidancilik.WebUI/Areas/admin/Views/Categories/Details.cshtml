@model Eticaret.Core.Entities.Category

@{
    ViewData["Title"] = "Kategori Detayları";
}

<div class="container mt-5">
    <!-- Başlık ve Aksiyon Butonları -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3">
                <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center"
                     style="width: 60px; height: 60px;">
                    <i class="fas fa-folder fa-2x text-white"></i>
                </div>
            </div>
            <div>
                <h2 class="mb-0 text-primary">
                    <i class="fas fa-folder-open me-2"></i>@Model.Name
                </h2>
                <small class="text-muted">Kategori ID: @Model.Id</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning">
                <i class="fas fa-edit me-2"></i>Düzenle
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Geri Dön
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Sol Panel: Temel Bilgiler ve Ürünler -->
        <div class="col-lg-8">
            <!-- Kategori Bilgileri Kartı -->
            <div class="card shadow-sm border-0 mb-4 rounded-3">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-4 border-bottom pb-2">
                        <i class="fas fa-info-circle me-2"></i>Kategori Bilgileri
                    </h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">
                                <i class="fas fa-hashtag me-1"></i>Kategori ID
                            </label>
                            <div>
                                <span class="badge bg-light text-dark border fs-6">@Model.Id</span>
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">
                                <i class="fas fa-tag me-1"></i>Kategori Adı
                            </label>
                            <div class="fs-5 fw-bold text-primary">@Model.Name</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">
                                <i class="fas fa-boxes me-1"></i>Toplam Ürün Sayısı
                            </label>
                            <div class="fs-5 fw-bold text-success">
                                @(Model.Products?.Count ?? 0)
                            </div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted small">
                                <i class="fas fa-layer-group me-1"></i>Kategori Durumu
                            </label>
                            <div>
                                @if (Model.Products?.Any() == true)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle me-1"></i>Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="fas fa-minus-circle me-1"></i>Boş
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Ürünler Listesi -->
            @if (Model.Products != null && Model.Products.Any())
            {
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-body">
                        <h5 class="card-title text-primary mb-3 border-bottom pb-2">
                            <i class="fas fa-boxes me-2"></i>Bu Kategorideki Ürünler (@Model.Products.Count)
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>#</th>
                                        <th>Ürün Adı</th>
                                        <th>Fiyat</th>
                                        <th>Açıklama</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int productCounter = 1;
                                        foreach (var product in Model.Products)
                                        {
                                            <tr>
                                                <td class="text-muted">@productCounter</td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <div class="me-3">
                                                            <div class="rounded bg-light d-flex align-items-center justify-content-center"
                                                                 style="width: 40px; height: 40px;">
                                                                <i class="fas fa-box text-muted"></i>
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <div class="fw-bold">@product.Name</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="fw-bold text-success">
                                                    @(product.Price.ToString("C") ?? "Belirtilmemiş")
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrEmpty(product.Description) && product.Description.Length > 50)
                                                    {
                                                        <span class="text-muted small">@product.Description.Substring(0, 50)...</span>
                                                    }
                                                    else if (!string.IsNullOrEmpty(product.Description))
                                                    {
                                                        <span class="text-muted small">@product.Description</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Açıklama yok</span>
                                                    }
                                                </td>
                                            </tr>
                                            productCounter++;
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Henüz ürün bulunmuyor</h5>
                        <p class="text-muted">Bu kategoriye henüz hiç ürün eklenmemiş.</p>
                    </div>
                </div>
            }
        </div>

        <!-- Sağ Panel: Önizleme -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-body text-center">
                    <h5 class="card-title text-primary mb-3">
                        <i class="fas fa-eye me-2"></i>Kategori Önizlemesi
                    </h5>

                    <div class="preview-container border rounded-3 p-4 mb-3 bg-light">
                        <div class="preview-icon mb-3">
                            <div class="rounded-circle bg-primary p-3 d-inline-block">
                                <i class="fas fa-folder fa-3x text-white"></i>
                            </div>
                        </div>
                        <h3 class="preview-title mb-2 text-primary">@Model.Name</h3>

                        <div class="preview-stats bg-white rounded-3 p-3 mt-3 border">
                            <div class="row">
                                <div class="col-12">
                                    <div class="fw-bold text-dark fs-4">@(Model.Products?.Count ?? 0)</div>
                                    <div class="text-muted small">Toplam Ürün</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <small class="text-muted">
                        <i class="fas fa-info-circle me-1"></i>
                        Bu kategori müşteriler tarafından bu şekilde görüntülenecektir.
                    </small>
                </div>
            </div>

            <!-- Hızlı İstatistikler -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">
                        <i class="fas fa-chart-pie me-2"></i>Hızlı İstatistikler
                    </h5>

                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                            <span class="text-muted">
                                <i class="fas fa-box me-2"></i>Toplam Ürün
                            </span>
                            <span class="badge bg-primary rounded-pill">@(Model.Products?.Count ?? 0)</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                            <span class="text-muted">
                                <i class="fas fa-clock me-2"></i>Son Güncelleme
                            </span>
                            <span class="small text-muted">@DateTime.Now.ToString("dd.MM.yyyy")</span>
                        </div>

                        <div class="list-group-item d-flex justify-content-between align-items-center border-0 px-0 py-2">
                            <span class="text-muted">
                                <i class="fas fa-hashtag me-2"></i>Kategori ID
                            </span>
                            <span class="badge bg-dark rounded-pill">@Model.Id</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 12px;
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .form-label {
        font-size: 0.85rem;
        font-weight: 500;
    }

    .table th {
        font-weight: 600;
        color: #495057;
        border-top: none;
    }

    .badge {
        font-weight: 500;
        padding: 0.35em 0.65em;
    }

    .preview-container {
        border: 2px dashed #dee2e6;
    }

    .rounded-3 {
        border-radius: 1rem !important;
    }

    .table-hover tbody tr:hover {
        background-color: rgba(13, 110, 253, 0.05);
    }

    .border-bottom {
        border-bottom: 2px solid rgba(0,0,0,0.1) !important;
    }

    .list-group-item {
        background: transparent;
    }
</style>