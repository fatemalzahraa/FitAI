@model Eticaret.Core.Entities.Role

@{
    ViewData["Title"] = "Rol Oluştur";
}

<div class="container-fluid">
    <!-- SAYFA BAŞLIĞI -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/admin">Yönetim</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Roller</a></li>
                        <li class="breadcrumb-item active">Oluştur</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- FORM KARTI -->
    <div class="row">
        <div class="col-lg-6 mx-auto">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-shield me-2"></i>Yeni Rol Ekle
                    </h5>
                </div>

                <div class="card-body">
                    <form asp-action="Create" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- ROL ADI -->
                        <div class="form-group mb-4">
                            <label asp-for="Name" class="form-label fw-semibold">
                                <i class="fas fa-tag me-2"></i>Rol Adı
                            </label>
                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="Örn: Admin, Editör, Kullanıcı"
                                   required />
                            <span asp-validation-for="Name" class="invalid-feedback d-block"></span>
                            <small class="form-text text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Rol adı en fazla 50 karakter olabilir.
                            </small>
                        </div>

                        <!-- BUTONLAR -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>

                            <div>
                                <button type="submit" class="btn btn-success btn-lg px-5">
                                    <i class="fas fa-save me-2"></i>Kaydet
                                </button>
                                <button type="reset" class="btn btn-warning btn-lg px-4 ms-2">
                                    <i class="fas fa-redo me-2"></i>Temizle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Kart */
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 0.75rem 1.5rem rgba(18, 38, 63, 0.08);
        }

        .card-header {
            border-radius: 15px 15px 0 0;
            padding: 1.25rem 1.5rem;
        }

        /* Form input */
        .form-control-lg {
            border-radius: 10px;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
        }

            .form-control-lg:focus {
                border-color: #5c9ded;
                box-shadow: 0 0 0 0.2rem rgba(92, 157, 237, 0.25);
                transform: translateY(-2px);
            }

        /* Label */
        .form-label {
            font-weight: 600;
            color: #495057;
        }

        /* Butonlar */
        .btn-lg {
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-success {
            background: linear-gradient(135deg, #00b09b, #96c93d);
            border: none;
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 176, 155, 0.3);
            }

        .btn-warning {
            background: linear-gradient(135deg, #ffb347, #ffcc33);
            border: none;
            color: #fff;
        }

            .btn-warning:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 179, 71, 0.3);
            }

        .btn-outline-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.2);
        }

        /* Breadcrumb */
        .breadcrumb {
            background: transparent;
            padding: 0;
            margin-bottom: 0;
        }

        .breadcrumb-item a {
            text-decoration: none;
            color: #6c757d;
        }

        .breadcrumb-item.active {
            font-weight: 500;
            color: #5c9ded;
        }

        .page-title-box {
            padding: 24px 0;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .btn-lg {
                width: 100%;
                margin-bottom: 10px;
            }

            .d-flex.justify-content-between {
                flex-direction: column;
            }
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Bootstrap validation
        (function () {
            'use strict';
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault();
                            event.stopPropagation();
                        }
                        form.classList.add('was-validated');
                    }, false);
                });
        })();
    </script>
}
