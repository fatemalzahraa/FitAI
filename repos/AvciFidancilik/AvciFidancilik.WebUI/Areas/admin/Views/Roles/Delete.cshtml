@model Eticaret.Core.Entities.Role

@{
    ViewData["Title"] = "Rol Sil";
}

<style>
    .delete-card {
        max-width: 600px;
        margin: 50px auto;
        padding: 30px;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .delete-title {
        font-weight: 600;
        color: #dc3545;
        margin-bottom: 20px;
        text-align: center;
    }

    .delete-warning {
        font-size: 16px;
        text-align: center;
        margin-bottom: 25px;
        color: #555;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 25px;
    }

    .info-label {
        font-weight: 600;
        color: #333;
    }

    .action-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
</style>

<div class="delete-card">
    <h2 class="delete-title">Rol Silme Onayı</h2>

    <p class="delete-warning">
        Bu rolü silmek istediğinizden emin misiniz?
        <br />
        <small class="text-muted">Bu işlem geri alınamaz.</small>
    </p>

    <div class="info-box">
        <div class="row">
            <div class="col-4 info-label">
                Rol Adı:
            </div>
            <div class="col-8">
                @Html.DisplayFor(model => model.Name)
            </div>
        </div>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <div class="action-buttons">
            <a asp-action="Index" class="btn btn-secondary">
                ← Listeye Dön
            </a>

            <button type="submit" class="btn btn-danger">
                Rolü Sil
            </button>
        </div>
    </form>
</div>
s