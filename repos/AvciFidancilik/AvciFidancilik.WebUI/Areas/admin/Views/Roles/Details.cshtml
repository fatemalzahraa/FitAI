@model Eticaret.Core.Entities.Role

@{
    ViewData["Title"] = "Rol Detayları";
}

<style>
    .details-card {
        max-width: 600px;
        margin: 50px auto;
        padding: 30px;
        border-radius: 12px;
        background: #ffffff;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
    }

    .details-title {
        font-weight: 600;
        color: #4361ee;
        margin-bottom: 25px;
        text-align: center;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px 20px;
        margin-bottom: 25px;
    }

    .info-label {
        font-weight: 600;
        color: #333;
    }

    .action-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
</style>

<div class="details-card">
    <h2 class="details-title">Rol Detay Bilgileri</h2>

    <div class="info-box">
        <div class="row">
            <div class="col-4 info-label">
                Rol Adı:
            </div>
            <div class="col-8">
                @Html.DisplayFor(model => model.Name)
            </div>
        </div>
    </div>

    <div class="action-buttons">
        <a asp-action="Index" class="btn btn-secondary">
            ← Listeye Dön
        </a>

        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
            Düzenle
        </a>
    </div>
</div>
