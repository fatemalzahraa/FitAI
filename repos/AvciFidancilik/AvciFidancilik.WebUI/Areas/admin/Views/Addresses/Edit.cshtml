@model Eticaret.Core.Entities.Address

@{
    ViewData["Title"] = "Adres Düzenle";
}

<div class="container mt-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="bg-light p-3 rounded mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/admin">Yönetim Paneli</a></li>
            <li class="breadcrumb-item"><a asp-area="admin" asp-controller="Addresses" asp-action="Index">Adresler</a></li>
            <li class="breadcrumb-item active" aria-current="page">Adres Düzenle</li>
        </ol>
    </nav>

    <!-- Başlık -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div class="rounded-circle bg-warning p-3 me-3">
                        <i class="fas fa-edit fa-2x text-white"></i>
                    </div>
                    <div>
                        <h1 class="h3 text-warning mb-1">Adres Düzenle</h1>
                        <p class="text-muted mb-0">"@Model.Title" adresini güncelliyorsunuz</p>
                    </div>
                </div>
                <div>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info me-2">
                        <i class="fas fa-eye me-2"></i>Detayları Gör
                    </a>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card border-warning shadow-lg">
                <div class="card-header bg-warning text-dark py-3">
                    <h4 class="mb-0"><i class="fas fa-pencil-alt me-2"></i>Adres Bilgilerini Düzenle</h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" />

                        <!-- Validasyon Hataları -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Adres Başlığı -->
                        <div class="form-group mb-4">
                            <label asp-for="Title" class="form-label fw-bold">Adres Başlığı *</label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Detaylı Adres -->
                        <div class="form-group mb-4">
                            <label asp-for="Line" class="form-label fw-bold">Detaylı Adres *</label>
                            <textarea asp-for="Line" class="form-control" rows="3" required></textarea>
                            <span asp-validation-for="Line" class="text-danger small"></span>
                        </div>

                        <!-- Şehir & İlçe -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-bold">Şehir *</label>
                                <input asp-for="City" class="form-control" required />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="District" class="form-label fw-bold">İlçe *</label>
                                <input asp-for="District" class="form-control" required />
                                <span asp-validation-for="District" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Posta Kodu & TC No -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="PostalCode" class="form-label fw-bold">Posta Kodu</label>
                                <input asp-for="PostalCode" class="form-control" maxlength="5" />
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="IdentityNumber" class="form-label fw-bold">TC Kimlik No</label>
                                <input asp-for="IdentityNumber" class="form-control" maxlength="11" />
                                <span asp-validation-for="IdentityNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Kullanıcı Seçimi -->
                        <div class="form-group mb-4">
                            <label asp-for="UserId" class="form-label fw-bold">Kullanıcı *</label>
                            <select asp-for="UserId" asp-items="ViewBag.UserId" class="form-select" required>
                                <option value="">-- Seçiniz --</option>
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <!-- Durum -->
                        <div class="form-group mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" type="checkbox" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label fw-bold">Aktif mi?</label>
                            </div>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-warning px-4">
                                Kaydet
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
