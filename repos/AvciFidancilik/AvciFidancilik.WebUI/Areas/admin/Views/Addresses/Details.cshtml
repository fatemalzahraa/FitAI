@model Eticaret.Core.Entities.Address
@{
    ViewData["Title"] = "Adres Detayları";
    Layout = "/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Adres Detayları</h5>
            <a asp-action="Index" class="btn btn-light btn-sm">
                <i class="fas fa-arrow-left me-1"></i> Geri Dön
            </a>
        </div>

        <div class="card-body">

            <dl class="row">
                <dt class="col-sm-3">Başlık</dt>
                <dd class="col-sm-9">@Model.Title</dd>

                <dt class="col-sm-3">Adres Satırı</dt>
                <dd class="col-sm-9">@Model.Line</dd>

                <dt class="col-sm-3">İlçe</dt>
                <dd class="col-sm-9">@Model.District</dd>

                <dt class="col-sm-3">Şehir</dt>
                <dd class="col-sm-9">@Model.City</dd>

                <dt class="col-sm-3">Posta Kodu</dt>
                <dd class="col-sm-9">@Model.PostalCode</dd>

                <dt class="col-sm-3">TC/Vergi No</dt>
                <dd class="col-sm-9">@Model.IdentityNumber</dd>

                <dt class="col-sm-3">Kullanıcı</dt>
                <dd class="col-sm-9">@Model.User?.Email</dd>
            </dl>

        </div>

        <div class="card-footer bg-light py-3">
            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-list me-2"></i>Tüm Adresler
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm ms-2">
                        <i class="fas fa-edit me-2"></i>Düzenle
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger btn-sm ms-2">
                        <i class="fas fa-trash me-2"></i>Sil
                    </a>
                </div>

                <div>
                    <a href="#" class="btn btn-outline-primary btn-sm me-2" id="printBtn">
                        <i class="fas fa-print me-2"></i>Yazdır
                    </a>
                    <a href="#" class="btn btn-outline-success btn-sm" id="shareBtn">
                        <i class="fas fa-share-alt me-2"></i>Paylaş
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("printBtn").addEventListener("click", function () {
            window.print();
        });

        document.getElementById("shareBtn").addEventListener("click", function () {
            navigator.share({
                title: "Adres Detayları",
                url: window.location.href
            });
        });
    </script>
}
