@model Eticaret.Core.Entities.Address

@{
    ViewData["Title"] = "Yeni Adres Ekle";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <!-- Breadcrumb Navigasyon -->
            <nav aria-label="breadcrumb" class="bg-light p-3 rounded mb-4">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/admin">Yönetim Paneli</a></li>
                    <li class="breadcrumb-item"><a asp-area="admin" asp-controller="Addresses" asp-action="Index">Adresler</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Yeni Adres</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="h3 text-primary mb-1"><i class="fas fa-map-marker-alt me-2"></i>Yeni Adres Ekle</h1>
                    <p class="text-muted mb-0">Sisteme yeni bir adres kaydı ekleyin</p>
                </div>
                <div>
                    <a asp-area="admin" asp-controller="Addresses" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-gradient-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="fas fa-plus-circle fa-2x"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h4 class="mb-0">Adres Bilgileri</h4>
                            <p class="mb-0 opacity-75">Tüm zorunlu alanları (*) eksiksiz doldurun</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Form Başlangıç -->
                    <form asp-area="admin" asp-controller="Addresses" asp-action="Create" method="post" id="addressForm" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger alert-dismissible fade show">
                            <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i>Lütfen aşağıdaki hataları düzeltin:</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>

                        <!-- Adres Başlığı -->
                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">
                                <i class="fas fa-heading me-2 text-primary"></i>Adres Başlığı <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                <input asp-for="Title" class="form-control form-control-lg"
                                       placeholder="Örn: Ev Adresi, İş Adresi, Fatura Adresi"
                                       required />
                            </div>
                            <span asp-validation-for="Title" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1 text-info"></i> Bu adresi tanımlayacak kısa bir başlık girin.
                            </div>
                        </div>

                        <!-- Detaylı Adres -->
                        <div class="mb-4">
                            <label asp-for="Line" class="form-label fw-bold">
                                <i class="fas fa-map me-2 text-primary"></i>Detaylı Adres <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-location-dot"></i></span>
                                <textarea asp-for="Line" class="form-control" rows="3"
                                          placeholder="Mahalle, sokak, cadde, apartman, daire, kat ve diğer adres detaylarını yazın"
                                          required></textarea>
                            </div>
                            <span asp-validation-for="Line" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1 text-info"></i> Lütfen tam ve açıklayıcı bir adres bilgisi girin.
                            </div>
                        </div>

                        <!-- Şehir ve İlçe - Yan yana -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label fw-bold">
                                    <i class="fas fa-city me-2 text-primary"></i>Şehir <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-building"></i></span>
                                    <input asp-for="City" class="form-control"
                                           placeholder="Örn: İstanbul, Ankara, İzmir"
                                           required />
                                </div>
                                <span asp-validation-for="City" class="text-danger small mt-1 d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="District" class="form-label fw-bold">
                                    <i class="fas fa-map-pin me-2 text-primary"></i>İlçe <span class="text-danger">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-location-crosshairs"></i></span>
                                    <input asp-for="District" class="form-control"
                                           placeholder="Örn: Kadıköy, Çankaya, Konak"
                                           required />
                                </div>
                                <span asp-validation-for="District" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Posta Kodu ve TC Kimlik No - Yan yana -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="PostalCode" class="form-label fw-bold">
                                    <i class="fas fa-envelope me-2 text-primary"></i>Posta Kodu
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-mail-bulk"></i></span>
                                    <input asp-for="PostalCode" class="form-control postal-code-input"
                                           placeholder="34000"
                                           maxlength="5" />
                                </div>
                                <span asp-validation-for="PostalCode" class="text-danger small mt-1 d-block"></span>
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1 text-info"></i> 5 haneli posta kodu (zorunlu değil)
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="IdentityNumber" class="form-label fw-bold">
                                    <i class="fas fa-id-card me-2 text-primary"></i>TC Kimlik No
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="fas fa-user-shield"></i></span>
                                    <input asp-for="IdentityNumber" class="form-control tc-input"
                                           placeholder="11111111111"
                                           maxlength="11" />
                                </div>
                                <span asp-validation-for="IdentityNumber" class="text-danger small mt-1 d-block"></span>
                                <div class="form-text">
                                    <i class="fas fa-info-circle me-1 text-info"></i> 11 haneli TC Kimlik No (zorunlu değil)
                                </div>
                            </div>
                        </div>

                        <!-- Kullanıcı Seçimi -->
                        <div class="mb-4">
                            <label asp-for="UserId" class="form-label fw-bold">
                                <i class="fas fa-user me-2 text-primary"></i>Kullanıcı <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-users"></i></span>
                                <select asp-for="UserId" class="form-select select2-enhanced"
                                        asp-items="ViewBag.UserId" required>
                                    <option value="">-- Lütfen bir kullanıcı seçin --</option>
                                </select>
                            </div>
                            <span asp-validation-for="UserId" class="text-danger small mt-1 d-block"></span>
                            <div class="form-text">
                                <i class="fas fa-info-circle me-1 text-info"></i> Bu adresin hangi kullanıcıya ait olacağını seçin.
                            </div>
                        </div>

                        <!-- Durum -->
                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch" checked>
                                <label class="form-check-label fw-bold" for="isActiveSwitch">
                                    <i class="fas fa-toggle-on me-2 text-success"></i>Adresi Aktif Et
                                </label>
                            </div>
                            <div class="form-text ms-4">
                                <i class="fas fa-info-circle me-1 text-info"></i> Aktif edilen adresler kullanılabilir durumda olur.
                            </div>
                        </div>

                        <!-- Form Butonları -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-5 pt-4 border-top">
                            <button type="reset" class="btn btn-outline-secondary me-md-2">
                                <i class="fas fa-eraser me-2"></i>Temizle
                            </button>
                            <button type="submit" class="btn btn-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Adresi Kaydet
                            </button>
                        </div>
                    </form>
                    <!-- Form Bitiş -->
                </div>

                <div class="card-footer bg-light py-3">
                    <div class="alert alert-info mb-0">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="fas fa-lightbulb fa-2x text-warning"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="alert-heading mb-2"><i class="fas fa-tips me-2"></i>İpuçları</h5>
                                <ul class="mb-0">
                                    <li><span class="text-danger">*</span> ile işaretli alanlar zorunludur</li>
                                    <li>TC Kimlik No ve Posta Kodu alanları isteğe bağlıdır</li>
                                    <li>Adres bilgilerini mümkün olduğunca detaylı girin</li>
                                    <li>Kaydetmeden önce bilgileri kontrol edin</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 15px;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
            }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .form-control, .form-select {
            border-radius: 10px;
            padding: 12px 15px;
            border: 2px solid #e9ecef;
            transition: all 0.3s;
        }

            .form-control:focus, .form-select:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 0.25rem rgba(102, 126, 234, 0.25);
            }

        .input-group-text {
            border-radius: 10px 0 0 10px;
            background-color: #f8f9fa;
            border: 2px solid #e9ecef;
            border-right: none;
        }

        .form-label {
            color: #495057;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .form-text {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 5px;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
            }

        .form-check-input:checked {
            background-color: #28a745;
            border-color: #28a745;
        }

        .breadcrumb {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 15px 20px;
        }

        .breadcrumb-item a {
            color: #667eea;
            text-decoration: none;
            font-weight: 500;
        }

        .breadcrumb-item.active {
            color: #6c757d;
            font-weight: 600;
        }

        .alert {
            border-radius: 10px;
            border: none;
        }

        .tc-input, .postal-code-input {
            font-family: 'Courier New', monospace;
            font-weight: bold;
            letter-spacing: 1px;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            console.log('Adres Ekleme Sayfası Yüklendi');

            // TC Kimlik No formatlama
            $('.tc-input').on('input', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length > 11) {
                    value = value.substring(0, 11);
                }
                $(this).val(value);
            });

            // Posta Kodu formatlama
            $('.postal-code-input').on('input', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length > 5) {
                    value = value.substring(0, 5);
                }
                $(this).val(value);
            });

            // Select2 için (eğer kullanıyorsanız)
            if ($.fn.select2) {
                $('.select2-enhanced').select2({
                    placeholder: "Kullanıcı seçin",
                    allowClear: true,
                    width: '100%',
                    theme: 'bootstrap-5'
                });
            }

            // Form submit animasyonu
            $('#addressForm').submit(function(e) {
                const submitBtn = $(this).find('button[type="submit"]');
                const originalText = submitBtn.html();

                // Butonu devre dışı bırak ve animasyon ekle
                submitBtn.prop('disabled', true)
                         .html('<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...');

                // Zorunlu alan kontrolü
                const userId = $('#UserId').val();
                if (!userId) {
                    alert('Lütfen bir kullanıcı seçin!');
                    submitBtn.prop('disabled', false).html(originalText);
                    e.preventDefault();
                    return false;
                }

                // TC Kimlik No uzunluk kontrolü
                const tcNo = $('.tc-input').val();
                if (tcNo && tcNo.length !== 11) {
                    alert('TC Kimlik No 11 haneli olmalıdır!');
                    submitBtn.prop('disabled', false).html(originalText);
                    e.preventDefault();
                    return false;
                }

                // Posta Kodu uzunluk kontrolü
                const postalCode = $('.postal-code-input').val();
                if (postalCode && postalCode.length !== 5) {
                    alert('Posta Kodu 5 haneli olmalıdır!');
                    submitBtn.prop('disabled', false).html(originalText);
                    e.preventDefault();
                    return false;
                }

                return true;
            });

            // Input'lara focus olduğunda efekt
            $('.form-control, .form-select').focus(function() {
                $(this).parent().addClass('input-focused');
            }).blur(function() {
                $(this).parent().removeClass('input-focused');
            });

            // Reset butonu işlevi
            $('button[type="reset"]').click(function() {
                if (confirm('Tüm form alanlarını temizlemek istediğinize emin misiniz?')) {
                    $('.select2-enhanced').val(null).trigger('change');
                    return true;
                }
                return false;
            });
        });
    </script>
}