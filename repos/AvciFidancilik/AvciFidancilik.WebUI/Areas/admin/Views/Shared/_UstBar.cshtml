<nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
    <!-- Navbar Brand-->
    <a class="navbar-brand ps-3" href="/Admin/Dashboard">ADMİN YÖNETİM PANELİ</a>

    <!-- Sidebar Toggle-->
    <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#!">
        <i class="fas fa-bars"></i>
    </button>

    <!-- Navbar Search -->
    <form class="d-none d-md-inline-block form-inline ms-auto me-0 me-md-3 my-2 my-md-0">
        <div class="input-group">
            <input class="form-control" type="text" placeholder="Ara..." aria-label="Ara..." aria-describedby="btnNavbarSearch" />
            <button class="btn btn-primary" id="btnNavbarSearch" type="button">
                <i class="fas fa-search"></i>
            </button>
        </div>
    </form>

    <!-- Navbar-->
    <ul class="navbar-nav ms-auto ms-md-0 me-3 me-lg-4">
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" id="navbarDropdown" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-user fa-fw"></i> @User.Identity?.Name
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                <li>
                    <!-- DÜZELTİLDİ: /Admin/Settings/Index -->
                    <a class="dropdown-item" href="/Admin/Settings">
                        <i class="fas fa-cog me-2"></i>Ayarlar
                    </a>
                </li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <a class="dropdown-item text-danger" href="#"
                       data-bs-toggle="modal" data-bs-target="#logoutModal">
                        <i class="fas fa-sign-out-alt me-2"></i>Çıkış Yap
                    </a>
                </li>
            </ul>
        </li>
    </ul>
</nav>

<!-- Çıkış Onay Modal'ı -->
<div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="logoutModalLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Çıkış Onayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div class="mb-3">
                    <i class="fas fa-sign-out-alt fa-4x text-warning mb-3"></i>
                    <h5 class="fw-bold">Admin panelinden çıkış yapmak istiyor musunuz?</h5>
                    <p class="text-muted mt-3">
                        Çıkış yaparsanız, tekrar giriş yapana kadar yönetim paneline erişemeyeceksiniz.
                    </p>
                </div>
            </div>
            <div class="modal-footer justify-content-center border-top-0">
                <!-- DÜZELTİLDİ: Action URL'si -->
                <form id="logoutForm" method="post" action="/Account/AdminLogout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="fas fa-sign-out-alt me-2"></i>Evet, Çıkış Yap
                    </button>
                </form>
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Hayır, İptal
                </button>
            </div>
        </div>
    </div>
</div>