@model Eticaret.Data.Entities.ChatLog

@{
    ViewData["Title"] = "Sohbet Kaydı Sil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0 delete-card">
                <div class="card-header bg-gradient-danger text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                        <div>
                            <h1 class="h3 mb-0">Sohbet Kaydı Sil</h1>
                            <p class="mb-0 opacity-75">Bu işlem geri alınamaz!</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning alert-dismissible fade show d-flex align-items-center" role="alert">
                        <i class="fas fa-exclamation-circle fa-2x me-3"></i>
                        <div>
                            <h5 class="alert-heading mb-1">Uyarı!</h5>
                            <p class="mb-0">Bu sohbet kaydını silmek üzeresiniz. Bu işlem geri alınamaz.</p>
                        </div>
                    </div>

                    <!-- Silinecek Chat Önizleme -->
                    <div class="delete-preview mb-4">
                        <div class="preview-header text-center mb-3">
                            <div class="preview-icon mb-2">
                                <i class="fas fa-comment-slash fa-3x text-danger"></i>
                            </div>
                            <h4 class="text-danger">Silinecek Sohbet Kaydı</h4>
                            <small class="text-muted">ID: @Model.Id • @Model.Tarih.ToString("dd.MM.yyyy HH:mm")</small>
                        </div>

                        <div class="chat-delete-preview">
                            <div class="message delete-user-msg mb-2 p-3 rounded">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fas fa-user-circle text-primary me-2"></i>
                                    <small class="fw-bold">Kullanıcı</small>
                                </div>
                                <div class="message-content">
                                    @{
                                        var shortUserMsg = Model.KullaniciMesaj?.Length > 100
                                        ? Model.KullaniciMesaj.Substring(0, 100) + "..."
                                        : Model.KullaniciMesaj;
                                    }
                                    @shortUserMsg
                                </div>
                            </div>

                            <div class="message delete-bot-msg mb-2 p-3 rounded">
                                <div class="d-flex align-items-center mb-1">
                                    <i class="fas fa-robot text-success me-2"></i>
                                    <small class="fw-bold">ChatBot</small>
                                </div>
                                <div class="message-content">
                                    @{
                                        var shortBotMsg = Model.BotCevap?.Length > 100
                                        ? Model.BotCevap.Substring(0, 100) + "..."
                                        : Model.BotCevap;
                                    }
                                    @shortBotMsg
                                </div>
                            </div>
                        </div>

                        <!-- İstatistikler -->
                        <div class="delete-stats mt-3 p-3 bg-light rounded">
                            <div class="row text-center">
                                <div class="col-4">
                                    <div class="stat-item">
                                        <div class="stat-number text-primary">@Model.KullaniciMesaj?.Length</div>
                                        <small class="text-muted">Kullanıcı Kar.</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-item">
                                        <div class="stat-number text-success">@Model.BotCevap?.Length</div>
                                        <small class="text-muted">Bot Kar.</small>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="stat-item">
                                        <div class="stat-number text-warning">
                                            @Model.Tarih.ToString("dd.MM.yyyy")
                                        </div>
                                        <small class="text-muted">Tarih</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Silme Formu -->
                    <form asp-action="Delete" id="deleteForm">
                        <input type="hidden" asp-for="Id" />

                        <!-- Ek Onay -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="confirmDelete1">
                            <label class="form-check-label" for="confirmDelete1">
                                Bu sohbet kaydını kalıcı olarak silmek istediğimi onaylıyorum
                            </label>
                        </div>

                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" id="confirmDelete2">
                            <label class="form-check-label" for="confirmDelete2">
                                Bu işlemin geri alınamayacağını anlıyorum
                            </label>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-success btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Vazgeç
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg px-5" id="deleteBtn" disabled>
                                <i class="fas fa-trash-alt me-2"></i>Kalıcı Olarak Sil
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .delete-card {
            border: 2px solid #dc3545;
            border-radius: 15px;
            animation: borderPulse 2s infinite;
        }

        .chat-delete-preview {
            border: 2px dashed #dc3545;
            border-radius: 10px;
            padding: 15px;
            background: #fff5f5;
        }

        .delete-user-msg {
            background: #ffeaea;
            border-left: 4px solid #dc3545;
        }

        .delete-bot-msg {
            background: #fff0f0;
            border-left: 4px solid #f56565;
        }

        .message-content {
            word-wrap: break-word;
        }

        .delete-stats {
            border: 1px solid #ffc1c1;
        }

        .stat-item {
            padding: 5px;
        }

        .stat-number {
            font-size: 1.2rem;
            font-weight: bold;
        }

        .preview-icon {
            animation: shake 0.5s ease-in-out infinite alternate;
        }

        .form-check-input:checked {
            background-color: #dc3545;
            border-color: #dc3545;
        }

        #deleteBtn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        @@keyframes borderPulse {
            0% {
                border-color: #dc3545;
            }

            50% {
                border-color: #ffc107;
            }

            100% {
                border-color: #dc3545;
            }
        }

        @@keyframes shake {
            from {
                transform: translateX(-3px);
            }

            to {
                transform: translateX(3px);
            }
        }

        @@keyframes fadeOut {
            from {
                opacity: 1;
            }

            to {
                opacity: 0.5;
            }
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Onay checkbox'larını kontrol et
            function checkConfirmations() {
                const isConfirmed = $('#confirmDelete1').is(':checked') && $('#confirmDelete2').is(':checked');
                $('#deleteBtn').prop('disabled', !isConfirmed);

                if (isConfirmed) {
                    $('#deleteBtn').removeClass('disabled');
                    $('.delete-card').css('animation', 'none');
                } else {
                    $('.delete-card').css('animation', 'borderPulse 2s infinite');
                }
            }

            $('#confirmDelete1, #confirmDelete2').change(checkConfirmations);

            // Silme butonu animasyonu
            $('#deleteBtn').click(function(e) {
                if ($(this).prop('disabled')) {
                    e.preventDefault();
                    showWarningToast('Lütfen tüm onay kutularını işaretleyin!');
                    return;
                }

                // Son onay modalı
                e.preventDefault();
                showFinalConfirmation();
            });

            // Uyarı toast'ı
            function showWarningToast(message) {
                const toast = `
                    <div class="toast show position-fixed" style="top:20px;right:20px;z-index:9999">
                        <div class="toast-header bg-warning text-dark">
                            <strong class="me-auto">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Uyarı
                            </strong>
                            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">
                            ${message}
                        </div>
                    </div>
                `;

                $('body').append(toast);
                setTimeout(() => $('.toast').remove(), 3000);
            }

            // Son onay modalı
            function showFinalConfirmation() {
                const modalHtml = `
                    <div class="modal fade" id="finalConfirmModal" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title">
                                        <i class="fas fa-skull-crossbones me-2"></i>
                                        SON UYARI
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body text-center">
                                    <div class="mb-4">
                                        <i class="fas fa-fire fa-4x text-danger mb-3"></i>
                                        <h4 class="text-danger fw-bold">KALICI SİLME</h4>
                                    </div>
                                    <p class="lead">
                                        "<strong>@Model.Tarih.ToString("dd.MM.yyyy HH:mm")</strong>" tarihli
                                        sohbet kaydını <span class="text-danger fw-bold">kalıcı olarak</span> silmek üzeresiniz!
                                    </p>
                                    <div class="alert alert-danger mt-3">
                                        <i class="fas fa-ban me-2"></i>
                                        <strong>Bu işlem geri alınamaz!</strong> Tüm veri kaybolacaktır.
                                    </div>
                                    <div class="input-group mt-4">
                                        <input type="text" class="form-control"
                                               placeholder='"SİL" yazarak onaylayın'
                                               id="confirmText">
                                        <button class="btn btn-outline-danger" type="button"
                                                onclick="checkFinalConfirmation()">
                                            Doğrula
                                        </button>
                                    </div>
                                    <small class="text-muted d-block mt-2">
                                        Onaylamak için yukarıya "SİL" yazmanız gerekmektedir.
                                    </small>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <i class="fas fa-times me-2"></i>İptal Et
                                    </button>
                                    <button type="button" class="btn btn-danger" id="finalDeleteBtn" disabled>
                                        <i class="fas fa-bomb me-2"></i>SİL
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                $('body').append(modalHtml);
                const modal = new bootstrap.Modal(document.getElementById('finalConfirmModal'));
                modal.show();

                // Modal kapanınca temizle
                $('#finalConfirmModal').on('hidden.bs.modal', function () {
                    $(this).remove();
                });
            }

            // Global fonksiyon
            window.checkFinalConfirmation = function() {
                const input = $('#confirmText').val();
                const finalBtn = $('#finalDeleteBtn');

                if (input.toUpperCase() === 'SİL') {
                    finalBtn.prop('disabled', false);
                    finalBtn.click(function() {
                        // Silme animasyonu
                        $('#deleteBtn').html('<i class="fas fa-spinner fa-spin me-2"></i>Siliniyor...');
                        $('#deleteBtn').prop('disabled', true);

                        // Formu submit et
                        setTimeout(() => {
                            $('#deleteForm').submit();
                        }, 1000);
                    });
                } else {
                    finalBtn.prop('disabled', true);
                    $('#confirmText').addClass('is-invalid');
                    setTimeout(() => $('#confirmText').removeClass('is-invalid'), 1000);
                }
            };

            // Sayfa yüklendiğinde animasyon başlat
            $('.preview-icon').css('animation', 'shake 0.5s ease-in-out infinite alternate');
        });
    </script>
}