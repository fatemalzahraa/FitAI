@model IEnumerable<Eticaret.Data.Entities.ChatLog>

@{
    ViewData["Title"] = "Chat Log Kayıtları";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 text-info"><i class="fas fa-comments me-2"></i>Chat Log Kayıtları</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="fas fa-plus-circle me-2"></i>Yeni Chat Log Ekle
        </a>
    </div>

    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-info text-white">
            <h5 class="mb-0"><i class="fas fa-history me-2"></i>Sohbet Geçmişi</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0" id="chatTable">
                    <thead class="table-info">
                        <tr>
                            <th><i class="fas fa-user me-2"></i>Kullanıcı Mesajı</th>
                            <th><i class="fas fa-robot me-2"></i>Bot Cevabı</th>
                            <th><i class="fas fa-calendar me-2"></i>Tarih</th>
                            <th class="text-center"><i class="fas fa-cogs me-2"></i>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="position-relative">
                                    <div class="message-preview user-message">
                                        <i class="fas fa-user-circle text-primary me-2"></i>
                                        <span class="truncate-text" title="@item.KullaniciMesaj">
                                            @Html.DisplayFor(modelItem => item.KullaniciMesaj)
                                        </span>
                                    </div>
                                </td>
                                <td class="position-relative">
                                    <div class="message-preview bot-message">
                                        <i class="fas fa-robot text-success me-2"></i>
                                        <span class="truncate-text" title="@item.BotCevap">
                                            @Html.DisplayFor(modelItem => item.BotCevap)
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="date-badge">
                                        <i class="fas fa-clock me-1"></i>
                                        <span>@item.Tarih.ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm action-btn"
                                           title="Düzenle" data-action="edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-info btn-sm action-btn"
                                           title="Detaylar" data-action="details">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm action-btn"
                                           title="Sil" data-action="delete">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted d-flex justify-content-between align-items-center">
            <small><i class="fas fa-info-circle me-1"></i>Toplam @Model.Count() sohbet kaydı bulunmaktadır.</small>
            <button class="btn btn-outline-secondary btn-sm" id="refreshBtn">
                <i class="fas fa-sync-alt me-1"></i>Yenile
            </button>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .truncate-text {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            max-width: 300px;
        }

        .message-preview {
            padding: 8px 12px;
            border-radius: 10px;
            margin: 5px 0;
            font-size: 0.9rem;
        }

        .user-message {
            background-color: #e3f2fd;
            border-left: 4px solid #2196f3;
        }

        .bot-message {
            background-color: #e8f5e9;
            border-left: 4px solid #4caf50;
        }

        .date-badge {
            background: #f5f5f5;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            display: inline-block;
        }

        .table-hover tbody tr:hover {
            background-color: rgba(13, 202, 240, 0.05) !important;
            transform: translateY(-2px);
            transition: all 0.3s ease;
        }

        .action-btn {
            border-radius: 8px !important;
            margin: 0 2px;
            position: relative;
            overflow: hidden;
        }

            .action-btn::after {
                content: '';
                position: absolute;
                top: 50%;
                left: 50%;
                width: 5px;
                height: 5px;
                background: rgba(255, 255, 255, 0.5);
                opacity: 0;
                border-radius: 100%;
                transform: scale(1, 1) translate(-50%);
                transform-origin: 50% 50%;
            }

            .action-btn:focus:not(:active)::after {
                animation: ripple 1s ease-out;
            }

        @@keyframes ripple {
            0% {
                transform: scale(0, 0);
                opacity: 0.5;
            }

            100% {
                transform: scale(20, 20);
                opacity: 0;
            }
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Tooltip'leri aktif et
            $('[title]').tooltip();

            // Mesaj önizlemelerine tıklama
            $('.truncate-text').click(function() {
                const fullText = $(this).attr('title');
                $(this).toggleClass('truncate-text');
                if ($(this).hasClass('truncate-text')) {
                    $(this).text(fullText.substring(0, 100) + '...');
                } else {
                    $(this).text(fullText);
                }
            });

            // Yenile butonu
            $('#refreshBtn').click(function() {
                $(this).addClass('fa-spin');
                setTimeout(() => {
                    $(this).removeClass('fa-spin');
                    location.reload();
                }, 500);
            });

            // Satır hover efekti
            $('#chatTable tbody tr').hover(
                function() {
                    $(this).addClass('shadow-sm');
                    $(this).find('.message-preview').css('transform', 'scale(1.02)');
                },
                function() {
                    $(this).removeClass('shadow-sm');
                    $(this).find('.message-preview').css('transform', 'scale(1)');
                }
            );

            // Tarih sıralama
            $('th').click(function() {
                if ($(this).index() === 2) {
                    alert('Tarihe göre sıralama özelliği aktif edilecek...');
                }
            });
        });
    </script>
}