@model Eticaret.Data.Entities.ChatLog

@{
    ViewData["Title"] = "Sohbet Detayları";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-info text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-info-circle fa-2x me-3"></i>
                        <div>
                            <h1 class="h3 mb-0">Sohbet Detayları</h1>
                            <p class="mb-0 opacity-75">Sohbet kaydının tüm detayları</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Chat Simülasyonu -->
                    <div class="chat-simulation mb-5">
                        <div class="chat-header text-center mb-4">
                            <div class="chat-avatar mb-2">
                                <i class="fas fa-comments fa-3x text-info"></i>
                            </div>
                            <h4 class="text-muted">Sohbet Simülasyonu</h4>
                            <small class="text-muted">ID: @Model.Id • @Model.Tarih.ToString("dd.MM.yyyy HH:mm")</small>
                        </div>

                        <div class="chat-messages">
                            <!-- Kullanıcı Mesajı -->
                            <div class="message user-message-detail mb-4 animate-slide-left">
                                <div class="message-wrapper">
                                    <div class="message-avatar">
                                        <div class="avatar-circle bg-primary">
                                            <i class="fas fa-user text-white"></i>
                                        </div>
                                    </div>
                                    <div class="message-content">
                                        <div class="message-header">
                                            <span class="fw-bold">Kullanıcı</span>
                                            <small class="text-muted ms-2">
                                                <i class="fas fa-clock me-1"></i>@Model.Tarih.ToString("HH:mm")
                                            </small>
                                        </div>
                                        <div class="message-body">
                                            @Model.KullaniciMesaj
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Bot Cevabı -->
                            <div class="message bot-message-detail mb-4 animate-slide-right">
                                <div class="message-wrapper">
                                    <div class="message-content">
                                        <div class="message-header">
                                            <span class="fw-bold">ChatBot</span>
                                            <small class="text-muted ms-2">
                                                <i class="fas fa-clock me-1"></i>@Model.Tarih.AddSeconds(2).ToString("HH:mm")
                                            </small>
                                        </div>
                                        <div class="message-body">
                                            @Model.BotCevap
                                        </div>
                                    </div>
                                    <div class="message-avatar">
                                        <div class="avatar-circle bg-success">
                                            <i class="fas fa-robot text-white"></i>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Chat İstatistikleri -->
                        <div class="chat-stats mt-4 p-3 bg-light rounded">
                            <h6 class="mb-3 text-muted"><i class="fas fa-chart-bar me-2"></i>Sohbet İstatistikleri</h6>
                            <div class="row text-center">
                                <div class="col-md-4 mb-2">
                                    <div class="stat-box">
                                        <div class="stat-value text-primary">
                                            @Model.KullaniciMesaj?.Length
                                        </div>
                                        <div class="stat-label">Kullanıcı Karakter</div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <div class="stat-box">
                                        <div class="stat-value text-success">
                                            @Model.BotCevap?.Length
                                        </div>
                                        <div class="stat-label">Bot Karakter</div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-2">
                                    <div class="stat-box">
                                        <div class="stat-value text-warning">
                                            @((Model.KullaniciMesaj?.Length ?? 0) + (Model.BotCevap?.Length ?? 0))
                                        </div>
                                        <div class="stat-label">Toplam Karakter</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hızlı İşlemler -->
                    <div class="quick-actions mb-4">
                        <h6 class="mb-3 text-muted"><i class="fas fa-bolt me-2"></i>Hızlı İşlemler</h6>
                        <div class="btn-group w-100" role="group">
                            <button class="btn btn-outline-primary" onclick="copyToClipboard('@Model.KullaniciMesaj')">
                                <i class="fas fa-copy me-2"></i>Mesajı Kopyala
                            </button>
                            <button class="btn btn-outline-success" onclick="copyToClipboard('@Model.BotCevap')">
                                <i class="fas fa-copy me-2"></i>Cevabı Kopyala
                            </button>
                            <button class="btn btn-outline-info" onclick="shareChat()">
                                <i class="fas fa-share me-2"></i>Paylaş
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                        </a>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn btn-primary btn-lg">
                                <i class="fas fa-edit me-2"></i>Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id"
                               class="btn btn-danger btn-lg">
                                <i class="fas fa-trash me-2"></i>Sil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .chat-simulation {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 20px;
        }

        .message-wrapper {
            display: flex;
            align-items: flex-start;
            margin-bottom: 10px;
        }

        .user-message-detail .message-wrapper {
            flex-direction: row;
        }

        .bot-message-detail .message-wrapper {
            flex-direction: row-reverse;
        }

        .message-avatar {
            flex-shrink: 0;
            margin: 0 10px;
        }

        .avatar-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
        }

        .message-content {
            max-width: 70%;
        }

        .user-message-detail .message-content {
            background: #e3f2fd;
            border-radius: 15px 15px 15px 0;
            padding: 12px 15px;
            border-left: 4px solid #2196f3;
        }

        .bot-message-detail .message-content {
            background: #e8f5e9;
            border-radius: 15px 15px 0 15px;
            padding: 12px 15px;
            border-right: 4px solid #4caf50;
        }

        .message-header {
            font-size: 0.85rem;
            margin-bottom: 5px;
        }

        .message-body {
            font-size: 1rem;
            line-height: 1.5;
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .chat-stats {
            border: 2px dashed #dee2e6;
        }

        .stat-box {
            padding: 10px;
        }

        .stat-value {
            font-size: 1.8rem;
            font-weight: bold;
            line-height: 1;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 5px;
        }

        .animate-slide-left {
            animation: slideInLeft 0.5s ease-out;
        }

        .animate-slide-right {
            animation: slideInRight 0.5s ease-out;
        }

        @@keyframes slideInLeft {
            from {
                opacity: 0;
                transform: translateX(-30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @@keyframes slideInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .btn-group .btn {
            border-radius: 8px !important;
            margin: 0 2px;
        }

        .quick-actions .btn-group {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }

        .quick-actions .btn {
            flex: 1;
            min-width: 150px;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Sayfa yüklendiğinde animasyonları tetikle
            setTimeout(() => {
                $('.animate-slide-left').addClass('show');
                $('.animate-slide-right').addClass('show');
            }, 100);

            // Metin kopyalama fonksiyonu
            window.copyToClipboard = function(text) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast('Kopyalandı!', 'success');
                }).catch(err => {
                    console.error('Kopyalama hatası:', err);
                    showToast('Kopyalama başarısız!', 'error');
                });
            };

            // Paylaş fonksiyonu
            window.shareChat = function() {
                const chatText = `Kullanıcı: ${'@Model.KullaniciMesaj'}\nBot: ${'@Model.BotCevap'}\nTarih: ${'@Model.Tarih.ToString("dd.MM.yyyy HH:mm")'}`;

                if (navigator.share) {
                    navigator.share({
                        title: 'Sohbet Kaydı',
                        text: chatText,
                        url: window.location.href
                    });
                } else {
                    copyToClipboard(chatText);
                }
            };

            // Toast mesajı göster
            function showToast(message, type = 'info') {
                const toastClass = type === 'success' ? 'bg-success' : 'bg-danger';
                const toastHtml = `
                    <div class="toast show position-fixed" style="top:20px;right:20px;z-index:9999">
                        <div class="toast-header ${toastClass} text-white">
                            <strong class="me-auto">
                                <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'} me-2"></i>
                                ${type === 'success' ? 'Başarılı' : 'Hata'}
                            </strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast"></button>
                        </div>
                        <div class="toast-body">
                            ${message}
                        </div>
                    </div>
                `;

                $('body').append(toastHtml);
                setTimeout(() => {
                    $('.toast').remove();
                }, 3000);
            }

            // Mesajları otomatik scroll et
            const chatMessages = $('.chat-messages');
            chatMessages.scrollTop(chatMessages[0].scrollHeight);
        });
    </script>
}