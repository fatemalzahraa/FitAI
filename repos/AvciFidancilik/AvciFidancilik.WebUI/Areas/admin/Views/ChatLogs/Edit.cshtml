@model Eticaret.Data.Entities.ChatLog

@{
    ViewData["Title"] = "Sohbet Kaydı Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-edit fa-2x me-3"></i>
                        <div>
                            <h1 class="h3 mb-0">Sohbet Kaydı Düzenle</h1>
                            <p class="mb-0 opacity-75">Sohbet bilgilerini güncelleyiniz</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" id="editForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <div class="form-group">
                                    <label asp-for="KullaniciMesaj" class="form-label fw-bold mb-2">
                                        <i class="fas fa-user me-2 text-primary"></i>Kullanıcı Mesajı
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-primary text-white">
                                            <i class="fas fa-comment"></i>
                                        </span>
                                        <textarea asp-for="KullaniciMesaj" class="form-control chat-textarea"
                                                  rows="3" placeholder="Kullanıcının mesajını giriniz..."
                                                  id="userMessage"></textarea>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        <span asp-validation-for="KullaniciMesaj" class="text-danger small"></span>
                                        <small class="text-muted">
                                            <span id="userCharCount">@Model.KullaniciMesaj?.Length</span>/500 karakter
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12 mb-4">
                                <div class="form-group">
                                    <label asp-for="BotCevap" class="form-label fw-bold mb-2">
                                        <i class="fas fa-robot me-2 text-success"></i>Bot Cevabı
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-success text-white">
                                            <i class="fas fa-reply"></i>
                                        </span>
                                        <textarea asp-for="BotCevap" class="form-control chat-textarea"
                                                  rows="3" placeholder="Bot'un cevabını giriniz..."
                                                  id="botResponse"></textarea>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        <span asp-validation-for="BotCevap" class="text-danger small"></span>
                                        <small class="text-muted">
                                            <span id="botCharCount">@Model.BotCevap?.Length</span>/500 karakter
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-12 mb-4">
                                <div class="form-group">
                                    <label asp-for="Tarih" class="form-label fw-bold mb-2">
                                        <i class="fas fa-calendar-alt me-2 text-warning"></i>Sohbet Tarihi
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-warning">
                                            <i class="fas fa-clock"></i>
                                        </span>
                                        <input asp-for="Tarih" class="form-control datetime-picker"
                                               value="@Model.Tarih.ToString("yyyy-MM-ddTHH:mm")" />
                                    </div>
                                    <span asp-validation-for="Tarih" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="original-data mb-4 p-3 border rounded bg-light">
                            <h6 class="mb-3 text-muted">
                                <i class="fas fa-history me-2"></i>Orijinal Kayıt
                                <small class="text-muted">(ID: @Model.Id)</small>
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <small class="text-muted">Oluşturulma Tarihi:</small>
                                    <div class="fw-bold">@Model.Tarih.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                                <div class="col-md-6">
                                    <small class="text-muted">Son Güncelleme:</small>
                                    <div class="fw-bold">@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</div>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-times me-2"></i>İptal
                            </a>
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@Model.Id"
                                   class="btn btn-info btn-lg">
                                    <i class="fas fa-eye me-2"></i>Detaylar
                                </a>
                                <button type="submit" class="btn btn-primary btn-lg px-5" id="saveBtn">
                                    <i class="fas fa-check me-2"></i>Güncelle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .chat-textarea {
            resize: vertical;
            min-height: 100px;
            border-left: none !important;
        }

            .chat-textarea:focus {
                box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
                border-color: #0d6efd;
            }

        .input-group-text {
            border-right: none;
        }

        .original-data {
            border-left: 4px solid #6c757d !important;
            background: #f8f9fa !important;
        }

        .datetime-picker {
            border-left: none !important;
        }

            .datetime-picker:focus {
                box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
                border-color: #ffc107;
            }

        .btn-group .btn {
            border-radius: 8px !important;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Karakter sayacı
            function updateCharCount(textareaId, counterId) {
                $(textareaId).on('input', function() {
                    const count = $(this).val().length;
                    $(counterId).text(count);

                    if (count > 500) {
                        $(counterId).addClass('text-danger');
                    } else {
                        $(counterId).removeClass('text-danger');
                    }
                });
            }

            updateCharCount('#userMessage', '#userCharCount');
            updateCharCount('#botResponse', '#botCharCount');

            // Form submit
            $('#editForm').submit(function() {
                if ($('#userMessage').val().length > 500 || $('#botResponse').val().length > 500) {
                    alert('Mesajlar 500 karakteri geçemez!');
                    return false;
                }

                $('#saveBtn').html('<i class="fas fa-spinner fa-spin me-2"></i>Güncelleniyor...');
                $('#saveBtn').prop('disabled', true);
                return true;
            });

            // Değişiklik kontrolü
            let originalData = {
                userMessage: $('#userMessage').val(),
                botResponse: $('#botResponse').val(),
                tarih: $('.datetime-picker').val()
            };

            $('#editForm').on('input change', function() {
                const currentData = {
                    userMessage: $('#userMessage').val(),
                    botResponse: $('#botResponse').val(),
                    tarih: $('.datetime-picker').val()
                };

                const hasChanged = JSON.stringify(originalData) !== JSON.stringify(currentData);
                $('#saveBtn').prop('disabled', !hasChanged);

                if (hasChanged) {
                    $('#saveBtn').html('<i class="fas fa-save me-2"></i>Güncelle');
                } else {
                    $('#saveBtn').html('<i class="fas fa-check me-2"></i>Değişiklik Yok');
                }
            });
        });
    </script>
}