@model Eticaret.Core.Entities.Order

@{
    ViewData["Title"] = "Sipariş Detayları";
}

<div class="container mt-4">
    <!-- Başlık -->
    <div class="mb-4">
        <h2 class="fw-bold text-primary">
            <i class="bi bi-receipt me-2"></i>Sipariş Detayları
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Siparişler</a></li>
                <li class="breadcrumb-item active">#@Model.Id</li>
            </ol>
        </nav>
    </div>

    <div class="row">
        <!-- SOL TARAF -->
        <div class="col-lg-8">
            <!-- Sipariş Bilgileri -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>Sipariş Bilgileri
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Sipariş No -->
                        <div class="col-md-6 mb-4">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <div class="bg-primary rounded-circle p-3 me-3">
                                    <i class="bi bi-hash text-white fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted">Sipariş Numarası</small>
                                    <div class="fs-3 fw-bold">#@Model.Id</div>
                                </div>
                            </div>
                        </div>

                        <!-- Sipariş Tarihi -->
                        <div class="col-md-6 mb-4">
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <div class="bg-info rounded-circle p-3 me-3">
                                    <i class="bi bi-calendar-check text-white fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted">Sipariş Tarihi</small>
                                    <div class="fw-bold">@Model.OrderDate.ToString("dd MMMM yyyy HH:mm")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Kullanıcı Bilgisi -->
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th width="30%">
                                    <i class="bi bi-person me-2"></i>Kullanıcı
                                </th>
                                <td>
                                    <strong>@Model.User.Email</strong><br />
                                    <small class="text-muted">User ID: @Model.UserId</small>
                                </td>
                            </tr>
                            <tr>
                                <th>
                                    <i class="bi bi-clock-history me-2"></i>Geçen Süre
                                </th>
                                <td>
                                    @{
                                        var diff = DateTime.UtcNow - Model.OrderDate;
                                        var ago = diff.TotalDays >= 1
                                        ? $"{(int)diff.TotalDays} gün önce"
                                        : diff.TotalHours >= 1
                                        ? $"{(int)diff.TotalHours} saat önce"
                                        : $"{(int)diff.TotalMinutes} dakika önce";
                                    }
                                    <strong>@ago</strong>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Sipariş Ürünleri -->
            @if (Model.OrderItems != null && Model.OrderItems.Any())
            {
                <div class="card shadow border-0 mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-cart-check me-2"></i>Sipariş Ürünleri
                        </h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Ürün ID</th>
                                    <th class="text-end">Adet</th>
                                    <th class="text-end">Birim Fiyat</th>
                                    <th class="text-end">Toplam</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.OrderItems)
                                {
                                    <tr>
                                        <td>Ürün #@item.ProductId</td>
                                        <td class="text-end">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                        <td class="text-end fw-bold">
                                            @(item.Quantity* item.UnitPrice).ToString("C")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="table-light">
                                    <td colspan="3" class="text-end fw-bold">Genel Toplam</td>
                                    <td class="text-end fw-bold text-success">
                                        @Model.OrderItems.Sum(x => x.Quantity * x.UnitPrice).ToString("C")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    Bu siparişte henüz ürün bulunmuyor.
                </div>
            }
        </div>

        <!-- SAĞ TARAF -->
        <div class="col-lg-4">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-gear me-2"></i>İşlemler
                    </h5>
                </div>
                <div class="card-body d-grid gap-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-2"></i>Düzenle
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-2"></i>Sil
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-2"></i>Listeye Dön
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
