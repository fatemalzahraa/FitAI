@model Eticaret.Core.Entities.Order

@{
    ViewData["Title"] = "Sipariş Sil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Uyarı Kartı -->
            <div class="card border-danger shadow-lg mb-4">
                <div class="card-header bg-danger text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill display-6 me-3"></i>
                        <div>
                            <h3 class="mb-1">Sipariş Silme İşlemi</h3>
                            <p class="mb-0 opacity-75">Bu işlem geri alınamaz!</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Sipariş Detayları -->
                    <div class="alert alert-warning border-warning">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-info-circle-fill me-3 fs-4"></i>
                            <div>
                                <h5 class="alert-heading mb-2">Aşağıdaki siparişi silmek üzeresiniz</h5>
                                <p class="mb-0">Siparişi silerseniz, bu siparişe ait tüm bilgiler kalıcı olarak silinecektir.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Sipariş Bilgileri Kartı -->
                    <div class="card border-0 bg-light mb-4">
                        <div class="card-body">
                            <h5 class="card-title mb-4 text-danger">
                                <i class="bi bi-cart-x me-2"></i>Silinecek Sipariş Detayları
                            </h5>

                            <div class="row">
                                <!-- Sipariş ID -->
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-center p-3 bg-white rounded shadow-sm">
                                        <div class="bg-primary rounded-circle p-2 me-3">
                                            <i class="bi bi-hash text-white"></i>
                                        </div>
                                        <div>
                                            <small class="text-muted d-block">Sipariş Numarası</small>
                                            <strong class="fs-5">#@Model.Id</strong>
                                        </div>
                                    </div>
                                </div>

                                
                            <!-- Detaylı Bilgiler -->
                            <div class="table-responsive">
                                <table class="table table-hover table-bordered">
                                    <tbody>
                                        <tr>
                                            <th class="bg-light" width="30%">
                                                <i class="bi bi-person me-2"></i>@Html.DisplayNameFor(model => model.User)
                                            </th>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-envelope me-2 text-primary"></i>
                                                    <span>@Html.DisplayFor(model => model.User.Email)</span>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">
                                                <i class="bi bi-calendar-event me-2"></i>@Html.DisplayNameFor(model => model.OrderDate)
                                            </th>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-clock me-2 text-primary"></i>
                                                    <span>@Model.OrderDate.ToString("dd MMMM yyyy HH:mm")</span>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th class="bg-light">
                                                <i class="bi bi-clock-history me-2"></i>Oluşturulma Zamanı
                                            </th>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi bi-calendar-check me-2 text-primary"></i>
                                                    <span>@DateTime.UtcNow.ToString("dd MMMM yyyy HH:mm")</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Ek Uyarı -->
                            <div class="alert alert-danger border-start border-5 border-danger mt-4">
                                <div class="d-flex">
                                    <i class="bi bi-exclamation-octagon-fill me-3 fs-4"></i>
                                    <div>
                                        <h6 class="alert-heading">Dikkat!</h6>
                                        <ul class="mb-0">
                                            <li>Bu işlem geri alınamaz</li>
                                            <li>Siparişe ait tüm kayıtlar silinecek</li>
                                            <li>Silme işlemi sistem loglarında kaydedilecektir</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Silme Onay Formu -->
                    <form asp-action="Delete" id="deleteForm" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="confirmDelete" required>
                                <label class="form-check-label fw-bold" for="confirmDelete">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Yukarıdaki uyarıları okudum ve siparişi silmek istiyorum
                                </label>
                                <div class="invalid-feedback">
                                    Silme işlemini onaylamadan devam edemezsiniz.
                                </div>
                            </div>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                            <button type="submit" id="deleteBtn" class="btn btn-danger btn-lg px-5" disabled>
                                <i class="bi bi-trash3 me-2"></i>Sil
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-5">
                                <i class="bi bi-arrow-left me-2"></i>Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light py-3">
                    <div class="text-muted small">
                        <i class="bi bi-shield-lock me-1"></i>
                        Bu işlem güvenlik nedeniyle loglanacaktır.
                    </div>
                </div>
            </div>

            <!-- Yan Etkiler Bilgi Kartı -->
            <div class="card border-info shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-lightbulb me-2"></i>Alternatif Öneri
                    </h5>
                </div>
                <div class="card-body">
                    <p>Bu siparişi silmek yerine durumunu "İptal Edildi" olarak değiştirmeyi düşünebilirsiniz. Bu sayede:</p>
                    <ul>
                        <li>Geçmiş kayıtlarınız korunur</li>
                        <li>İstatistiksel veriler tutarlı kalır</li>
                        <li>Müşteri iletişim geçmişi saklanır</li>
                    </ul>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-info">
                        <i class="bi bi-pencil me-2"></i>Düzenle (Alternatif)
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --danger-color: #dc3545;
            --danger-dark: #c82333;
            --warning-color: #ffc107;
            --info-color: #17a2b8;
            --light-bg: #f8f9fa;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
            --shadow-lg: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        body {
            background: linear-gradient(135deg, #fdfcfb 0%, #f5f7fa 100%);
            min-height: 100vh;
        }

        .card {
            border-radius: 15px;
            overflow: hidden;
            border: none;
            transition: transform 0.3s ease;
        }

            .card.border-danger {
                border: 2px solid var(--danger-color) !important;
            }

            .card.border-info {
                border: 2px solid var(--info-color) !important;
            }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
        }

            .card-header.bg-danger {
                background: linear-gradient(135deg, var(--danger-color), var(--danger-dark)) !important;
            }

        .table th {
            font-weight: 600;
            background-color: rgba(0, 0, 0, 0.02);
        }

        .table td {
            vertical-align: middle;
        }

        .badge {
            border-radius: 50px;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .btn-danger {
            background: linear-gradient(135deg, var(--danger-color), var(--danger-dark));
            border: none;
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

            .btn-danger:disabled {
                background: #6c757d;
                cursor: not-allowed;
                transform: none !important;
                box-shadow: none !important;
            }

            .btn-danger:hover:not(:disabled) {
                transform: translateY(-2px);
                box-shadow: 0 6px 15px rgba(220, 53, 69, 0.4);
            }

            .btn-danger:active:not(:disabled) {
                transform: translateY(0);
            }

        .btn-outline-secondary {
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 600;
            border: 2px solid #6c757d;
        }

            .btn-outline-secondary:hover {
                background-color: #6c757d;
                color: white;
            }

        .form-check-input {
            width: 1.2em;
            height: 1.2em;
            margin-top: 0.2em;
        }

            .form-check-input:checked {
                background-color: var(--danger-color);
                border-color: var(--danger-color);
            }

            .form-check-input:focus {
                border-color: var(--danger-color);
                box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
            }

        /* Animasyonlar */
        @@keyframes pulse {
            0%

        {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }

        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .card {
            animation: fadeIn 0.5s ease-out;
        }

        .alert-warning {
            animation: pulse 2s infinite;
        }

        /* Responsive tasarım */
        @@media (max-width: 768px) {
            .card-body {
                padding: 1.5rem !important;
            }

            .btn-lg {
                padding: 10px 20px !important;
                font-size: 1rem;
            }

            .d-flex {
                flex-direction: column;
                text-align: center;
            }

                .d-flex > * {
                    margin-bottom: 10px;
                }
        }

        /* Özel hover efektleri */
        .table-hover tbody tr:hover {
            background-color: rgba(220, 53, 69, 0.05) !important;
            transform: scale(1.002);
            transition: all 0.2s ease;
        }

        /* Checkbox etiket hover efekti */
        .form-check-label:hover {
            color: var(--danger-color);
            cursor: pointer;
        }
    </style>
}

@section Scripts {
    <script>
        // Checkbox kontrolü
        document.getElementById('confirmDelete').addEventListener('change', function() {
            const deleteBtn = document.getElementById('deleteBtn');
            deleteBtn.disabled = !this.checked;

            if (this.checked) {
                deleteBtn.innerHTML = '<i class="bi bi-trash3 me-2"></i>Onayla ve Sil';
            } else {
                deleteBtn.innerHTML = '<i class="bi bi-trash3 me-2"></i>Sil';
            }
        });

        // Form gönderim kontrolü
        document.getElementById('deleteForm').addEventListener('submit', function(e) {
            const confirmCheck = document.getElementById('confirmDelete');
            const deleteBtn = document.getElementById('deleteBtn');

            if (!confirmCheck.checked) {
                e.preventDefault();
                alert('Lütfen silme işlemini onaylayınız!');
                return false;
            }

            // Son onay sorusu
            const userConfirmed = confirm('⚠️ SİPARIŞ SİLİNECEK!\n\nBu işlem GERİ ALINAMAZ!\n\nSipariş #@Model.Id numaralı siparişi silmek istediğinizden emin misiniz?');

            if (!userConfirmed) {
                e.preventDefault();
                return false;
            }

            // Buton durumunu değiştir
            if (deleteBtn) {
                deleteBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Siliniyor...';
                deleteBtn.disabled = true;

                // Tüm butonları devre dışı bırak
                const allButtons = this.querySelectorAll('button');
                allButtons.forEach(btn => btn.disabled = true);
            }
        });

        // Sayfa yüklendiğinde uyarı
        document.addEventListener('DOMContentLoaded', function() {
            console.warn('Sipariş silme sayfası yüklendi - Dikkat: Bu sayfada yapılan işlemler geri alınamaz!');

            // Klavye kısayolu (ESC ile iptal)
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    window.location.href = '@Url.Action("Index")';
                }
            });
        });
    </script>
}