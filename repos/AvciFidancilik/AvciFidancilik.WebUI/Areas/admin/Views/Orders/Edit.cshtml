@model Eticaret.Core.Entities.Order

@{
    ViewData["Title"] = "Sipariş Düzenle";

   
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="mb-0">
                            <i class="bi bi-pencil-square me-2"></i>Sipariş Düzenle
                        </h3>
                        <div class="badge bg-light text-dark fs-6">
                            <i class="bi bi-hash me-1"></i>#@Model.Id
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" id="orderForm" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <!-- Sipariş Bilgileri -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="alert alert-info">
                                    <h6 class="alert-heading">
                                        <i class="bi bi-info-circle-fill me-2"></i>Sipariş Bilgileri
                                    </h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <small class="d-block">Sipariş Numarası</small>
                                            <strong>#@Model.Id</strong>
                                        </div>
                                        <div class="col-md-6">
                                            <small class="d-block">Oluşturulma Tarihi</small>
                                            <strong>@Model.OrderDate.ToString("dd MMMM yyyy HH:mm")</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Alanları -->
                        <div class="row">
                            <!-- Kullanıcı Seçimi -->
                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="UserId" class="form-label fw-bold">
                                        <i class="bi bi-person me-1"></i>Kullanıcı
                                    </label>
                                    <select asp-for="UserId" class="form-select form-select-lg"
                                            asp-items="ViewBag.UserId" required>
                                        <option value="">-- Kullanıcı Seçiniz --</option>
                                    </select>
                                    <div class="invalid-feedback">
                                        Lütfen bir kullanıcı seçiniz.
                                    </div>
                                    <span asp-validation-for="UserId" class="text-danger small"></span>
                                    <small class="form-text text-muted">
                                        Siparişin bağlı olduğu kullanıcıyı seçin
                                    </small>
                                </div>
                            </div>

                            <!-- Sipariş Tarihi -->
                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label asp-for="OrderDate" class="form-label fw-bold">
                                        <i class="bi bi-calendar me-1"></i>Sipariş Tarihi
                                    </label>
                                    <div class="input-group">
                                        <input asp-for="OrderDate" type="datetime-local"
                                               class="form-control form-control-lg"
                                               value="@Model.OrderDate.ToString("yyyy-MM-ddTHH:mm")"
                                               required />
                                        <button type="button" class="btn btn-outline-secondary" onclick="setCurrentDateTime()">
                                            <i class="bi bi-clock"></i>
                                        </button>
                                    </div>
                                    <div class="invalid-feedback">
                                        Lütfen geçerli bir tarih seçiniz.
                                    </div>
                                    <span asp-validation-for="OrderDate" class="text-danger small"></span>
                                    <small class="form-text text-muted">
                                        Siparişin oluşturulma tarihi
                                    </small>
                                </div>
                            </div>

                         

                            <!-- Durum Görsel Göstergesi -->
                            <div class="col-md-6 mb-4">
                                <div class="form-group">
                                    <label class="form-label fw-bold">
                                        <i class="bi bi-eye me-1"></i>Durum Önizleme
                                    </label>
                                    <div id="statusPreview" class="p-3 rounded text-center"
                                         style="min-height: 60px; display: flex; align-items: center; justify-content: center;">
                                        <span id="previewBadge" class="badge fs-6 px-4 py-2">
                                            Durum seçiniz
                                        </span>
                                    </div>
                                    <small class="form-text text-muted">
                                        Seçilen durumun görsel önizlemesi
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Değişiklikler -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border-info">
                                    <div class="card-header bg-info text-white py-2">
                                        <h6 class="mb-0">
                                            <i class="bi bi-clock-history me-2"></i>Değişiklik Geçmişi
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <small class="text-muted">Son Güncelleme</small>
                                                <div class="fw-bold">@DateTime.UtcNow.ToString("dd MMMM yyyy HH:mm")</div>
                                            </div>
                                            <div class="col-md-6">
                                                <small class="text-muted">Değişiklik Yapan</small>
                                                <div class="fw-bold">Mevcut Kullanıcı</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
                            <div>
                                <button type="submit" class="btn btn-primary btn-lg px-4">
                                    <i class="bi bi-check-circle me-2"></i>Değişiklikleri Kaydet
                                </button>
                                <button type="button" class="btn btn-outline-secondary btn-lg px-4" onclick="resetForm()">
                                    <i class="bi bi-arrow-clockwise me-2"></i>Sıfırla
                                </button>
                            </div>
                            <div>
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info btn-lg px-4 me-2">
                                    <i class="bi bi-eye me-2"></i>Görüntüle
                                </a>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                    <i class="bi bi-x-circle me-2"></i>İptal
                                </a>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light py-3">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="text-muted small">
                                <i class="bi bi-calendar-plus me-1"></i>
                                Oluşturulma: @Model.OrderDate.ToString("dd.MM.yyyy")
                            </div>
                        </div>
                        <div class="col-md-6 text-end">
                            <div class="text-muted small">
                                <i class="bi bi-pencil me-1"></i>
                                Son Düzenleme: @DateTime.UtcNow.ToString("HH:mm")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hızlı Aksiyonlar -->
            <div class="card shadow border-0 mt-4">
                <div class="card-header bg-secondary text-white py-3">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning me-2"></i>Hızlı Aksiyonlar
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash me-2"></i>Siparişi Sil
                        </a>
                        <button type="button" class="btn btn-outline-success" onclick="setStatus('Delivered')">
                            <i class="bi bi-check-circle me-2"></i>Teslim Edildi Yap
                        </button>
                        <button type="button" class="btn btn-outline-warning" onclick="setStatus('Cancelled')">
                            <i class="bi bi-x-circle me-2"></i>İptal Edildi Yap
                        </button>
                        <button type="button" class="btn btn-outline-info" onclick="printOrder()">
                            <i class="bi bi-printer me-2"></i>Yazdır
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        :root {
            --primary-color: #4361ee;
            --secondary-color: #3a0ca3;
            --success-color: #4cc9f0;
            --info-color: #17a2b8;
            --warning-color: #ffc107;
            --danger-color: #dc3545;
            --light-bg: #f8f9fa;
            --shadow: 0 4px 12px rgba(0, 0, 0, 0.08);
            --shadow-lg: 0 8px 25px rgba(0, 0, 0, 0.15);
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #e4edf5 100%);
            min-height: 100vh;
        }

        .card {
            border-radius: 15px;
            overflow: hidden;
            border: none;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-lg);
            }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
        }

            .card-header.bg-primary {
                background: linear-gradient(135deg, var(--primary-color), var(--secondary-color)) !important;
            }

            .card-header.bg-info {
                background: linear-gradient(135deg, var(--info-color), #138496) !important;
            }

        .form-control, .form-select {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 12px 15px;
            transition: all 0.3s;
            font-size: 1rem;
        }

        .form-control-lg {
            padding: 14px 16px;
            font-size: 1.1rem;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 0.25rem rgba(67, 97, 238, 0.25);
        }

        .form-label {
            color: #495057;
            margin-bottom: 8px;
            font-weight: 600;
            display: flex;
            align-items: center;
        }

        .form-text {
            margin-top: 6px;
            font-size: 0.85rem;
        }

        .btn {
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
            border: none;
            padding: 12px 30px;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow);
            }

        .btn-outline-secondary, .btn-outline-info {
            border: 2px solid;
            padding: 12px 30px;
        }

            .btn-outline-secondary:hover {
                background-color: #6c757d;
                color: white;
                border-color: #6c757d;
            }

            .btn-outline-info:hover {
                background-color: var(--info-color);
                color: white;
                border-color: var(--info-color);
            }

        .btn-outline-danger {
            border: 2px solid var(--danger-color);
        }

            .btn-outline-danger:hover {
                background: linear-gradient(135deg, var(--danger-color), #c82333);
                color: white;
            }

        .input-group .btn-outline-secondary {
            border-left: none;
            border-radius: 0 10px 10px 0;
        }

        .input-group .form-control {
            border-right: none;
            border-radius: 10px 0 0 10px;
        }

        .badge {
            border-radius: 50px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

            /* Durum renkleri */
            .badge.bg-warning {
                background: linear-gradient(135deg, #ffc107, #e0a800) !important;
            }

            .badge.bg-primary {
                background: linear-gradient(135deg, #4361ee, #3a0ca3) !important;
            }

            .badge.bg-info {
                background: linear-gradient(135deg, #17a2b8, #138496) !important;
            }

            .badge.bg-success {
                background: linear-gradient(135deg, #28a745, #20c997) !important;
            }

            .badge.bg-danger {
                background: linear-gradient(135deg, #dc3545, #c82333) !important;
            }

        .alert-info {
            background-color: rgba(67, 97, 238, 0.1);
            border: 2px solid rgba(67, 97, 238, 0.2);
            border-radius: 10px;
            color: #2d3748;
        }

        /* Animasyonlar */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card {
            animation: fadeIn 0.5s ease-out;
        }

        @@keyframes pulse {
            0% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.02);
            }

            100% {
                transform: scale(1);
            }
        }

        .btn-primary:focus {
            animation: pulse 0.5s ease;
        }

        /* Responsive tasarım */
        @@media (max-width: 768px) {
            .card-body {
                padding: 1.5rem !important;
            }

            .btn-lg {
                padding: 10px 20px !important;
                font-size: 1rem;
            }

            .d-flex {
                flex-direction: column;
                gap: 10px;
            }

                .d-flex > * {
                    margin-bottom: 10px;
                }
        }

        /* Hover efektleri */
        .form-group:hover .form-label {
            color: var(--primary-color);
        }

        select option {
            padding: 10px;
        }

        /* Özel stiller */
        #statusPreview {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            border: 2px dashed #dee2e6;
            transition: all 0.3s ease;
        }

            #statusPreview:hover {
                border-color: var(--primary-color);
                background: linear-gradient(135deg, #f0f5ff, #e6eeff);
            }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Durum değişikliğinde badge güncelleme
        document.getElementById('Status').addEventListener('change', function() {
            updateStatusPreview(this.value);
        });

  
            // Form validation
            var forms = document.querySelectorAll('.needs-validation');
            Array.prototype.slice.call(forms).forEach(function(form) {
                form.addEventListener('submit', function(event) {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        });

        // Durum önizlemesini güncelle
        function updateStatusPreview(status) {
            const preview = document.getElementById('previewBadge');
            const previewContainer = document.getElementById('statusPreview');

            let badgeClass = 'bg-secondary';
            let badgeText = 'Durum seçiniz';

            switch(status) {
                case 'Pending':
                    badgeClass = 'bg-warning';
                    badgeText = 'Beklemede';
                    break;
                case 'Processing':
                    badgeClass = 'bg-primary';
                    badgeText = 'İşleniyor';
                    break;
                case 'Shipped':
                    badgeClass = 'bg-info';
                    badgeText = 'Kargolandı';
                    break;
                case 'Delivered':
                    badgeClass = 'bg-success';
                    badgeText = 'Teslim Edildi';
                    break;
                case 'Cancelled':
                    badgeClass = 'bg-danger';
                    badgeText = 'İptal Edildi';
                    break;
            }

            preview.className = `badge ${badgeClass} fs-6 px-4 py-2`;
            preview.textContent = badgeText;
        }

        // Hızlı durum değiştirme
        function setStatus(status) {
            const statusSelect = document.getElementById('Status');
            statusSelect.value = status;
            updateStatusPreview(status);

            // Kullanıcıya bildirim
            showToast(`Durum "${getStatusText(status)}" olarak ayarlandı`, 'info');
        }

        // Durum metnini al
        function getStatusText(status) {
            const statusMap = {
                'Pending': 'Beklemede',
                'Processing': 'İşleniyor',
                'Shipped': 'Kargolandı',
                'Delivered': 'Teslim Edildi',
                'Cancelled': 'İptal Edildi'
            };
            return statusMap[status] || status;
        }

        // Şuanki tarihi ayarla
        function setCurrentDateTime() {
            const now = new Date();
            const localDateTime = now.toISOString().slice(0, 16);
            document.querySelector('input[type="datetime-local"]').value = localDateTime;
            showToast('Şuanki tarih ve saat ayarlandı', 'success');
        }


        // Yazdırma işlemi
        function printOrder() {
            window.print();
        }

        // Form gönderildiğinde yükleme göstergesi
        document.getElementById('orderForm').addEventListener('submit', function(e) {
            const submitBtn = this.querySelector('button[type="submit"]');
            if(submitBtn) {
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Kaydediliyor...';
                submitBtn.disabled = true;
            }
        });

        // Toast mesajı göster
        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type} border-0`;
            toast.setAttribute('role', 'alert');
            toast.setAttribute('aria-live', 'assertive');
            toast.setAttribute('aria-atomic', 'true');

            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">
                        <i class="bi bi-${type === 'success' ? 'check-circle' :
                                          type === 'error' ? 'exclamation-circle' :
                                          type === 'warning' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            `;

            document.body.appendChild(toast);

            // Bootstrap Toast'ı başlat
            if (typeof bootstrap !== 'undefined') {
                const bsToast = new bootstrap.Toast(toast);
                bsToast.show();
            }

            // Toast'ı temizle
            setTimeout(() => {
                if (toast.parentNode) {
                    document.body.removeChild(toast);
                }
            }, 3000);
        }
    </script>
}