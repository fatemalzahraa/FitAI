@model IEnumerable<Eticaret.Core.Entities.Order>

@{
    ViewData["Title"] = "Sipariş Yönetimi";
}

<div class="container-fluid px-4">

    <!-- BAŞLIK -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold text-primary">
                <i class="bi bi-cart-check me-2"></i>Sipariş Yönetimi
            </h1>
            <p class="text-muted">Tüm siparişleri buradan görüntüleyebilirsiniz</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg">
            <i class="bi bi-plus-circle me-2"></i>Yeni Sipariş
        </a>
    </div>

    <!-- TABLO -->
    <div class="card shadow mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="ordersTable">
                    <thead class="table-light">
                        <tr>
                            <th width="60">#</th>
                            <th>Sipariş No</th>
                            <th>Müşteri</th>
                            <th>Sipariş Tarihi</th>
                            <th class="text-end">Toplam Tutar</th>
                            <th class="text-center" width="180">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    Henüz sipariş bulunmamaktadır.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int i = 1;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@i</td>
                                    <td>#@item.Id</td>
                                    <td>@item.User?.Email</td>
                                    <td>@item.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td class="text-end">
                                        
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info">
                                            Detay
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Düzenle
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Bu siparişi silmek istediğinize emin misiniz?')">
                                            Sil
                                        </a>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        body {
            background-color: #f8f9fc;
        }

        .card {
            border-radius: 12px;
            box-shadow: 0 0.15rem 1.75rem rgba(0,0,0,.15);
            transition: .3s;
        }

            .card:hover {
                transform: translateY(-3px);
            }

        .table thead th {
            font-weight: 700;
            background-color: #f8f9fc;
            border-bottom: 2px solid #e3e6f0;
        }

        .table tbody tr:hover {
            background-color: rgba(67,97,238,.05);
        }

        .btn {
            border-radius: 8px;
            font-weight: 600;
        }

        .btn-primary {
            background: linear-gradient(135deg,#4361ee,#3a0ca3);
            border: none;
        }

            .btn-primary:hover {
                box-shadow: 0 4px 15px rgba(67,97,238,.4);
                transform: translateY(-2px);
            }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            console.log("Sipariş index yüklendi");
        });

        function showToast(message) {
            alert(message);
        }
    </script>
}
