@{
    ViewData["Title"] = "Ayarlar";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid py-4">
    <!-- Başlık ve İstatistikler -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="page-header d-flex justify-content-between align-items-center">
                <div>
                    <h1 class="display-6 fw-bold text-gradient text-primary">
                        <i class="fas fa-sliders-h me-3"></i>Ayarlar Paneli
                    </h1>
                    <p class="text-muted mb-0">Sistem ve kullanıcı ayarlarınızı yönetin</p>
                </div>
                <div class="status-badge">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                        <i class="fas fa-circle me-1" style="font-size: 8px;"></i>
                        Tüm sistemler çalışıyor
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sol Sidebar - Modern Menü -->
        <div class="col-lg-3 col-xl-2 mb-4">
            <div class="settings-sidebar card border-0 shadow-lg">
                <div class="card-body p-3">
                    <div class="user-info text-center mb-4 py-3">
                        <div class="avatar-wrapper position-relative mb-3">
                            <div class="avatar-circle-lg bg-gradient-primary shadow">
                                <i class="fas fa-user-cog text-white fa-2x"></i>
                            </div>
                            <button class="btn-avatar-edit btn btn-sm btn-light rounded-circle shadow-sm position-absolute bottom-0 end-0">
                                <i class="fas fa-pen fa-xs"></i>
                            </button>
                        </div>
                        <h6 class="mb-1 fw-bold">@User.Identity?.Name</h6>
                        <small class="text-muted d-block">Süper Admin</small>
                        <div class="mt-2">
                            <span class="badge bg-primary bg-opacity-10 text-primary">Premium</span>
                        </div>
                    </div>

                    <nav class="nav flex-column settings-nav">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tab-profile">
                            <div class="nav-icon">
                                <i class="fas fa-user-circle"></i>
                            </div>
                            <span>Profil</span>
                            <i class="fas fa-chevron-right nav-arrow"></i>
                        </a>
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-security">
                            <div class="nav-icon">
                                <i class="fas fa-shield-alt"></i>
                            </div>
                            <span>Güvenlik</span>
                            <i class="fas fa-chevron-right nav-arrow"></i>
                        </a>
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-notifications">
                            <div class="nav-icon">
                                <i class="fas fa-bell"></i>
                            </div>
                            <span>Bildirimler</span>
                            <i class="fas fa-chevron-right nav-arrow"></i>
                        </a>
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-appearance">
                            <div class="nav-icon">
                                <i class="fas fa-palette"></i>
                            </div>
                            <span>Görünüm</span>
                            <i class="fas fa-chevron-right nav-arrow"></i>
                        </a>
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-system">
                            <div class="nav-icon">
                                <i class="fas fa-server"></i>
                            </div>
                            <span>Sistem</span>
                            <i class="fas fa-chevron-right nav-arrow"></i>
                        </a>
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-backup">
                            <div class="nav-icon">
                                <i class="fas fa-database"></i>
                            </div>
                            <span>Yedekleme</span>
                            <i class="fas fa-chevron-right nav-arrow"></i>
                        </a>
                        <a class="nav-link" data-bs-toggle="tab" href="#tab-api">
                            <div class="nav-icon">
                                <i class="fas fa-code"></i>
                            </div>
                            <span>API</span>
                            <i class="fas fa-chevron-right nav-arrow"></i>
                        </a>
                    </nav>

                    <div class="mt-4 pt-3 border-top">
                        <div class="d-grid">
                            <button class="btn btn-outline-primary btn-sm" onclick="exportSettings()">
                                <i class="fas fa-download me-2"></i>Ayarları Dışa Aktar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ İçerik - Modern Tablar -->
        <div class="col-lg-9 col-xl-10">
            <div class="tab-content">
                <!-- PROFİL TAB -->
                <div class="tab-pane fade show active" id="tab-profile">
                    <div class="card border-0 shadow-lg mb-4">
                        <div class="card-header bg-transparent border-0 pt-4 pb-3">
                            <h3 class="card-title fw-bold text-gradient text-primary">
                                <i class="fas fa-user-circle me-2"></i>Profil Bilgileri
                            </h3>
                            <p class="text-muted mb-0">Kişisel bilgilerinizi güncelleyin</p>
                        </div>
                        <div class="card-body pt-0">
                            <form class="profile-form">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group floating-label">
                                            <input type="text" class="form-control" id="firstName" value="Admin" required>
                                            <label for="firstName">Ad</label>
                                            <div class="form-icon">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group floating-label">
                                            <input type="text" class="form-control" id="lastName" value="User" required>
                                            <label for="lastName">Soyad</label>
                                            <div class="form-icon">
                                                <i class="fas fa-user"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group floating-label mt-3">
                                    <input type="email" class="form-control" id="email" value="admin@eticaret.com" required>
                                    <label for="email">Email Adresi</label>
                                    <div class="form-icon">
                                        <i class="fas fa-envelope"></i>
                                    </div>
                                </div>

                                <div class="form-group floating-label mt-3">
                                    <input type="tel" class="form-control" id="phone" value="+90 555 123 4567">
                                    <label for="phone">Telefon Numarası</label>
                                    <div class="form-icon">
                                        <i class="fas fa-phone"></i>
                                    </div>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-md-6">
                                        <div class="form-group floating-label">
                                            <select class="form-select" id="timezone">
                                                <option>UTC +03:00 (İstanbul)</option>
                                                <option>UTC +01:00 (Londra)</option>
                                                <option>UTC -05:00 (New York)</option>
                                            </select>
                                            <label for="timezone">Zaman Dilimi</label>
                                            <div class="form-icon">
                                                <i class="fas fa-globe"></i>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group floating-label">
                                            <select class="form-select" id="language">
                                                <option selected>Türkçe</option>
                                                <option>English</option>
                                                <option>Deutsch</option>
                                            </select>
                                            <label for="language">Dil</label>
                                            <div class="form-icon">
                                                <i class="fas fa-language"></i>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-end mt-5">
                                    <button type="button" class="btn btn-light me-3">İptal</button>
                                    <button type="submit" class="btn btn-primary px-4">
                                        <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- GÜVENLİK TAB -->
                <div class="tab-pane fade" id="tab-security">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-lg mb-4">
                                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                                    <h3 class="card-title fw-bold text-gradient text-warning">
                                        <i class="fas fa-shield-alt me-2"></i>Hesap Güvenliği
                                    </h3>
                                    <p class="text-muted mb-0">Hesabınızı güvende tutun</p>
                                </div>
                                <div class="card-body pt-0">
                                    <form class="security-form">
                                        <div class="form-group floating-label">
                                            <input type="password" class="form-control" id="currentPass" required>
                                            <label for="currentPass">Mevcut Şifre</label>
                                            <div class="form-icon">
                                                <i class="fas fa-lock"></i>
                                            </div>
                                        </div>

                                        <div class="row mt-4">
                                            <div class="col-md-6">
                                                <div class="form-group floating-label">
                                                    <input type="password" class="form-control" id="newPass" required>
                                                    <label for="newPass">Yeni Şifre</label>
                                                    <div class="form-icon">
                                                        <i class="fas fa-key"></i>
                                                    </div>
                                                </div>
                                                <div class="password-strength mt-3">
                                                    <div class="d-flex justify-content-between mb-1">
                                                        <small>Şifre Gücü</small>
                                                        <small class="text-danger fw-bold" id="strengthText">Zayıf</small>
                                                    </div>
                                                    <div class="progress" style="height: 6px;">
                                                        <div class="progress-bar bg-danger" id="strengthBar" style="width: 25%"></div>
                                                    </div>
                                                    <div class="password-rules mt-2">
                                                        <small class="text-muted d-block">
                                                            <i class="fas fa-check-circle text-success me-1"></i>
                                                            En az 8 karakter
                                                        </small>
                                                        <small class="text-muted d-block">
                                                            <i class="fas fa-times-circle text-danger me-1"></i>
                                                            Büyük/küçük harf
                                                        </small>
                                                        <small class="text-muted d-block">
                                                            <i class="fas fa-times-circle text-danger me-1"></i>
                                                            Rakam içermeli
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group floating-label">
                                                    <input type="password" class="form-control" id="confirmPass" required>
                                                    <label for="confirmPass">Yeni Şifre (Tekrar)</label>
                                                    <div class="form-icon">
                                                        <i class="fas fa-key"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="d-flex justify-content-end mt-5">
                                            <button type="submit" class="btn btn-warning px-4">
                                                <i class="fas fa-key me-2"></i>Şifreyi Güncelle
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <!-- İki Faktörlü Kimlik Doğrulama -->
                            <div class="card border-0 shadow-lg mb-4">
                                <div class="card-body">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3">
                                            <i class="fas fa-mobile-alt fa-lg"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">İki Faktörlü Doğrulama</h6>
                                            <small class="text-muted">Ek güvenlik katmanı</small>
                                        </div>
                                    </div>
                                    <div class="form-check form-switch form-switch-lg">
                                        <input class="form-check-input" type="checkbox" id="2faSwitch">
                                        <label class="form-check-label" for="2faSwitch"></label>
                                    </div>
                                    <div id="2faSettings" class="mt-3" style="display: none;">
                                        <div class="qr-code-placeholder bg-light rounded p-4 text-center mb-3">
                                            <i class="fas fa-qrcode fa-3x text-muted mb-2"></i>
                                            <p class="small mb-0">Google Authenticator ile tarayın</p>
                                        </div>
                                        <input type="text" class="form-control form-control-sm" placeholder="6 haneli kodu girin">
                                    </div>
                                </div>
                            </div>

                            <!-- Oturum Yönetimi -->
                            <div class="card border-0 shadow-lg">
                                <div class="card-body">
                                    <h6 class="fw-bold mb-3">
                                        <i class="fas fa-desktop me-2"></i>Aktif Oturumlar
                                    </h6>
                                    <div class="session-item d-flex align-items-center mb-3 p-2 rounded bg-light">
                                        <div class="session-icon me-3">
                                            <i class="fas fa-desktop text-primary fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">Windows 10 - Chrome</div>
                                            <small class="text-success">Şu anda aktif</small>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-sign-out-alt"></i>
                                        </button>
                                    </div>
                                    <div class="session-item d-flex align-items-center p-2 rounded bg-light">
                                        <div class="session-icon me-3">
                                            <i class="fas fa-mobile-alt text-info fa-lg"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-semibold">iPhone 13 - Safari</div>
                                            <small class="text-muted">2 saat önce</small>
                                        </div>
                                        <button class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-sign-out-alt"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BİLDİRİMLER TAB -->
                <div class="tab-pane fade" id="tab-notifications">
                    <div class="card border-0 shadow-lg">
                        <div class="card-header bg-transparent border-0 pt-4 pb-3">
                            <h3 class="card-title fw-bold text-gradient text-info">
                                <i class="fas fa-bell me-2"></i>Bildirim Tercihleri
                            </h3>
                            <p class="text-muted mb-0">Hangi bildirimleri almak istediğinizi seçin</p>
                        </div>
                        <div class="card-body pt-0">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="notification-category mb-4">
                                        <h6 class="fw-bold mb-3 text-primary">
                                            <i class="fas fa-envelope me-2"></i>Email Bildirimleri
                                        </h6>
                                        <div class="form-check card-check mb-3">
                                            <input class="form-check-input" type="checkbox" id="notif1" checked>
                                            <label class="form-check-label" for="notif1">
                                                <span class="fw-semibold">Yeni Siparişler</span>
                                                <small class="text-muted d-block">Müşterilerden gelen yeni siparişler</small>
                                            </label>
                                        </div>
                                        <div class="form-check card-check mb-3">
                                            <input class="form-check-input" type="checkbox" id="notif2" checked>
                                            <label class="form-check-label" for="notif2">
                                                <span class="fw-semibold">Yeni Kullanıcılar</span>
                                                <small class="text-muted d-block">Sisteme kayıt olan yeni kullanıcılar</small>
                                            </label>
                                        </div>
                                        <div class="form-check card-check">
                                            <input class="form-check-input" type="checkbox" id="notif3">
                                            <label class="form-check-label" for="notif3">
                                                <span class="fw-semibold">Sistem Güncellemeleri</span>
                                                <small class="text-muted d-block">Yeni özellikler ve güncellemeler</small>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="notification-category">
                                        <h6 class="fw-bold mb-3 text-warning">
                                            <i class="fas fa-bell me-2"></i>Push Bildirimleri
                                        </h6>
                                        <div class="alert alert-warning alert-micro">
                                            <i class="fas fa-exclamation-circle me-1"></i>
                                            Tarayıcı bildirimleri için izin gereklidir
                                        </div>
                                        <div class="form-check card-check mb-3">
                                            <input class="form-check-input" type="checkbox" id="notif4" checked>
                                            <label class="form-check-label" for="notif4">
                                                <span class="fw-semibold">Anlık Sipariş Bildirimleri</span>
                                            </label>
                                        </div>
                                        <div class="form-check card-check">
                                            <input class="form-check-input" type="checkbox" id="notif5">
                                            <label class="form-check-label" for="notif5">
                                                <span class="fw-semibold">Kritik Sistem Uyarıları</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <div class="form-group floating-label">
                                        <input type="time" class="form-control" value="09:00">
                                        <label>Bildirim Başlangıç Saati</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group floating-label">
                                        <input type="time" class="form-control" value="18:00">
                                        <label>Bildirim Bitiş Saati</label>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-5">
                                <button type="button" class="btn btn-info px-4" onclick="saveNotifications()">
                                    <i class="fas fa-save me-2"></i>Bildirim Ayarlarını Kaydet
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- GÖRÜNÜM TAB -->
                <div class="tab-pane fade" id="tab-appearance">
                    <div class="card border-0 shadow-lg">
                        <div class="card-header bg-transparent border-0 pt-4 pb-3">
                            <h3 class="card-title fw-bold text-gradient text-success">
                                <i class="fas fa-palette me-2"></i>Tema ve Görünüm
                            </h3>
                            <p class="text-muted mb-0">Panelinizin görünümünü kişiselleştirin</p>
                        </div>
                        <div class="card-body pt-0">
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="theme-option text-center mb-4">
                                        <div class="theme-preview mb-3 rounded overflow-hidden shadow-sm border">
                                            <div class="theme-header bg-primary p-2"></div>
                                            <div class="theme-content bg-white p-3">
                                                <div class="bg-light rounded mb-2" style="height: 10px;"></div>
                                                <div class="bg-light rounded mb-2" style="height: 10px; width: 80%;"></div>
                                                <div class="bg-light rounded" style="height: 10px; width: 60%;"></div>
                                            </div>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="theme" id="theme1" checked>
                                            <label class="form-check-label fw-semibold" for="theme1">
                                                Açık Tema
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="theme-option text-center mb-4">
                                        <div class="theme-preview mb-3 rounded overflow-hidden shadow-sm border">
                                            <div class="theme-header bg-dark p-2"></div>
                                            <div class="theme-content bg-gray-900 p-3">
                                                <div class="bg-gray-700 rounded mb-2" style="height: 10px;"></div>
                                                <div class="bg-gray-700 rounded mb-2" style="height: 10px; width: 80%;"></div>
                                                <div class="bg-gray-700 rounded" style="height: 10px; width: 60%;"></div>
                                            </div>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="theme" id="theme2">
                                            <label class="form-check-label fw-semibold" for="theme2">
                                                Koyu Tema
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="theme-option text-center mb-4">
                                        <div class="theme-preview mb-3 rounded overflow-hidden shadow-sm border">
                                            <div class="theme-header bg-gradient-primary p-2"></div>
                                            <div class="theme-content bg-white p-3">
                                                <div class="bg-light rounded mb-2" style="height: 10px;"></div>
                                                <div class="bg-light rounded mb-2" style="height: 10px; width: 80%;"></div>
                                                <div class="bg-light rounded" style="height: 10px; width: 60%;"></div>
                                            </div>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="theme" id="theme3">
                                            <label class="form-check-label fw-semibold" for="theme3">
                                                Gradient Tema
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <div class="form-group floating-label">
                                        <select class="form-select" id="sidebarStyle">
                                            <option value="default">Standart Sidebar</option>
                                            <option value="compact">Compact Sidebar</option>
                                            <option value="hidden">Gizli Sidebar</option>
                                        </select>
                                        <label for="sidebarStyle">Sidebar Stili</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group floating-label">
                                        <select class="form-select" id="navbarColor">
                                            <option value="light">Açık Navbar</option>
                                            <option value="dark" selected>Koyu Navbar</option>
                                            <option value="primary">Renkli Navbar</option>
                                        </select>
                                        <label for="navbarColor">Navbar Rengi</label>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-5">
                                <button type="button" class="btn btn-success px-4" onclick="applyTheme()">
                                    <i class="fas fa-check me-2"></i>Temayı Uygula
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- SİSTEM TAB -->
                <div class="tab-pane fade" id="tab-system">
                    <div class="row">
                        <div class="col-lg-8">
                            <div class="card border-0 shadow-lg mb-4">
                                <div class="card-header bg-transparent border-0 pt-4 pb-3">
                                    <h3 class="card-title fw-bold text-gradient text-dark">
                                        <i class="fas fa-server me-2"></i>Sistem Ayarları
                                    </h3>
                                    <p class="text-muted mb-0">Sistem genel ayarları</p>
                                </div>
                                <div class="card-body pt-0">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group floating-label">
                                                <input type="text" class="form-control" value="Avcı Fidancılık">
                                                <label>Site Başlığı</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group floating-label">
                                                <input type="text" class="form-control" value="Fidancılık ve Peyzaj">
                                                <label>Site Sloganı</label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group floating-label mt-3">
                                        <textarea class="form-control" rows="3">Fidancılık ve peyzaj hizmetleri sunan profesyonel firma</textarea>
                                        <label>Site Açıklaması</label>
                                    </div>

                                    <div class="system-toggle mt-4 p-4 rounded bg-light">
                                        <div class="d-flex justify-content-between align-items-center mb-3">
                                            <div>
