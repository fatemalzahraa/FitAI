<script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Premium Ayarlar Paneli yüklendi');

        // Sidebar nav aktif class
        const navLinks = document.querySelectorAll('.settings-nav .nav-link');
        navLinks.forEach(link => {
            link.addEventListener('click', function() {
                navLinks.forEach(l => l.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // Bakım modu toggle
        document.getElementById('maintenanceSwitch').addEventListener('change', function() {
            document.getElementById('maintenanceOptions').style.display =
                this.checked ? 'block' : 'none';
        });

        // 2FA toggle
        document.getElementById('2faSwitch').addEventListener('change', function() {
            document.getElementById('2faSettings').style.display =
                this.checked ? 'block' : 'none';
        });

        // Şifre gücü kontrolü
        document.getElementById('newPass')?.addEventListener('input', function() {
            updatePasswordStrength(this.value);
        });

        // Form submit
        document.querySelector('.profile-form')?.addEventListener('submit', function(e) {
            e.preventDefault();
            showNotification('Profil başarıyla güncellendi!', 'success');
        });

        document.querySelector('.security-form')?.addEventListener('submit', function(e) {
            e.preventDefault();
            const newPass = document.getElementById('newPass').value;
            const confirmPass = document.getElementById('confirmPass').value;

            if (newPass !== confirmPass) {
                showNotification('Şifreler uyuşmuyor!', 'error');
                return;
            }

            showNotification('Şifre başarıyla güncellendi!', 'success');
        });

        // Avatar düzenleme
        document.querySelector('.btn-avatar-edit').addEventListener('click', function() {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.onchange = function(e) {
                if (e.target.files[0]) {
                    showNotification('Profil fotoğrafı güncelleniyor...', 'info');
                    // Burada fotoğraf yükleme işlemi yapılabilir
                }
            };
            input.click();
        });
    });

    function updatePasswordStrength(password) {
        let score = 0;
        const rules = document.querySelectorAll('.password-rules small');

        // Uzunluk kontrolü
        if (password.length >= 8) {
            score++;
            rules[0].querySelector('i').className = 'fas fa-check-circle text-success me-1';
        } else {
            rules[0].querySelector('i').className = 'fas fa-times-circle text-danger me-1';
        }

        // Büyük/küçük harf kontrolü
        if (/[A-Z]/.test(password) && /[a-z]/.test(password)) {
            score++;
            rules[1].querySelector('i').className = 'fas fa-check-circle text-success me-1';
        } else {
            rules[1].querySelector('i').className = 'fas fa-times-circle text-danger me-1';
        }

        // Rakam kontrolü
        if (/[0-9]/.test(password)) {
            score++;
            rules[2].querySelector('i').className = 'fas fa-check-circle text-success me-1';
        } else {
            rules[2].querySelector('i').className = 'fas fa-times-circle text-danger me-1';
        }

        // Özel karakter kontrolü
        if (/[^A-Za-z0-9]/.test(password)) score++;

        const levels = [
            { text: 'Çok Zayıf', color: 'danger', width: 25 },
            { text: 'Zayıf', color: 'warning', width: 40 },
            { text: 'Orta', color: 'info', width: 60 },
            { text: 'Güçlü', color: 'primary', width: 80 },
            { text: 'Çok Güçlü', color: 'success', width: 100 }
        ];

        const level = levels[Math.min(score, levels.length - 1)];

        document.getElementById('strengthText').textContent = level.text;
        document.getElementById('strengthText').className = `fw-bold text-${level.color}`;
        document.getElementById('strengthBar').className = `progress-bar bg-${level.color}`;
        document.getElementById('strengthBar').style.width = `${level.width}%`;
    }

    function showNotification(message, type = 'info') {
        const notification = document.createElement('div');
        notification.className = `notification notification-${type}`;
        notification.innerHTML = `
            <div class="notification-content">
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'} me-2"></i>
                ${message}
            </div>
            <button class="notification-close">
                <i class="fas fa-times"></i>
            </button>
        `;

        document.body.appendChild(notification);

        // Animasyonla göster
        setTimeout(() => notification.classList.add('show'), 10);

        // Kapat butonu
        notification.querySelector('.notification-close').addEventListener('click', () => {
            notification.classList.remove('show');
            setTimeout(() => notification.remove(), 300);
        });

        // Otomatik kapatma
        setTimeout(() => {
            if (notification.parentNode) {
                notification.classList.remove('show');
                setTimeout(() => notification.remove(), 300);
            }
        }, 4000);
    }

    function applyTheme() {
        showNotification('Tema başarıyla uygulandı!', 'success');
    }

    function saveNotifications() {
        showNotification('Bildirim ayarları kaydedildi', 'info');
    }

    function createBackup() {
        showNotification('Yedekleme başlatıldı...', 'info');
    }

    function clearCache() {
        if (confirm('Tüm önbellek temizlenecek. Emin misiniz?')) {
            showNotification('Önbellek temizleniyor...', 'warning');
        }
    }

    function copyApiKey() {
        navigator.clipboard.writeText('sk_live_51HbMo2K3...');
        showNotification('API anahtarı kopyalandı!', 'success');
    }

    function generateApiKey() {
        if (confirm('Yeni API anahtarı oluşturulsun mu? Eski anahtar geçersiz olacak.')) {
            showNotification('Yeni API anahtarı oluşturuluyor...', 'info');
        }
    }

    function exportSettings() {
        showNotification('Ayarlar dışa aktarılıyor...', 'info');
    }
</script>

