@model Eticaret.Core.Entities.ProductImage

@{
    ViewData["Title"] = "Resim Düzenle";
    
    var allProductImages = ViewBag.AllProductImages as IEnumerable<Eticaret.Core.Entities.ProductImage> ?? new List<Eticaret.Core.Entities.ProductImage>();
    var currentImage = Model;
    var productName = currentImage.Product?.Name ?? "Bilinmeyen Ürün";
    var productId = currentImage.ProductId;
    var isMain = currentImage.IsMain;
    var imageCount = allProductImages.Count();
    var existingImageUrl = currentImage.ImageUrl;
}

<div class="container-fluid py-4">
    <div class="row">
        <!-- Sol Kolon: Düzenleme Formu ve Ana Önizleme -->
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-warning text-dark py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-edit me-2"></i>@ViewData["Title"]
                            <span class="badge bg-light text-dark ms-2">ID: #@currentImage.Id</span>
                        </h4>
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@currentImage.Id" class="btn btn-info btn-sm">
                                <i class="fas fa-eye me-1"></i>Detaylar
                            </a>
                            <a asp-action="Delete" asp-route-id="@currentImage.Id" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash me-1"></i>Sil
                            </a>
                            <a asp-action="ProductImages" asp-route-productId="@productId" class="btn btn-light btn-sm">
                                <i class="fas fa-arrow-left me-1"></i>Geri Dön
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Ürün Bilgisi -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="alert alert-primary">
                                <div class="d-flex align-items-center">
                                    <div class="alert-icon me-3">
                                        <i class="fas fa-shopping-bag fa-2x"></i>
                                    </div>
                                    <div>
                                        <h5 class="alert-heading mb-2">Ürün: @productName</h5>
                                        <p class="mb-0">
                                            <i class="fas fa-hashtag me-1"></i>Ürün ID: <strong>#@productId</strong> | 
                                            <i class="fas fa-images me-1 ms-2"></i>Toplam Resim: <strong>@imageCount</strong>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Edit" method="post" enctype="multipart/form-data" id="editForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" asp-for="ImageUrl" /> <!-- Mevcut URL'yi hidden olarak tut -->

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h5 class="alert-heading">
                                    <i class="fas fa-exclamation-triangle me-2"></i>Lütfen aşağıdaki hataları düzeltin:
                                </h5>
                                <div asp-validation-summary="All" class="mb-0"></div>
                            </div>
                        }

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show">
                                <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show">
                                <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }

                        <!-- Mevcut Resim Önizleme -->
                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="card border">
                                    <div class="card-header bg-light d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0">
                                            <i class="fas fa-image me-2"></i>Mevcut Resim
                                            @if (isMain)
                                            {
                                                <span class="badge bg-warning text-dark ms-2">
                                                    <i class="fas fa-crown me-1"></i>Ana Resim
                                                </span>
                                            }
                                        </h5>
                                        <div>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="copyToClipboard('@existingImageUrl')">
                                                <i class="fas fa-copy me-1"></i>URL'yi Kopyala
                                            </button>
                                        </div>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-3 mb-md-0">
                                                <div class="current-image-container rounded-3 overflow-hidden border p-3 text-center"
                                                     style="background: linear-gradient(135deg, #f8f9fa, #e9ecef); min-height: 250px;">
                                                    @if (!string.IsNullOrEmpty(existingImageUrl))
                                                    {
                                                        <img src="@Url.Content(existingImageUrl)" 
                                                             class="img-fluid rounded-2" 
                                                             alt="Mevcut resim"
                                                             id="currentImagePreview"
                                                             style="max-height: 220px; object-fit: contain;"
                                                             onerror="this.onerror=null;this.src='/img/no-image.png';">
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex flex-column justify-content-center align-items-center h-100">
                                                            <i class="fas fa-image fa-4x text-muted mb-3"></i>
                                                            <p class="text-muted mb-0">Resim bulunamadı</p>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="current-image-info">
                                                    <div class="mb-3">
                                                        <label class="form-label fw-bold">
                                                            <i class="fas fa-link me-2"></i>Mevcut Resim URL'si:
                                                        </label>
                                                        <div class="input-group">
                                                            <input type="text" 
                                                                   class="form-control form-control-sm" 
                                                                   value="@existingImageUrl" 
                                                                   readonly
                                                                   id="currentImageUrl">
                                                            <button type="button" 
                                                                    class="btn btn-outline-secondary btn-sm"
                                                                    onclick="copyToClipboard('@existingImageUrl')">
                                                                <i class="fas fa-copy"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                    <div class="alert alert-info">
                                                        <h6 class="alert-heading">
                                                            <i class="fas fa-info-circle me-2"></i>Bilgi:
                                                        </h6>
                                                        <p class="mb-0 small">
                                                            Mevcut resmi değiştirmek istiyorsanız aşağıdaki "Resim Değiştir" 
                                                            bölümünü kullanın.
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Düzenleme Alanı -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="card border mb-4 h-100">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0">
                                            <i class="fas fa-sync-alt me-2"></i>Resim Değiştirme
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <!-- URL tab'ini kaldırdık, sadece dosya yükleme var -->
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">
                                                <i class="fas fa-file-upload me-2"></i>Yeni Resim Dosyası
                                                <span class="text-muted small">(Opsiyonel)</span>
                                            </label>
                                            <input type="file" class="form-control" id="imageFile" 
                                                   name="imageFile" accept="image/*">
                                            <small class="text-muted">
                                                JPG, PNG, GIF veya WebP formatında, maksimum 5MB. 
                                                <strong>Boş bırakırsanız mevcut resim korunur.</strong>
                                            </small>
                                            <div class="mt-2" id="newFilePreview" style="display: none;">
                                                <div class="border rounded p-2 mt-2 text-center">
                                                    <img id="newFileImage" class="img-fluid rounded" 
                                                         style="max-height: 100px;">
                                                    <div class="mt-2">
                                                        <small id="newFileName" class="text-muted"></small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="alert alert-warning mt-3">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            <strong>Not:</strong> Yeni resim yüklerseniz mevcut resim sunucudan silinebilir.
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card border mb-4 h-100">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0">
                                            <i class="fas fa-cog me-2"></i>Resim Ayarları
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="form-group mb-4">
                                            <div class="d-flex align-items-center justify-content-between mb-3">
                                                <div>
                                                    <h6 class="mb-1 fw-bold">
                                                        <i class="fas fa-star me-2"></i>Ana Resim Ayarları
                                                    </h6>
                                                    <p class="mb-0 text-muted small">
                                                        Bu resmi ürünün ana görseli olarak ayarla
                                                    </p>
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" role="switch"
                                                           id="isMainSwitch" asp-for="IsMain" 
                                                           style="width: 48px; height: 24px;">
                                                    <label class="form-check-label fw-bold" for="isMainSwitch">
                                                        @(isMain ? "Aktif" : "Pasif")
                                                    </label>
                                                </div>
                                            </div>

                                            @if (isMain)
                                            {
                                                <div class="alert alert-warning">
                                                    <i class="fas fa-crown me-2"></i>
                                                    Bu resim şu anda <strong>ana resim</strong> olarak ayarlı.
                                                    Ana resim durumunu değiştirirseniz, diğer resimlerden biri 
                                                    otomatik olarak ana resim yapılacak.
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="alert alert-info">
                                                    <i class="fas fa-info-circle me-2"></i>
                                                    Bu resmi ana resim yapmak için yukarıdaki anahtarı aktif edin.
                                                </div>
                                            }
                                        </div>

                                        <div class="card border-info">
                                            <div class="card-header bg-info bg-opacity-10">
                                                <h6 class="mb-0">
                                                    <i class="fas fa-list-check me-2"></i>Değişiklik Özeti
                                                </h6>
                                            </div>
                                            <div class="card-body">
                                                <ul class="list-group list-group-flush" id="changesList">
                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                        <span>Resim dosyası</span>
                                                        <span class="badge bg-secondary">Değişmedi</span>
                                                    </li>
                                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                                        <span>Ana resim durumu</span>
                                                        <span class="badge @(isMain ? "bg-warning" : "bg-secondary")">
                                                            @(isMain ? "Ana Resim" : "Normal")
                                                        </span>
                                                    </li>
                                                </ul>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Form Butonları -->
                        <div class="row">
                            <div class="col-12">
                                <div class="card border">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <a asp-action="ProductImages" asp-route-productId="@productId" class="btn btn-outline-secondary">
                                                    <i class="fas fa-times me-2"></i>İptal
                                                </a>
                                            </div>
                                            <div class="d-flex gap-3">
                                                <a asp-action="Details" asp-route-id="@currentImage.Id" 
                                                   class="btn btn-info px-4">
                                                    <i class="fas fa-eye me-2"></i>Önizle
                                                </a>
                                                <button type="submit" class="btn btn-warning px-4" id="submitBtn">
                                                    <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon: Ürünün Diğer Resimleri -->
        <div class="col-lg-4">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-images me-2"></i>Ürünün Diğer Resimleri
                        <span class="badge bg-light text-primary ms-2">@(imageCount - 1)</span>
                    </h5>
                </div>
                <div class="card-body p-3">
                    @if (imageCount <= 1)
                    {
                        <div class="text-center py-4">
                            <i class="fas fa-image fa-3x text-muted mb-3"></i>
                            <h6 class="text-muted mb-2">Başka resim bulunmuyor</h6>
                            <a asp-action="CreateForProduct" asp-route-productId="@productId" 
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-plus me-1"></i>Yeni Resim Ekle
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="row g-2" id="otherImagesGrid">
                            @foreach (var image in allProductImages.Where(x => x.Id != currentImage.Id)
                                       .OrderByDescending(x => x.IsMain).ThenBy(x => x.Id))
                            {
                                <div class="col-6 col-md-4 col-lg-6">
                                    <div class="card image-thumb-card border bg-light mb-2 position-relative" 
                                         onclick="location.href='@Url.Action("Edit", new { id = image.Id })'"
                                         style="cursor: pointer; transition: all 0.3s;">
                                        <div class="card-body p-2 text-center">
                                            <div class="image-thumb-container mb-2 rounded overflow-hidden" 
                                                 style="height: 100px; background: #f8f9fa;">
                                                @if (!string.IsNullOrEmpty(image.ImageUrl))
                                                {
                                                    <img src="@Url.Content(image.ImageUrl)" 
                                                         class="img-fluid h-100 w-100" 
                                                         style="object-fit: cover;"
                                                         alt="Resim thumbnail"
                                                         onerror="this.onerror=null;this.src='/img/no-image.png';">
                                                }
                                                else
                                                {
                                                    <div class="h-100 d-flex align-items-center justify-content-center">
                                                        <i class="fas fa-image fa-2x text-muted"></i>
                                                    </div>
                                                }
                                            </div>
                                            
                                            <div class="image-info">
                                                <small class="d-block">
                                                    #@image.Id
                                                    @if (image.IsMain)
                                                    {
                                                        <span class="badge bg-warning text-dark ms-1">
                                                            <i class="fas fa-crown"></i>
                                                        </span>
                                                    }
                                                </small>
                                            </div>
                                        </div>
                                        
                                        <div class="card-hover-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-primary bg-opacity-75 opacity-0 transition-all">
                                            <div class="text-white">
                                                <i class="fas fa-edit fa-lg mb-2"></i>
                                                <p class="mb-0 small">Düzenle</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-grid gap-2">
                                <a asp-action="CreateForProduct" asp-route-productId="@productId" 
                                   class="btn btn-primary btn-sm">
                                    <i class="fas fa-plus me-1"></i>Bu Ürüne Yeni Resim Ekle
                                </a>
                                <a asp-action="ProductImages" asp-route-productId="@productId" 
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-list me-1"></i>Tüm Resimleri Görüntüle
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Ana Resim İstatistikleri -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="fas fa-chart-bar me-2"></i>Resim İstatistikleri
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <div class="stat-item p-2">
                                <div class="stat-number fw-bold fs-4 text-primary">@imageCount</div>
                                <div class="stat-label text-muted small">Toplam Resim</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="stat-item p-2">
                                <div class="stat-number fw-bold fs-4 @(isMain ? "text-warning" : "text-secondary")">
                                    @allProductImages.Count(x => x.IsMain)
                                </div>
                                <div class="stat-label text-muted small">Ana Resim</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-3">
                        <div class="progress" style="height: 8px;">
                            @{
                                var mainImagePercentage = imageCount > 0 ? (allProductImages.Count(x => x.IsMain) * 100 / imageCount) : 0;
                            }
                            <div class="progress-bar bg-warning" style="width: @mainImagePercentage%"></div>
                        </div>
                        <small class="text-muted d-block mt-1 text-center">
                            Ana resim oranı: %@mainImagePercentage
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const imageFile = document.getElementById('imageFile');
            const newFilePreview = document.getElementById('newFilePreview');
            const newFileImage = document.getElementById('newFileImage');
            const newFileName = document.getElementById('newFileName');
            const isMainSwitch = document.getElementById('isMainSwitch');
            const editForm = document.getElementById('editForm');
            const submitBtn = document.getElementById('submitBtn');
            const changesList = document.getElementById('changesList');
            const currentImageUrl = document.getElementById('currentImageUrl');
            
            let hasChanges = false;
            let originalIsMain = @isMain.ToString().ToLower();

            imageFile.addEventListener('change', function(e) {
                if (this.files && this.files[0]) {
                    const file = this.files[0];
                    
                    if (file.size > 5 * 1024 * 1024) {
                        alert('Dosya boyutu maksimum 5MB olmalıdır!');
                        this.value = '';
                        return;
                    }
                    
                    if (!file.type.startsWith('image/')) {
                        alert('Lütfen geçerli bir resim dosyası seçin!');
                        this.value = '';
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = function(e) {
                        newFileImage.src = e.target.result;
                        newFileName.textContent = file.name + ' (' + formatFileSize(file.size) + ')';
                        newFilePreview.style.display = 'block';
                        
                        markAsChanged('image');
                    };
                    reader.readAsDataURL(file);
                }
            });

            isMainSwitch.addEventListener('change', function() {
                const isMainChanged = (this.checked !== originalIsMain);
                if (isMainChanged) {
                    markAsChanged('main');
                }
            });

            editForm.addEventListener('submit', function(e) {
                if (imageFile.files.length > 0) {
                    const file = imageFile.files[0];
                    if (file.size > 5 * 1024 * 1024) {
                        e.preventDefault();
                        alert('Dosya boyutu maksimum 5MB olmalıdır!');
                        return;
                    }
                }

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...';
                
                return true;
            });

            function formatFileSize(bytes) {
                if (bytes === 0) return '0 Bytes';
                const k = 1024;
                const sizes = ['Bytes', 'KB', 'MB', 'GB'];
                const i = Math.floor(Math.log(bytes) / Math.log(k));
                return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
            }

            function markAsChanged(type) {
                hasChanges = true;
                
                const items = changesList.querySelectorAll('.list-group-item');
                
                if (type === 'image') {
                    items[0].querySelector('.badge').className = 'badge bg-success';
                    items[0].querySelector('.badge').textContent = 'Değişecek';
                }
                
                if (type === 'main') {
                    items[1].querySelector('.badge').className = isMainSwitch.checked ? 'badge bg-warning' : 'badge bg-secondary';
                    items[1].querySelector('.badge').textContent = isMainSwitch.checked ? 'Ana Resim' : 'Normal';
                }
            }

            window.copyToClipboard = function(text) {
                navigator.clipboard.writeText(text).then(() => {
                    const originalValue = currentImageUrl.value;
                    currentImageUrl.value = '✓ Kopyalandı!';
                    currentImageUrl.classList.add('is-valid');
                    
                    setTimeout(() => {
                        currentImageUrl.value = originalValue;
                        currentImageUrl.classList.remove('is-valid');
                    }, 2000);
                }).catch(err => {
                    console.error('Kopyalama hatası:', err);
                    alert('Kopyalama başarısız!');
                });
            };

            const thumbCards = document.querySelectorAll('.image-thumb-card');
            thumbCards.forEach(card => {
                const overlay = card.querySelector('.card-hover-overlay');
                
                card.addEventListener('mouseenter', function() {
                    if (overlay) overlay.style.opacity = '1';
                    this.style.transform = 'translateY(-5px)';
                    this.style.boxShadow = '0 5px 15px rgba(0,0,0,0.1)';
                });
                
                card.addEventListener('mouseleave', function() {
                    if (overlay) overlay.style.opacity = '0';
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = 'none';
                });
            });
        });
    </script>

    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }

        .card {
            border-radius: 15px;
            overflow: hidden;
            border: none;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
            transition: all 0.3s ease;
        }

        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
        }

        .btn {
            border-radius: 10px;
            padding: 10px 20px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-warning:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(255, 193, 7, 0.3);
        }

        .nav-tabs .nav-link.active {
            border-color: #dee2e6 #dee2e6 #fff;
            color: #007bff;
            font-weight: 600;
            border-bottom: 3px solid #007bff;
        }

        .image-thumb-card:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15) !important;
        }

        @@media (max-width: 768px) {
            .card-body {
                padding: 1.25rem !important;
            }
        }
    </style>
}