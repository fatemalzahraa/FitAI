@model Eticaret.Core.Entities.ProductImage

@{
    ViewData["Title"] = "Resim Detayları";

    var allProductImages = ViewBag.AllProductImages as IEnumerable<Eticaret.Core.Entities.ProductImage> ?? new List<Eticaret.Core.Entities.ProductImage>();
    var currentImage = Model;
    var productName = currentImage.Product?.Name ?? "Bilinmeyen Ürün";
    var productId = currentImage.ProductId;
    var isMain = currentImage.IsMain;
    var imageCount = allProductImages.Count();
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <!-- Header -->
                <div class="card-header @(isMain ? "bg-warning text-dark" : "bg-primary text-white") py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h4 class="mb-0">
                                <i class="fas fa-info-circle me-2"></i>@ViewData["Title"]
                                <span class="badge bg-light @(isMain ? "text-dark" : "text-primary") ms-2">
                                    ID: #@currentImage.Id
                                </span>
                                @if (isMain)
                                {
                                    <span class="badge bg-light text-dark ms-1">
                                        <i class="fas fa-crown me-1"></i>Ana Resim
                                    </span>
                                }
                            </h4>
                            <p class="mb-0 mt-2 small">
                                <i class="fas fa-shopping-bag me-1"></i>Ürün: @productName
                            </p>
                        </div>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@currentImage.Id" class="btn btn-light btn-sm">
                                <i class="fas fa-edit me-1"></i>Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@currentImage.Id" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash me-1"></i>Sil
                            </a>
                            <a asp-action="ProductImages" asp-route-productId="@productId" class="btn btn-light btn-sm">
                                <i class="fas fa-arrow-left me-1"></i>Geri Dön
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <!-- Resim ve Bilgiler -->
                    <div class="row">
                        <!-- Resim -->
                        <div class="col-lg-6 mb-4">
                            <div class="card border h-100">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="fas fa-image me-2"></i>Resim
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="image-preview-container rounded-3 border p-3 text-center"
                                         style="background: linear-gradient(135deg, #f8f9fa, #e9ecef); min-height: 300px;">
                                        @if (!string.IsNullOrEmpty(currentImage.ImageUrl))
                                        {
                                            <img src="@Url.Content(currentImage.ImageUrl)"
                                                 class="img-fluid rounded-2"
                                                 alt="Ürün resmi"
                                                 style="max-height: 250px; object-fit: contain;"
                                                 onerror="this.onerror=null;this.src='/img/no-image.png';">
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column justify-content-center align-items-center h-100">
                                                <i class="fas fa-image fa-4x text-muted mb-3"></i>
                                                <p class="text-muted mb-0">Resim bulunamadı</p>
                                            </div>
                                        }
                                    </div>

                                    <div class="mt-3">
                                        <label class="form-label fw-bold">
                                            <i class="fas fa-link me-2"></i>Resim URL'si:
                                        </label>
                                        <div class="input-group">
                                            <input type="text"
                                                   class="form-control"
                                                   value="@currentImage.ImageUrl"
                                                   readonly>
                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    onclick="copyToClipboard('@currentImage.ImageUrl')">
                                                <i class="fas fa-copy me-1"></i>Kopyala
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Bilgiler -->
                        <div class="col-lg-6 mb-4">
                            <div class="card border h-100">
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">
                                        <i class="fas fa-info-circle me-2"></i>Resim Bilgileri
                                    </h5>
                                </div>
                                <div class="card-body">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="info-card bg-light p-3 rounded-3">
                                                <small class="text-muted d-block mb-1">
                                                    <i class="fas fa-hashtag me-1"></i>Resim ID
                                                </small>
                                                <span class="fw-bold fs-5">#@currentImage.Id</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-card bg-light p-3 rounded-3">
                                                <small class="text-muted d-block mb-1">
                                                    <i class="fas fa-shopping-bag me-1"></i>Ürün ID
                                                </small>
                                                <span class="fw-bold fs-5">#@productId</span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-card bg-light p-3 rounded-3">
                                                <small class="text-muted d-block mb-1">
                                                    <i class="fas fa-star me-1"></i>Durum
                                                </small>
                                                <span class="fw-bold">
                                                    @if (isMain)
                                                    {
                                                        <span class="badge bg-warning text-dark">
                                                            <i class="fas fa-crown me-1"></i>Ana Resim
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">
                                                            <i class="fas fa-image me-1"></i>Normal Resim
                                                        </span>
                                                    }
                                                </span>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-card bg-light p-3 rounded-3">
                                                <small class="text-muted d-block mb-1">
                                                    <i class="fas fa-images me-1"></i>Sıra
                                                </small>
                                                <span class="fw-bold fs-5">
                                                    @@(allProductImages.FindIndex(x => x.Id == currentImage.Id) + 1)/@imageCount
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <hr class="my-4">

                                    <div class="mb-4">
                                        <h6 class="fw-bold mb-3">
                                            <i class="fas fa-exchange-alt me-2"></i>Hızlı İşlemler
                                        </h6>
                                        <div class="d-grid gap-2">
                                            @if (!isMain)
                                            {
                                                <form asp-action="SetAsMain" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@currentImage.Id" />
                                                    <button type="submit" class="btn btn-warning w-100">
                                                        <i class="fas fa-crown me-2"></i>Ana Resim Yap
                                                    </button>
                                                </form>
                                            }

                                            <a href="@Url.Content(currentImage.ImageUrl)"
                                               target="_blank"
                                               class="btn btn-info">
                                                <i class="fas fa-external-link-alt me-2"></i>Resmi Yeni Sekmede Aç
                                            </a>

                                            <button type="button"
                                                    class="btn btn-outline-secondary"
                                                    onclick="copyToClipboard('@currentImage.ImageUrl')">
                                                <i class="fas fa-copy me-2"></i>Resim URL'sini Kopyala
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Diğer Resimler -->
                    @if (imageCount > 1)
                    {
                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="card border">
                                    <div class="card-header bg-light">
                                        <h5 class="mb-0">
                                            <i class="fas fa-images me-2"></i>Bu Ürünün Diğer Resimleri
                                            <span class="badge bg-primary ms-2">@(imageCount - 1)</span>
                                        </h5>
                                    </div>
                                    <div class="card-body">
                                        <div class="row g-3">
                                            @foreach (var image in allProductImages.Where(x => x.Id != currentImage.Id)
                                                                                    .OrderByDescending(x => x.IsMain).ThenBy(x => x.Id))
                                            {
                                                <div class="col-6 col-md-4 col-lg-3">
                                                    <div class="card border bg-light h-100"
                                                         onclick="location.href='@Url.Action("Details", new { id = image.Id })'"
                                                         style="cursor: pointer; transition: all 0.3s;">
                                                        <div class="card-body p-3 text-center">
                                                            <div class="image-thumb-container mb-3 rounded overflow-hidden"
                                                                 style="height: 120px; background: #f8f9fa;">
                                                                @if (!string.IsNullOrEmpty(image.ImageUrl))
                                                                {
                                                                    <img src="@Url.Content(image.ImageUrl)"
                                                                         class="img-fluid h-100 w-100"
                                                                         style="object-fit: cover;"
                                                                         alt="Resim"
                                                                         onerror="this.onerror=null;this.src='/img/no-image.png';">
                                                                }
                                                                else
                                                                {
                                                                    <div class="h-100 d-flex align-items-center justify-content-center">
                                                                        <i class="fas fa-image fa-2x text-muted"></i>
                                                                    </div>
                                                                }
                                                            </div>

                                                            <div class="image-info">
                                                                <small class="d-block fw-bold">
                                                                    #@image.Id
                                                                    @if (image.IsMain)
                                                                    {
                                                                        <span class="badge bg-warning text-dark ms-1">
                                                                            <i class="fas fa-crown"></i>
                                                                        </span>
                                                                    }
                                                                </small>
                                                                <small class="text-muted">
                                                                    <i class="fas fa-chevron-right me-1"></i>Detaylar
                                                                </small>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                alert('URL panoya kopyalandı!');
            }).catch(err => {
                console.error('Kopyalama hatası:', err);
                alert('Kopyalama başarısız!');
            });
        }

        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.card[onclick]');
            cards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-5px)';
                    this.style.boxShadow = '0 5px 15px rgba(0,0,0,0.1)';
                });

                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0)';
                    this.style.boxShadow = 'none';
                });
            });
        });
    </script>

    <style>
        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        }

        .card {
            border-radius: 15px;
            border: none;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .btn {
            border-radius: 10px;
        }

        .info-card {
            transition: all 0.3s ease;
        }

            .info-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }
    </style>
}