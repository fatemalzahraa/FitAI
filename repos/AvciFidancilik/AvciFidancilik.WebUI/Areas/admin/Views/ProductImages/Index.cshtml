@model IEnumerable<ProductImage>

@{
    ViewData["Title"] = "Ürün Görselleri";
    var productId = ViewBag.ProductId;
    var productName = ViewBag.ProductName;
    var hasProduct = productId != null;
    var productImages = Model.ToList();
}

<div class="container-fluid">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Anasayfa</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Products" asp-action="Index">Ürünler</a></li>
            @if (hasProduct)
            {
                <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@productId">@productName</a></li>
                <li class="breadcrumb-item active">Resim Galerisi</li>
            }
            else
            {
                <li class="breadcrumb-item active">Tüm Resimler</li>
            }
        </ol>
    </nav>

    <!-- Başlık ve İstatistik -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2">
                <i class="fas fa-images text-primary me-2"></i>@ViewData["Title"]
            </h1>
            @if (hasProduct)
            {
                <p class="text-muted mb-0">
                    <i class="fas fa-cube me-1"></i>@productName
                    <span class="badge bg-secondary ms-2">#@productId</span>
                </p>
            }
        </div>
        <div class="d-flex gap-2">
            @if (hasProduct)
            {
                <a asp-area="Admin" asp-controller="Products" asp-action="Details" asp-route-id="@productId" 
                   class="btn btn-outline-info">
                    <i class="fas fa-info-circle me-2"></i>Ürün Detayları
                </a>
                <a asp-action="CreateForProduct" asp-route-productId="@productId" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Resim Ekle
                </a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Ürünlere Dön
                </a>
            }
            else
            {
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus me-2"></i>Yeni Resim Ekle
                </a>
                <a asp-area="Admin" asp-controller="Products" asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Ürünlere Dön
                </a>
            }
        </div>
    </div>

    <!-- İstatistik Kartları -->
    @if (Model.Any())
    {
        <div class="row mb-4">
            <div class="col-md-3 col-6">
                <div class="card border-0 bg-primary bg-opacity-10">
                    <div class="card-body text-center">
                        <div class="text-primary mb-2">
                            <i class="fas fa-images fa-2x"></i>
                        </div>
                        <h3 class="mb-1">@Model.Count()</h3>
                        <p class="text-muted mb-0">Toplam Resim</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 bg-warning bg-opacity-10">
                    <div class="card-body text-center">
                        <div class="text-warning mb-2">
                            <i class="fas fa-star fa-2x"></i>
                        </div>
                        <h3 class="mb-1">@Model.Count(x => x.IsMain)</h3>
                        <p class="text-muted mb-0">Ana Resim</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 bg-success bg-opacity-10">
                    <div class="card-body text-center">
                        <div class="text-success mb-2">
                            <i class="fas fa-box fa-2x"></i>
                        </div>
                        <h3 class="mb-1">@Model.Select(x => x.ProductId).Distinct().Count()</h3>
                        <p class="text-muted mb-0">Ürün Sayısı</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="card border-0 bg-info bg-opacity-10">
                    <div class="card-body text-center">
                        <div class="text-info mb-2">
                            <i class="fas fa-percentage fa-2x"></i>
                        </div>
                        <h3 class="mb-1">@(Model.Count() > 0 ? Math.Round((double)Model.Count(x => x.IsMain) / Model.Count() * 100, 1) : 0)%</h3>
                        <p class="text-muted mb-0">Ana Resim Oranı</p>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Bildirimler -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-image fa-4x text-muted mb-4"></i>
                <h4 class="text-muted mb-3">Henüz görsel bulunmuyor</h4>
                <p class="text-muted mb-4">İlk görseli ekleyerek başlayabilirsiniz</p>
                @if (hasProduct)
                {
                    <a asp-action="CreateForProduct" asp-route-productId="@productId" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Resim Ekle
                    </a>
                }
                else
                {
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Resim Ekle
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <!-- Ana Galeri Bölümü -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-th me-2"></i>
                        @if (hasProduct)
                        {
                            <span>@productName - Ürün Görselleri</span>
                        }
                        else
                        {
                            <span>Tüm Ürün Görselleri</span>
                        }
                    </h5>
                    <div class="d-flex gap-2">
                        @if (hasProduct && productImages.Count > 1)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" id="prevGalleryBtn">
                                <i class="fas fa-chevron-left me-1"></i>Önceki
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="nextGalleryBtn">
                                Sonraki<i class="fas fa-chevron-right ms-1"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-primary" onclick="openFullscreenGallery()">
                                <i class="fas fa-expand me-1"></i>Tam Ekran
                            </button>
                        }
                    </div>
                </div>
            </div>
            
            <div class="card-body p-4">
                @if (hasProduct)
                {
                    <!-- Ürüne Özel Kaydırmalı Galeri -->
                    <div class="product-gallery-container">
                        <div class="row g-3" id="galleryRow">
                            @foreach (var item in productImages.OrderByDescending(x => x.IsMain).ThenByDescending(x => x.Id))
                            {
                                <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6 gallery-item" data-image-id="@item.Id">
                                    <div class="card h-100 border-0 shadow-sm gallery-card">
                                        <!-- Resim -->
                                        <div class="position-relative">
                                            <img src="@item.ImageUrl" 
                                                 class="card-img-top gallery-image" 
                                                 style="height: 180px; object-fit: cover; cursor: pointer;"
                                                 alt="@item.Product?.Name - Resim @item.Id"
                                                 onerror="this.src='/img/no-image.png';"
                                                 data-bs-toggle="modal" 
                                                 data-bs-target="#imageModal"
                                                 data-image-url="@item.ImageUrl"
                                                 data-image-id="@item.Id"
                                                 data-product-name="@item.Product?.Name">
                                            
                                            <!-- Ana Resim İkonu -->
                                            @if (item.IsMain)
                                            {
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge bg-warning text-dark px-2 py-1">
                                                        <i class="fas fa-crown me-1"></i>Ana
                                                    </span>
                                                </div>
                                            }
                                            
                                            <!-- Hızlı İşlemler -->
                                            <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-gradient-to-top">
                                                <div class="d-flex justify-content-center gap-1">
                                                    <a asp-action="Details" asp-route-id="@item.Id" 
                                                       class="btn btn-sm btn-light rounded-circle" title="Detay">
                                                        <i class="fas fa-eye fa-xs"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.Id" 
                                                       class="btn btn-sm btn-light rounded-circle" title="Düzenle">
                                                        <i class="fas fa-edit fa-xs"></i>
                                                    </a>
                                                    @if (!item.IsMain)
                                                    {
                                                        <button onclick="setAsMain(@item.Id)" 
                                                                class="btn btn-sm btn-light rounded-circle" title="Ana Resim Yap">
                                                            <i class="fas fa-star fa-xs text-warning"></i>
                                                        </button>
                                                    }
                                                    <a asp-action="Delete" asp-route-id="@item.Id" 
                                                       class="btn btn-sm btn-light rounded-circle" title="Sil">
                                                        <i class="fas fa-trash-alt fa-xs text-danger"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Resim Bilgileri -->
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start mb-1">
                                                <span class="badge bg-primary">#@item.Id</span>
                                                <small class="text-muted">
                                                    @if (item.IsMain)
                                                    {
                                                        <i class="fas fa-star text-warning"></i>
                                                    }
                                                </small>
                                            </div>
                                            
                                            <!-- URL Kısa Bilgi -->
                                            <p class="small text-muted mb-2 text-truncate" title="@item.ImageUrl">
                                                <i class="fas fa-link me-1"></i>
                                                @if (item.ImageUrl.Length > 25)
                                                {
                                                    @item.ImageUrl.Substring(0, 25)@:...
                                                }
                                                else
                                                {
                                                    @item.ImageUrl
                                                }
                                            </p>
                                            
                                            <!-- Detay Butonu -->
                                            <a asp-action="Details" asp-route-id="@item.Id" 
                                               class="btn btn-outline-primary btn-sm w-100">
                                                <i class="fas fa-info-circle me-1"></i>Detaylar
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    
                    <!-- Galeri Navigasyon İndikatörleri -->
                    @if (productImages.Count > 6)
                    {
                        <div class="d-flex justify-content-center mt-4">
                            <div class="gallery-indicators d-flex gap-2" id="galleryIndicators">
                                <!-- JavaScript ile dinamik olarak eklenecek -->
                            </div>
                        </div>
                    }
                }
                else
                {
                    <!-- Tüm Ürünler İçin Grid Görünüm -->
                    <div class="row">
                        @foreach (var item in Model.OrderByDescending(x => x.IsMain).ThenByDescending(x => x.Id))
                        {
                            <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                                <div class="card h-100 border-0 shadow-sm">
                                    <!-- Resim -->
                                    <div class="position-relative">
                                        <img src="@item.ImageUrl" 
                                             class="card-img-top" 
                                             style="height: 200px; object-fit: cover;"
                                             alt="@item.Product?.Name - Resim @item.Id"
                                             onerror="this.src='/img/no-image.png';"
                                             data-bs-toggle="modal" 
                                             data-bs-target="#imageModal"
                                             data-image-url="@item.ImageUrl"
                                             data-image-id="@item.Id"
                                             data-product-name="@item.Product?.Name">
                                        
                                        <!-- Ana Resim İkonu -->
                                        @if (item.IsMain)
                                        {
                                            <div class="position-absolute top-0 end-0 m-2">
                                                <span class="badge bg-warning text-dark px-3 py-2">
                                                    <i class="fas fa-crown me-1"></i>Ana Resim
                                                </span>
                                            </div>
                                        }
                                        
                                        <!-- Ürün Adı -->
                                        @if (item.Product != null)
                                        {
                                            <div class="position-absolute bottom-0 start-0 w-100 p-2 bg-dark bg-opacity-75 text-white">
                                                <small class="d-block text-truncate">
                                                    <i class="fas fa-cube me-1"></i>@item.Product.Name
                                                </small>
                                            </div>
                                        }
                                    </div>
                                    
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                            <span class="badge bg-primary">#@item.Id</span>
                                            <div>
                                                <a asp-area="Admin" asp-controller="Products" asp-action="Details" 
                                                   asp-route-id="@item.ProductId" 
                                                   class="btn btn-sm btn-outline-info">
                                                    <i class="fas fa-external-link-alt"></i>
                                                </a>
                                            </div>
                                        </div>
                                        
                                        <!-- İşlem Butonları -->
                                        <div class="d-grid gap-2">
                                            <div class="btn-group w-100" role="group">
                                                <a asp-action="Details" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-primary btn-sm">
                                                    <i class="fas fa-info-circle me-1"></i>Detay
                                                </a>
                                                @if (!item.IsMain)
                                                {
                                                    <button onclick="setAsMain(@item.Id)" 
                                                            class="btn btn-outline-warning btn-sm"
                                                            title="Ana Resim Yap">
                                                        <i class="fas fa-star me-1"></i>Ana Yap
                                                    </button>
                                                }
                                                <a asp-action="Edit" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-secondary btn-sm">
                                                    <i class="fas fa-edit me-1"></i>Düzenle
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                                   class="btn btn-outline-danger btn-sm">
                                                    <i class="fas fa-trash-alt me-1"></i>Sil
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- Sayfa Alt Bilgisi -->
    @if (Model.Any())
    {
        <div class="row mt-4">
            <div class="col-12">
                <div class="card border-0 bg-light">
                    <div class="card-body">
                        <div class="row align-items-center">
                            <div class="col-md-6">
                                <p class="mb-0 text-muted">
                                    <i class="fas fa-info-circle me-2"></i>
                                    @if (hasProduct)
                                    {
                                        <span>Bu ürüne ait <span class="fw-bold">@productImages.Count</span> resim bulunuyor.</span>
                                    }
                                    else
                                    {
                                        <span>Toplam <span class="fw-bold">@Model.Count()</span> resim listeleniyor.</span>
                                    }
                                </p>
                            </div>
                            <div class="col-md-6 text-end">
                                @if (hasProduct)
                                {
                                    <a asp-action="CreateForProduct" asp-route-productId="@productId" 
                                       class="btn btn-primary">
                                        <i class="fas fa-plus me-2"></i>Yeni Resim Ekle
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Create" class="btn btn-primary">
                                        <i class="fas fa-plus me-2"></i>Yeni Resim Ekle
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Büyük Resim Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="fas fa-expand me-2"></i>Resim Önizleme
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div class="text-center p-4 bg-dark">
                    <img id="modalImage" src="" class="img-fluid rounded" style="max-height: 70vh; object-fit: contain;">
                </div>
            </div>
            <div class="modal-footer bg-dark">
                <button type="button" class="btn btn-light" onclick="downloadModalImage()">
                    <i class="fas fa-download me-2"></i>İndir
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Kapat
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tam Ekran Galeri Modal -->
<div class="modal fade" id="fullscreenGalleryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-fullscreen">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white">
                    <i class="fas fa-images me-2"></i>@productName - Tam Ekran Galeri
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="fullscreenCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner" id="fullscreenCarouselItems">
                        @if (hasProduct)
                        {
                            var index = 0;
                            foreach (var item in productImages.OrderByDescending(x => x.IsMain).ThenByDescending(x => x.Id))
                            {
                                <div class="carousel-item @(index == 0 ? "active" : "")">
                                    <div class="d-flex justify-content-center align-items-center h-100">
                                        <div class="text-center p-4">
                                            <img src="@item.ImageUrl" 
                                                 class="img-fluid" 
                                                 style="max-height: 80vh; object-fit: contain;"
                                                 alt="@productName - Resim @item.Id"
                                                 onerror="this.src='/img/no-image.png';">
                                            <div class="mt-4 text-white">
                                                <h5>Resim #@item.Id</h5>
                                                @if (item.IsMain)
                                                {
                                                    <span class="badge bg-warning text-dark px-3 py-2">
                                                        <i class="fas fa-crown me-1"></i>Ana Resim
                                                    </span>
                                                }
                                                <p class="mt-2 text-muted">@item.ImageUrl</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                index++;
                            }
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#fullscreenCarousel" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Önceki</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#fullscreenCarousel" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Sonraki</span>
                    </button>
                </div>
            </div>
            <div class="modal-footer border-0">
                <div class="d-flex justify-content-between w-100">
                    <div>
                        <span class="text-white me-3" id="currentImageCount">1 / @productImages.Count</span>
                        <button class="btn btn-outline-light" onclick="downloadCurrentImage()">
                            <i class="fas fa-download me-2"></i>İndir
                        </button>
                    </div>
                    <div>
                        <button class="btn btn-outline-light me-2" data-bs-dismiss="modal">
                            <i class="fas fa-times me-2"></i>Kapat
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Resim Modal
            const imageModal = document.getElementById('imageModal');
            const modalImage = document.getElementById('modalImage');
            
            if (imageModal) {
                imageModal.addEventListener('show.bs.modal', function(event) {
                    const button = event.relatedTarget;
                    const imageUrl = button.getAttribute('data-image-url');
                    modalImage.src = imageUrl;
                });
            }

            // Kaydırmalı Galeri Navigasyonu
            if (@hasProduct.ToString().ToLower() && @productImages.Count > 6) {
                initGalleryNavigation();
            }

            // Resim hover efekti
            const galleryCards = document.querySelectorAll('.gallery-card');
            galleryCards.forEach(card => {
                card.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-8px) scale(1.02)';
                    this.style.boxShadow = '0 15px 30px rgba(0, 0, 0, 0.15)';
                    this.style.zIndex = '10';
                });
                
                card.addEventListener('mouseleave', function() {
                    this.style.transform = 'translateY(0) scale(1)';
                    this.style.boxShadow = '';
                    this.style.zIndex = '1';
                });
            });

            // Tam ekran galeri için event listener
            const fullscreenCarousel = document.getElementById('fullscreenCarousel');
            if (fullscreenCarousel) {
                fullscreenCarousel.addEventListener('slid.bs.carousel', function(event) {
                    const activeIndex = event.to;
                    document.getElementById('currentImageCount').textContent = 
                        `${activeIndex + 1} / @productImages.Count`;
                });
            }
        });

        // Galeri Navigasyonu Başlatma
        function initGalleryNavigation() {
            const galleryRow = document.getElementById('galleryRow');
            const items = galleryRow.querySelectorAll('.gallery-item');
            const itemsPerPage = 6;
            const totalPages = Math.ceil(items.length / itemsPerPage);
            let currentPage = 0;
            
            // İndikatörleri oluştur
            const indicators = document.getElementById('galleryIndicators');
            if (indicators) {
                indicators.innerHTML = '';
                for (let i = 0; i < totalPages; i++) {
                    const indicator = document.createElement('button');
                    indicator.className = `btn btn-sm ${i === 0 ? 'btn-primary' : 'btn-outline-primary'} rounded-circle`;
                    indicator.style.width = '10px';
                    indicator.style.height = '10px';
                    indicator.style.padding = '0';
                    indicator.onclick = () => goToPage(i);
                    indicators.appendChild(indicator);
                }
            }
            
            // Sayfa gösterimi
            function showPage(page) {
                const start = page * itemsPerPage;
                const end = start + itemsPerPage;
                
                items.forEach((item, index) => {
                    if (index >= start && index < end) {
                        item.style.display = 'block';
                        item.style.animation = 'fadeIn 0.5s ease';
                    } else {
                        item.style.display = 'none';
                    }
                });
                
                // İndikatörleri güncelle
                if (indicators) {
                    indicators.querySelectorAll('button').forEach((btn, i) => {
                        btn.className = `btn btn-sm ${i === page ? 'btn-primary' : 'btn-outline-primary'} rounded-circle`;
                        btn.style.width = '10px';
                        btn.style.height = '10px';
                        btn.style.padding = '0';
                    });
                }
                
                currentPage = page;
            }
            
            // Sayfa değiştirme
            function goToPage(page) {
                if (page >= 0 && page < totalPages) {
                    showPage(page);
                }
            }
            
            // Navigasyon butonları
            document.getElementById('prevGalleryBtn').onclick = () => {
                goToPage(currentPage - 1);
            };
            
            document.getElementById('nextGalleryBtn').onclick = () => {
                goToPage(currentPage + 1);
            };
            
            // İlk sayfayı göster
            showPage(0);
        }

        // Tam ekran galeri açma
        function openFullscreenGallery() {
            const modal = new bootstrap.Modal(document.getElementById('fullscreenGalleryModal'));
            modal.show();
        }

        // Mevcut resmi indirme
        function downloadCurrentImage() {
            const activeItem = document.querySelector('#fullscreenCarousel .carousel-item.active img');
            if (activeItem) {
                const imageUrl = activeItem.src;
                const link = document.createElement('a');
                link.href = imageUrl;
                link.download = `urun-resmi-${Date.now()}.jpg`;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                showToast('Resim indiriliyor...', 'info');
            }
        }

        // Ana resim yapma fonksiyonu
        function setAsMain(imageId) {
            if (confirm('Bu resmi ana resim yapmak istediğinize emin misiniz?')) {
                $.ajax({
                    url: '@Url.Action("SetAsMain", "ProductImages")',
                    type: 'POST',
                    data: { id: imageId },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            showToast('Resim başarıyla ana resim yapıldı!', 'success');
                            setTimeout(() => {
                                location.reload();
                            }, 1500);
                        } else {
                            showToast(response.message || 'Bir hata oluştu!', 'error');
                        }
                    },
                    error: function() {
                        showToast('İşlem sırasında bir hata oluştu!', 'error');
                    }
                });
            }
        }

        // Modal resmini indirme
        function downloadModalImage() {
            const imageUrl = document.getElementById('modalImage').src;
            const link = document.createElement('a');
            link.href = imageUrl;
            link.download = 'urun-resmi.jpg';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            showToast('Resim indiriliyor...', 'info');
        }

        // Toast bildirimi
        function showToast(message, type) {
            const toast = document.createElement('div');
            toast.className = `position-fixed top-0 end-0 m-3 p-3 rounded shadow-lg text-white ${type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-info'}`;
            toast.style.zIndex = '9999';
            toast.innerHTML = `
                <div class="d-flex align-items-center">
                    <i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-exclamation-circle' : 'fa-info-circle'} me-2"></i>
                    <span>${message}</span>
                </div>
            `;
            document.body.appendChild(toast);
            
            setTimeout(() => {
                toast.remove();
            }, 3000);
        }
    </script>

    <style>
        body {
            background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            min-height: 100vh;
        }

        .breadcrumb {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 1rem;
        }

        .product-gallery-container {
            overflow: hidden;
            position: relative;
        }

        .gallery-item {
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .gallery-card {
            border: 1px solid rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            border-radius: 12px;
            overflow: hidden;
        }

        .gallery-card:hover {
            border-color: #4f46e5;
        }

        .gallery-image {
            transition: transform 0.5s ease;
        }

        .gallery-card:hover .gallery-image {
            transform: scale(1.1);
        }

        .bg-gradient-to-top {
            background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
        }

        .carousel-control-prev,
        .carousel-control-next {
            width: 50px;
            height: 50px;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 50%;
            top: 50%;
            transform: translateY(-50%);
            margin: 0 20px;
        }

        .carousel-control-prev:hover,
        .carousel-control-next:hover {
            background: rgba(0, 0, 0, 0.8);
        }

        .gallery-indicators button {
            transition: all 0.3s ease;
        }

        .gallery-indicators button:hover {
            transform: scale(1.2);
        }

        .btn {
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn:hover {
            transform: translateY(-2px);
        }

        .btn-primary {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            border: none;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
        }

        .btn-outline-primary {
            border-color: #4f46e5;
            color: #4f46e5;
        }

        .btn-outline-primary:hover {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            border-color: #4f46e5;
            color: white;
        }

        .badge {
            border-radius: 6px;
            padding: 6px 10px;
            font-weight: 600;
        }

        .text-truncate {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .modal-fullscreen .modal-content {
            border-radius: 0;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @@media (max-width: 768px) {
            .gallery-item {
                flex: 0 0 50%;
                max-width: 50%;
            }
            
            .carousel-control-prev,
            .carousel-control-next {
                width: 40px;
                height: 40px;
                margin: 0 10px;
            }
            
            .modal-dialog {
                margin: 0;
            }
        }

        @@media (max-width: 576px) {
            .gallery-item {
                flex: 0 0 100%;
                max-width: 100%;
            }
            
            .h3 {
                font-size: 1.5rem;
            }
            
            .gallery-image {
                height: 150px !important;
            }
        }

        /* Scrollbar stilleri */
        .product-gallery-container::-webkit-scrollbar {
            height: 6px;
        }

        .product-gallery-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .product-gallery-container::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

        .product-gallery-container::-webkit-scrollbar-thumb:hover {
            background: #a1a1a1;
        }
    </style>
}