@model Eticaret.Core.Entities.OrderItem

@{
    ViewData["Title"] = "Sipariş Kalemi Detayları";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <!-- Başlık Kartı -->
            <div class="card mb-4 shadow-sm border-info">
                <div class="card-header bg-info text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="card-title mb-0">
                                <i class="bi bi-eye-fill me-2"></i>
                                Sipariş Kalemi Detayları
                            </h3>
                            <small class="opacity-75">Kayıt No: @Model.Id</small>
                        </div>
                        <span class="badge bg-light text-info fs-6">
                            <i class="bi bi-calendar-check me-1"></i>
                            @DateTime.Now.ToString("dd.MM.yyyy")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Ana Bilgi Kartları -->
            <div class="row mb-4">
                <!-- Sipariş Bilgileri -->
                <div class="col-md-6 mb-3">
                    <div class="card h-100 border-primary border-2">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-receipt me-2"></i>
                                Sipariş Bilgileri
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-primary bg-opacity-10 p-2 rounded me-3">
                                    <i class="bi bi-hash text-primary fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Sipariş Numarası</small>
                                    <h4 class="mb-0">#@Html.DisplayFor(model => model.Order.Id)</h4>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Sipariş Durumu</label>
                               
                            </div>

                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="bi bi-info-circle me-1"></i>
                                    Bu siparişe ait kalem detaylarını görüntülüyorsunuz.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Ürün Bilgileri -->
                <div class="col-md-6 mb-3">
                    <div class="card h-100 border-success border-2">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-box-seam me-2"></i>
                                Ürün Bilgileri
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="bg-success bg-opacity-10 p-2 rounded me-3">
                                    <i class="bi bi-tag text-success fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Ürün Adı</small>
                                    <h4 class="mb-0">@Html.DisplayFor(model => model.Product.Name)</h4>
                                </div>
                            </div>

                            <div class="row g-2">
                                <div class="col-6">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">Stok Kodu</small>
                                        <strong class="text-primary">@Html.DisplayFor(model => model.Product.Id)</strong>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="border rounded p-2 text-center">
                                        <small class="text-muted d-block">Kategori</small>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="bi bi-card-text me-1"></i>
                                    @{
                                        var description = Model.Product?.Description ?? "Açıklama bulunmuyor";
                                        var shortDescription = description.Length > 100 ? description.Substring(0, 100) + "..." : description;
                                    }
                                    @shortDescription
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detaylı Bilgiler Tablosu -->
            <div class="card mb-4 shadow">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-calculator me-2"></i>
                        Fiyat ve Miktar Detayları
                    </h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th width="25%">Özellik</th>
                                    <th width="35%">Değer</th>
                                    <th width="40%">Hesaplama ve Açıklama</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold">
                                        <i class="bi bi-123 text-primary me-2"></i>
                                        Adet
                                    </td>
                                    <td>
                                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-1">
                                            @Html.DisplayFor(model => model.Quantity) adet
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            Sipariş edilen ürün miktarı. Minimum 1 adet olmalıdır.
                                        </small>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">
                                        <i class="bi bi-currency-dollar text-success me-2"></i>
                                        Birim Fiyat
                                    </td>
                                    <td>
                                        <span class="text-success fw-bold fs-5">
                                            @Html.DisplayFor(model => model.UnitPrice) ₺
                                        </span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            Ürünün birim fiyatı (KDV dahil).
                                        </small>
                                    </td>
                                </tr>
                                <tr class="table-active">
                                    <td class="fw-bold">
                                        <i class="bi bi-cash-stack text-danger me-2"></i>
                                        Toplam Tutar
                                    </td>
                                    <td>
                                        <span class="text-danger fw-bold fs-4">
                                            @(Model.Quantity* Model.UnitPrice) ₺
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <small class="text-muted me-2">
                                                @Model.Quantity × @Model.UnitPrice =
                                            </small>
                                            <span class="badge bg-danger">
                                                @(Model.Quantity* Model.UnitPrice) ₺
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">
                                        <i class="bi bi-percent text-info me-2"></i>
                                        KDV Oranı
                                    </td>
                                    <td>
                                        <span class="badge bg-info">%18</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            Toplam tutar %18 KDV dahil fiyattır.
                                        </small>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Sistem Bilgileri -->
            <div class="card mb-4 border-secondary">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-gear me-2"></i>
                        Sistem Bilgileri
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-2">
                            <div class="border rounded p-3">
                                <i class="bi bi-database text-primary fs-1 mb-2"></i>
                                <h6>Kayıt Durumu</h6>
                                <span class="badge bg-success">Aktif</span>
                            </div>
                        </div>
                        <div class="col-md-3 mb-2">
                            <div class="border rounded p-3">
                                <i class="bi bi-clock-history text-warning fs-1 mb-2"></i>
                                <h6>Son Güncelleme</h6>
                                <small>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                        </div>
                        <div class="col-md-3 mb-2">
                            <div class="border rounded p-3">
                                <i class="bi bi-person-check text-info fs-1 mb-2"></i>
                                <h6>Görüntüleyen</h6>
                                <small>Yönetici</small>
                            </div>
                        </div>
                        <div class="col-md-3 mb-2">
                            <div class="border rounded p-3">
                                <i class="bi bi-shield-check text-success fs-1 mb-2"></i>
                                <h6>Güvenlik</h6>
                                <small>Doğrulandı</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Butonlar -->
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left-circle me-2"></i>
                            Listeye Geri Dön
                        </a>

                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                                <i class="bi bi-pencil-square me-2"></i>
                                Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                                <i class="bi bi-trash me-2"></i>
                                Sil
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-center text-muted small">
                    <i class="bi bi-c-circle"></i> Avcı Fidançılık - Sipariş Yönetim Sistemi
                    <span class="mx-2">•</span>
                    <i class="bi bi-clock"></i> Son Görüntüleme: @DateTime.Now.ToString("HH:mm:ss")
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 10px;
            transition: transform 0.2s;
        }

            .card:hover {
                transform: translateY(-2px);
            }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
        }

        .border-2 {
            border-width: 2px !important;
        }

        .table th {
            background-color: #f8f9fa;
            border-bottom: 2px solid #dee2e6;
        }

        .table td {
            vertical-align: middle;
            padding: 1rem 0.75rem;
        }

        .badge {
            font-size: 0.85em;
        }

        .fs-4 {
            font-size: 1.5rem !important;
        }

        .fs-6 {
            font-size: 1rem !important;
        }

        .text-muted {
            color: #6c757d !important;
        }

        .border {
            border-color: #dee2e6 !important;
        }
    </style>
}