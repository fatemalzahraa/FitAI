@model Eticaret.Core.Entities.OrderItem

@{
    ViewData["Title"] = "Sipariş Kalemi Düzenle";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-lg">
                <!-- Başlık -->
                <div class="card-header bg-warning text-dark">
                    <div class="d-flex justify-content-between align-items-center">
                        <h3 class="card-title mb-0">
                            <i class="bi bi-pencil-square me-2"></i>
                            Sipariş Kalemi Düzenle
                        </h3>
                        <span class="badge bg-dark">
                            <i class="bi bi-tag me-1"></i>
                            Kayıt No: @Model.Id
                        </span>
                    </div>
                </div>

                <!-- Bilgi Mesajı -->
                <div class="card-body">
                    <div class="alert alert-info alert-dismissible fade show mb-4" role="alert">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Bilgi:</strong> Aşağıdaki sipariş kalemi bilgilerini düzenleyebilirsiniz. 
                        Değişiklikler kaydedildiğinde otomatik olarak güncellenecektir.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
                    </div>

                    <!-- Mevcut Değerler Gösterimi -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card border-start border-info border-3">
                                <div class="card-body py-2">
                                    <small class="text-muted">Mevcut Sipariş</small>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-receipt text-info me-2"></i>

                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-start border-success border-3">
                                <div class="card-body py-2">
                                    <small class="text-muted">Mevcut Ürün</small>
                                    <div class="d-flex align-items-center">
                                        <i class="bi bi-box-seam text-success me-2"></i>
                                        <strong>@Model.Product?.Name</strong>
                                        <span class="badge bg-success ms-2">@Model.Product?.Price ₺</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Düzenleme Formu -->
                    <form asp-action="Edit" class="needs-validation" novalidate>
                        <input type="hidden" asp-for="Id" />
                        
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Sipariş Seçimi -->
                        <div class="mb-4">
                            <label asp-for="OrderId" class="form-label fw-bold">
                                <i class="bi bi-receipt me-1"></i>
                                Yeni Sipariş Seçimi
                            </label>
                            <select asp-for="OrderId" class="form-select form-select-lg" asp-items="ViewBag.OrderId">
                                <option value="" disabled>Lütfen yeni bir sipariş seçin...</option>
                            </select>
                            <span asp-validation-for="OrderId" class="text-danger small d-block mt-1"></span>
                            <div class="form-text">
                                <i class="bi bi-lightbulb me-1"></i>
                                Bu sipariş kalemini başka bir siparişe taşımak için seçim yapın.
                            </div>
                        </div>

                        <!-- Ürün Seçimi -->
                        <div class="mb-4">
                            <label asp-for="ProductId" class="form-label fw-bold">
                                <i class="bi bi-box-seam me-1"></i>
                                Yeni Ürün Seçimi
                            </label>
                            <select asp-for="ProductId" class="form-select form-select-lg" asp-items="ViewBag.ProductId">
                                <option value="" disabled>Lütfen yeni bir ürün seçin...</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small d-block mt-1"></span>
                            <div class="form-text">
                                <i class="bi bi-lightbulb me-1"></i>
                                Ürün değişikliği yapmak için seçim yapın.
                            </div>
                        </div>

                        <!-- Adet ve Fiyat Satırı -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Quantity" class="form-label fw-bold">
                                        <i class="bi bi-123 me-1"></i>
                                        Yeni Adet
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <input asp-for="Quantity" class="form-control" min="1" 
                                               placeholder="Örn: 5" id="quantityInput" />
                                        <span class="input-group-text bg-light">adet</span>
                                    </div>
                                    <span asp-validation-for="Quantity" class="text-danger small d-block mt-1"></span>
                                    <div class="form-text">
                                        Mevcut: <span class="badge bg-secondary">@Model.Quantity adet</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="UnitPrice" class="form-label fw-bold">
                                        <i class="bi bi-currency-dollar me-1"></i>
                                        Yeni Birim Fiyat
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <input asp-for="UnitPrice" class="form-control" step="0.01" min="0.01" 
                                               placeholder="Örn: 149.99" id="unitPriceInput" />
                                        <span class="input-group-text bg-light">₺</span>
                                    </div>
                                    <span asp-validation-for="UnitPrice" class="text-danger small d-block mt-1"></span>
                                    <div class="form-text">
                                        Mevcut: <span class="badge bg-secondary">@Model.UnitPrice ₺</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Fiyat Hesaplama Paneli -->
                        <div class="card border-success mb-4">
                            <div class="card-header bg-success bg-opacity-10 border-success">
                                <h5 class="mb-0 text-success">
                                    <i class="bi bi-calculator me-2"></i>
                                    Fiyat Hesaplama
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row text-center">
                                    <div class="col-md-4 mb-2">
                                        <div class="border rounded p-3">
                                            <small class="text-muted d-block">Eski Toplam</small>
                                            <h4 class="text-muted">
                                                @(Model.Quantity * Model.UnitPrice) ₺
                                            </h4>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <div class="border rounded p-3">
                                            <small class="text-muted d-block">Yeni Toplam</small>
                                            <h4 class="text-success" id="newTotalPrice">0.00 ₺</h4>
                                        </div>
                                    </div>
                                    <div class="col-md-4 mb-2">
                                        <div class="border rounded p-3">
                                            <small class="text-muted d-block">Fark</small>
                                            <h4 class="text-info" id="priceDifference">0.00 ₺</h4>
                                        </div>
                                    </div>
                                </div>
                                <div class="text-center mt-2">
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Hesaplama: <span id="calculationFormula">0 × 0 = 0 ₺</span>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Değişiklik Özeti -->
                        <div class="alert alert-warning mb-4">
                            <h6><i class="bi bi-clipboard-check me-2"></i>Değişiklik Özeti</h6>
                            <ul class="mb-0" id="changeSummary">
                                <li>Henüz değişiklik yapılmadı</li>
                            </ul>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-between mt-4">
                            <div>
                                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info me-2">
                                    <i class="bi bi-eye me-2"></i>
                                    Detaylara Dön
                                </a>
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="bi bi-x-circle me-2"></i>
                                    İptal
                                </a>
                            </div>
                            <div>
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="bi bi-check-circle me-2"></i>
                                    Değişiklikleri Kaydet
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <!-- Footer -->
                <div class="card-footer text-center text-muted small">
                    <i class="bi bi-shield-lock me-1"></i>
                    Avcı Fidançılık - Sipariş Kalemi Düzenleme Paneli
                    <span class="mx-2">•</span>
                    Son Güncelleme: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const quantityInput = document.getElementById('quantityInput');
            const unitPriceInput = document.getElementById('unitPriceInput');
            const newTotalPrice = document.getElementById('newTotalPrice');
            const priceDifference = document.getElementById('priceDifference');
            const calculationFormula = document.getElementById('calculationFormula');
            const changeSummary = document.getElementById('changeSummary');
            
            // Mevcut değerleri sakla
            const originalQuantity = @Model.Quantity;
            const originalUnitPrice = @Model.UnitPrice;
            const originalTotal = originalQuantity * originalUnitPrice;

            // Değişiklikleri izle
            function updateCalculations() {
                const newQuantity = parseFloat(quantityInput.value) || originalQuantity;
                const newUnitPrice = parseFloat(unitPriceInput.value) || originalUnitPrice;
                const newTotal = newQuantity * newUnitPrice;
                const difference = newTotal - originalTotal;
                
                // Hesaplamaları güncelle
                newTotalPrice.textContent = newTotal.toFixed(2) + ' ₺';
                priceDifference.textContent = (difference >= 0 ? '+' : '') + difference.toFixed(2) + ' ₺';
                calculationFormula.textContent = `${newQuantity} × ${newUnitPrice.toFixed(2)} = ${newTotal.toFixed(2)} ₺`;
                
                // Fark rengini ayarla
                if (difference > 0) {
                    priceDifference.className = 'text-success';
                } else if (difference < 0) {
                    priceDifference.className = 'text-danger';
                } else {
                    priceDifference.className = 'text-info';
                }
                
                // Değişiklik özetini güncelle
                updateChangeSummary(newQuantity, newUnitPrice);
            }
            
            function updateChangeSummary(newQuantity, newUnitPrice) {
                const changes = [];
                
                if (newQuantity !== originalQuantity) {
                    changes.push(`Adet: ${originalQuantity} → ${newQuantity} (${newQuantity > originalQuantity ? '+' : ''}${newQuantity - originalQuantity})`);
                }
                
                if (newUnitPrice !== originalUnitPrice) {
                    changes.push(`Birim Fiyat: ${originalUnitPrice.toFixed(2)} ₺ → ${newUnitPrice.toFixed(2)} ₺ (${newUnitPrice > originalUnitPrice ? '+' : ''}${(newUnitPrice - originalUnitPrice).toFixed(2)} ₺)`);
                }
                
                if (changes.length === 0) {
                    changeSummary.innerHTML = '<li>Henüz değişiklik yapılmadı</li>';
                } else {
                    changeSummary.innerHTML = changes.map(change => `<li>${change}</li>`).join('');
                }
            }
            
            // Input değişikliklerini dinle
            quantityInput.addEventListener('input', updateCalculations);
            unitPriceInput.addEventListener('input', updateCalculations);
            
            // Sayfa yüklendiğinde bir kere çalıştır
            updateCalculations();
            
            // Form gönderilmeden önce kontrol
            document.querySelector('form').addEventListener('submit', function(e) {
                const newQuantity = parseFloat(quantityInput.value) || 0;
                const newUnitPrice = parseFloat(unitPriceInput.value) || 0;
                
                if (newQuantity < 1) {
                    e.preventDefault();
                    alert('❌ Adet en az 1 olmalıdır!');
                    quantityInput.focus();
                    return false;
                }
                
                if (newUnitPrice < 0.01) {
                    e.preventDefault();
                    alert('❌ Birim fiyat geçerli bir değer olmalıdır!');
                    unitPriceInput.focus();
                    return false;
                }
                
                // Son onay
                if (!confirm('📝 Değişiklikleri kaydetmek istediğinize emin misiniz?')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>

    <style>
        .card {
            border-radius: 12px;
            overflow: hidden;
        }
        .card-header {
            border-bottom: none;
        }
        .form-select-lg {
            padding: 0.75rem 1rem;
            font-size: 1rem;
        }
        .input-group-lg > .form-control {
            padding: 0.75rem 1rem;
        }
        .border-3 {
            border-width: 3px !important;
        }
        .bg-opacity-10 {
            background-color: rgba(var(--bs-success-rgb), 0.1) !important;
        }
        #newTotalPrice, #priceDifference {
            font-weight: 700;
        }
        .alert ul {
            margin-bottom: 0;
            padding-left: 1.5rem;
        }
        .alert li {
            margin-bottom: 0.25rem;
        }
        .btn-lg {
            padding: 0.75rem 2rem;
            font-size: 1.1rem;
        }
        .form-text {
            margin-top: 0.25rem;
        }
    </style>
}