@model Eticaret.Core.Entities.OrderItem

@{
    ViewData["Title"] = "Yeni Sipariş Kalemi Oluştur";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Yeni Sipariş Kalemi Oluştur</h3>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <!-- Sipariş Seçimi -->
                        <div class="mb-3">
                            <label asp-for="OrderId" class="form-label fw-bold">Sipariş</label>
                            <select asp-for="OrderId" class="form-select" asp-items="ViewBag.OrderId">
                                <option value="" selected disabled>Lütfen bir sipariş seçin...</option>
                            </select>
                            <span asp-validation-for="OrderId" class="text-danger small"></span>
                        </div>

                        <!-- Ürün Seçimi -->
                        <div class="mb-3">
                            <label asp-for="ProductId" class="form-label fw-bold">Ürün</label>
                            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId">
                                <option value="" selected disabled>Lütfen bir ürün seçin...</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>

                        <!-- Adet -->
                        <div class="mb-3">
                            <label asp-for="Quantity" class="form-label fw-bold">Adet</label>
                            <input asp-for="Quantity" class="form-control" min="1" placeholder="En az 1 adet giriniz" />
                            <span asp-validation-for="Quantity" class="text-danger small"></span>
                            <div class="form-text">Sipariş edilecek ürün miktarı.</div>
                        </div>

                        <!-- Birim Fiyat -->
                        <div class="mb-3">
                            <label asp-for="UnitPrice" class="form-label fw-bold">Birim Fiyat (₺)</label>
                            <div class="input-group">
                                <input asp-for="UnitPrice" class="form-control" step="0.01" min="0.01" placeholder="Örn: 149.99" />
                                <span class="input-group-text">₺</span>
                            </div>
                            <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                            <div class="form-text">Ürünün birim fiyatını giriniz.</div>
                        </div>

                        <!-- Toplam Fiyat (Otomatik Hesaplanan - Sadece Gösterim) -->
                        <div class="mb-4 p-3 border rounded bg-light">
                            <div class="row">
                                <div class="col">
                                    <label class="form-label fw-bold">Tahmini Toplam Tutar</label>
                                </div>
                                <div class="col text-end">
                                    <span id="totalPriceDisplay" class="fs-5 fw-bold text-success">0.00 ₺</span>
                                </div>
                            </div>
                            <small class="text-muted">(Adet × Birim Fiyat)</small>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle"></i> Kaydet
                            </button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-muted text-center small">
                    Avcı Fidançılık Yönetim Paneli - Sipariş Kalemi Kayıt Formu
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Toplam fiyatı otomatik hesapla ve göster
        document.addEventListener('DOMContentLoaded', function() {
            const quantityInput = document.getElementById('Quantity');
            const unitPriceInput = document.getElementById('UnitPrice');
            const totalDisplay = document.getElementById('totalPriceDisplay');

            function calculateTotal() {
                const quantity = parseFloat(quantityInput.value) || 0;
                const unitPrice = parseFloat(unitPriceInput.value) || 0;
                const total = quantity * unitPrice;
                totalDisplay.textContent = total.toFixed(2) + ' ₺';
            }

            // Her iki alan değiştiğinde toplamı hesapla
            quantityInput.addEventListener('input', calculateTotal);
            unitPriceInput.addEventListener('input', calculateTotal);

            // Sayfa yüklendiğinde bir kere hesapla
            calculateTotal();
        });
    </script>
}