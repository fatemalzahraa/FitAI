@model IEnumerable<Eticaret.Core.Entities.OrderItem>

@{
    ViewData["Title"] = "Sipariş Kalemleri Yönetimi";
    var totalItems = Model?.Count() ?? 0;
    var totalQuantity = Model?.Sum(item => item.Quantity) ?? 0;
    var totalValue = Model?.Sum(item => item.Quantity * item.UnitPrice) ?? 0;
}

<div class="container-fluid mt-4">
    <!-- Başlık ve İstatistikler -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-1">
                                <i class="bi bi-cart-check me-2"></i>
                                Sipariş Kalemleri Yönetimi
                            </h2>
                            <small class="opacity-75">Avcı Fidançılık - Sipariş Yönetim Sistemi</small>
                        </div>
                        <span class="badge bg-light text-primary fs-5">
                            <i class="bi bi-database me-1"></i>
                            @totalItems Kayıt
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <div class="card border-info border-2">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">
                                        <i class="bi bi-list-check"></i> Toplam Kayıt
                                    </h6>
                                    <h2 class="text-info">@totalItems</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card border-success border-2">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">
                                        <i class="bi bi-box-seam"></i> Toplam Adet
                                    </h6>
                                    <h2 class="text-success">@totalQuantity</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card border-warning border-2">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">
                                        <i class="bi bi-currency-dollar"></i> Toplam Değer
                                    </h6>
                                    <h2 class="text-warning">@totalValue.ToString("N2") ₺</h2>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="card border-danger border-2">
                                <div class="card-body">
                                    <h6 class="text-muted mb-2">
                                        <i class="bi bi-calculator"></i> Ortalama
                                    </h6>
                                    <h2 class="text-danger">
                                        @(totalItems > 0 ? (totalValue / totalItems).ToString("N2") : "0.00") ₺
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Eylem Butonları -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <a asp-action="Create" class="btn btn-success btn-lg">
                        <i class="bi bi-plus-circle me-2"></i>
                        Yeni Sipariş Kalemi Ekle
                    </a>
                    <button type="button" class="btn btn-outline-info ms-2" id="refreshBtn">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                <div class="d-flex align-items-center">
                    <div class="input-group" style="width: 300px;">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control" id="searchInput" placeholder="Sipariş kalemi ara...">
                        <button class="btn btn-outline-secondary" type="button" id="clearSearch">
                            <i class="bi bi-x"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Veri Tablosu -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-table me-2"></i>
                            Sipariş Kalemleri Listesi
                        </h5>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="toggleSummary">
                            <label class="form-check-label" for="toggleSummary">
                                Özet Göster
                            </label>
                        </div>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0" id="orderItemsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th width="5%">
                                        <i class="bi bi-hash"></i> ID
                                    </th>
                                    <th width="20%">
                                        <i class="bi bi-receipt"></i> Sipariş Bilgisi
                                    </th>
                                    <th width="25%">
                                        <i class="bi bi-box-seam"></i> Ürün Bilgisi
                                    </th>
                                    <th width="15%" class="text-center">
                                        <i class="bi bi-123"></i> Adet
                                    </th>
                                    <th width="15%" class="text-end">
                                        <i class="bi bi-currency-dollar"></i> Birim Fiyat
                                    </th>
                                    <th width="15%" class="text-end">
                                        <i class="bi bi-calculator"></i> Toplam
                                    </th>
                                    <th width="15%" class="text-center">
                                        <i class="bi bi-gear"></i> İşlemler
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    foreach (var item in Model)
                                    {
                                        var totalPrice = item.Quantity * item.UnitPrice;
                                       
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-5">
                                            <div class="text-muted">
                                                <i class="bi bi-inbox display-1"></i>
                                                <h4 class="mt-3">Henüz sipariş kalemi bulunmuyor</h4>
                                                <p class="mb-0">Yeni bir sipariş kalemi eklemek için "Yeni Sipariş Kalemi Ekle" butonuna tıklayın.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="card-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i>
                            Toplam @totalItems kayıt gösteriliyor
                        </div>
                        <div>
                            <nav aria-label="Sayfalar">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item disabled">
                                        <a class="page-link" href="#" tabindex="-1">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                                    <li class="page-item">
                                        <a class="page-link" href="#">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hızlı Eylemler -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card border-secondary">
                <div class="card-header bg-secondary text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-lightning-charge me-2"></i>
                        Hızlı Eylemler
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3 col-6 mb-2">
                            <a href="#" class="btn btn-outline-primary w-100">
                                <i class="bi bi-printer me-1"></i>
                                Listeyi Yazdır
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-2">
                            <a href="#" class="btn btn-outline-success w-100">
                                <i class="bi bi-file-excel me-1"></i>
                                Excel'e Aktar
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-2">
                            <a href="#" class="btn btn-outline-warning w-100">
                                <i class="bi bi-filter me-1"></i>
                                Filtrele
                            </a>
                        </div>
                        <div class="col-md-3 col-6 mb-2">
                            <a href="#" class="btn btn-outline-info w-100">
                                <i class="bi bi-graph-up me-1"></i>
                                Rapor Al
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Arama fonksiyonu
            const searchInput = document.getElementById('searchInput');
            const clearSearch = document.getElementById('clearSearch');
            const tableRows = document.querySelectorAll('#orderItemsTable tbody tr');

            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase().trim();

                tableRows.forEach(row => {
                    if (row.querySelector('td')) { // Boş satırları atla
                        const searchData = row.getAttribute('data-search')?.toLowerCase() || '';
                        if (searchTerm === '' || searchData.includes(searchTerm)) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    }
                });
            });

            clearSearch.addEventListener('click', function() {
                searchInput.value = '';
                tableRows.forEach(row => row.style.display = '');
                searchInput.focus();
            });

            // Yenile butonu
            document.getElementById('refreshBtn').addEventListener('click', function() {
                window.location.reload();
            });

            // Özet göster/gizle
            document.getElementById('toggleSummary').addEventListener('change', function() {
                const statsCards = document.querySelectorAll('.col-md-3.mb-3');
                statsCards.forEach(card => {
                    card.style.display = this.checked ? 'block' : 'none';
                });
            });

            // Satır tıklama efekti
            tableRows.forEach(row => {
                if (row.querySelector('td')) {
                    row.addEventListener('mouseenter', function() {
                        this.style.backgroundColor = '#f8f9fa';
                    });

                    row.addEventListener('mouseleave', function() {
                        this.style.backgroundColor = '';
                    });
                }
            });
        });
    </script>

    <style>
        .card {
            border-radius: 10px;
            overflow: hidden;
        }

        .card-header {
            border-bottom: none;
        }

        .table th {
            background-color: #343a40;
            color: white;
            font-weight: 600;
            border-bottom: 2px solid #495057;
        }

        .table td {
            vertical-align: middle;
            padding: 1rem 0.75rem;
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: rgba(0,0,0,.02);
        }

        .table-hover tbody tr:hover {
            background-color: rgba(0,123,255,.1);
        }

        .btn-group .btn {
            border-radius: 5px !important;
            margin: 0 2px;
        }

        .badge {
            font-size: 0.75em;
            padding: 0.35em 0.65em;
        }

        .border-2 {
            border-width: 2px !important;
        }

        .bg-opacity-10 {
            background-color: rgba(var(--bs-primary-rgb), 0.1);
        }

        .pagination .page-item.active .page-link {
            background-color: #0d6efd;
            border-color: #0d6efd;
        }

        #searchInput:focus {
            border-color: #86b7fe;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .fs-5 {
            font-size: 1.25rem !important;
        }

        .fs-6 {
            font-size: 1rem !important;
        }
    </style>
}