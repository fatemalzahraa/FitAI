@model Eticaret.Core.Entities.Product

@{
    ViewData["Title"] = Model.Name + " - Ürün Detayları";
    
    // Görsel URL'lerini kontrol etme
    var mainImageUrl = !string.IsNullOrEmpty(Model.ImageUrl) ? Model.ImageUrl : "/img/default-product.png";
    var hasAdditionalImages = Model.ProductImages != null && Model.ProductImages.Any();
    var totalImages = hasAdditionalImages ? Model.ProductImages.Count + 1 : 1;
}

<div class="container-fluid mt-3">
    <!-- Üst Navigasyon ve Başlık -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">
                        <i class="fas fa-boxes me-1"></i>Ürün Yönetimi</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="fas fa-info-circle me-1"></i>@Model.Name
                    </li>
                </ol>
            </nav>
            <div class="d-flex align-items-center">
                <h2 class="mb-0 me-3">
                    <i class="fas fa-box text-primary me-2"></i>
                    <span class="text-primary">@Model.Name</span>
                </h2>
                <span class="badge bg-dark fs-6 py-2">ID: @Model.Id.ToString("D6")</span>
            </div>
        </div>
        <div class="btn-group">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i>Düzenle
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Listeye Dön
            </a>
        </div>
    </div>

    <!-- Hızlı İstatistik Kartları -->
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 shadow-sm bg-primary bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle p-2 me-3">
                            <i class="fas fa-money-bill-wave text-white"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.Price.ToString("C2")</h5>
                            <small class="text-muted">Fiyat</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 shadow-sm bg-@(Model.Stock > 10 ? "success" : Model.Stock > 0 ? "warning" : "danger") bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="rounded-circle p-2 me-3 bg-@(Model.Stock > 10 ? "success" : Model.Stock > 0 ? "warning" : "danger")">
                            <i class="fas fa-boxes text-white"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@Model.Stock</h5>
                            <small class="text-muted">Stok Miktarı</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 shadow-sm bg-info bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-info rounded-circle p-2 me-3">
                            <i class="fas fa-image text-white"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@totalImages</h5>
                            <small class="text-muted">Görsel Sayısı</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 shadow-sm bg-success bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-success rounded-circle p-2 me-3">
                            <i class="fas fa-shopping-cart text-white"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@(Model.OrderItems?.Count ?? 0)</h5>
                            <small class="text-muted">Toplam Sipariş</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sol Panel: Görsel Galerisi -->
        <div class="col-lg-7">
            <!-- Ana Görsel Kartı -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-image text-primary me-2"></i>Ürün Görselleri
                        </h5>
                        <div>
                            <span class="badge bg-primary">
                                <i class="fas fa-images me-1"></i> @totalImages görsel
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Ana Görsel -->
                    <div class="text-center mb-4">
                        <div class="main-image-container position-relative d-inline-block">
                            <div class="position-relative" id="mainImageWrapper">
                                <img id="mainProductImage" 
                                     src="@mainImageUrl"
                                     class="img-fluid rounded shadow-sm cursor-zoom"
                                     alt="@Model.Name"
                                     onerror="this.onerror=null; this.src='/img/default-product.png';"
                                     style="max-height: 400px; width: auto; object-fit: contain;">
                                
                                <!-- Görsel Üzeri Kontroller -->
                                <div class="position-absolute top-0 end-0 m-3">
                                    <button class="btn btn-sm btn-light shadow-sm" 
                                            onclick="toggleFullscreen('mainProductImage')"
                                            title="Tam Ekran">
                                        <i class="fas fa-expand"></i>
                                    </button>
                                </div>
                                
                                <!-- Görsel Durum Badgesi -->
                                <div class="position-absolute bottom-0 start-0 m-3">
                                    <span class="badge bg-@(Model.ImageUrl != "/img/default-product.png" ? "success" : "secondary")">
                                        <i class="fas fa-@(Model.ImageUrl != "/img/default-product.png" ? "check" : "image") me-1"></i>
                                        @(Model.ImageUrl != "/img/default-product.png" ? "Ana Görsel" : "Varsayılan Görsel")
                                    </span>
                                </div>
                            </div>
                            
                            <!-- Görsel Navigasyon (Çoklu görsel varsa) -->
                            @if (hasAdditionalImages)
                            {
                                <div class="d-flex justify-content-center mt-3">
                                    <button class="btn btn-outline-secondary btn-sm me-2" onclick="previousImage()" title="Önceki">
                                        <i class="fas fa-chevron-left"></i>
                                    </button>
                                    <span class="align-self-center mx-2" id="imageCounter">1 / @totalImages</span>
                                    <button class="btn btn-outline-secondary btn-sm ms-2" onclick="nextImage()" title="Sonraki">
                                        <i class="fas fa-chevron-right"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Thumbnail Galerisi -->
                    <div class="thumbnail-gallery">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-th me-2"></i>Tüm Görseller
                        </h6>
                        
                        <div class="row g-2" id="thumbnailGallery">
                            <!-- Ana Görsel Thumbnail -->
                            <div class="col-3 col-sm-2 mb-2">
                                <div class="thumbnail-item active" onclick="selectImage(0, '@mainImageUrl')">
                                    <div class="thumbnail-wrapper position-relative">
                                        <img src="@mainImageUrl"
                                             class="img-thumbnail rounded"
                                             style="width: 100%; height: 80px; object-fit: cover;"
                                             onerror="this.onerror=null; this.src='/img/default-product.png';">
                                        <span class="position-absolute top-0 start-0 badge bg-primary" style="font-size: 0.6rem;">Ana</span>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Ek Görseller -->
                            @if (hasAdditionalImages)
                            {
                                var imageIndex = 1;
                                foreach (var image in Model.ProductImages)
                                {
                                    var imageUrl = !string.IsNullOrEmpty(image.ImageUrl) ? image.ImageUrl : "/img/default-product.png";
                                    <div class="col-3 col-sm-2 mb-2">
                                        <div class="thumbnail-item" onclick="selectImage(@imageIndex, '@imageUrl')">
                                            <div class="thumbnail-wrapper position-relative">
                                                <img src="@imageUrl"
                                                     class="img-thumbnail rounded"
                                                     style="width: 100%; height: 80px; object-fit: cover;"
                                                     onerror="this.onerror=null; this.src='/img/default-product.png';">
                                                <span class="position-absolute top-0 start-0 badge bg-info" style="font-size: 0.6rem;">@imageIndex</span>
                                            </div>
                                        </div>
                                    </div>
                                    imageIndex++;
                                }
                            }
                        </div>
                        
                        <!-- Görsel Yok Mesajı -->
                        @if (!hasAdditionalImages)
                        {
                            <div class="text-center py-4">
                                <div class="empty-gallery">
                                    <i class="fas fa-images text-muted" style="font-size: 3rem;"></i>
                                    <p class="text-muted mt-3">Ek görsel bulunmuyor</p>
                                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-plus me-1"></i>Görsel Ekle
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            
            <!-- Görsel İşlemleri Kartı -->
            <div class="card shadow border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-cog text-secondary me-2"></i>Görsel İşlemleri
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <button class="btn btn-outline-primary w-100" onclick="downloadCurrentImage()">
                                <i class="fas fa-download me-1"></i>İndir
                            </button>
                        </div>
                        <div class="col-md-4">
                            <button class="btn btn-outline-info w-100" onclick="copyImageUrl()">
                                <i class="fas fa-copy me-1"></i>URL Kopyala
                            </button>
                        </div>
                        <div class="col-md-4">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning w-100">
                                <i class="fas fa-edit me-1"></i>Görselleri Yönet
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Ürün Detayları -->
        <div class="col-lg-5">
            <!-- Ürün Bilgileri Kartı -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Ürün Bilgileri
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Temel Bilgiler -->
                    <div class="mb-4">
                        <h4 class="text-primary">@Model.Name</h4>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="text-success mb-0">@Model.Price.ToString("C2")</h3>
                            <span class="badge bg-@(Model.Stock > 10 ? "success" : Model.Stock > 0 ? "warning" : "danger") fs-6">
                                @Model.Stock Adet
                            </span>
                        </div>
                    </div>

                    <!-- Stok Durumu -->
                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-chart-bar me-2"></i>Stok Durumu
                        </h6>
                        <div class="progress mb-2" style="height: 12px;">
                            @{
                                var stockPercentage = Model.Stock > 100 ? 100 : Model.Stock;
                                var progressClass = Model.Stock > 10 ? "bg-success" :
                                Model.Stock > 0 ? "bg-warning" : "bg-danger";
                            }
                            <div class="progress-bar @progressClass progress-bar-striped" 
                                 role="progressbar" 
                                 style="width: @stockPercentage%"
                                 aria-valuenow="@stockPercentage" 
                                 aria-valuemin="0" 
                                 aria-valuemax="100">
                                <small class="position-absolute" style="left: 10px; color: white;">@stockPercentage%</small>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between small text-muted">
                            <span>0</span>
                            <span>50</span>
                            <span>100+</span>
                        </div>
                    </div>

                    <!-- Kategori Bilgisi -->
                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-tags me-2"></i>Kategori Bilgisi
                        </h6>
                        @if (Model.Category != null)
                        {
                            <div class="d-flex align-items-center p-3 bg-light rounded">
                                <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
                                    <i class="fas fa-folder text-info" style="font-size: 1.5rem;"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <h5 class="mb-1">@Model.Category.Name</h5>
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">ID: @Model.CategoryId</small>
                                        <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" 
                                           class="text-decoration-none small">
                                            <i class="fas fa-external-link-alt me-1"></i>Diğer Ürünler
                                        </a>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle me-2"></i>
                                Bu ürün bir kategoriye atanmamış.
                            </div>
                        }
                    </div>

                    <!-- Açıklama -->
                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-file-alt me-2"></i>Ürün Açıklaması
                        </h6>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="p-3 bg-light rounded" style="max-height: 200px; overflow-y: auto;">
                                <p class="mb-0" style="white-space: pre-line; line-height: 1.6;">
                                    @Model.Description
                                </p>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-file-alt text-muted" style="font-size: 2rem;"></i>
                                <p class="text-muted mt-2">Açıklama girilmemiş</p>
                            </div>
                        }
                    </div>

                    <!-- İstatistikler -->
                    <div class="mb-4">
                        <h6 class="border-bottom pb-2 mb-3">
                            <i class="fas fa-chart-pie me-2"></i>İstatistikler
                        </h6>
                        <div class="row g-2">
                            <div class="col-4">
                                <div class="text-center p-2 border rounded">
                                    <div class="text-primary fs-4">@(Model.OrderItems?.Count ?? 0)</div>
                                    <small class="text-muted">Sipariş</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-center p-2 border rounded">
                                    <div class="text-danger fs-4">@(Model.Favorites?.Count ?? 0)</div>
                                    <small class="text-muted">Favori</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-center p-2 border rounded">
                                    <div class="text-success fs-4">@(Model.CartItems?.Count ?? 0)</div>
                                    <small class="text-muted">Sepet</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hızlı İşlemler Kartı -->
            <div class="card shadow border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-bolt text-warning me-2"></i>Hızlı İşlemler
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-2"></i>Ürünü Düzenle
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-list me-2"></i>Tüm Ürünlere Dön
                        </a>
                        <div class="btn-group">
                            <button type="button" onclick="printProductDetails()" class="btn btn-outline-primary">
                                <i class="fas fa-print me-2"></i>Yazdır
                            </button>
                            <button type="button" onclick="shareProduct()" class="btn btn-outline-info">
                                <i class="fas fa-share me-2"></i>Paylaş
                            </button>
                            <button type="button" onclick="copyProductInfo()" class="btn btn-outline-success">
                                <i class="fas fa-copy me-2"></i>Kopyala
                            </button>
                        </div>
                        <a asp-action="Delete" asp-route-id="@Model.Id" 
                           class="btn btn-outline-danger mt-2"
                           onclick="return confirm('Bu ürünü silmek istediğinize emin misiniz?\\n\\nÜrün: @Model.Name\\nID: @Model.Id\\n\\nBu işlem geri alınamaz!');">
                            <i class="fas fa-trash-alt me-2"></i>Ürünü Sil
                        </a>
                    </div>
                </div>
            </div>

            <!-- Ürün Metadatası -->
            <div class="card shadow border-0 mt-4">
                <div class="card-body">
                    <div class="row small text-muted">
                        <div class="col-6">
                            <i class="fas fa-calendar me-1"></i>
                            Son Görüntülenme: <br>
                            <strong>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</strong>
                        </div>
                        <div class="col-6 text-end">
                            <i class="fas fa-info-circle me-1"></i>
                            Kayıt Tarihi: <br>
                            <strong>Bilinmiyor</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tam Ekran Görsel Modal -->
<div class="modal fade" id="imageFullscreenModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center p-0">
                <img id="fullscreenImage" src="" class="img-fluid" style="max-height: 70vh;">
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <small class="text-white bg-dark bg-opacity-75 rounded-pill px-3 py-2">
                    <i class="fas fa-image me-1"></i>
                    @Model.Name - 
                    <span id="fullscreenImageCounter"></span>
                </small>
            </div>
        </div>
    </div>
</div>

<!-- Görsel Bilgi Modal -->
<div class="modal fade" id="imageInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle me-2"></i>Görsel Bilgileri
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="text-center mb-3">
                    <img id="infoImage" src="" class="img-fluid rounded" style="max-height: 200px;">
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <div class="border rounded p-2">
                            <small class="text-muted d-block">Boyut</small>
                            <strong id="infoSize">-</strong>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border rounded p-2">
                            <small class="text-muted d-block">Format</small>
                            <strong id="infoFormat">-</strong>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <input type="text" class="form-control form-control-sm" id="imageUrlDisplay" readonly>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" onclick="copyToClipboard('imageUrlDisplay')">
                    <i class="fas fa-copy me-1"></i>URL'yi Kopyala
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Görsel verilerini sakla
        const productImages = [
            { url: '@mainImageUrl', type: 'main', title: 'Ana Görsel' }
        ];
        
        @if (hasAdditionalImages)
        {
            var index = 1;
            foreach (var img in Model.ProductImages)
            {
                var imgUrl = !string.IsNullOrEmpty(img.ImageUrl) ? img.ImageUrl : "/img/default-product.png";
                @:productImages.push({ url: '@imgUrl', type: 'additional', title: 'Görsel @index' });
                index++;
            }
        }
        
        let currentImageIndex = 0;
        const totalImages = productImages.length;
        
        // Bootstrap Modal'ları başlat
        const imageFullscreenModal = new bootstrap.Modal(document.getElementById('imageFullscreenModal'));
        const imageInfoModal = new bootstrap.Modal(document.getElementById('imageInfoModal'));
        
        // Görsel seçme fonksiyonu
        function selectImage(index, imageUrl) {
            currentImageIndex = index;
            updateMainImage(imageUrl);
            updateThumbnails();
            updateImageCounter();
        }
        
        // Sonraki görsel
        function nextImage() {
            currentImageIndex = (currentImageIndex + 1) % totalImages;
            updateMainImage(productImages[currentImageIndex].url);
            updateThumbnails();
            updateImageCounter();
        }
        
        // Önceki görsel
        function previousImage() {
            currentImageIndex = (currentImageIndex - 1 + totalImages) % totalImages;
            updateMainImage(productImages[currentImageIndex].url);
            updateThumbnails();
            updateImageCounter();
        }
        
        // Ana görseli güncelle
        function updateMainImage(imageUrl) {
            const mainImage = document.getElementById('mainProductImage');
            if (mainImage) {
                // Yumuşak geçiş efekti
                mainImage.style.opacity = '0.5';
                setTimeout(() => {
                    mainImage.src = imageUrl;
                    mainImage.style.opacity = '1';
                }, 200);
            }
        }
        
        // Thumbnail'leri güncelle
        function updateThumbnails() {
            document.querySelectorAll('.thumbnail-item').forEach((item, index) => {
                if (index === currentImageIndex) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
        }
        
        // Görsel sayacını güncelle
        function updateImageCounter() {
            const counter = document.getElementById('imageCounter');
            if (counter) {
                counter.textContent = `${currentImageIndex + 1} / ${totalImages}`;
            }
        }
        
        // Tam ekran modu
        function toggleFullscreen(elementId) {
            const element = document.getElementById(elementId);
            if (!document.fullscreenElement) {
                element.requestFullscreen().catch(err => {
                    console.log(`Tam ekran hatası: ${err.message}`);
                    showFullscreenModal(productImages[currentImageIndex].url);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }
        
        // Tam ekran modal
        function showFullscreenModal(imageUrl) {
            const fullscreenImage = document.getElementById('fullscreenImage');
            const fullscreenImageCounter = document.getElementById('fullscreenImageCounter');
            
            if (fullscreenImage) {
                fullscreenImage.src = imageUrl;
                fullscreenImageCounter.textContent = `Görsel ${currentImageIndex + 1}/${totalImages}`;
                imageFullscreenModal.show();
            }
        }
        
        // Görsel indirme
        function downloadCurrentImage() {
            const imageUrl = productImages[currentImageIndex].url;
            const link = document.createElement('a');
            link.href = imageUrl;
            link.download = `urun-gorsel-${currentImageIndex + 1}-${Date.now()}.jpg`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
        
        // Görsel URL'sini kopyala
        function copyImageUrl() {
            const imageUrl = productImages[currentImageIndex].url;
            copyToClipboardValue(imageUrl);
            showToast('Görsel URL\'si kopyalandı!', 'success');
        }
        
        // Görsel bilgilerini göster
        function showImageInfo() {
            const imageUrl = productImages[currentImageIndex].url;
            const infoImage = document.getElementById('infoImage');
            const imageUrlDisplay = document.getElementById('imageUrlDisplay');
            
            if (infoImage && imageUrlDisplay) {
                infoImage.src = imageUrl;
                imageUrlDisplay.value = imageUrl;
                
                // Görsel boyutunu al (eğer erişilebilirse)
                const img = new Image();
                img.onload = function() {
                    document.getElementById('infoSize').textContent = 
                        `${this.width} × ${this.height} piksel`;
                    document.getElementById('infoFormat').textContent = 
                        imageUrl.split('.').pop().toUpperCase();
                };
                img.onerror = function() {
                    document.getElementById('infoSize').textContent = 'Bilinmiyor';
                    document.getElementById('infoFormat').textContent = 'Bilinmiyor';
                };
                img.src = imageUrl;
                
                imageInfoModal.show();
            }
        }
        
        // Ürün detaylarını yazdır
        function printProductDetails() {
            const originalTitle = document.title;
            document.title = `Ürün Detayları - ${'@Model.Name'} - ${new Date().toLocaleDateString('tr-TR')}`;
            window.print();
            setTimeout(() => {
                document.title = originalTitle;
            }, 1000);
        }
        
        // Ürünü paylaş
        function shareProduct() {
            const productData = {
                title: '@Model.Name',
                text: `Ürün: @Model.Name\nFiyat: @Model.Price.ToString("C2")\nStok: @Model.Stock adet`,
                url: window.location.href
            };
            
            if (navigator.share) {
                navigator.share(productData)
                    .then(() => console.log('Paylaşım başarılı'))
                    .catch((error) => {
                        console.log('Paylaşım hatası:', error);
                        copyProductInfo();
                    });
            } else {
                copyProductInfo();
            }
        }
        
        // Ürün bilgilerini kopyala
        function copyProductInfo() {
            const productInfo = `
Ürün Adı: @Model.Name
Ürün ID: @Model.Id
Fiyat: @Model.Price.ToString("C2")
Stok: @Model.Stock adet
Kategori: @(Model.Category?.Name ?? "Belirtilmemiş")
Açıklama: @(Model.Description.Length > 100 ? Model.Description.Substring(0, 100) + "..." : Model.Description)
URL: ${window.location.href}
            `.trim();
            
            copyToClipboardValue(productInfo);
            showToast('Ürün bilgileri kopyalandı!', 'success');
        }
        
        // Yardımcı fonksiyonlar
        function copyToClipboard(elementId) {
            const element = document.getElementById(elementId);
            if (element) {
                element.select();
                element.setSelectionRange(0, 99999);
                document.execCommand('copy');
                showToast('Kopyalandı!', 'success');
            }
        }
        
        function copyToClipboardValue(text) {
            navigator.clipboard.writeText(text).then(() => {
                showToast('Kopyalandı!', 'success');
            }).catch(err => {
                const textArea = document.createElement('textarea');
                textArea.value = text;
                document.body.appendChild(textArea);
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                showToast('Kopyalandı!', 'success');
            });
        }
        
        function showToast(message, type) {
            // Basit bir toast bildirimi
            const toast = document.createElement('div');
            toast.className = `position-fixed bottom-0 end-0 p-3`;
            toast.innerHTML = `
                <div class="toast show" role="alert">
                    <div class="toast-header bg-${type} text-white">
                        <strong class="me-auto">Bilgi</strong>
                        <button type="button" class="btn-close btn-close-white" onclick="this.parentElement.parentElement.remove()"></button>
                    </div>
                    <div class="toast-body">
                        ${message}
                    </div>
                </div>
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
        
        // Sayfa yüklendiğinde
        document.addEventListener('DOMContentLoaded', function() {
            console.log('Ürün detayları yüklendi:', {
                name: '@Model.Name',
                id: @Model.Id,
                images: totalImages,
                price: @Model.Price,
                stock: @Model.Stock
            });
            
            // İlk thumbnail'i aktif yap
            updateThumbnails();
            updateImageCounter();
            
            // Görsel hata kontrolü
            document.querySelectorAll('img').forEach(img => {
                img.onerror = function() {
                    if (!this.src.includes('/img/default-product.png')) {
                        console.warn('Görsel yüklenemedi:', this.src);
                        this.src = '/img/default-product.png';
                    }
                };
            });
            
            // Klavye kısayolları
            document.addEventListener('keydown', function(e) {
                // Sol ok: önceki görsel
                if (e.key === 'ArrowLeft') {
                    previousImage();
                    e.preventDefault();
                }
                // Sağ ok: sonraki görsel
                else if (e.key === 'ArrowRight') {
                    nextImage();
                    e.preventDefault();
                }
                // Space/Enter: tam ekran
                else if (e.key === ' ' || e.key === 'Enter') {
                    if (document.activeElement.tagName !== 'INPUT' && 
                        document.activeElement.tagName !== 'TEXTAREA') {
                        showFullscreenModal(productImages[currentImageIndex].url);
                        e.preventDefault();
                    }
                }
                // Esc: tam ekrandan çık
                else if (e.key === 'Escape') {
                    if (document.fullscreenElement) {
                        document.exitFullscreen();
                    }
                }
            });
            
            // Fullscreen değişikliklerini dinle
            document.addEventListener('fullscreenchange', function() {
                const mainImage = document.getElementById('mainProductImage');
                if (mainImage) {
                    if (document.fullscreenElement) {
                        mainImage.classList.add('fullscreen');
                    } else {
                        mainImage.classList.remove('fullscreen');
                    }
                }
            });
        });
    </script>
    }
    
