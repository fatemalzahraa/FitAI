@model Eticaret.Core.Entities.Product

@{
    ViewData["Title"] = "Ürün Silme";
}

<div class="container mt-4">
    <!-- Başlık -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1 text-danger">
                <i class="fas fa-exclamation-triangle me-2"></i>Ürün Silme
            </h2>
            <p class="text-muted mb-0">"@Model.Name" ürününü silmek üzeresiniz</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Geri Dön
        </a>
    </div>

    <!-- Uyarı Mesajı -->
    <div class="alert alert-danger border-0 shadow-sm" role="alert">
        <div class="d-flex align-items-center">
            <i class="fas fa-exclamation-circle fa-2x me-3"></i>
            <div>
                <h5 class="alert-heading mb-2">Dikkat! Bu işlem geri alınamaz</h5>
                <p class="mb-0">Bu ürünü silmek üzeresiniz. Bu işlem geri alınamaz ve aşağıdaki bağlantılı veriler de silinebilir:</p>
                <ul class="mb-0 mt-2">
                    <li>Sipariş geçmişi bu ürünü içeriyorsa</li>
                    <li>Sepetlerde bu ürün varsa</li>
                    <li>Favorilere eklenmişse</li>
                    <li>Ürün görselleri</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sol Taraf: Ürün Bilgileri -->
        <div class="col-lg-8">
            <div class="card shadow border-0 mb-4">
                <div class="card-body">
                    <h5 class="card-title text-danger mb-4 border-bottom pb-2">
                        <i class="fas fa-info-circle me-2"></i>Silinecek Ürün Bilgileri
                    </h5>

                    <div class="row">
                        <!-- Ürün Resmi -->
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm mb-3"
                                         style="max-height: 200px; object-fit: cover;"
                                         alt="@Model.Name"
                                         onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=Resim+Yok'" />
                                }
                                else
                                {
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                         style="height: 200px;">
                                        <i class="fas fa-box fa-3x text-muted"></i>
                                    </div>
                                }
                                <span class="badge bg-danger">Silinecek</span>
                            </div>
                        </div>

                        <!-- Ürün Detayları -->
                        <div class="col-md-8">
                            <div class="mb-3">
                                <label class="form-label text-muted small">Ürün Adı</label>
                                <div class="fs-5 fw-bold">@Model.Name</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small">Fiyat</label>
                                <div class="fs-4 fw-bold text-success">@Model.Price.ToString("C")</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small">Stok Adedi</label>
                                <div>
                                    <span class="badge @(Model.Stock > 0 ? "bg-success" : "bg-danger")">
                                        @Model.Stock adet
                                    </span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small">Kategori</label>
                                <div>
                                    <span class="badge bg-primary">
                                        <i class="fas fa-folder me-1"></i>@Model.Category?.Name
                                    </span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label text-muted small">Açıklama</label>
                                <div class="border rounded p-3 bg-light">
                                    @if (!string.IsNullOrEmpty(Model.Description))
                                    {
                                        @Model.Description
                                    }
                                    else
                                    {
                                        <span class="text-muted">Açıklama yok</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- İlişkili Veriler -->
            <div class="card shadow border-0">
                <div class="card-body">
                    <h5 class="card-title text-muted mb-3">
                        <i class="fas fa-link me-2"></i>İlişkili Veriler
                    </h5>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <div class="text-center p-3 border rounded bg-light">
                                <i class="fas fa-shopping-cart fa-2x text-warning mb-2"></i>
                                <div class="fw-bold">Sepette</div>
                                <div class="small text-muted">@(Model.CartItems?.Count ?? 0) kullanıcı</div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="text-center p-3 border rounded bg-light">
                                <i class="fas fa-heart fa-2x text-danger mb-2"></i>
                                <div class="fw-bold">Favorilerde</div>
                                <div class="small text-muted">@(Model.Favorites?.Count ?? 0) kullanıcı</div>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <div class="text-center p-3 border rounded bg-light">
                                <i class="fas fa-image fa-2x text-info mb-2"></i>
                                <div class="fw-bold">Görseller</div>
                                <div class="small text-muted">@(Model.ProductImages?.Count ?? 0) adet</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Taraf: Onay ve İşlemler -->
        <div class="col-lg-4">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-trash-alt me-2"></i>Silme Onayı
                    </h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="alert alert-warning border-0">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <strong>Bu işlem geri alınamaz!</strong>
                        </div>
                    </div>

                    <!-- Silme Formu -->
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">Onay Kodu</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-key"></i></span>
                                <input type="text" class="form-control" id="confirmCode"
                                       placeholder="SİL yazarak onaylayın" required />
                            </div>
                            <div class="form-text text-muted">
                                Lütfen "SİL" yazarak silme işlemini onaylayın
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger btn-lg" id="deleteButton" disabled>
                                <i class="fas fa-trash-alt me-2"></i>Ürünü Kalıcı Olarak Sil
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-2"></i>Vazgeç ve Listeye Dön
                            </a>
                        </div>
                    </form>

                    <!-- Alternatif Seçenekler -->
                    <div class="mt-4">
                        <h6 class="text-muted mb-3">
                            <i class="fas fa-lightbulb me-2"></i>Alternatif Seçenekler
                        </h6>
                        <div class="list-group list-group-flush">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                                <i class="fas fa-edit me-2 text-warning"></i>Ürünü düzenle
                            </a>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="list-group-item list-group-item-action">
                                <i class="fas fa-eye me-2 text-info"></i>Detayları görüntüle
                            </a>
                            <a href="#" class="list-group-item list-group-item-action" onclick="setStockZero()">
                                <i class="fas fa-box me-2 text-secondary"></i>Stok adedini 0 yap
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Silme onay kodu kontrolü
            const confirmCodeInput = document.getElementById('confirmCode');
            const deleteButton = document.getElementById('deleteButton');

            confirmCodeInput.addEventListener('input', function() {
                if (this.value.toUpperCase() === 'SİL') {
                    deleteButton.disabled = false;
                    deleteButton.classList.remove('btn-secondary');
                    deleteButton.classList.add('btn-danger');
                } else {
                    deleteButton.disabled = true;
                    deleteButton.classList.remove('btn-danger');
                    deleteButton.classList.add('btn-secondary');
                }
            });

            // Form submit öncesi son uyarı
            const deleteForm = document.querySelector('form[asp-action="Delete"]');
            if (deleteForm) {
                deleteForm.addEventListener('submit', function(e) {
                    const confirmed = confirm('Bu ürünü kalıcı olarak silmek istediğinize emin misiniz? Bu işlem geri alınamaz!');
                    if (!confirmed) {
                        e.preventDefault();
                    }
                });
            }

            // Stok sıfırlama fonksiyonu (örnek - gerçek uygulamada controller action gerekli)
            window.setStockZero = function() {
                if (confirm('Stok adedini 0 yapmak istediğinize emin misiniz? Ürün silinmeyecek, sadece stok adedi sıfırlanacak.')) {
                    alert('Bu özellik için controller action gerekli. Örneğin: /Products/SetStockZero/' + @Model.Id);
                    // Burada AJAX çağrısı yapılabilir
                }
            };
        });
    </script>
}

<style>
    .card {
        border-radius: 12px;
        transition: all 0.3s ease;
    }

    .alert-danger {
        border-radius: 10px;
        background-color: #f8d7da;
        border: none;
    }

    .alert-warning {
        border-radius: 10px;
        background-color: #fff3cd;
        border: none;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
        font-weight: 500;
        transition: all 0.3s;
    }

        .btn-danger:hover:not(:disabled) {
            background-color: #c82333;
            border-color: #bd2130;
            transform: translateY(-1px);
            box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
        }

        .btn-danger:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .btn-outline-secondary:hover {
        transform: translateY(-1px);
    }

    .border-danger {
        border: 2px solid #dc3545 !important;
    }

    .badge {
        font-weight: 500;
        padding: 0.4em 0.8em;
    }

    .list-group-item {
        border: none;
        padding: 0.75rem 0;
    }

    .list-group-item-action:hover {
        background-color: rgba(0, 0, 0, 0.03);
        transform: translateX(5px);
        transition: all 0.2s;
    }

    .form-label {
        font-size: 0.85rem;
        font-weight: 500;
        color: #495057;
    }

    .input-group-text {
        background-color: #f8f9fa;
        border: 2px solid #dee2e6;
    }

    .form-control {
        border: 2px solid #dee2e6;
    }

        .form-control:focus {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        }

    .d-grid .btn {
        border-radius: 8px;
    }
</style>