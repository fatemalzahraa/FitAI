@model Eticaret.Core.Entities.Product

@{
    ViewData["Title"] = "Yeni Ürün Oluştur";
}

<div class="container mt-4">
    <!-- Başlık ve Üst Bilgi -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-plus-circle text-success me-2"></i>Yeni Ürün Oluştur
            </h2>
            <p class="text-muted mb-0">Yeni bir ürün eklemek için aşağıdaki formu doldurun</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Geri Dön
        </a>
    </div>

    <!-- Hata ve Başarı Mesajları -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i>
            @Html.Raw(TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>
            @Html.Raw(TempData["Success"])
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Sol Panel -->
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle me-2"></i>Lütfen formdaki hataları düzeltin:
                        </div>

                        <div class="row">
                            <!-- Ürün Adı -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-bold">
                                    <i class="fas fa-tag me-1"></i>Ürün Adı <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="Örnek: Kayısı fidanı" required />
                                <span asp-validation-for="Name" class="text-danger small mt-1"></span>
                            </div>

                            <!-- Kategori -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="CategoryId" class="form-label fw-bold">
                                    <i class="fas fa-folder me-1"></i>Kategori <span class="text-danger">*</span>
                                </label>
                                <select asp-for="CategoryId" class="form-select form-select-lg" asp-items="ViewBag.CategoryId" required>
                                    <option value="">-- Kategori Seçin --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger small mt-1"></span>
                            </div>

                            <!-- Fiyat -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-bold">
                                    <i class="fas fa-money-bill-wave me-1"></i>Fiyat (₺) <span class="text-danger">*</span>
                                </label>
                                <div class="input-group input-group-lg">
                                    <span class="input-group-text">₺</span>
                                    <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" required />
                                </div>
                                <span asp-validation-for="Price" class="text-danger small mt-1"></span>
                            </div>

                            <!-- Stok -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Stock" class="form-label fw-bold">
                                    <i class="fas fa-boxes me-1"></i>Stok Adedi <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Stock" class="form-control form-control-lg" type="number" min="0" required />
                                <span asp-validation-for="Stock" class="text-danger small mt-1"></span>
                            </div>

                            <!-- Açıklama -->
                            <div class="col-12 mb-3">
                                <label asp-for="Description" class="form-label fw-bold">
                                    <i class="fas fa-align-left me-1"></i>Açıklama <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                                <span asp-validation-for="Description" class="text-danger small mt-1"></span>
                            </div>

                            <!-- Resim Yükleme (URL KALDIRILDI!) -->
                            <div class="col-12 mb-3">
                                <div class="border rounded p-3 bg-light">
                                    <label class="form-label fw-bold d-block mb-3">
                                        <i class="fas fa-image me-1"></i>Ürün Resmi (Opsiyonel)
                                    </label>

                                    <div class="row">
                                        <div class="col-md-12 mb-3">
                                            <label class="form-label small fw-bold">
                                                <i class="fas fa-upload me-1"></i>Dosya Yükle
                                            </label>
                                            <input type="file" name="imageFile" class="form-control"
                                                   accept=".jpg,.jpeg,.png,.gif,.bmp,.webp"
                                                   id="imageFileInput" />
                                            <div class="form-text small">Max 5MB, izin verilen formatlar</div>
                                        </div>
                                    </div>

                                    <!-- Önizleme -->
                                    <div class="mt-3 text-center" id="imagePreviewContainer" style="display:none;">
                                        <div class="border rounded p-2 bg-white">
                                            <h6 class="text-muted mb-2">Resim Önizleme:</h6>
                                            <img id="imagePreview" class="img-fluid rounded"
                                                 style="max-height:150px; max-width:150px;"
                                                 onerror="this.src='/img/default-product.jpg'" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-end gap-3 pt-4 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="fas fa-times me-2"></i>İptal
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-2"></i>Ürünü Oluştur
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sağ Panel -->
        <div class="col-lg-4">
            <div class="card shadow border-0 mb-4">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">
                        <i class="fas fa-eye me-2"></i>Ürün Önizlemesi
                    </h5>

                    <div class="product-preview border rounded p-3 bg-light">
                        <div class="text-center mb-3" id="previewImageContainer">
                            <img id="previewImage" src="/img/default-product.jpg"
                                 class="img-fluid rounded"
                                 style="max-height:150px; max-width:150px;" />
                        </div>

                        <h5 id="previewName" class="text-center mb-2">Ürün Adı</h5>
                        <p id="previewDescription" class="text-muted small text-center mb-3">
                            Ürün açıklaması burada görünecek...
                        </p>

                        <div class="d-flex justify-content-between align-items-center">
                            <div><span class="text-success fw-bold fs-5" id="previewPrice">₺0.00</span></div>
                            <div><span class="badge bg-primary" id="previewStock">0 stok</span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow border-0">
                <div class="card-body">
                    <h5 class="card-title text-primary mb-3">
                        <i class="fas fa-info-circle me-2"></i>Bilgilendirme
                    </h5>
                    <div class="alert alert-info">
                        <ul class="small mb-0">
                            <li><span class="fw-bold">*</span> işaretli alanlar zorunludur</li>
                            <li>Ürün adı müşteriler tarafından görünür</li>
                            <li>Resim yüklemezseniz varsayılan resim kullanılır</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Dosya önizleme
        document.getElementById("imageFileInput").addEventListener("change", function (e) {
            const file = e.target.files[0];
            if (!file) return;

            const preview = document.getElementById("imagePreview");
            const container = document.getElementById("imagePreviewContainer");

            const reader = new FileReader();
            reader.onload = function (ev) {
                preview.src = ev.target.result;
                container.style.display = "block";
            };
            reader.readAsDataURL(file);
        });
    </script>
}
