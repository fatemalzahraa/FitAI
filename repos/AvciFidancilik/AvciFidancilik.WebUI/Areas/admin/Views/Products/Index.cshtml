@model IEnumerable<Eticaret.Core.Entities.Product>

@{
    ViewData["Title"] = "Ürün Yönetimi";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-boxes text-primary"></i> Ürün Yönetimi</h1>
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus-circle"></i> Yeni Ürün Ekle
        </a>
    </div>

    <!-- Bildirim Mesajları -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Html.Raw(TempData["Success"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Html.Raw(TempData["Error"])
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtre ve Arama Kartı -->
    <div class="card shadow mb-4">
        <div class="card-header bg-light py-3">
            <div class="row">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input type="text" id="productSearch" class="form-control" placeholder="Ürün ara...">
                        <button class="btn btn-outline-secondary" type="button" id="clearSearch">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-info" id="lowStockFilter">
                            <i class="fas fa-exclamation-triangle"></i> Düşük Stok (< 10)
                        </button>
                        <button type="button" class="btn btn-outline-secondary" id="resetFilters">
                            <i class="fas fa-redo"></i> Filtreleri Temizle
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Ürün İstatistikleri -->
        <div class="card-body py-2">
            <div class="row">
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded p-2 me-3">
                            <i class="fas fa-box text-white"></i>
                        </div>
                        <div>
                            <small class="text-muted">Toplam Ürün</small>
                            <h5 class="mb-0" id="totalProducts">@Model.Count()</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-warning rounded p-2 me-3">
                            <i class="fas fa-exclamation-triangle text-white"></i>
                        </div>
                        <div>
                            <small class="text-muted">Düşük Stok</small>
                            <h5 class="mb-0" id="lowStockCount">@Model.Count(p => p.Stock < 10)</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-danger rounded p-2 me-3">
                            <i class="fas fa-times text-white"></i>
                        </div>
                        <div>
                            <small class="text-muted">Stokta Yok</small>
                            <h5 class="mb-0" id="outOfStockCount">@Model.Count(p => p.Stock == 0)</h5>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="d-flex align-items-center">
                        <div class="bg-success rounded p-2 me-3">
                            <i class="fas fa-dollar-sign text-white"></i>
                        </div>
                        <div>
                            <small class="text-muted">Toplam Değer</small>
                            <h5 class="mb-0" id="totalValue">@Model.Sum(p => p.Price * p.Stock).ToString("C2")</h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ürün Tablosu -->
    <div class="card shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="productsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="50px"></th>
                            <th>
                                <div class="d-flex align-items-center">
                                    <span>Ürün Adı</span>
                                    <button class="btn btn-sm btn-link text-decoration-none sort-btn" data-sort="name">
                                        <i class="fas fa-sort"></i>
                                    </button>
                                </div>
                            </th>
                            <th>Kategori</th>
                            <th>
                                <div class="d-flex align-items-center">
                                    <span>Fiyat</span>
                                    <button class="btn btn-sm btn-link text-decoration-none sort-btn" data-sort="price">
                                        <i class="fas fa-sort"></i>
                                    </button>
                                </div>
                            </th>
                            <th>
                                <div class="d-flex align-items-center">
                                    <span>Stok</span>
                                    <button class="btn btn-sm btn-link text-decoration-none sort-btn" data-sort="stock">
                                        <i class="fas fa-sort"></i>
                                    </button>
                                </div>
                            </th>
                            <th>Durum</th>
                            <th width="150px" class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var stockStatus = item.Stock == 0 ? "danger" : item.Stock < 10 ? "warning" : "success";
                            var statusText = item.Stock == 0 ? "Stokta Yok" : item.Stock < 10 ? "Düşük Stok" : "Stokta Var";

                            <tr class="product-row" data-stock="@item.Stock" data-name="@item.Name.ToLower()">
                                <td class="text-center">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             class="img-thumbnail rounded"
                                             style="width: 40px; height: 40px; object-fit: cover;"
                                             alt="@item.Name"
                                             onerror="this.src='/img/default-product.png'">
                                    }
                                    else
                                    {
                                        <div class="bg-secondary rounded d-flex align-items-center justify-content-center"
                                             style="width: 40px; height: 40px;">
                                            <i class="fas fa-box text-white"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="fw-bold">@item.Name</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 300px;">
                                        @(item.Description.Length > 100 ? item.Description.Substring(0, 100) + "..." : item.Description)
                                    </small>
                                </td>
                                <td>
                                    @if (item.Category != null)
                                    {
                                        <span class="badge bg-info">@item.Category.Name</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Kategorisiz</span>
                                    }
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">@item.Price.ToString("C2")</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="progress flex-grow-1 me-2" style="height: 6px;">
                                            @{
                                                var progressWidth = item.Stock > 50 ? 100 : (item.Stock * 2);
                                            }
                                            <div class="progress-bar bg-@stockStatus"
                                                 role="progressbar"
                                                 style="width: @progressWidth%">
                                            </div>
                                        </div>
                                        <span class="badge bg-@stockStatus">
                                            @item.Stock
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-@stockStatus">@statusText</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-info"
                                           title="Detaylar"
                                           data-bs-toggle="tooltip">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning"
                                           title="Düzenle"
                                           data-bs-toggle="tooltip">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger"
                                           title="Sil"
                                           data-bs-toggle="tooltip">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-box-open fa-3x mb-3"></i>
                                        <h5>Henüz hiç ürün eklenmemiş</h5>
                                        <p>İlk ürününüzü eklemek için "Yeni Ürün Ekle" butonuna tıklayın.</p>
                                        <a asp-action="Create" class="btn btn-primary mt-2">
                                            <i class="fas fa-plus-circle"></i> İlk Ürününü Ekle
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tablo Alt Bilgisi -->
        <div class="card-footer bg-light">
            <div class="row">
                <div class="col-md-6">
                    <small class="text-muted">
                        Toplam <span id="displayedCount">@Model.Count()</span> üründen
                        <span id="filteredCount">@Model.Count()</span> görüntüleniyor
                    </small>
                </div>
                <div class="col-md-6 text-end">
                    <small class="text-muted">
                        Son güncelleme: @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Tooltip'leri etkinleştir
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Arama işlevselliği
            $('#productSearch').on('keyup', function() {
                var searchText = $(this).val().toLowerCase();
                var visibleRows = 0;

                $('.product-row').each(function() {
                    var productName = $(this).data('name');
                    if (productName.includes(searchText)) {
                        $(this).show();
                        visibleRows++;
                    } else {
                        $(this).hide();
                    }
                });

                updateCounters(visibleRows);
            });

            // Arama temizleme
            $('#clearSearch').click(function() {
                $('#productSearch').val('');
                $('.product-row').show();
                updateCounters($('.product-row').length);
            });

            // Düşük stok filtresi
            $('#lowStockFilter').click(function() {
                var lowStockCount = 0;
                $('.product-row').each(function() {
                    var stock = $(this).data('stock');
                    if (stock < 10) {
                        $(this).show();
                        lowStockCount++;
                    } else {
                        $(this).hide();
                    }
                });

                updateCounters(lowStockCount);
                $(this).addClass('active');
                $('#resetFilters').removeClass('active');
            });

            // Filtreleri temizle
            $('#resetFilters').click(function() {
                $('.product-row').show();
                $('#productSearch').val('');
                $('.sort-btn i').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');
                $('.btn-group .btn').removeClass('active');
                updateCounters($('.product-row').length);
            });

            // Sıralama işlevselliği
            $('.sort-btn').click(function() {
                var sortType = $(this).data('sort');
                var isAscending = $(this).find('i').hasClass('fa-sort-up');

                // Diğer sıralama butonlarını sıfırla
                $('.sort-btn i').removeClass('fa-sort-up fa-sort-down').addClass('fa-sort');

                // Yeni sıralama durumunu ayarla
                if (isAscending) {
                    $(this).find('i').removeClass('fa-sort-up').addClass('fa-sort-down');
                    sortTable(sortType, false);
                } else {
                    $(this).find('i').removeClass('fa-sort-down').addClass('fa-sort-up');
                    sortTable(sortType, true);
                }
            });

            // Tablo sıralama fonksiyonu
            function sortTable(sortType, ascending) {
                var rows = $('.product-row').get();

                rows.sort(function(a, b) {
                    var aValue, bValue;

                    switch(sortType) {
                        case 'name':
                            aValue = $(a).data('name');
                            bValue = $(b).data('name');
                            break;
                        case 'price':
                            aValue = parseFloat($(a).find('td:nth-child(4)').text().replace(/[^0-9.-]+/g, ''));
                            bValue = parseFloat($(b).find('td:nth-child(4)').text().replace(/[^0-9.-]+/g, ''));
                            break;
                        case 'stock':
                            aValue = $(a).data('stock');
                            bValue = $(b).data('stock');
                            break;
                    }

                    if (ascending) {
                        return aValue > bValue ? 1 : -1;
                    } else {
                        return aValue < bValue ? 1 : -1;
                    }
                });

                // Sıralanmış satırları tabloya ekle
                $.each(rows, function(index, row) {
                    $('#productsTable tbody').append(row);
                });
            }

            // Sayaçları güncelleme fonksiyonu
            function updateCounters(visibleCount) {
                $('#filteredCount').text(visibleCount);

                // Eğer filtrelenmişse istatistikleri güncelle
                if (visibleCount < $('.product-row').length) {
                    $('#totalProducts').parent().addClass('text-muted');
                } else {
                    $('#totalProducts').parent().removeClass('text-muted');
                }
            }

            // Stok durumuna göre satır vurgulama
            $('.product-row').each(function() {
                var stock = $(this).data('stock');
                if (stock == 0) {
                    $(this).addClass('table-danger');
                } else if (stock < 10) {
                    $(this).addClass('table-warning');
                }
            });
        });
    </script>

    <style>
        .product-row:hover {
            background-color: #f8f9fa;
            cursor: pointer;
        }

        .table-hover tbody tr:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            transition: all 0.2s ease;
        }

        .progress {
            min-width: 80px;
        }

        .btn-group-sm .btn {
            padding: 0.25rem 0.5rem;
        }

        .badge {
            font-size: 0.85em;
            font-weight: 500;
        }

        .sort-btn {
            padding: 0;
            margin-left: 5px;
        }

        .table th {
            border-top: none;
            font-weight: 600;
            color: #495057;
        }

        .table td {
            vertical-align: middle;
        }

        .alert {
            animation: fadeIn 0.5s;
        }

        @@keyframes fadeIn {
            from

        {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .card {
            border: none;
            border-radius: 10px;
        }

        .card-header {
            border-radius: 10px 10px 0 0 !important;
        }
    </style>
}