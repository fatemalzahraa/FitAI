@model ChatOption

@{
    ViewData["Title"] = "Sohbet Seçeneği Detayları";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-info text-white">
            <h3 class="card-title mb-0">
                <i class="fas fa-info-circle me-2"></i>Sohbet Seçeneği Detayları
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-8">
                    <div class="detail-section mb-4">
                        <h5 class="section-title">Genel Bilgiler</h5>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <tbody>
                                    <tr>
                                        <th width="30%">Senaryo</th>
                                        <td>
                                            <span class="badge bg-primary">@Html.DisplayFor(model => model.Scenario)</span>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Buton Metni</th>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <span class="me-2">@Html.DisplayFor(model => model.ButtonText)</span>
                                                <button class="btn btn-sm btn-outline-secondary copy-btn" data-text="@Model.ButtonText">
                                                    <i class="fas fa-copy"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <th>Aksiyon Değeri</th>
                                        <td>
                                            <code class="bg-light p-2 rounded">@Html.DisplayFor(model => model.ActionValue)</code>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="detail-section">
                        <h5 class="section-title">Adım Yönetimi</h5>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="step-card text-center p-3 mb-3">
                                    <div class="step-number">@Html.DisplayFor(model => model.StepIndex)</div>
                                    <div class="step-label">Mevcut Adım</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="step-card text-center p-3 mb-3">
                                    <div class="step-number text-success">@Html.DisplayFor(model => model.NextStepIndex)</div>
                                    <div class="step-label">Sonraki Adım</div>
                                </div>
                            </div>
                        </div>

                        <div class="step-visualization mt-4">
                            <div class="d-flex align-items-center justify-content-center">
                                <div class="step-circle current">@Html.DisplayFor(model => model.StepIndex)</div>
                                <div class="step-arrow"><i class="fas fa-arrow-right"></i></div>
                                <div class="step-circle next">@Html.DisplayFor(model => model.NextStepIndex)</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <h6 class="mb-0"><i class="fas fa-comment-dots me-2"></i>Sohbet Önizlemesi</h6>
                        </div>
                        <div class="card-body">
                            <div class="chat-simulation">
                                <div class="chat-bubble received mb-3">
                                    Size nasıl yardımcı olabilirim?
                                </div>
                                <div class="chat-bubble sent">
                                    <button class="btn btn-primary w-100 text-start">
                                        <i class="fas fa-hand-pointer me-2"></i>
                                        @Html.DisplayFor(model => model.ButtonText)
                                    </button>
                                </div>
                                <div class="mt-3 text-center text-muted small">
                                    <i class="fas fa-mouse-pointer me-1"></i>
                                    Kullanıcı bu butona tıklayacak
                                </div>
                            </div>

                            <div class="mt-4">
                                <div class="alert alert-light">
                                    <h6><i class="fas fa-database me-2"></i>Veri Bilgisi</h6>
                                    <small>
                                        <strong>ID:</strong> @Model.Id<br>
                                        <strong>Aksiyon:</strong> @Model.ActionValue<br>
                                        <strong>Tarih:</strong> @DateTime.Now.ToString("dd.MM.yyyy HH:mm")
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-between">
                    <div>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                        </a>
                    </div>
                    <div>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-2"></i>Düzenle
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model?.Id" class="btn btn-danger ms-2">
                            <i class="fas fa-trash-alt me-2"></i>Sil
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .detail-section {
            background: #fff;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #e0e0e0;
            margin-bottom: 20px;
        }

        .section-title {
            color: #0d6efd;
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 8px;
            margin-bottom: 20px;
        }

        .step-card {
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            background: #f8f9fa;
            transition: all 0.3s ease;
        }

            .step-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .step-number {
            font-size: 2.5rem;
            font-weight: bold;
            color: #0d6efd;
        }

        .step-label {
            color: #666;
            font-size: 0.9rem;
            margin-top: 5px;
        }

        .step-visualization {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
        }

        .step-circle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: #0d6efd;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: bold;
        }

            .step-circle.current {
                background: #0d6efd;
            }

            .step-circle.next {
                background: #198754;
            }

        .step-arrow {
            margin: 0 30px;
            font-size: 1.5rem;
            color: #666;
        }

        .chat-simulation {
            background: #f0f2f5;
            padding: 15px;
            border-radius: 10px;
        }

        .chat-bubble {
            max-width: 100%;
        }

            .chat-bubble.received {
                background: white;
                padding: 10px 15px;
                border-radius: 15px 15px 15px 5px;
                box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            }

            .chat-bubble.sent {
                text-align: right;
            }

        .copy-btn:hover {
            background-color: #0d6efd;
            color: white;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Copy to clipboard functionality
            $('.copy-btn').click(function() {
                const text = $(this).data('text');
                navigator.clipboard.writeText(text).then(() => {
                    $(this).html('<i class="fas fa-check"></i>');
                    $(this).removeClass('btn-outline-secondary').addClass('btn-success');

                    setTimeout(() => {
                        $(this).html('<i class="fas fa-copy"></i>');
                        $(this).removeClass('btn-success').addClass('btn-outline-secondary');
                    }, 2000);

                    showToast('Metin panoya kopyalandı!', 'success');
                });
            });

            // Animate step cards
            $('.step-card').addClass('animate__animated animate__fadeInUp');

            // Toast function
            function showToast(message, type) {
                const toast = $(`<div class="toast align-items-center text-white bg-${type} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`);

                $('#toastContainer').append(toast);
                const bsToast = new bootstrap.Toast(toast[0]);
                bsToast.show();

                toast.on('hidden.bs.toast', function() {
                    $(this).remove();
                });
            }

            // Add toast container if not exists
            if ($('#toastContainer').length === 0) {
                $('body').append('<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            }
        });
    </script>
}