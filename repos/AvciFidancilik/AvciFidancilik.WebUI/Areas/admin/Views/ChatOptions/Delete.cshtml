@model ChatOption

@{
    ViewData["Title"] = "Sohbet Seçeneği Sil";
}

<div class="container mt-4">
    <div class="card border-danger shadow">
        <div class="card-header bg-danger text-white">
            <h3 class="card-title mb-0">
                <i class="fas fa-exclamation-triangle me-2"></i>Sohbet Seçeneği Sil
            </h3>
        </div>
        <div class="card-body">
            <div class="alert alert-warning">
                <h5 class="alert-heading">
                    <i class="fas fa-exclamation-circle me-2"></i>Bu kaydı silmek istediğinizden emin misiniz?
                </h5>
                <p class="mb-0">Bu işlem geri alınamaz. Lütfen aşağıdaki bilgileri kontrol edin.</p>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="info-card mb-4">
                        <h5 class="info-card-header">Temel Bilgiler</h5>
                        <div class="info-card-body">
                            <div class="row mb-2">
                                <div class="col-5"><strong>Senaryo:</strong></div>
                                <div class="col-7"><span class="badge bg-primary">@Html.DisplayFor(model => model.Scenario)</span></div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5"><strong>Buton Metni:</strong></div>
                                <div class="col-7">@Html.DisplayFor(model => model.ButtonText)</div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5"><strong>Aksiyon Değeri:</strong></div>
                                <div class="col-7"><code>@Html.DisplayFor(model => model.ActionValue)</code></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-card mb-4">
                        <h5 class="info-card-header">Adım Bilgileri</h5>
                        <div class="info-card-body">
                            <div class="row mb-2">
                                <div class="col-5"><strong>Mevcut Adım:</strong></div>
                                <div class="col-7">
                                    <span class="badge bg-info">@Html.DisplayFor(model => model.StepIndex)</span>
                                </div>
                            </div>
                            <div class="row mb-2">
                                <div class="col-5"><strong>Sonraki Adım:</strong></div>
                                <div class="col-7">
                                    <span class="badge bg-success">@Html.DisplayFor(model => model.NextStepIndex)</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4">
                <form asp-action="Delete" id="deleteForm">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between">
                        <div>
                            <button type="submit" class="btn btn-danger px-4" id="deleteBtn">
                                <i class="fas fa-trash-alt me-2"></i>Evet, Sil
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                                <i class="fas fa-times me-2"></i>İptal
                            </a>
                        </div>
                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-outline-warning">
                            <i class="fas fa-edit me-2"></i>Düzenle
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .info-card {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            overflow: hidden;
        }

        .info-card-header {
            background-color: #f8f9fa;
            padding: 10px 15px;
            margin: 0;
            border-bottom: 1px solid #dee2e6;
            font-size: 1rem;
            font-weight: 600;
        }

        .info-card-body {
            padding: 15px;
        }

        .badge {
            font-size: 0.85em;
            padding: 5px 10px;
        }

        code {
            background-color: #f8f9fa;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.9em;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Delete confirmation with countdown
            $('#deleteBtn').click(function(e) {
                e.preventDefault();

                const btn = $(this);
                const originalText = btn.html();
                let countdown = 3;

                btn.prop('disabled', true);
                btn.html(`<i class="fas fa-clock me-2"></i>${countdown} saniye...`);

                const interval = setInterval(function() {
                    countdown--;
                    if (countdown > 0) {
                        btn.html(`<i class="fas fa-clock me-2"></i>${countdown} saniye...`);
                    } else {
                        clearInterval(interval);
                        btn.html(originalText);
                        btn.prop('disabled', false);

                        // Show final confirmation
                        if (confirm('Son uyarı! Bu kayıt silinecek. Devam etmek istiyor musunuz?')) {
                            $('#deleteForm').submit();
                        }
                    }
                }, 1000);
            });

            // Add animation for warning
            $('.alert-warning').addClass('animate__animated animate__headShake');

            // Toast container
            if ($('#toastContainer').length === 0) {
                $('body').append('<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            }
        });
    </script>
}