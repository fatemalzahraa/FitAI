@model ChatOption

@{
    ViewData["Title"] = "Yeni Sohbet Seçeneği";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h3 class="card-title mb-0">
                <i class="fas fa-plus-circle me-2"></i>Yeni Sohbet Seçeneği Oluştur
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-8">
                    <form asp-action="Create" id="chatOptionForm" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Scenario" class="form-control" placeholder="Senaryo" required />
                                    <label asp-for="Scenario" class="form-label"></label>
                                    <span asp-validation-for="Scenario" class="text-danger small"></span>
                                    <div class="form-text">Örn: FidanOnerisi, Bakim, Destek</div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <input asp-for="StepIndex" class="form-control" placeholder="Adım" type="number" min="0" required />
                                    <label asp-for="StepIndex" class="form-label"></label>
                                    <span asp-validation-for="StepIndex" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <input asp-for="NextStepIndex" class="form-control" placeholder="Sonraki Adım" type="number" min="0" required />
                                    <label asp-for="NextStepIndex" class="form-label"></label>
                                    <span asp-validation-for="NextStepIndex" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ButtonText" class="form-control" placeholder="Buton Metni" required />
                                    <label asp-for="ButtonText" class="form-label"></label>
                                    <span asp-validation-for="ButtonText" class="text-danger small"></span>
                                    <div class="form-text">Kullanıcının göreceği buton metni</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ActionValue" class="form-control" placeholder="Aksiyon Değeri" required />
                                    <label asp-for="ActionValue" class="form-label"></label>
                                    <span asp-validation-for="ActionValue" class="text-danger small"></span>
                                    <div class="form-text">Backend'e gönderilecek değer</div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-2"></i>Kaydet
                            </button>
                            <a asp-action="Index" class="btn btn-secondary ms-2">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                            <button type="button" class="btn btn-outline-info ms-2" id="previewBtn">
                                <i class="fas fa-eye me-2"></i>Önizleme
                            </button>
                        </div>
                    </form>
                </div>

                <div class="col-lg-4">
                    <div class="card border-info">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Önizleme</h6>
                        </div>
                        <div class="card-body">
                            <div class="chat-preview">
                                <div class="chat-message mb-2">Merhaba, size nasıl yardımcı olabilirim?</div>
                                <div class="chat-buttons" id="previewContainer">
                                    <div class="d-grid gap-2">
                                        <button class="btn btn-outline-primary text-start preview-button">
                                            <span id="previewButtonText">Buton Metni</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-lightbulb me-1"></i>
                                    <strong>Bilgi:</strong>
                                    <div>Adım: <span id="previewStep">0</span></div>
                                    <div>Sonraki Adım: <span id="previewNextStep">0</span></div>
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .chat-preview {
            background-color: #f8f9fa;
            border-radius: 10px;
            padding: 15px;
            border: 1px solid #dee2e6;
        }

        .chat-message {
            background-color: #e9ecef;
            padding: 10px 15px;
            border-radius: 15px;
            max-width: 80%;
        }

        .preview-button {
            transition: all 0.3s ease;
            border-radius: 20px;
            padding: 10px 15px;
        }

            .preview-button:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            }

        .form-floating > .form-control:focus ~ label,
        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: #0d6efd;
        }

        .card {
            border: none;
            border-radius: 10px;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Form validation
            var form = document.getElementById('chatOptionForm');
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);

            // Real-time preview
            function updatePreview() {
                $('#previewButtonText').text($('#Scenario').val() ? $('#Scenario').val() : 'Senaryo');
                $('.preview-button span').first().text($('#ButtonText').val() ? $('#ButtonText').val() : 'Buton Metni');
                $('#previewStep').text($('#StepIndex').val() ? $('#StepIndex').val() : '0');
                $('#previewNextStep').text($('#NextStepIndex').val() ? $('#NextStepIndex').val() : '0');
            }

            // Update preview on input change
            $('#Scenario, #ButtonText, #StepIndex, #NextStepIndex').on('input', updatePreview);

            // Initialize preview
            updatePreview();

            // Preview button click
            $('#previewBtn').click(function() {
                updatePreview();
                showToast('Önizleme güncellendi!', 'success');
            });

            // Toast notification function
            function showToast(message, type) {
                const toast = $(`<div class="toast align-items-center text-white bg-${type} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`);

                $('#toastContainer').append(toast);
                const bsToast = new bootstrap.Toast(toast[0]);
                bsToast.show();

                toast.on('hidden.bs.toast', function() {
                    $(this).remove();
                });
            }

            // Add toast container if not exists
            if ($('#toastContainer').length === 0) {
                $('body').append('<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            }
        });
    </script>
}