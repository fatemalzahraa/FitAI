@model ChatOption

@{
    ViewData["Title"] = "Sohbet Seçeneği Düzenle";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-warning text-dark">
            <h3 class="card-title mb-0">
                <i class="fas fa-edit me-2"></i>Sohbet Seçeneği Düzenle
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-8">
                    <form asp-action="Edit" id="editForm" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Scenario" class="form-control" placeholder="Senaryo" required />
                                    <label asp-for="Scenario" class="form-label"></label>
                                    <span asp-validation-for="Scenario" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <input asp-for="StepIndex" class="form-control" placeholder="Adım" type="number" min="0" required />
                                    <label asp-for="StepIndex" class="form-label"></label>
                                    <span asp-validation-for="StepIndex" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-floating">
                                    <input asp-for="NextStepIndex" class="form-control" placeholder="Sonraki Adım" type="number" min="0" required />
                                    <label asp-for="NextStepIndex" class="form-label"></label>
                                    <span asp-validation-for="NextStepIndex" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ButtonText" class="form-control" placeholder="Buton Metni" required />
                                    <label asp-for="ButtonText" class="form-label"></label>
                                    <span asp-validation-for="ButtonText" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="ActionValue" class="form-control" placeholder="Aksiyon Değeri" required />
                                    <label asp-for="ActionValue" class="form-label"></label>
                                    <span asp-validation-for="ActionValue" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info mt-4">
                            <h6><i class="fas fa-history me-2"></i>Değişiklik Geçmişi</h6>
                            <small>
                                Bu kayıt en son <strong>@DateTime.Now.AddDays(-1).ToString("dd.MM.yyyy HH:mm")</strong> tarihinde güncellenmiştir.<br>
                                Kayıt ID: <strong>@Model.Id</strong>
                            </small>
                        </div>

                        <div class="form-group mt-4">
                            <button type="submit" class="btn btn-warning px-4" id="saveBtn">
                                <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info ms-2">
                                <i class="fas fa-eye me-2"></i>Detaylar
                            </a>
                            <a asp-action="Index" class="btn btn-outline-secondary ms-2">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                            <button type="button" class="btn btn-outline-danger ms-2" id="resetBtn">
                                <i class="fas fa-undo me-2"></i>Sıfırla
                            </button>
                        </div>
                    </form>
                </div>

                <div class="col-lg-4">
                    <div class="card border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h6 class="mb-0"><i class="fas fa-chart-line me-2"></i>İstatistikler</h6>
                        </div>
                        <div class="card-body">
                            <div class="stat-item mb-3">
                                <div class="stat-label">Senaryo Değeri</div>
                                <div class="stat-value" id="currentScenario">@Model.Scenario</div>
                            </div>
                            <div class="stat-item mb-3">
                                <div class="stat-label">Adım İlerleme</div>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated"
                                         id="stepProgress"
                                         role="progressbar"
                                         style="width: 0%">
                                    </div>
                                </div>
                                <small class="text-muted" id="stepText">@Model.StepIndex → @Model.NextStepIndex</small>
                            </div>
                            <div class="stat-item">
                                <div class="stat-label">Buton Uzunluğu</div>
                                <div class="d-flex align-items-center">
                                    <div class="flex-grow-1">
                                        <div class="progress" style="height: 10px;">
                                            <div class="progress-bar bg-info"
                                                 id="buttonLengthProgress"
                                                 role="progressbar"
                                                 style="width: 0%">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="ms-2" id="buttonLength">0</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-floating > .form-control:focus {
            border-color: #ffc107;
            box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.25);
        }

        .stat-item {
            margin-bottom: 15px;
        }

        .stat-label {
            font-size: 0.85rem;
            color: #666;
            margin-bottom: 5px;
        }

        .stat-value {
            font-size: 1.2rem;
            font-weight: bold;
            color: #333;
        }

        .progress-bar-animated {
            animation: progress-animation 2s linear infinite;
        }
        @@keyframes progress-animation {
            from

        {
            background-position: 1rem 0;
        }

        to {
            background-position: 0 0;
        }

        }

        .card {
            border-radius: 10px;
            overflow: hidden;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Form validation
            var form = document.getElementById('editForm');
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);

            // Original values for reset
            const originalValues = {
                Scenario: $('#Scenario').val(),
                StepIndex: $('#StepIndex').val(),
                NextStepIndex: $('#NextStepIndex').val(),
                ButtonText: $('#ButtonText').val(),
                ActionValue: $('#ActionValue').val()
            };

            // Update statistics
            function updateStatistics() {
                const stepIndex = parseInt($('#StepIndex').val()) || 0;
                const nextStepIndex = parseInt($('#NextStepIndex').val()) || 0;
                const buttonText = $('#ButtonText').val() || '';

                // Update scenario
                $('#currentScenario').text($('#Scenario').val() || originalValues.Scenario);

                // Update step progress
                const maxStep = Math.max(stepIndex, nextStepIndex, 10);
                const progress = nextStepIndex > stepIndex ?
                    ((nextStepIndex / maxStep) * 100) :
                    ((stepIndex / maxStep) * 100);

                $('#stepProgress').css('width', progress + '%');
                $('#stepText').text(`${stepIndex} → ${nextStepIndex}`);

                // Update button length
                const buttonLength = buttonText.length;
                const maxLength = 50;
                const lengthProgress = Math.min((buttonLength / maxLength) * 100, 100);

                $('#buttonLengthProgress').css('width', lengthProgress + '%');
                $('#buttonLength').text(buttonLength);

                // Color coding for button length
                if (buttonLength > 30) {
                    $('#buttonLengthProgress').removeClass('bg-info bg-warning').addClass('bg-danger');
                } else if (buttonLength > 20) {
                    $('#buttonLengthProgress').removeClass('bg-info bg-danger').addClass('bg-warning');
                } else {
                    $('#buttonLengthProgress').removeClass('bg-warning bg-danger').addClass('bg-info');
                }
            }

            // Update on input change
            $('#Scenario, #StepIndex, #NextStepIndex, #ButtonText').on('input', updateStatistics);

            // Initialize statistics
            updateStatistics();

            // Reset button
            $('#resetBtn').click(function() {
                if (confirm('Tüm değişiklikleri sıfırlamak istediğinizden emin misiniz?')) {
                    $('#Scenario').val(originalValues.Scenario);
                    $('#StepIndex').val(originalValues.StepIndex);
                    $('#NextStepIndex').val(originalValues.NextStepIndex);
                    $('#ButtonText').val(originalValues.ButtonText);
                    $('#ActionValue').val(originalValues.ActionValue);

                    updateStatistics();
                    form.classList.remove('was-validated');

                    showToast('Değişiklikler sıfırlandı!', 'info');
                }
            });

            // Save button animation
            $('#saveBtn').click(function() {
                const btn = $(this);
                btn.prop('disabled', true);
                btn.html('<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...');

                setTimeout(() => {
                    btn.prop('disabled', false);
                    btn.html('<i class="fas fa-save me-2"></i>Değişiklikleri Kaydet');
                    showToast('Değişiklikler kaydedildi!', 'success');
                }, 1500);
            });

            // Toast function
            function showToast(message, type) {
                const toast = $(`<div class="toast align-items-center text-white bg-${type} border-0" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`);

                $('#toastContainer').append(toast);
                const bsToast = new bootstrap.Toast(toast[0]);
                bsToast.show();

                toast.on('hidden.bs.toast', function() {
                    $(this).remove();
                });
            }

            // Add toast container if not exists
            if ($('#toastContainer').length === 0) {
                $('body').append('<div id="toastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>');
            }
        });
    </script>
}