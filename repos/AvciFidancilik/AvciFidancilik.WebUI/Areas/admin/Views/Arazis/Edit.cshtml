@model Eticaret.Data.Entities.Arazi

@{
    ViewData["Title"] = "Arazi Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-edit fa-2x me-3"></i>
                        <div>
                            <h1 class="h3 mb-0">Arazi Düzenle</h1>
                            <p class="mb-0 opacity-75">Arazi bilgilerini güncelleyiniz</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" id="editForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <div class="form-floating">
                                    <input asp-for="Donum" class="form-control form-control-lg"
                                           placeholder="Dönüm" />
                                    <label asp-for="Donum" class="form-label">
                                        <i class="fas fa-ruler-combined me-2"></i>Dönüm
                                    </label>
                                    <span asp-validation-for="Donum" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-12 mb-4">
                                <div class="form-floating">
                                    <input asp-for="Sehir" class="form-control form-control-lg"
                                           placeholder="Şehir" />
                                    <label asp-for="Sehir" class="form-label">
                                        <i class="fas fa-city me-2"></i>Şehir
                                    </label>
                                    <span asp-validation-for="Sehir" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <div class="col-md-12 mb-4">
                                <div class="form-floating">
                                    <input asp-for="ToprakTipi" class="form-control form-control-lg"
                                           placeholder="Toprak Tipi" />
                                    <label asp-for="ToprakTipi" class="form-label">
                                        <i class="fas fa-mountain me-2"></i>Toprak Tipi
                                    </label>
                                    <span asp-validation-for="ToprakTipi" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="fas fa-times me-2"></i>İptal
                            </a>
                            <div class="btn-group">
                                <a asp-action="Details" asp-route-id="@Model.Id"
                                   class="btn btn-info btn-lg">
                                    <i class="fas fa-eye me-2"></i>Detaylar
                                </a>
                                <button type="submit" class="btn btn-primary btn-lg px-5">
                                    <i class="fas fa-check me-2"></i>Güncelle
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .form-control-lg {
            height: calc(3.5rem + 2px);
            padding: 1rem 1rem;
            font-size: 1.1rem;
        }

        .form-floating > label {
            padding: 1rem 1rem;
        }

        .card {
            border-radius: 20px;
            overflow: hidden;
        }

        .form-control:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25);
        }

        .btn-group .btn {
            border-radius: 8px !important;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Form submit animasyonu
            $('#editForm').submit(function() {
                $('button[type="submit"]').html('<i class="fas fa-spinner fa-spin me-2"></i>Güncelleniyor...');
                $('button[type="submit"]').prop('disabled', true);
            });
        });
    </script>
}