@model Eticaret.Data.Entities.Arazi

@{
    ViewData["Title"] = "Arazi Sil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-danger text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                        <div>
                            <h1 class="h3 mb-0">Arazi Silme</h1>
                            <p class="mb-0 opacity-75">Bu işlem geri alınamaz!</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        <strong>Uyarı!</strong> Bu arazinin kaydını silmek üzeresiniz. Bu işlem geri alınamaz.
                    </div>

                    <div class="delete-preview mb-4 p-4 rounded bg-light border">
                        <h4 class="text-center text-danger mb-4">
                            <i class="fas fa-tractor me-2"></i>Silinecek Arazi Bilgileri
                        </h4>

                        <div class="info-grid">
                            <div class="info-item text-center mb-3">
                                <div class="icon-wrapper mb-2">
                                    <i class="fas fa-ruler-combined fa-2x text-primary"></i>
                                </div>
                                <div class="fw-bold">Dönüm</div>
                                <div class="fs-5 fw-bold text-primary">@Html.DisplayFor(model => model.Donum)</div>
                            </div>

                            <div class="info-item text-center mb-3">
                                <div class="icon-wrapper mb-2">
                                    <i class="fas fa-city fa-2x text-success"></i>
                                </div>
                                <div class="fw-bold">Şehir</div>
                                <div class="fs-5 fw-bold text-success">@Html.DisplayFor(model => model.Sehir)</div>
                            </div>

                            <div class="info-item text-center mb-3">
                                <div class="icon-wrapper mb-2">
                                    <i class="fas fa-mountain fa-2x text-warning"></i>
                                </div>
                                <div class="fw-bold">Toprak Tipi</div>
                                <div class="fs-5 fw-bold text-warning">@Html.DisplayFor(model => model.ToprakTipi)</div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" id="deleteForm">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-success btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Vazgeç
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg px-5" id="deleteBtn">
                                <i class="fas fa-trash-alt me-2"></i>Sil
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 20px;
            overflow: hidden;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 15px;
        }

        .icon-wrapper {
            background: white;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto;
            box-shadow: 0 3px 10px rgba(0,0,0,0.1);
        }

        .delete-preview {
            border: 2px dashed #dc3545 !important;
            animation: pulse 2s infinite;
        }

        #deleteBtn {
            position: relative;
            overflow: hidden;
        }

            #deleteBtn:hover {
                transform: scale(1.05);
                transition: transform 0.3s ease;
            }

        @@keyframes pulse {
            0% {
                border-color: #dc3545;
            }

            50% {
                border-color: #ffc107;
            }

            100% {
                border-color: #dc3545;
            }
        }

        @@media (max-width: 768px) {
            .info-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            let isDeleting = false;

            // Silme butonuna tıklanınca
            $('#deleteBtn').click(function(e) {
                if(!isDeleting) {
                    e.preventDefault();

                    // Onay modalı göster
                    showConfirmationModal();
                }
            });

            function showConfirmationModal() {
                // Bootstrap modal ile onay
                const modalHtml = `
                    <div class="modal fade" id="confirmModal" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content border-danger">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        Son Onay
                                    </h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body text-center">
                                    <i class="fas fa-trash fa-4x text-danger mb-3"></i>
                                    <h4 class="mb-3">Emin misiniz?</h4>
                                    <p class="text-muted">
                                        "<strong>@Model.Sehir</strong>" şehrindeki
                                        <strong>@Model.Donum dönümlük</strong> araziyi
                                        kalıcı olarak silmek istiyor musunuz?
                                    </p>
                                    <div class="form-check mt-3">
                                        <input class="form-check-input" type="checkbox" id="finalConfirm">
                                        <label class="form-check-label" for="finalConfirm">
                                            Evet, bu kaydı silmek istediğimi onaylıyorum
                                        </label>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                                        <i class="fas fa-times me-2"></i>İptal
                                    </button>
                                    <button type="button" class="btn btn-danger" id="finalDeleteBtn" disabled>
                                        <i class="fas fa-trash-alt me-2"></i>Kalıcı Olarak Sil
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;

                $('body').append(modalHtml);
                const modal = new bootstrap.Modal(document.getElementById('confirmModal'));
                modal.show();

                // Checkbox değişikliğini dinle
                $('#finalConfirm').change(function() {
                    $('#finalDeleteBtn').prop('disabled', !$(this).is(':checked'));
                });

                // Final delete butonu
                $('#finalDeleteBtn').click(function() {
                    isDeleting = true;
                    $('#deleteBtn').html('<i class="fas fa-spinner fa-spin me-2"></i>Siliniyor...');
                    $('#deleteBtn').prop('disabled', true);
                    modal.hide();
                    $('#deleteForm').submit();
                });

                // Modal kapanınca temizle
                $('#confirmModal').on('hidden.bs.modal', function () {
                    $(this).remove();
                });
            }
        });
    </script>
}