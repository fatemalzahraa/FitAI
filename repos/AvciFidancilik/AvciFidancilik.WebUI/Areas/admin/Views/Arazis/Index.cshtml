@model IEnumerable<Eticaret.Data.Entities.Arazi>

@{
    ViewData["Title"] = "Arazi Kayıtları";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 text-primary"><i class="fas fa-tractor me-2"></i>Arazi Kayıtları</h1>
        <a asp-action="Create" class="btn btn-success btn-lg">
            <i class="fas fa-plus-circle me-2"></i>Yeni Arazi Ekle
        </a>
    </div>

    <div class="card shadow-lg border-0">
        <div class="card-header bg-gradient-primary text-white">
            <h5 class="mb-0"><i class="fas fa-list me-2"></i>Arazi Listesi</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th><i class="fas fa-ruler-combined me-2"></i>@Html.DisplayNameFor(model => model.Donum)</th>
                            <th><i class="fas fa-city me-2"></i>@Html.DisplayNameFor(model => model.Sehir)</th>
                            <th><i class="fas fa-mountain me-2"></i>@Html.DisplayNameFor(model => model.ToprakTipi)</th>
                            <th class="text-center"><i class="fas fa-cogs me-2"></i>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">
                                <td class="fw-bold">@Html.DisplayFor(modelItem => item.Donum) Dönüm</td>
                                <td>
                                    <span class="badge bg-info text-dark fs-6">
                                        @Html.DisplayFor(modelItem => item.Sehir)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark fs-6">
                                        @Html.DisplayFor(modelItem => item.ToprakTipi)
                                    </span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary btn-sm"
                                           title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-info btn-sm"
                                           title="Detaylar">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger btn-sm"
                                           title="Sil">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted text-center">
            <small><i class="fas fa-info-circle me-1"></i>Toplam @Model.Count() arazi kaydı bulunmaktadır.</small>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .table-hover tbody tr:hover {
            background-color: rgba(13, 110, 253, 0.05);
            transform: scale(1.005);
            transition: all 0.3s ease;
        }

        .btn-group .btn {
            border-radius: 5px !important;
            margin: 0 2px;
        }

        .card {
            border-radius: 15px;
            overflow: hidden;
        }

        .badge {
            padding: 8px 12px;
            font-weight: 500;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Tooltip'leri aktif et
            $('[title]').tooltip();

            // Tablo satırlarına hover efekti
            $('tbody tr').hover(
                function() {
                    $(this).addClass('shadow-sm');
                },
                function() {
                    $(this).removeClass('shadow-sm');
                }
            );
        });
    </script>
}