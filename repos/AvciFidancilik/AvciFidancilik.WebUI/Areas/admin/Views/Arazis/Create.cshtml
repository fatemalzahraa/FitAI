@model Eticaret.Data.Entities.Arazi

@{
    ViewData["Title"] = "Yeni Arazi Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header custom-gradient-header py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-plus-circle fa-2x me-3 header-icon"></i>
                        <div>
                            <h1 class="h3 mb-0 header-title">Yeni Arazi Ekle</h1>
                            <p class="mb-0 header-subtitle">Arazi bilgilerini aşağıdaki form üzerinden giriniz</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 card-custom-bg">
                    <form asp-action="Create" id="createForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-custom"></div>

                        <div class="row">
                            <div class="col-md-12 mb-4">
                                <div class="form-floating">
                                    <input asp-for="Donum" class="form-control form-control-custom"
                                           placeholder="Dönüm"
                                           id="donumInput" />
                                    <label asp-for="Donum" class="form-label floating-label">
                                        <i class="fas fa-ruler-combined me-2 input-icon"></i>Dönüm
                                    </label>
                                    <span asp-validation-for="Donum" class="validation-error"></span>
                                </div>
                            </div>

                            <div class="col-md-12 mb-4">
                                <div class="form-floating">
                                    <input asp-for="Sehir" class="form-control form-control-custom"
                                           placeholder="Şehir" />
                                    <label asp-for="Sehir" class="form-label floating-label">
                                        <i class="fas fa-city me-2 input-icon"></i>Şehir
                                    </label>
                                    <span asp-validation-for="Sehir" class="validation-error"></span>
                                </div>
                            </div>

                            <div class="col-md-12 mb-4">
                                <div class="form-floating">
                                    <input asp-for="ToprakTipi" class="form-control form-control-custom"
                                           placeholder="Toprak Tipi" />
                                    <label asp-for="ToprakTipi" class="form-label floating-label">
                                        <i class="fas fa-mountain me-2 input-icon"></i>Toprak Tipi
                                    </label>
                                    <span asp-validation-for="ToprakTipi" class="validation-error"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top border-custom">
                            <a asp-action="Index" class="btn btn-custom-secondary btn-lg">
                                <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-custom-primary btn-lg px-5">
                                <i class="fas fa-save me-2"></i>Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Özel Renk Paleti */
        :root {
            --primary-color: #4361ee; /* Mor-Mavi */
            --secondary-color: #3f37c9; /* Koyu Mor-Mavi */
            --accent-color: #4cc9f0; /* Açık Mavi */
            --success-color: #4ad66d; /* Yeşil */
            --warning-color: #ff9e00; /* Turuncu */
            --danger-color: #ff6b6b; /* Kırmızı */
            --light-color: #f8f9fa; /* Açık Gri */
            --dark-color: #212529; /* Koyu Gri */
            --card-bg: #ffffff; /* Kart arkaplan */
            --border-color: #dee2e6; /* Kenarlık rengi */
        }

        /* Kart Başlığı */
        .custom-gradient-header {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%) !important;
            color: white !important;
        }

        .header-icon {
            color: var(--accent-color) !important;
        }

        .header-title {
            color: white !important;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.2);
        }

        .header-subtitle {
            color: rgba(255, 255, 255, 0.85) !important;
        }

        /* Kart Gövdesi */
        .card-custom-bg {
            background-color: var(--card-bg) !important;
        }

        .card {
            border-radius: 20px !important;
            overflow: hidden !important;
            border: 2px solid var(--border-color) !important;
            box-shadow: 0 10px 30px rgba(67, 97, 238, 0.15) !important;
        }

        /* Form Kontrolleri */
        .form-control-custom {
            height: calc(3.5rem + 2px) !important;
            padding: 1rem 1rem !important;
            font-size: 1.1rem !important;
            border: 2px solid var(--border-color) !important;
            border-radius: 12px !important;
            background-color: var(--light-color) !important;
            transition: all 0.3s ease !important;
        }

            .form-control-custom:focus {
                border-color: var(--primary-color) !important;
                box-shadow: 0 0 0 0.25rem rgba(67, 97, 238, 0.25) !important;
                background-color: white !important;
                transform: translateY(-2px) !important;
            }

        /* Floating Label */
        .floating-label {
            padding: 1rem 1rem !important;
            color: var(--secondary-color) !important;
            font-weight: 500 !important;
        }

        .form-floating > .form-control-custom:focus ~ .floating-label,
        .form-floating > .form-control-custom:not(:placeholder-shown) ~ .floating-label {
            color: var(--primary-color) !important;
            font-weight: 600 !important;
        }

        /* Input İkonları */
        .input-icon {
            color: var(--primary-color) !important;
        }

        /* Validasyon Hataları */
        .validation-error {
            color: var(--danger-color) !important;
            font-size: 0.875rem !important;
            margin-top: 0.5rem !important;
            display: block !important;
        }

        .alert-custom {
            background-color: rgba(255, 107, 107, 0.1) !important;
            border: 1px solid var(--danger-color) !important;
            color: var(--danger-color) !important;
            border-radius: 10px !important;
        }

        /* Butonlar */
        .btn-custom-primary {
            background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%) !important;
            border: none !important;
            color: white !important;
            border-radius: 12px !important;
            transition: all 0.3s ease !important;
            position: relative !important;
            overflow: hidden !important;
        }

            .btn-custom-primary:hover {
                transform: translateY(-3px) !important;
                box-shadow: 0 10px 20px rgba(67, 97, 238, 0.3) !important;
            }

            .btn-custom-primary:active {
                transform: translateY(-1px) !important;
            }

            .btn-custom-primary::after {
                content: '' !important;
                position: absolute !important;
                top: 50% !important;
                left: 50% !important;
                width: 5px !important;
                height: 5px !important;
                background: rgba(255, 255, 255, 0.5) !important;
                opacity: 0 !important;
                border-radius: 100% !important;
                transform: scale(1, 1) translate(-50%) !important;
                transform-origin: 50% 50% !important;
            }

            .btn-custom-primary:focus:not(:active)::after {
                animation: ripple 1s ease-out !important;
            }

        .btn-custom-secondary {
            background-color: var(--light-color) !important;
            border: 2px solid var(--border-color) !important;
            color: var(--secondary-color) !important;
            border-radius: 12px !important;
            transition: all 0.3s ease !important;
        }

            .btn-custom-secondary:hover {
                background-color: var(--primary-color) !important;
                border-color: var(--primary-color) !important;
                color: white !important;
                transform: translateY(-2px) !important;
                box-shadow: 0 5px 15px rgba(67, 97, 238, 0.2) !important;
            }

        /* Kenarlıklar */
        .border-custom {
            border-color: var(--border-color) !important;
        }

        /* Animasyonlar */
        @@keyframes ripple {
            0% {
                transform: scale(0, 0) !important;
                opacity: 0.5 !important;
            }

            100% {
                transform: scale(20, 20) !important;
                opacity: 0 !important;
            }
        }

        /* Responsive Düzenlemeler */
        @@media (max-width: 768px) {
            .form-control-custom {
                height: calc(3rem + 2px) !important;
                font-size: 1rem !important;
            }

            .btn-lg {
                padding: 0.75rem 1.5rem !important;
                font-size: 1rem !important;
            }

            .card {
                border-radius: 15px !important;
            }
        }

        /* Giriş alanları için placeholder stil */
        .form-control-custom::placeholder {
            color: #adb5bd !important;
            opacity: 0.7 !important;
        }

        /* İkonlar için hover efekti */
        .input-icon {
            transition: transform 0.3s ease !important;
        }

        .form-floating:hover .input-icon {
            transform: scale(1.1) !important;
        }

        /* Kart hover efekti */
        .card:hover {
            box-shadow: 0 15px 35px rgba(67, 97, 238, 0.2) !important;
            transform: translateY(-5px) !important;
            transition: all 0.3s ease !important;
        }

        /* Form grup animasyonu */
        .form-floating {
            animation: fadeInUp 0.5s ease-out !important;
            animation-fill-mode: both !important;
        }

            .form-floating:nth-child(1) {
                animation-delay: 0.1s !important;
            }

            .form-floating:nth-child(2) {
                animation-delay: 0.2s !important;
            }

            .form-floating:nth-child(3) {
                animation-delay: 0.3s !important;
            }

        @@keyframes fadeInUp {
            from {
                opacity: 0 !important;
                transform: translateY(20px) !important;
            }

            to {
                opacity: 1 !important;
                transform: translateY(0) !important;
            }
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function() {
            // Form submit animasyonu
            $('#createForm').submit(function() {
                $('button[type="submit"]').html('<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...');
                $('button[type="submit"]').prop('disabled', true);

                // Butona loading efekti ekle
                $('button[type="submit"]').addClass('loading');
            });

            // Dönüm input'u için özel format
            $('#donumInput').on('input', function() {
                let value = $(this).val().replace(/[^0-9.]/g, '');
                $(this).val(value);

                // Pozitif feedback efekti
                if (value && !isNaN(value)) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                    $(this).next('.floating-label').find('.input-icon').css('color', 'var(--success-color)');
                } else if (value) {
                    $(this).addClass('is-invalid');
                    $(this).next('.floating-label').find('.input-icon').css('color', 'var(--danger-color)');
                } else {
                    $(this).removeClass('is-valid is-invalid');
                    $(this).next('.floating-label').find('.input-icon').css('color', 'var(--primary-color)');
                }
            });

            // Diğer input'lar için validasyon feedback'i
            $('input.form-control-custom').not('#donumInput').on('input', function() {
                if ($(this).val().trim()) {
                    $(this).removeClass('is-invalid').addClass('is-valid');
                    $(this).next('.floating-label').find('.input-icon').css('color', 'var(--success-color)');
                } else {
                    $(this).removeClass('is-valid');
                    $(this).next('.floating-label').find('.input-icon').css('color', 'var(--primary-color)');
                }
            });

            // Input'lara focus olduğunda label rengi değişimi
            $('.form-control-custom').on('focus', function() {
                $(this).next('.floating-label').find('.input-icon').css({
                    'transform': 'scale(1.2)',
                    'color': 'var(--accent-color)'
                });
            }).on('blur', function() {
                $(this).next('.floating-label').find('.input-icon').css('transform', 'scale(1)');
            });

            // Sayfa yüklendiğinde fade in efekti
            $('.card').css('opacity', '0').animate({ opacity: 1 }, 800);

            // Form validasyon için özel mesajlar
            $.validator.setDefaults({
                highlight: function(element) {
                    $(element).addClass('is-invalid').removeClass('is-valid');
                    $(element).next('.floating-label').find('.input-icon').css('color', 'var(--danger-color)');
                },
                unhighlight: function(element) {
                    if ($(element).val().trim()) {
                        $(element).removeClass('is-invalid').addClass('is-valid');
                        $(element).next('.floating-label').find('.input-icon').css('color', 'var(--success-color)');
                    } else {
                        $(element).removeClass('is-invalid is-valid');
                        $(element).next('.floating-label').find('.input-icon').css('color', 'var(--primary-color)');
                    }
                },
                errorElement: 'span',
                errorClass: 'validation-error',
                errorPlacement: function(error, element) {
                    error.insertAfter(element);
                }
            });
        });
    </script>
}