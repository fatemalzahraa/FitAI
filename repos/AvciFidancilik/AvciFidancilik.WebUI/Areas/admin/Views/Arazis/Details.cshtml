@model Eticaret.Data.Entities.Arazi

@{
    ViewData["Title"] = "Arazi Detayları";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-info text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-info-circle fa-2x me-3"></i>
                        <div>
                            <h1 class="h3 mb-0">Arazi Detayları</h1>
                            <p class="mb-0 opacity-75">Arazi bilgilerini görüntüleyiniz</p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <!-- Arazi Görseli (Simülasyon) -->
                        <div class="col-md-4 mb-4">
                            <div class="text-center">
                                <div class="land-visual mb-3" id="landVisual">
                                    <i class="fas fa-tractor fa-6x text-success"></i>
                                </div>
                                <span class="badge bg-primary fs-5 p-3">
                                    ID: @Html.DisplayFor(model => model.Id)
                                </span>
                            </div>
                        </div>

                        <!-- Arazi Detayları -->
                        <div class="col-md-8">
                            <div class="details-container">
                                <div class="detail-item mb-4 p-3 rounded bg-light">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-ruler-combined fa-lg text-primary me-3"></i>
                                        <h5 class="mb-0 text-muted">Dönüm</h5>
                                    </div>
                                    <h2 class="fw-bold text-primary mb-0">
                                        @Html.DisplayFor(model => model.Donum)
                                        <small class="fs-6 text-muted">Dönüm</small>
                                    </h2>
                                </div>

                                <div class="detail-item mb-4 p-3 rounded bg-light">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-city fa-lg text-success me-3"></i>
                                        <h5 class="mb-0 text-muted">Şehir</h5>
                                    </div>
                                    <h2 class="fw-bold text-success mb-0">
                                        @Html.DisplayFor(model => model.Sehir)
                                    </h2>
                                </div>

                                <div class="detail-item mb-4 p-3 rounded bg-light">
                                    <div class="d-flex align-items-center mb-2">
                                        <i class="fas fa-mountain fa-lg text-warning me-3"></i>
                                        <h5 class="mb-0 text-muted">Toprak Tipi</h5>
                                    </div>
                                    <h2 class="fw-bold text-warning mb-0">
                                        @Html.DisplayFor(model => model.ToprakTipi)
                                    </h2>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                        </a>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn btn-primary btn-lg">
                                <i class="fas fa-edit me-2"></i>Düzenle
                            </a>
                            <a asp-action="Delete" asp-route-id="@Model.Id"
                               class="btn btn-danger btn-lg">
                                <i class="fas fa-trash me-2"></i>Sil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border-radius: 20px;
            overflow: hidden;
        }

        .land-visual {
            background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
            border-radius: 15px;
            padding: 40px 20px;
            border: 3px dashed #4caf50;
        }

        .detail-item {
            transition: all 0.3s ease;
            border-left: 5px solid;
        }

            .detail-item:nth-child(1) {
                border-left-color: #0d6efd;
            }

            .detail-item:nth-child(2) {
                border-left-color: #198754;
            }

            .detail-item:nth-child(3) {
                border-left-color: #ffc107;
            }

            .detail-item:hover {
                transform: translateX(5px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.1);
            }

        .btn-group .btn {
            border-radius: 8px !important;
            margin-left: 10px;
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Toprak tipine göre görsel renk değiştirme
            const toprakTipi = "@Model.ToprakTipi".toLowerCase();
            const landVisual = $('#landVisual');

            if(toprakTipi.includes('kumlu') || toprakTipi.includes('kum')) {
                landVisual.css({
                    'background': 'linear-gradient(135deg, #fff3cd 0%, #ffecb5 100%)',
                    'border-color': '#ffc107'
                });
            } else if(toprakTipi.includes('kil') || toprakTipi.includes('balçık')) {
                landVisual.css({
                    'background': 'linear-gradient(135deg, #d7ccc8 0%, #bcaaa4 100%)',
                    'border-color': '#795548'
                });
            } else if(toprakTipi.includes('verimli') || toprakTipi.includes('humus')) {
                landVisual.css({
                    'background': 'linear-gradient(135deg, #8bc34a 0%, #689f38 100%)',
                    'border-color': '#4caf50'
                });
            }
        });
    </script>
}