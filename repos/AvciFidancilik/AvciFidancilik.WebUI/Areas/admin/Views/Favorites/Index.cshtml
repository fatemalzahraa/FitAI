@model IEnumerable<Eticaret.Core.Entities.Favorite>

@{
    ViewData["Title"] = "Favori Ürünler";
}

<style>
    :root {
        --primary-color: #4361ee;
        --secondary-color: #3a0ca3;
        --success-color: #4cc9f0;
        --warning-color: #f72585;
        --light-color: #f8f9fa;
        --dark-color: #212529;
        --border-radius: 12px;
        --box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        --transition: all 0.3s ease;
    }

    body {
        background-color: #f5f7fb;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        color: #333;
        line-height: 1.6;
        padding: 20px;
    }

    .page-container {
        max-width: 1400px;
        margin: 0 auto;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 30px;
        background: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
        color: white;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
    }

        .page-header h1 {
            font-size: 2.8rem;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .page-header .subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
            max-width: 600px;
            margin: 0 auto;
        }

    .action-buttons {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        flex-wrap: wrap;
        gap: 20px;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, #4cc9f0 0%, #4361ee 100%);
        color: white;
        border: none;
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: var(--transition);
        box-shadow: 0 4px 15px rgba(67, 97, 238, 0.2);
    }

        .btn-primary-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(67, 97, 238, 0.3);
            color: white;
            text-decoration: none;
        }

    .search-filter {
        display: flex;
        gap: 15px;
        align-items: center;
        flex-wrap: wrap;
    }

    .search-box {
        position: relative;
        min-width: 300px;
    }

        .search-box input {
            width: 100%;
            padding: 12px 45px 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 8px;
            font-size: 1rem;
            transition: var(--transition);
        }

            .search-box input:focus {
                outline: none;
                border-color: var(--primary-color);
                box-shadow: 0 0 0 3px rgba(67, 97, 238, 0.1);
            }

        .search-box i {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #666;
        }

    .filter-btn {
        background: white;
        border: 2px solid #e0e0e0;
        padding: 10px 20px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #333;
        text-decoration: none;
        transition: var(--transition);
    }

        .filter-btn:hover {
            border-color: var(--primary-color);
            color: var(--primary-color);
            text-decoration: none;
        }

    .table-container {
        background: white;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        overflow: hidden;
        margin-bottom: 30px;
    }

    .favorites-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 800px;
    }

        .favorites-table thead {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        }

        .favorites-table th {
            padding: 20px;
            text-align: left;
            font-weight: 600;
            color: var(--dark-color);
            border-bottom: 2px solid #e0e0e0;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .favorites-table td {
            padding: 18px 20px;
            border-bottom: 1px solid #f0f0f0;
            vertical-align: middle;
        }

        .favorites-table tbody tr {
            transition: var(--transition);
        }

            .favorites-table tbody tr:hover {
                background-color: rgba(67, 97, 238, 0.05);
                transform: translateX(5px);
            }

    .user-info-cell, .product-info-cell {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .user-avatar, .product-icon {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
        color: white;
    }

    .user-avatar {
        background: linear-gradient(135deg, #4cc9f0 0%, #3a0ca3 100%);
    }

    .product-icon {
        background: linear-gradient(135deg, #f72585 0%, #7209b7 100%);
    }

    .user-details, .product-details {
        display: flex;
        flex-direction: column;
    }

    .user-email {
        font-weight: 600;
        color: var(--dark-color);
        font-size: 1rem;
    }

    .user-id {
        font-size: 0.85rem;
        color: #666;
    }

    .product-name {
        font-weight: 600;
        color: var(--dark-color);
        margin-bottom: 4px;
        font-size: 1rem;
    }

    .product-description {
        font-size: 0.9rem;
        color: #666;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .action-buttons-cell {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .btn-action {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        text-decoration: none;
        transition: var(--transition);
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }

    .btn-view {
        background: var(--primary-color);
    }

        .btn-view:hover {
            background: var(--secondary-color);
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(67, 97, 238, 0.3);
        }

    .btn-edit {
        background: #28a745;
    }

        .btn-edit:hover {
            background: #218838;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
        }

    .btn-delete {
        background: var(--warning-color);
    }

        .btn-delete:hover {
            background: #d11450;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(247, 37, 133, 0.3);
        }

    .no-data {
        text-align: center;
        padding: 60px 20px;
    }

        .no-data i {
            font-size: 4rem;
            color: #ccc;
            margin-bottom: 20px;
        }

        .no-data h3 {
            color: #666;
            margin-bottom: 15px;
        }

        .no-data p {
            color: #888;
            max-width: 500px;
            margin: 0 auto 25px;
        }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 30px;
        padding-top: 30px;
        border-top: 1px solid #e0e0e0;
    }

    .page-item {
        list-style: none;
    }

    .page-link {
        display: block;
        padding: 10px 18px;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        color: var(--dark-color);
        text-decoration: none;
        transition: var(--transition);
    }

        .page-link:hover {
            background-color: #f8f9fa;
            border-color: var(--primary-color);
            color: var(--primary-color);
        }

    .active .page-link {
        background: linear-gradient(135deg, #4361ee 0%, #3a0ca3 100%);
        color: white;
        border-color: var(--primary-color);
    }

    .stats-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: var(--border-radius);
        padding: 25px;
        text-align: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
        transition: var(--transition);
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
        }

        .stat-card i {
            font-size: 2.5rem;
            color: var(--primary-color);
            margin-bottom: 15px;
        }

        .stat-card .stat-number {
            font-size: 2.2rem;
            font-weight: 700;
            color: var(--dark-color);
            margin: 10px 0;
        }

        .stat-card .stat-label {
            color: #666;
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

    @@media (max-width: 768px) {
        .page-header h1 {
            font-size: 2rem;
        }

        .action-buttons {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            min-width: 100%;
        }

        .table-container {
            overflow-x: auto;
        }

        .favorites-table {
            min-width: 600px;
        }

        .action-buttons-cell {
            justify-content: center;
        }
    }
</style>

<div class="page-container">
    <div class="page-header">
        <h1><i class="fas fa-heart"></i> Favori Ürünler</h1>
        <p class="subtitle">Tüm favori ürün kayıtlarınızı burada görüntüleyebilir ve yönetebilirsiniz</p>
    </div>

    <div class="stats-cards">
        <div class="stat-card">
            <i class="fas fa-heart"></i>
            <div class="stat-number">@Model.Count()</div>
            <div class="stat-label">Toplam Favori</div>
        </div>
        <div class="stat-card">
            <i class="fas fa-users"></i>
            <div class="stat-number">@Model.Select(f => f.UserId).Distinct().Count()</div>
            <div class="stat-label">Kullanıcı Sayısı</div>
        </div>
        <div class="stat-card">
            <i class="fas fa-boxes"></i>
            <div class="stat-number">@Model.Select(f => f.ProductId).Distinct().Count()</div>
            <div class="stat-label">Farklı Ürün</div>
        </div>
    </div>

    <div class="action-buttons">
        <a asp-action="Create" class="btn-primary-custom">
            <i class="fas fa-plus-circle"></i> Yeni Favori Ekle
        </a>

        <div class="search-filter">
            <div class="search-box">
                <input type="text" id="searchInput" placeholder="Kullanıcı veya ürün ara...">
                <i class="fas fa-search"></i>
            </div>
            <a href="#" class="filter-btn">
                <i class="fas fa-filter"></i> Filtrele
            </a>
        </div>
    </div>

    <div class="table-container">
        @if (!Model.Any())
        {
            <div class="no-data">
                <i class="fas fa-heart-broken"></i>
                <h3>Henüz favori ürün bulunmuyor</h3>
                <p>Kullanıcılar henüz hiçbir ürünü favorilerine eklemedi. Yeni bir favori eklemek için "Yeni Favori Ekle" butonuna tıklayın.</p>
                <a asp-action="Create" class="btn-primary-custom">
                    <i class="fas fa-plus-circle"></i> İlk Favoriyi Ekle
                </a>
            </div>
        }
        else
        {
            <table class="favorites-table">
                <thead>
                    <tr>
                        <th style="width: 30px;">#</th>
                        <th>Kullanıcı</th>
                        <th>Ürün</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int counter = 1;
                        foreach (var item in Model)
                        {
                            var userEmail = item.User?.Email ?? "";
                            var productDescription = item.Product?.Description ?? "";
                            var productName = item.Product?.Name ?? "";

                            <tr data-search="@(userEmail?.ToLower() ?? "") @(productDescription?.ToLower() ?? "")">
                                <td style="text-align: center; font-weight: 600; color: #666;">@counter</td>
                                <td>
                                    @if (item.User != null)
                                    {
                                        <div class="user-info-cell">
                                            <div class="user-avatar">
                                                @(userEmail?.Substring(0, 1).ToUpper() ?? "?")
                                            </div>
                                            <div class="user-details">
                                                <span class="user-email">@userEmail</span>
                                                <span class="user-id">ID: @item.UserId</span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Kullanıcı bulunamadı</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Product != null)
                                    {
                                        <div class="product-info-cell">
                                            <div class="product-icon">
                                                <i class="fas fa-box"></i>
                                            </div>
                                            <div class="product-details">
                                                <span class="product-name">@productName</span>
                                                <span class="product-description" title="@productDescription">
                                                    @productDescription
                                                </span>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Ürün bulunamadı</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons-cell">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn-action btn-view"
                                           title="Detayları Görüntüle">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn-action btn-edit"
                                           title="Düzenle">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn-action btn-delete"
                                           title="Sil"
                                           onclick="return confirm('Bu favoriyi silmek istediğinizden emin misiniz?')">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                            counter++;
                        }
                    }
                </tbody>
            </table>
        }
    </div>

    <!-- Basit sayfalama (isteğe bağlı) -->
    @if (Model.Any())
    {
        <div class="pagination">
            <ul style="display: flex; list-style: none; padding: 0; margin: 0; gap: 8px;">
                <li class="page-item active">
                    <a class="page-link" href="#">1</a>
                </li>
                <!-- Diğer sayfa linkleri buraya eklenebilir -->
            </ul>
        </div>
    }
</div>

<!-- Font Awesome ikonları -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script>
    // Arama fonksiyonu
    document.addEventListener('DOMContentLoaded', function () {
        const searchInput = document.getElementById('searchInput');
        const tableRows = document.querySelectorAll('.favorites-table tbody tr');

        if (searchInput && tableRows.length > 0) {
            searchInput.addEventListener('keyup', function () {
                const searchTerm = this.value.toLowerCase().trim();

                tableRows.forEach(row => {
                    const searchData = row.getAttribute('data-search') || '';
                    if (searchTerm === '' || searchData.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                });
            });
        }

        // Filtre butonu için basit dropdown (isteğe bağlı)
        const filterBtn = document.querySelector('.filter-btn');
        if (filterBtn) {
            filterBtn.addEventListener('click', function (e) {
                e.preventDefault();
                alert('Filtreleme özelliği geliştirilme aşamasındadır.');
            });
        }

        // Satırlara tıklama efekti
        tableRows.forEach(row => {
            row.addEventListener('click', function (e) {
                // Eğer tıklanan element bir action butonu değilse
                if (!e.target.closest('.btn-action')) {
                    const detailsLink = this.querySelector('a[href*="Details"]');
                    if (detailsLink) {
                        window.location.href = detailsLink.href;
                    }
                }
            });
        });

        // Tabloya hover efekti için class ekle
        const table = document.querySelector('.favorites-table');
        if (table) {
            table.addEventListener('mouseover', function (e) {
                if (e.target.tagName === 'TD') {
                    const row = e.target.parentElement;
                    row.style.cursor = 'pointer';
                }
            });

            table.addEventListener('mouseout', function (e) {
                if (e.target.tagName === 'TD') {
                    const row = e.target.parentElement;
                    row.style.cursor = 'default';
                }
            });
        }
    });
</script>