@model Eticaret.Core.Entities.Favorite

@{
    ViewData["Title"] = "Favori Detayları";
    var hasProduct = Model.Product != null;
    var hasUser = Model.User != null;
}

<style>
    :root {
        --primary-color: #4361ee;
        --secondary-color: #3f37c9;
        --light-color: #f8f9fa;
        --dark-color: #212529;
        --success-color: #4cc9f0;
        --warning-color: #f72585;
        --border-radius: 12px;
        --box-shadow: 0 8px 25px rgba(0, 0, 0, 0.1);
        --transition: all 0.3s ease;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
        background-color: #f5f7fb;
        color: #333;
        line-height: 1.6;
        padding: 20px;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .page-header {
        text-align: center;
        margin-bottom: 40px;
        padding: 20px;
    }

        .page-header h1 {
            color: var(--primary-color);
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .page-header p {
            color: #666;
            font-size: 1.1rem;
            max-width: 600px;
            margin: 0 auto;
        }

    .card {
        background-color: white;
        border-radius: var(--border-radius);
        box-shadow: var(--box-shadow);
        padding: 30px;
        margin-bottom: 30px;
        transition: var(--transition);
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.12);
        }

    .card-header {
        display: flex;
        align-items: center;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eaeaea;
    }

    .card-icon {
        background-color: var(--primary-color);
        color: white;
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        font-size: 1.5rem;
    }

    .card-header h4 {
        color: var(--dark-color);
        font-size: 1.8rem;
        margin: 0;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 25px;
        margin-bottom: 30px;
    }

    .detail-item {
        padding: 15px;
        background-color: var(--light-color);
        border-radius: 8px;
        transition: var(--transition);
    }

        .detail-item:hover {
            background-color: #e9ecef;
        }

    .detail-label {
        font-weight: 600;
        color: var(--secondary-color);
        font-size: 0.95rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
    }

    .detail-value {
        font-size: 1.2rem;
        color: var(--dark-color);
        word-break: break-word;
    }

    .empty-value {
        color: #999;
        font-style: italic;
    }

    .product-section, .user-section {
        margin-top: 30px;
    }

    .section-title {
        font-size: 1.5rem;
        color: var(--primary-color);
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #f0f0f0;
        display: flex;
        align-items: center;
    }

        .section-title i {
            margin-right: 10px;
        }

    .product-card, .user-card {
        display: flex;
        align-items: center;
        background: linear-gradient(135deg, #f5f7ff 0%, #f0f2ff 100%);
        border-radius: var(--border-radius);
        padding: 25px;
        margin-bottom: 20px;
        border-left: 5px solid var(--primary-color);
    }

    .product-image {
        width: 120px;
        height: 120px;
        border-radius: 10px;
        object-fit: cover;
        margin-right: 25px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .user-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background-color: var(--primary-color);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        margin-right: 25px;
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    }

    .product-info, .user-info {
        flex-grow: 1;
    }

        .product-info h5, .user-info h5 {
            font-size: 1.5rem;
            color: var(--dark-color);
            margin-bottom: 10px;
        }

    .product-description, .user-email {
        color: #666;
        font-size: 1.1rem;
        line-height: 1.5;
    }

    .action-buttons {
        display: flex;
        justify-content: flex-start;
        gap: 15px;
        margin-top: 40px;
        flex-wrap: wrap;
    }

    .btn {
        padding: 12px 28px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: var(--transition);
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }

    .btn-edit {
        background-color: var(--primary-color);
        color: white;
    }

        .btn-edit:hover {
            background-color: var(--secondary-color);
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 7px 15px rgba(67, 97, 238, 0.3);
        }

    .btn-back {
        background-color: #6c757d;
        color: white;
    }

        .btn-back:hover {
            background-color: #5a6268;
            color: white;
            transform: translateY(-3px);
        }

    .btn-delete {
        background-color: var(--warning-color);
        color: white;
    }

        .btn-delete:hover {
            background-color: #d11450;
            color: white;
            transform: translateY(-3px);
        }

    .btn i {
        margin-right: 8px;
    }

    .favorite-id-badge {
        display: inline-block;
        background-color: #e9ecef;
        color: var(--dark-color);
        padding: 5px 15px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
        margin-left: 10px;
    }

    .timestamp {
        font-size: 0.9rem;
        color: #888;
        margin-top: 5px;
    }

    .no-data {
        text-align: center;
        padding: 40px 20px;
        background-color: #f9f9f9;
        border-radius: var(--border-radius);
        color: #888;
    }

        .no-data i {
            font-size: 3rem;
            margin-bottom: 15px;
            color: #ccc;
        }

    @@media (max-width: 768px) {
        .detail-grid

    {
        grid-template-columns: 1fr;
    }

    .product-card, .user-card {
        flex-direction: column;
        text-align: center;
    }

    .product-image, .user-avatar {
        margin-right: 0;
        margin-bottom: 20px;
    }

    .action-buttons {
        flex-direction: column;
    }

    .btn {
        width: 100%;
        margin-bottom: 10px;
    }

    }
</style>

<div class="container">
    <div class="page-header">
        <h1>Favori Detayları <span class="favorite-id-badge">ID: @Model.Id</span></h1>
        <p>Favori ürün kaydının detaylı bilgilerini bu sayfadan görüntüleyebilirsiniz.</p>
    </div>

    <div class="card">
        <div class="card-header">
            <div class="card-icon">
                <i class="fas fa-heart"></i>
            </div>
            <h4>Favori Bilgileri</h4>
        </div>

        <div class="detail-grid">
            <div class="detail-item">
                <div class="detail-label">Favori Numarası</div>
                <div class="detail-value">@Model.Id</div>
            </div>

            <div class="detail-item">
                <div class="detail-label">Kullanıcı ID</div>
                <div class="detail-value">@Model.UserId</div>
            </div>

            <div class="detail-item">
                <div class="detail-label">Ürün ID</div>
                <div class="detail-value">@Model.ProductId</div>
            </div>

            <div class="detail-item">
                <div class="detail-label">Oluşturulma Tarihi</div>
                <div class="detail-value">
                    <span>@DateTime.Now.ToString("dd MMMM yyyy HH:mm")</span>
                    <div class="timestamp">(Simülasyon: Gerçek tarih için modelinize CreatedDate alanı ekleyin)</div>
                </div>
            </div>
        </div>

        <div class="user-section">
            <div class="section-title">
                <i class="fas fa-user"></i> Kullanıcı Bilgileri
            </div>

            @if (hasUser)
            {
                <div class="user-card">
                    <div class="user-avatar">
                        @Model.User.Email.Substring(0, 1).ToUpper()
                    </div>
                    <div class="user-info">
                        <h5>@Model.User.Email</h5>
                        <div class="user-email">
                            <i class="fas fa-envelope"></i> @Model.User.Email
                        </div>
                        <!-- Diğer kullanıcı bilgilerini buraya ekleyebilirsiniz -->
                        <div class="timestamp">
                            Kullanıcı ID: @Model.UserId
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="no-data">
                    <i class="fas fa-user-slash"></i>
                    <h4>Kullanıcı Bilgisi Bulunamadı</h4>
                    <p>Bu favori kaydına ait kullanıcı bilgisi mevcut değil.</p>
                </div>
            }
        </div>

        <div class="product-section">
            <div class="section-title">
                <i class="fas fa-shopping-bag"></i> Ürün Bilgileri
            </div>

            @if (hasProduct)
            {
                <div class="product-card">
                    <!-- Ürün resmi için placeholder, gerçek uygulamada Product.ImageUrl gibi bir alan kullanabilirsiniz -->
                    <img src="https://via.placeholder.com/300x200/4361ee/ffffff?text=Ürün+Resmi" alt="Ürün Resmi" class="product-image">
                    <div class="product-info">
                        <h5>@Model.Product.Name <!-- Product entity'sinde Name alanı olduğunu varsaydım --></h5>
                        <div class="product-description">
                            <strong>Açıklama:</strong> @Model.Product.Description
                        </div>
                        <!-- Diğer ürün bilgilerini buraya ekleyebilirsiniz -->
                        <div class="timestamp">
                            Ürün ID: @Model.ProductId
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="no-data">
                    <i class="fas fa-box-open"></i>
                    <h4>Ürün Bilgisi Bulunamadı</h4>
                    <p>Bu favori kaydına ait ürün bilgisi mevcut değil.</p>
                </div>
            }
        </div>

        <div class="action-buttons">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-edit">
                <i class="fas fa-edit"></i> Düzenle
            </a>

            <!-- Silme işlemi için ek buton (isteğe bağlı) -->
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-delete">
                <i class="fas fa-trash-alt"></i> Sil
            </a>

            <a asp-action="Index" class="btn btn-back">
                <i class="fas fa-arrow-left"></i> Listeye Dön
            </a>
        </div>
    </div>
</div>

<!-- FontAwesome ikonları için CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">

<script>
    // Küçük bir interaktivite eklemek için
    document.addEventListener('DOMContentLoaded', function() {
        // Kartlara tıklanabilirlik efekti ekleyelim
        const detailItems = document.querySelectorAll('.detail-item');
        detailItems.forEach(item => {
            item.addEventListener('click', function() {
                this.style.transform = 'scale(1.02)';
                setTimeout(() => {
                    this.style.transform = 'scale(1)';
                }, 200);
            });
        });

        // Ürün kartına tıklayınca ürün detay sayfasına gitmek için (isteğe bağlı)
        const productCard = document.querySelector('.product-card');
        if(productCard) {
            productCard.style.cursor = 'pointer';
            productCard.addEventListener('click', function() {
                window.location.href = '@Url.Action("Details", "Product", new { id = Model.ProductId })';
            });
        }

        // Kullanıcı kartına tıklayınca kullanıcı detay sayfasına gitmek için (isteğe bağlı)
        const userCard = document.querySelector('.user-card');
        if(userCard) {
            userCard.style.cursor = 'pointer';
            userCard.addEventListener('click', function() {
                window.location.href = '@Url.Action("Details", "User", new { id = Model.UserId })';
            });
        }
    });
</script>