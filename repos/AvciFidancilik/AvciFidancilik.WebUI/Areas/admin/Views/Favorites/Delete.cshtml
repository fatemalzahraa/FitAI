@model Eticaret.Core.Entities.Favorite

@{
    ViewData["Title"] = "Favoriyi Sil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-danger shadow-lg">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="fas fa-trash-alt me-2"></i>Favoriyi Sil
                    </h3>
                </div>

                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <h4 class="alert-heading">
                            <i class="fas fa-exclamation-triangle me-2"></i>Bu kaydı silmek istediğinizden emin misiniz?
                        </h4>
                        <p class="mb-0">Bu işlem geri alınamaz. Favori ürün listenizden bu ürün çıkarılacaktır.</p>
                    </div>

                    <div class="favorite-details-container">
                        <h5 class="text-muted mb-4">Favori Detayları</h5>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="detail-card">
                                    <div class="detail-header">
                                        <i class="fas fa-user text-primary me-2"></i>
                                        <span class="fw-bold">Kullanıcı Bilgisi</span>
                                    </div>
                                    <div class="detail-body">
                                        <div class="row">
                                            <div class="col-4 fw-semibold text-secondary">Kullanıcı:</div>
                                            <div class="col-8">
                                                <span class="badge bg-light text-dark p-2">
                                                    @Html.DisplayFor(model => model.User.Email)
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="detail-card">
                                    <div class="detail-header">
                                        <i class="fas fa-box text-success me-2"></i>
                                        <span class="fw-bold">Ürün Bilgisi</span>
                                    </div>
                                    <div class="detail-body">
                                        <div class="row">
                                            <div class="col-4 fw-semibold text-secondary">Ürün:</div>
                                            <div class="col-8">
                                                <span class="product-description">
                                                    @Html.DisplayFor(model => model.Product.Description)
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="info-box bg-light p-3 rounded">
                            <div class="d-flex align-items-center">
                                <i class="fas fa-info-circle text-info me-3 fs-4"></i>
                                <div>
                                    <small class="text-muted">
                                        <strong>Not:</strong> Bu işlem sadece favori listesinden ürünü kaldırır.
                                        Ürün ve kullanıcı bilgileri sistemde kalmaya devam eder.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between">
                        <form asp-action="Delete" class="w-100">
                            <input type="hidden" asp-for="Id" />

                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-action="Index" class="btn btn-secondary">
                                    <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                                </a>

                                <button type="submit" class="btn btn-danger px-4" onclick="return confirmDelete()">
                                    <i class="fas fa-trash-alt me-2"></i>Sil
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .detail-card {
            border: 1px solid #e0e0e0;
            border-radius: 10px;
            overflow: hidden;
            height: 100%;
            transition: all 0.3s ease;
        }

            .detail-card:hover {
                box-shadow: 0 5px 15px rgba(0,0,0,0.08);
                transform: translateY(-2px);
            }

        .detail-header {
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            padding: 12px 15px;
            border-bottom: 1px solid #dee2e6;
        }

        .detail-body {
            padding: 15px;
            background-color: white;
        }

        .product-description {
            background-color: #f8f9fa;
            padding: 8px 12px;
            border-radius: 6px;
            border-left: 3px solid #28a745;
            display: inline-block;
        }

        .info-box {
            border-left: 4px solid #17a2b8;
            margin-top: 20px;
        }

        .card {
            border-radius: 12px;
            border: none;
        }

        .card-header {
            border-radius: 12px 12px 0 0 !important;
            padding: 1rem 1.5rem;
        }

        .btn-danger {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
            }

        .btn-secondary {
            background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
            border: none;
            padding: 10px 25px;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-secondary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
            }

        .alert-warning {
            border-radius: 10px;
            border: none;
            background: linear-gradient(135deg, #fff3cd 0%, #ffeaa7 100%);
            border-left: 5px solid #ffc107;
        }
    </style>
}

@section Scripts {
    <script>
        function confirmDelete() {
            return confirm('Favori ürünü silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.');
        }

        // Font Awesome ikonlarının yüklenmesi
        document.addEventListener('DOMContentLoaded', function() {
            if (!document.querySelector('link[href*="font-awesome"]')) {
                const link = document.createElement('link');
                link.rel = 'stylesheet';
                link.href = 'https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css';
                document.head.appendChild(link);
            }
        });
    </script>
}