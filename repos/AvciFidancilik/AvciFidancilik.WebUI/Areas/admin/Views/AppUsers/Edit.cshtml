@model AppUser

@{
    ViewData["Title"] = Model.Name + " " + Model.SurName + " - Kullanıcıyı Düzenle";
    
    var createdDateLocal = Model.CreatedDate.ToLocalTime();
    var userAge = DateTime.Now.Subtract(Model.CreatedDate).Days;
    var daysOld = userAge;
    var monthsOld = (int)(daysOld / 30.44);
    var yearsOld = (int)(daysOld / 365.25);
    
    var isAdmin = Model.IsAdmin ? "Yönetici" : "Normal Kullanıcı";
    var isActive = Model.IsActive ? "Aktif" : "Pasif";
    var statusColor = Model.IsActive ? "success" : "secondary";
    var roleColor = Model.IsAdmin ? "warning" : "info";
}

<div class="container-fluid mt-4">
    <!-- Başlık ve Navigasyon -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">
                        <i class="fas fa-users me-1"></i>Kullanıcı Yönetimi</a>
                    </li>
                    <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id" class="text-decoration-none">
                        <i class="fas fa-user-circle me-1"></i>@Model.Name @Model.SurName</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="fas fa-edit me-1"></i>Düzenle
                    </li>
                </ol>
            </nav>
            <h2 class="mb-0">
                <i class="fas fa-user-edit text-warning me-2"></i>
                <span class="text-primary">@Model.Name @Model.SurName</span> - Kullanıcıyı Düzenle
            </h2>
            <p class="text-muted mb-0">ID: @Model.Id.ToString("D6") | Kullanıcı Adı: @Model.UserName</p>
        </div>
        <div class="btn-group">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-info">
                <i class="fas fa-eye me-1"></i>Detaylar
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Listeye Dön
            </a>
        </div>
    </div>

    <!-- Hata Özeti -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
            <div class="d-flex align-items-center">
                <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
                <div>
                    <h6 class="alert-heading mb-2">
                        <i class="fas fa-times-circle me-1"></i>Formda düzeltilmesi gereken hatalar var
                    </h6>
                    <div asp-validation-summary="ModelOnly" class="mb-0 small"></div>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Sol Panel: Form -->
        <div class="col-lg-8">
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-user-cog text-warning me-2"></i>Kullanıcı Bilgilerini Düzenle
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" id="editUserForm">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="CreatedDate" />
                        <input type="hidden" asp-for="UserGuid" />
                        
                        <div class="row g-3">
                            <!-- Ad -->
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-bold required">
                                    <i class="fas fa-user text-primary me-1"></i>Ad
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-id-card"></i>
                                    </span>
                                    <input asp-for="Name" class="form-control" 
                                           placeholder="Kullanıcının adını giriniz" 
                                           maxlength="50" />
                                </div>
                                <div class="mt-1">
                                    <span asp-validation-for="Name" class="text-danger small"></span>
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">Maksimum 50 karakter</small>
                                        <small class="text-muted">
                                            <span id="nameCharCount">@Model.Name.Length</span>/50
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Soyad -->
                            <div class="col-md-6">
                                <label asp-for="SurName" class="form-label fw-bold required">
                                    <i class="fas fa-user-tag text-primary me-1"></i>Soyad
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-id-card"></i>
                                    </span>
                                    <input asp-for="SurName" class="form-control" 
                                           placeholder="Kullanıcının soyadını giriniz" 
                                           maxlength="50" />
                                </div>
                                <div class="mt-1">
                                    <span asp-validation-for="SurName" class="text-danger small"></span>
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">Maksimum 50 karakter</small>
                                        <small class="text-muted">
                                            <span id="surnameCharCount">@Model.SurName.Length</span>/50
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- E-posta -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold required">
                                    <i class="fas fa-envelope text-danger me-1"></i>E-posta
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-at"></i>
                                    </span>
                                    <input asp-for="Email" type="email" class="form-control" 
                                           placeholder="ornek@mail.com" 
                                           maxlength="100" />
                                </div>
                                <div class="mt-1">
                                    <span asp-validation-for="Email" class="text-danger small"></span>
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">Geçerli bir e-posta adresi giriniz</small>
                                        <small class="text-muted">
                                            <span id="emailCharCount">@Model.Email.Length</span>/100
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Telefon -->
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-bold required">
                                    <i class="fas fa-phone text-success me-1"></i>Telefon
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-mobile-alt"></i>
                                    </span>
                                    <input asp-for="Phone" type="tel" class="form-control" 
                                           placeholder="(5XX) XXX XX XX" 
                                           maxlength="15" 
                                           pattern="[0-9+\s\(\)\-]*" 
                                           id="phoneInput" />
                                    <button class="btn btn-outline-secondary" type="button" 
                                            onclick="formatPhoneNumber()">
                                        <i class="fas fa-magic"></i>
                                    </button>
                                </div>
                                <div class="mt-1">
                                    <span asp-validation-for="Phone" class="text-danger small"></span>
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">Maksimum 15 karakter</small>
                                        <small class="text-muted">
                                            <span id="phoneCharCount">@Model.Phone.Length</span>/15
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Kullanıcı Adı -->
                            <div class="col-md-6">
                                <label asp-for="UserName" class="form-label fw-bold required">
                                    <i class="fas fa-user-alt text-info me-1"></i>Kullanıcı Adı
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input asp-for="UserName" class="form-control" 
                                           placeholder="kullanici_adi" 
                                           pattern="[a-zA-Z0-9_]+"
                                           title="Sadece harf, rakam ve alt çizgi kullanılabilir"
                                           maxlength="50" />
                                    <button class="btn btn-outline-secondary" type="button" 
                                            onclick="suggestUsername()" 
                                            title="Kullanıcı Adı Öner">
                                        <i class="fas fa-lightbulb"></i>
                                    </button>
                                </div>
                                <div class="mt-1">
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">Sadece harf, rakam ve alt çizgi</small>
                                        <small class="text-muted">
                                            <span id="usernameCharCount">@Model.UserName.Length</span>/50
                                        </small>
                                    </div>
                                    <small class="text-muted d-block mt-1">
                                        <i class="fas fa-info-circle me-1"></i>
                                        Oturum açmak için kullanılacak benzersiz kullanıcı adı
                                    </small>
                                </div>
                            </div>

                            <!-- Şifre -->
                            <div class="col-md-6">
                                <label asp-for="PasswordHash" class="form-label fw-bold">
                                    <i class="fas fa-lock text-warning me-1"></i>Şifre
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="fas fa-key"></i>
                                    </span>
                                    <input asp-for="PasswordHash" type="password" 
                                           class="form-control" 
                                           placeholder="Değiştirmek istemiyorsanız boş bırakın" 
                                           minlength="6" 
                                           maxlength="100" 
                                           id="passwordInput" />
                                    <button class="btn btn-outline-secondary" type="button" 
                                            onclick="togglePasswordVisibility()">
                                        <i class="fas fa-eye" id="passwordToggleIcon"></i>
                                    </button>
                                    <button class="btn btn-outline-info" type="button" 
                                            onclick="generatePassword()" 
                                            title="Güçlü Şifre Oluştur">
                                        <i class="fas fa-random"></i>
                                    </button>
                                </div>
                                <div class="mt-1">
                                    <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                                    <div class="d-flex justify-content-between">
                                        <small class="text-muted">En az 6 karakter (boş bırakabilirsiniz)</small>
                                        <small class="text-muted">
                                            <span id="passwordCharCount">0</span>/100
                                        </small>
                                    </div>
                                </div>
                                
                                <!-- Şifre Güçlülük Göstergesi -->
                                <div class="mt-2">
                                    <div class="password-strength">
                                        <div class="progress" style="height: 4px;">
                                            <div class="progress-bar" id="passwordStrengthBar" 
                                                 style="width: 0%" role="progressbar"></div>
                                        </div>
                                        <small class="text-muted d-block mt-1" id="passwordStrengthText">
                                            Yeni şifre girilmedi
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Kullanıcı Ayarları -->
                            <div class="col-12">
                                <div class="card border mt-3">
                                    <div class="card-header bg-light">
                                        <h6 class="mb-0">
                                            <i class="fas fa-cog text-secondary me-2"></i>Kullanıcı Ayarları
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" 
                                                           asp-for="IsActive" 
                                                           id="isActiveSwitch">
                                                    <label class="form-check-label fw-bold" asp-for="IsActive">
                                                        <i class="fas fa-toggle-@(Model.IsActive ? "on" : "off") text-@statusColor me-1"></i>
                                                        Aktif Kullanıcı
                                                    </label>
                                                </div>
                                                <small class="text-muted">
                                                    Aktif olmayan kullanıcılar sisteme giriş yapamaz.
                                                    <br>
                                                    <span id="activeStatusText">
                                                        @(Model.IsActive ? "Kullanıcı şu anda aktif" : "Kullanıcı şu anda pasif")
                                                    </span>
                                                </small>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" 
                                                           asp-for="IsAdmin" 
                                                           id="isAdminSwitch">
                                                    <label class="form-check-label fw-bold" asp-for="IsAdmin">
                                                        <i class="fas fa-user-shield text-@roleColor me-1"></i>
                                                        Yönetici Yetkisi
                                                    </label>
                                                </div>
                                                <small class="text-muted">
                                                    Yönetici kullanıcılar tüm sistem özelliklerine erişebilir.
                                                    <br>
                                                    <span id="adminStatusText">
                                                        @(Model.IsAdmin ? "Kullanıcı şu anda yönetici" : "Kullanıcı şu anda normal kullanıcı")
                                                    </span>
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sistem Bilgileri (Read-only) -->
                            <div class="col-12">
                                <div class="card border mt-3 bg-light">
                                    <div class="card-header">
                                        <h6 class="mb-0">
                                            <i class="fas fa-info-circle text-info me-2"></i>Sistem Bilgileri (Değiştirilemez)
                                        </h6>
                                    </div>
                                    <div class="card-body">
                                        <div class="row small">
                                            <div class="col-md-4 mb-2">
                                                <div class="border rounded p-2 bg-white">
                                                    <small class="text-muted d-block">Kullanıcı ID</small>
                                                    <strong>@Model.Id</strong>
                                                </div>
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <div class="border rounded p-2 bg-white">
                                                    <small class="text-muted d-block">Oluşturulma Tarihi</small>
                                                    <strong>@createdDateLocal.ToString("dd.MM.yyyy HH:mm")</strong>
                                                </div>
                                            </div>
                                            <div class="col-md-4 mb-2">
                                                <div class="border rounded p-2 bg-white">
                                                    <small class="text-muted d-block">Kayıt Süresi</small>
                                                    <strong>@yearsOld yıl @(monthsOld % 12) ay</strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Form Butonları -->
                            <div class="col-12">
                                <div class="d-flex justify-content-between align-items-center pt-4 border-top">
                                    <div>
                                        <a asp-action="Delete" asp-route-id="@Model.Id" 
                                           class="btn btn-outline-danger"
                                           onclick="return confirm('Bu kullanıcıyı silmek istediğinize emin misiniz?\\n\\nKullanıcı: @Model.Name @Model.SurName\\nID: @Model.Id\\n\\nBu işlem geri alınamaz!');">
                                            <i class="fas fa-trash-alt me-2"></i>Kullanıcıyı Sil
                                        </a>
                                    </div>
                                    <div class="btn-group">
                                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                                            <i class="fas fa-times me-2"></i>İptal
                                        </a>
                                        <button type="button" class="btn btn-outline-info" onclick="resetForm()">
                                            <i class="fas fa-redo me-2"></i>Değişiklikleri Temizle
                                        </button>
                                        <button type="submit" class="btn btn-warning px-4" id="submitBtn">
                                            <i class="fas fa-save me-2"></i>Değişiklikleri Kaydet
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sağ Panel: Önizleme ve Yardım -->
        <div class="col-lg-4">
            <!-- Canlı Önizleme -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-eye text-primary me-2"></i>Canlı Önizleme
                    </h5>
                </div>
                <div class="card-body">
                    <div class="user-preview text-center">
                        <div class="preview-avatar mb-3">
                            <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center" 
                                 style="width: 80px; height: 80px;">
                                <i class="fas fa-user-edit text-warning" style="font-size: 2rem;"></i>
                            </div>
                        </div>
                        <div class="preview-info">
                            <h5 id="previewName" class="text-primary mb-1">@Model.Name @Model.SurName</h5>
                            <p class="text-muted small mb-2" id="previewEmail">@Model.Email</p>
                            <div class="badges mb-3">
                                <span class="badge bg-@statusColor" id="previewStatus">@isActive</span>
                                <span class="badge bg-@roleColor" id="previewRole">@isAdmin</span>
                            </div>
                            <div class="row small text-muted">
                                <div class="col-6">
                                    <i class="fas fa-user me-1"></i>
                                    <div id="previewUsername">@Model.UserName</div>
                                </div>
                                <div class="col-6">
                                    <i class="fas fa-phone me-1"></i>
                                    <div id="previewPhone">@Model.Phone</div>
                                </div>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Değişiklikler kaydedilmeden önce burada önizlenir
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Değişiklik Özeti -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-clipboard-list text-info me-2"></i>Değişiklik Özeti
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush small" id="changesList">
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-center">
                            <span>Değiştirilen Alanlar</span>
                            <span class="badge bg-primary" id="changedFieldsCount">0</span>
                        </div>
                        <div class="list-group-item px-0">
                            <div id="changesContainer">
                                <small class="text-muted">Henüz değişiklik yapılmadı</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form İpuçları -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-lightbulb text-warning me-2"></i>Form İpuçları
                    </h5>
                </div>
                <div class="card-body">
                    <div class="accordion" id="tipsAccordion">
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" 
                                        data-bs-target="#tip1" aria-expanded="false">
                                    <i class="fas fa-key me-2"></i>Şifre Değişikliği
                                </button>
                            </h2>
                            <div id="tip1" class="accordion-collapse collapse" 
                                 data-bs-parent="#tipsAccordion">
                                <div class="accordion-body small">
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-1">
                                            <i class="fas fa-check-circle text-success me-1"></i>
                                            Şifreyi değiştirmek istemiyorsanız boş bırakın
                                        </li>
                                        <li class="mb-1">
                                            <i class="fas fa-check-circle text-success me-1"></i>
                                            Yeni şifre en az 6 karakter olmalıdır
                                        </li>
                                        <li>
                                            <i class="fas fa-check-circle text-success me-1"></i>
                                            Güçlü şifre için büyük/küçük harf, rakam ve özel karakter kullanın
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" 
                                        data-bs-toggle="collapse" data-bs-target="#tip2">
                                    <i class="fas fa-user-shield me-2"></i>Yönetici Yetkisi
                                </button>
                            </h2>
                            <div id="tip2" class="accordion-collapse collapse" 
                                 data-bs-parent="#tipsAccordion">
                                <div class="accordion-body small">
                                    <p>
                                        <strong>Yönetici kullanıcılar:</strong>
                                    </p>
                                    <ul class="list-unstyled mb-0">
                                        <li class="mb-1">
                                            <i class="fas fa-star text-warning me-1"></i>
                                            Tüm kullanıcıları yönetebilir
                                        </li>
                                        <li class="mb-1">
                                            <i class="fas fa-star text-warning me-1"></i>
                                            Sistem ayarlarına erişebilir
                                        </li>
                                        <li>
                                            <i class="fas fa-star text-warning me-1"></i>
                                            Tüm raporları görüntüleyebilir
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Form İstatistikleri -->
            <div class="card shadow border-0">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar text-success me-2"></i>Form İstatistikleri
                    </h5>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush small">
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>Form Tamamlama</span>
                            <div class="progress" style="width: 100px; height: 6px;">
                                <div class="progress-bar bg-success" id="completionProgress" style="width: 100%"></div>
                            </div>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>Zorunlu Alanlar</span>
                            <span class="badge bg-success" id="requiredFields">7/7</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>Şifre Gücü</span>
                            <span class="badge bg-secondary" id="passwordStrengthBadge">Değişmedi</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <span>Son Güncelleme</span>
                            <small class="text-muted">@DateTime.Now.ToString("HH:mm")</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            console.log('Kullanıcı düzenleme sayfası yüklendi:', {
                userId: @Model.Id,
                name: '@Model.Name @Model.SurName',
                username: '@Model.UserName',
                isAdmin: @Model.IsAdmin.ToString().ToLower(),
                isActive: @Model.IsActive.ToString().ToLower()
            });

            // Original values for comparison
            const originalValues = {
                Name: '@Model.Name',
                SurName: '@Model.SurName',
                Email: '@Model.Email',
                Phone: '@Model.Phone',
                UserName: '@Model.UserName',
                PasswordHash: '@Model.PasswordHash',
                IsActive: @Model.IsActive.ToString().ToLower(),
                IsAdmin: @Model.IsAdmin.ToString().ToLower()
            };

            // Karakter sayacı fonksiyonları
            function setupCharCounter(inputId, counterId, originalValue) {
                const input = document.querySelector(`[name="${inputId}"]`);
                const counter = document.getElementById(counterId);
                
                if (input && counter) {
                    function updateCounter() {
                        const length = input.value.length;
                        counter.textContent = length;
                        counter.className = length > input.maxLength ? 'text-danger' : 'text-success';
                        checkForChanges();
                        updatePreview();
                    }
                    
                    input.addEventListener('input', updateCounter);
                    updateCounter(); // İlk yükleme
                }
            }
            
            // Karakter sayaçlarını başlat
            setupCharCounter('Name', 'nameCharCount', originalValues.Name);
            setupCharCounter('SurName', 'surnameCharCount', originalValues.SurName);
            setupCharCounter('Email', 'emailCharCount', originalValues.Email);
            setupCharCounter('Phone', 'phoneCharCount', originalValues.Phone);
            setupCharCounter('UserName', 'usernameCharCount', originalValues.UserName);
            
            // Şifre için özel sayaç
            const passwordInput = document.getElementById('passwordInput');
            const passwordCharCount = document.getElementById('passwordCharCount');
            
            if (passwordInput && passwordCharCount) {
                function updatePasswordCounter() {
                    const length = passwordInput.value.length;
                    passwordCharCount.textContent = length;
                    passwordCharCount.className = length > 0 && length < 6 ? 'text-danger' : 'text-success';
                    checkPasswordStrength(passwordInput.value);
                    checkForChanges();
                }
                
                passwordInput.addEventListener('input', updatePasswordCounter);
                updatePasswordCounter();
            }
            
            // Şifre göster/gizle
            window.togglePasswordVisibility = function() {
                const passwordInput = document.getElementById('passwordInput');
                const icon = document.getElementById('passwordToggleIcon');
                
                if (passwordInput.type === 'password') {
                    passwordInput.type = 'text';
                    icon.className = 'fas fa-eye-slash';
                } else {
                    passwordInput.type = 'password';
                    icon.className = 'fas fa-eye';
                }
            };
            
            // Şifre gücü kontrolü
            function checkPasswordStrength(password) {
                if (!password || password === '') {
                    $('#passwordStrengthBar').css('width', '0%').removeClass('bg-danger bg-warning bg-success');
                    $('#passwordStrengthText').text('Yeni şifre girilmedi').removeClass('text-danger text-warning text-success');
                    $('#passwordStrengthBadge').text('Değişmedi').removeClass('bg-danger bg-warning bg-success').addClass('bg-secondary');
                    return;
                }
                
                let strength = 0;
                let strengthText = 'Zayıf';
                let strengthClass = 'danger';
                let barWidth = 25;
                
                if (password.length >= 8) strength++;
                if (password.length >= 12) strength++;
                if (/[A-Z]/.test(password)) strength++;
                if (/[a-z]/.test(password)) strength++;
                if (/[0-9]/.test(password)) strength++;
                if (/[^A-Za-z0-9]/.test(password)) strength++;
                
                if (strength >= 5) {
                    strengthText = 'Çok Güçlü';
                    strengthClass = 'success';
                    barWidth = 100;
                } else if (strength >= 4) {
                    strengthText = 'Güçlü';
                    strengthClass = 'success';
                    barWidth = 75;
                } else if (strength >= 3) {
                    strengthText = 'Orta';
                    strengthClass = 'warning';
                    barWidth = 50;
                } else if (strength >= 2) {
                    strengthText = 'Zayıf';
                    strengthClass = 'danger';
                    barWidth = 25;
                } else {
                    strengthText = 'Çok Zayıf';
                    strengthClass = 'danger';
                    barWidth = 10;
                }
                
                // Güncelle
                $('#passwordStrengthBar')
                    .removeClass('bg-danger bg-warning bg-success')
                    .addClass('bg-' + strengthClass)
                    .css('width', barWidth + '%');
                
                $('#passwordStrengthText')
                    .removeClass('text-danger text-warning text-success')
                    .addClass('text-' + strengthClass)
                    .text('Şifre gücü: ' + strengthText);
                
                $('#passwordStrengthBadge')
                    .removeClass('bg-secondary bg-danger bg-warning bg-success')
                    .addClass('bg-' + strengthClass)
                    .text(strengthText);
            }
            
            // Telefon formatlama
            window.formatPhoneNumber = function() {
                const phoneInput = document.getElementById('phoneInput');
                let value = phoneInput.value.replace(/\D/g, '');
                
                if (value.length > 0) {
                    value = '(' + value.substring(0, 3) + ') ' + value.substring(3, 6) + ' ' + value.substring(6, 8) + ' ' + value.substring(8, 10);
                }
                
                phoneInput.value = value.substring(0, 15);
                $('#phoneCharCount').text(value.length > 15 ? 15 : value.length);
                checkForChanges();
                updatePreview();
            };
            
            // Kullanıcı adı öner
            window.suggestUsername = function() {
                const name = $('#Name').val().toLowerCase().replace(/[^a-z]/g, '');
                const surname = $('#SurName').val().toLowerCase().replace(/[^a-z]/g, '');
                
                if (name && surname) {
                    const randomNum = Math.floor(Math.random() * 999) + 1;
                    const username = name.charAt(0) + surname + randomNum;
                    $('#UserName').val(username.substring(0, 50));
                    $('#usernameCharCount').text(username.length > 50 ? 50 : username.length);
                    checkForChanges();
                    updatePreview();
                } else {
                    alert('Önce ad ve soyad bilgilerini giriniz.');
                }
            };
            
            // Rastgele şifre oluştur
            window.generatePassword = function() {
                const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@@#$%^&*()';
                let password = '';
                const length = 12;
                
                for (let i = 0; i < length; i++) {
                    password += chars.charAt(Math.floor(Math.random() * chars.length));
                }
                
                $('#passwordInput').val(password);
                $('#passwordCharCount').text(password.length);
                checkPasswordStrength(password);
                checkForChanges();
            };
            
            // Değişiklikleri kontrol et
            function checkForChanges() {
                const currentValues = {
                    Name: $('[name="Name"]').val(),
                    SurName: $('[name="SurName"]').val(),
                    Email: $('[name="Email"]').val(),
                    Phone: $('[name="Phone"]').val(),
                    UserName: $('[name="UserName"]').val(),
                    PasswordHash: $('#passwordInput').val(),
                    IsActive: $('#isActiveSwitch').is(':checked'),
                    IsAdmin: $('#isAdminSwitch').is(':checked')
                };
                
                let changedFields = 0;
                let changesHtml = '';
                
                // Her alanı kontrol et
                Object.keys(currentValues).forEach(key => {
                    let original = originalValues[key];
                    let current = currentValues[key];
                    
                    // Boolean değerleri için
                    if (key === 'IsActive' || key === 'IsAdmin') {
                        original = original === 'true';
                        if (original !== current) {
                            changedFields++;
                            const fieldName = key === 'IsActive' ? 'Durum' : 'Rol';
                            const originalText = original ? (key === 'IsActive' ? 'Aktif' : 'Yönetici') : (key === 'IsActive' ? 'Pasif' : 'Normal');
                            const currentText = current ? (key === 'IsActive' ? 'Aktif' : 'Yönetici') : (key === 'IsActive' ? 'Pasif' : 'Normal');
                            
                            changesHtml += `
                                <div class="change-item mb-1">
                                    <small>
                                        <i class="fas fa-pen text-warning me-1"></i>
                                        ${fieldName}: <span class="text-danger">${originalText}</span> → 
                                        <span class="text-success">${currentText}</span>
                                    </small>
                                </div>
                            `;
                        }
                    }
                    // Şifre için özel kontrol
                    else if (key === 'PasswordHash') {
                        if (current && current !== '' && current !== original) {
                            changedFields++;
                            changesHtml += `
                                <div class="change-item mb-1">
                                    <small>
                                        <i class="fas fa-pen text-warning me-1"></i>
                                        Şifre: <span class="text-danger">Değiştirildi</span>
                                    </small>
                                </div>
                            `;
                        }
                    }
                    // Diğer alanlar için
                    else {
                        if (current !== original) {
                            changedFields++;
                            changesHtml += `
                                <div class="change-item mb-1">
                                    <small>
                                        <i class="fas fa-pen text-warning me-1"></i>
                                        ${key}: <span class="text-danger">${original || '(boş)'}</span> → 
                                        <span class="text-success">${current || '(boş)'}</span>
                                    </small>
                                </div>
                            `;
                        }
                    }
                });
                
                // Değişiklik özetini güncelle
                $('#changedFieldsCount').text(changedFields);
                if (changedFields > 0) {
                    $('#changesContainer').html(changesHtml);
                    $('#changedFieldsCount').removeClass('bg-primary').addClass('bg-warning');
                } else {
                    $('#changesContainer').html('<small class="text-muted">Henüz değişiklik yapılmadı</small>');
                    $('#changedFieldsCount').removeClass('bg-warning').addClass('bg-primary');
                }
            }
            
            // Canlı önizleme güncelleme
            function updatePreview() {
                // Ad Soyad
                const name = $('#Name').val() || '@Model.Name';
                const surname = $('#SurName').val() || '@Model.SurName';
                $('#previewName').text(name + ' ' + surname);
                
                // Email
                const email = $('#Email').val() || '@Model.Email';
                $('#previewEmail').text(email);
                
                // Username
                const username = $('#UserName').val() || '@Model.UserName';
                $('#previewUsername').text(username);
                
                // Phone
                const phone = $('#Phone').val() || '@Model.Phone';
                $('#previewPhone').text(phone);
                
                // Status
                const isActive = $('#isActiveSwitch').is(':checked');
                $('#previewStatus')
                    .text(isActive ? 'Aktif' : 'Pasif')
                    .removeClass('bg-success bg-secondary')
                    .addClass(isActive ? 'bg-success' : 'bg-secondary');
                
                // Role
                const isAdmin = $('#isAdminSwitch').is(':checked');
                $('#previewRole')
                    .text(isAdmin ? 'Yönetici' : 'Normal Kullanıcı')
                    .removeClass('bg-warning bg-info')
                    .addClass(isAdmin ? 'bg-warning' : 'bg-info');
                
                // Durum metinlerini güncelle
                $('#activeStatusText').text(isActive ? 'Kullanıcı şu anda aktif' : 'Kullanıcı şu anda pasif');
                $('#adminStatusText').text(isAdmin ? 'Kullanıcı şu anda yönetici' : 'Kullanıcı şu anda normal kullanıcı');
            }
            
            // Form sıfırlama
            window.resetForm = function() {
                if (confirm('Formdaki tüm değişiklikleri sıfırlamak istediğinize emin misiniz?')) {
                    // Formu orijinal değerlere sıfırla
                    $('[name="Name"]').val('@Model.Name');
                    $('[name="SurName"]').val('@Model.SurName');
                    $('[name="Email"]').val('@Model.Email');
                    $('[name="Phone"]').val('@Model.Phone');
                    $('[name="UserName"]').val('@Model.UserName');
                    $('#passwordInput').val('');
                    
                    // Checkbox'ları orijinal değerlere sıfırla
                    $('#isActiveSwitch').prop('checked', @Model.IsActive.ToString().ToLower());
                    $('#isAdminSwitch').prop('checked', @Model.IsAdmin.ToString().ToLower());
                    
                    // Karakter sayaçlarını güncelle
                    $('#nameCharCount').text('@Model.Name.Length');
                    $('#surnameCharCount').text('@Model.SurName.Length');
                    $('#emailCharCount').text('@Model.Email.Length');
                    $('#phoneCharCount').text('@Model.Phone.Length');
                    $('#usernameCharCount').text('@Model.UserName.Length');
                    $('#passwordCharCount').text('0');
                    
                    // Şifre gücünü sıfırla
                    checkPasswordStrength('');
                    
                    // Önizlemeyi güncelle
                    updatePreview();
                    
                    // Değişiklikleri kontrol et
                    checkForChanges();
                    
                    showToast('Form sıfırlandı!', 'info');
                }
            };
            
            // Toast bildirimi
            function showToast(message, type) {
                // Mevcut toast'ları temizle
                $('.toast').remove();
                
                const toast = document.createElement('div');
                toast.className = `position-fixed bottom-0 end-0 p-3`;
                toast.innerHTML = `
                    <div class="toast show" role="alert">
                        <div class="toast-header bg-${type} text-white">
                            <strong class="me-auto">Bilgi</strong>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
                        </div>
                        <div class="toast-body">
                            ${message}
                        </div>
                    </div>
                `;
                document.body.appendChild(toast);
                
                // Toast'ı otomatik kaldır
                setTimeout(() => {
                    $(toast).remove();
                }, 3000);
            }
            
            // Form gönderimi
            $('#editUserForm').on('submit', function() {
                $('#submitBtn').prop('disabled', true)
                    .html('<i class="fas fa-spinner fa-spin me-2"></i>Kaydediliyor...');
            });
            
            // Form alanları için event listener'lar
            $('input').on('input change', function() {
                checkForChanges();
                updatePreview();
            });
            
            // Klavye kısayolları
            $(document).on('keydown', function(e) {
                // Ctrl+S: Kaydet
                if (e.ctrlKey && e.key === 's') {
                    e.preventDefault();
                    $('#submitBtn').click();
                }
                // Ctrl+R: Sıfırla
                if (e.ctrlKey && e.key === 'r') {
                    e.preventDefault();
                    resetForm();
                }
                // ESC: İptal
                if (e.key === 'Escape') {
                    window.location.href = '@Url.Action("Details", new { id = Model.Id })';
                }
            });
            
            // İlk yükleme
            updatePreview();
            checkForChanges();
            
            // Telefon input'una formatlama ekle
            $('#phoneInput').on('input', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length > 0) {
                    value = '(' + value.substring(0, 3) + ') ' + value.substring(3, 6) + ' ' + value.substring(6, 8) + ' ' + value.substring(8, 10);
                }
                $(this).val(value.substring(0, 15));
                $('#phoneCharCount').text(value.length > 15 ? 15 : value.length);
            });
        });
    </script>

