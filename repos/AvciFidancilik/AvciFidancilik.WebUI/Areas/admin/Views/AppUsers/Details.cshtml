@model Eticaret.Core.Entities.AppUser

@{
    ViewData["Title"] = Model.Name + " " + Model.SurName + " - Kullanıcı Detayları";

    var createdDateLocal = Model.CreatedDate.ToLocalTime();
    var userAge = DateTime.Now.Subtract(Model.CreatedDate);
    var daysOld = userAge.Days;
    var monthsOld = (int)(daysOld / 30.44);
    var yearsOld = (int)(daysOld / 365.25);

    var isAdmin = Model.IsAdmin ? "Yönetici" : "Normal Kullanıcı";
    var isActive = Model.IsActive ? "Aktif" : "Pasif";
    var statusColor = Model.IsActive ? "success" : "secondary";
    var roleColor = Model.IsAdmin ? "warning" : "info";
    var userGuidShort = Model.UserGuid.ToString().Substring(0, 8) + "...";

    var addressCount = Model.Addresses?.Count ?? 0;
    var orderCount = Model.Orders?.Count ?? 0;
    var favoriteCount = Model.Favorites?.Count ?? 0;
    var contactCount = Model.Contacts?.Count ?? 0;
}

<div class="container-fluid mt-4">

    <!-- Başlık ve Breadcrumb -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a asp-action="Index" class="text-decoration-none">
                            <i class="fas fa-users me-1"></i>Kullanıcı Yönetimi
                        </a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="fas fa-user-circle me-1"></i>@Model.Name @Model.SurName
                    </li>
                </ol>
            </nav>

            <div class="d-flex align-items-center">
                <h2 class="mb-0 me-3">
                    <i class="fas fa-user text-primary me-2"></i>
                    <span class="text-primary">@Model.Name @Model.SurName</span>
                </h2>
                <span class="badge bg-dark fs-6 py-2">ID: @Model.Id.ToString("D6")</span>
            </div>

            <p class="text-muted mb-0">
                Kullanıcı Adı: @Model.UserName |
                Kayıtlı @yearsOld yıl @(monthsOld % 12) aydır
            </p>
        </div>

        <div class="btn-group">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                <i class="fas fa-edit me-1"></i>Düzenle
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Listeye Dön
            </a>
        </div>
    </div>

    <!-- Hızlı İstatistik Kartları -->
    <div class="row mb-4">
        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 shadow-sm bg-primary bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-primary rounded-circle p-2 me-3">
                            <i class="fas fa-user-tag text-white"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@isAdmin</h5>
                            <span class="badge bg-@roleColor">Rol</span>
                            <small class="text-muted d-block">Kullanıcı Tipi</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 shadow-sm bg-@statusColor bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-@statusColor rounded-circle p-2 me-3">
                            <i class="fas fa-toggle-@(Model.IsActive ? "on" : "off") text-white"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@isActive</h5>
                            <span class="badge bg-@statusColor">Durum</span>
                            <small class="text-muted d-block">Hesap Durumu</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 shadow-sm bg-info bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-info rounded-circle p-2 me-3">
                            <i class="fas fa-calendar-alt text-white"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@createdDateLocal.ToString("dd.MM.yyyy")</h5>
                            <small class="text-muted d-block">Kayıt Tarihi</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3 col-6 mb-3">
            <div class="card border-0 shadow-sm bg-success bg-opacity-10">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="bg-success rounded-circle p-2 me-3">
                            <i class="fas fa-shopping-cart text-white"></i>
                        </div>
                        <div>
                            <h5 class="mb-0">@orderCount</h5>
                            <small class="text-muted d-block">Toplam Sipariş</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">

        <!-- Sol Panel -->
        <div class="col-lg-8">

            <!-- Kişisel Bilgiler -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-id-card text-primary me-2"></i>Kişisel Bilgiler
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <!-- Ad -->
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="fas fa-user text-primary"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted">Ad</small>
                                        <strong class="fs-5 d-block">@Model.Name</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Soyad -->
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="fas fa-user-tag text-primary"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted">Soyad</small>
                                        <strong class="fs-5 d-block">@Model.SurName</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tam Ad -->
                        <div class="col-12">
                            <div class="p-3 border rounded bg-primary bg-opacity-10">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary rounded-circle p-2 me-3">
                                        <i class="fas fa-id-card-alt text-white"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted">Tam Ad</small>
                                        <strong class="fs-4 text-primary">@Model.Name @Model.SurName</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- İletişim Bilgileri -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-address-book text-success me-2"></i>İletişim Bilgileri
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <!-- Email -->
                        <div class="col-md-6">
                            <div class="p-3 border rounded h-100">
                                <div class="d-flex align-items-start">
                                    <div class="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="fas fa-envelope text-danger"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted">E-posta</small>
                                        <strong class="fs-5 d-block">@Model.Email</strong>

                                        <div class="mt-2">
                                            <a href="mailto:@Model.Email" class="btn btn-sm btn-outline-danger">
                                                <i class="fas fa-paper-plane me-1"></i>Gönder
                                            </a>
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    onclick="copyToClipboard('@Model.Email')">
                                                <i class="fas fa-copy me-1"></i>Kopyala
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Telefon -->
                        <div class="col-md-6">
                            <div class="p-3 border rounded h-100">
                                <div class="d-flex align-items-start">
                                    <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="fas fa-phone text-success"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <small class="text-muted">Telefon</small>
                                        <strong class="fs-5 d-block">@Model.Phone</strong>

                                        <div class="mt-2">
                                            <a href="tel:@Model.Phone" class="btn btn-sm btn-outline-success">
                                                <i class="fas fa-phone-alt me-1"></i>Ara
                                            </a>
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    onclick="copyToClipboard('@Model.Phone')">
                                                <i class="fas fa-copy me-1"></i>Kopyala
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- Hesap Bilgileri -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="fas fa-user-lock text-warning me-2"></i>Hesap Bilgileri
                    </h5>
                </div>

                <div class="card-body">
                    <div class="row g-3">

                        <!-- Kullanıcı adı -->
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="fas fa-user text-info"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted">Kullanıcı Adı</small>
                                        <strong class="fs-5 d-block">
                                            <code>@Model.UserName</code>
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- GUID -->
                        <div class="col-md-6">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="bg-dark bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="fas fa-fingerprint text-dark"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted">GUID</small>
                                        <strong class="fs-6 d-block">@userGuidShort</strong>
                                        <button class="btn btn-sm btn-outline-secondary mt-2"
                                                onclick="copyToClipboard('@Model.UserGuid')">
                                            <i class="fas fa-copy me-1"></i>Kopyala
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Kayıt tarihi -->
                        <div class="col-12">
                            <div class="p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="bg-secondary bg-opacity-10 rounded-circle p-2 me-3">
                                        <i class="fas fa-clock text-secondary"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted">Kayıt Tarihi</small>
                                        <strong class="fs-5 d-block">@Model.CreatedDate.ToString("dd MMMM yyyy HH:mm")</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!-- Sağ Panel -->
        <div class="col-lg-4">

            <!-- Adresler -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-map-marker-alt text-danger me-2"></i>Adresler
                    </h5>
                    <span class="badge bg-danger">@addressCount</span>
                </div>

                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    @if (Model.Addresses != null && Model.Addresses.Any())
                    {
                        foreach (var a in Model.Addresses)
                        {
                            <div class="border rounded p-2 mb-2">
                                <strong>@a.Title</strong>
                                <small class="d-block text-muted">@a.Line</small>
                                <small class="d-block">@a.District / @a.City</small>
                                <small class="text-muted">@a.PostalCode</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Kayıtlı adres yok.</p>
                    }
                </div>
            </div>

            <!-- Siparişler -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-shopping-cart text-success me-2"></i>Siparişler
                    </h5>
                    <span class="badge bg-success">@orderCount</span>
                </div>

                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    @if (Model.Orders != null && Model.Orders.Any())
                    {
                        foreach (var o in Model.Orders)
                        {
                            <div class="border rounded p-2 mb-2">
                                <strong>Sipariş #: @o.Id</strong>
                                <small class="d-block text-muted">@@o.CreatedDate.ToString("dd.MM.yyyy")</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Sipariş bulunmuyor.</p>
                    }
                </div>
            </div>

            <!-- Favoriler -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-heart text-danger me-2"></i>Favoriler
                    </h5>
                    <span class="badge bg-danger">@favoriteCount</span>
                </div>

                <div class="card-body" style="max-height: 250px; overflow-y: auto;">
                    @if (Model.Favorites != null && Model.Favorites.Any())
                    {
                        foreach (var f in Model.Favorites)
                        {
                            <div class="border rounded p-2 mb-2">
                                <strong>@f.Product?.Name</strong>
                                <small class="d-block text-muted">Ürün ID: @f.ProductId</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Favori ürün bulunmuyor.</p>
                    }
                </div>
            </div>

            <!-- İletişim Mesajları -->
            <div class="card shadow border-0 mb-4">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-comments text-primary me-2"></i>İletişim Mesajları
                    </h5>
                    <span class="badge bg-primary">@contactCount</span>
                </div>

                <div class="card-body" style="max-height: 250px; overflow-y: auto;">
                    @if (Model.Contacts != null && Model.Contacts.Any())
                    {
                        foreach (var c in Model.Contacts)
                        {
                            <div class="border rounded p-2 mb-2">
                                <strong>@c.Subject</strong>
                                <small class="d-block">@c.Message</small>
                                <small class="text-muted d-block">
                                    @c.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                </small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">Mesaj bulunmuyor.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text);
        alert("Kopyalandı: " + text);
    }
</script>
