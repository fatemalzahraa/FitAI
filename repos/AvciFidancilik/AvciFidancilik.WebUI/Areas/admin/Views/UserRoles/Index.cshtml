@model IEnumerable<Eticaret.Core.Entities.UserRole>

@{
    ViewData["Title"] = "Kullanıcı Rolleri";
}

<div class="container-fluid">
    <!-- SAYFA BAŞLIĞI -->
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/admin">Yönetim</a></li>
                        <li class="breadcrumb-item active">Kullanıcı Rolleri</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLO KARTI -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-users-cog me-2"></i>Kullanıcı – Rol Atamaları
                    </h5>
                    <a asp-action="Create" class="btn btn-success btn-sm">
                        <i class="fas fa-plus me-2"></i>Yeni Rol Ata
                    </a>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover custom-table">
                            <thead>
                                <tr>
                                    <th>Kullanıcı (Email)</th>
                                    <th>Rol</th>
                                    <th class="text-center">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Any())
                                {
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-4">
                                            <i class="fas fa-info-circle me-2"></i>Kayıt bulunamadı.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>
                                                <i class="fas fa-user me-2 text-primary"></i>
                                                @item.User?.Email
                                            </td>
                                            <td>
                                                <span class="badge bg-info px-3 py-2">
                                                    <i class="fas fa-user-tag me-1"></i>
                                                    @item.Role?.Name
                                                </span>
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Details" asp-route-id="@item.Id"
                                                       class="btn btn-outline-info btn-sm"
                                                       title="Detaylar">
                                                        <i class="fas fa-eye"></i>
                                                    </a>
                                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                                       class="btn btn-outline-primary btn-sm"
                                                       title="Düzenle">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                                       class="btn btn-outline-danger btn-sm"
                                                       title="Sil">
                                                        <i class="fas fa-trash-alt"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Sayfa başlığı */
        .page-title-box {
            padding: 24px 0;
        }

        /* Kart */
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 0.75rem 1.5rem rgba(18, 38, 63, 0.08);
        }

        .card-header {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border-radius: 15px 15px 0 0;
            padding: 1rem 1.5rem;
        }

        /* Tablo */
        .custom-table thead th {
            background-color: #f8f9fa;
            font-weight: 600;
            color: #495057;
            border-bottom: 2px solid #dee2e6;
        }

        .custom-table tbody tr {
            transition: all 0.2s ease;
        }

            .custom-table tbody tr:hover {
                background-color: #f1f3f9;
            }

        /* Badge */
        .badge {
            font-size: 0.85rem;
            border-radius: 20px;
        }

        /* Butonlar */
        .btn-sm {
            border-radius: 8px;
            transition: all 0.2s ease;
        }

            .btn-sm:hover {
                transform: translateY(-2px);
            }

        /* Breadcrumb */
        .breadcrumb {
            background: transparent;
            padding: 0;
            margin-bottom: 0;
        }

        .breadcrumb-item a {
            text-decoration: none;
            color: #6c757d;
        }

        .breadcrumb-item.active {
            font-weight: 500;
            color: #495057;
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .btn-group {
                display: flex;
                flex-direction: column;
            }

                .btn-group .btn {
                    margin-bottom: 5px;
                }
        }
    </style>
}
