@model Eticaret.Core.Entities.UserRole

@{
    ViewData["Title"] = "Kullanıcı Rolü Düzenle";
    var userEmail = Model.User?.Email ?? "Bilinmeyen Kullanıcı";
    var roleName = Model.Role?.Name ?? "Bilinmeyen Rol";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/admin">Yönetim</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Kullanıcı Rolleri</a></li>
                        <li class="breadcrumb-item active">Düzenle</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-edit me-2"></i>Kullanıcı Rolünü Düzenle
                    </h5>
                </div>
                <div class="card-body">

                    <!-- BAŞARI/HATA MESAJLARI -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <!-- MEVCUT KAYIT BİLGİLERİ -->
                    <div class="current-info mb-4">
                        <div class="info-card bg-light p-3 rounded">
                            <h6 class="mb-3">
                                <i class="fas fa-info-circle me-2 text-warning"></i>Mevcut Atama
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="fas fa-user me-2"></i>Mevcut Kullanıcı:
                                        </span>
                                        <span class="info-value">@userEmail</span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="info-label">
                                            <i class="fas fa-user-tag me-2"></i>Mevcut Rol:
                                        </span>
                                        <span class="info-value">@roleName</span>
                                    </div>
                                </div>
                            </div>
                            <div class="info-item mt-2">
                                <span class="info-label">
                                    <i class="fas fa-hashtag me-2"></i>Kayıt ID:
                                </span>
                                <span class="info-value badge bg-secondary">@Model.Id</span>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Edit" class="needs-validation" novalidate id="editForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <label asp-for="UserId" class="form-label fw-semibold">
                                        <i class="fas fa-user me-2"></i>Yeni Kullanıcı Seçimi
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-users"></i>
                                        </span>
                                        <select asp-for="UserId" class="form-select form-control-lg" asp-items="ViewBag.UserId" required id="userIdSelect">
                                            <option value="">Lütfen yeni kullanıcı seçin</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="UserId" class="invalid-feedback d-block"></span>
                                    <small class="form-text text-muted mt-1">
                                        <i class="fas fa-info-circle me-1"></i>Rolü atamak istediğiniz yeni kullanıcıyı seçin.
                                    </small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-4">
                                    <label asp-for="RoleId" class="form-label fw-semibold">
                                        <i class="fas fa-user-tag me-2"></i>Yeni Rol Seçimi
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="fas fa-shield-alt"></i>
                                        </span>
                                        <select asp-for="RoleId" class="form-select form-control-lg" asp-items="ViewBag.RoleId" required id="roleIdSelect">
                                            <option value="">Lütfen yeni rol seçin</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="RoleId" class="invalid-feedback d-block"></span>
                                    <small class="form-text text-muted mt-1">
                                        <i class="fas fa-info-circle me-1"></i>Kullanıcıya atamak istediğiniz yeni rolü seçin.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- DEĞİŞİKLİK ÖNİZLEME -->
                        <div class="change-preview mt-4 mb-4" id="changePreview" style="display: none;">
                            <div class="preview-card border-start border-4 border-warning p-3 bg-light rounded">
                                <h6 class="mb-3">
                                    <i class="fas fa-eye me-2 text-warning"></i>Değişiklik Önizleme
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="preview-item">
                                            <span class="preview-label">Eski:</span>
                                            <span class="preview-old">@userEmail</span>
                                        </div>
                                        <div class="preview-item">
                                            <span class="preview-label">Yeni:</span>
                                            <span class="preview-new" id="previewNewUser">-</span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="preview-item">
                                            <span class="preview-label">Eski:</span>
                                            <span class="preview-old">@roleName</span>
                                        </div>
                                        <div class="preview-item">
                                            <span class="preview-label">Yeni:</span>
                                            <span class="preview-new" id="previewNewRole">-</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ACTION BUTONLARI -->
                        <div class="action-buttons mt-5 pt-4 border-top">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4" id="backButton">
                                        <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                                    </a>
                                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info btn-lg px-4 ms-2">
                                        <i class="fas fa-eye me-2"></i>Detaylar
                                    </a>
                                </div>
                                <div>
                                    <button type="submit" class="btn btn-warning btn-lg px-5" id="saveButton">
                                        <i class="fas fa-save me-2"></i>Güncelle
                                    </button>
                                    <button type="reset" class="btn btn-outline-danger btn-lg px-4 ms-2">
                                        <i class="fas fa-redo me-2"></i>Sıfırla
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Temel kart stil */
        .card {
            border: none;
            box-shadow: 0 0.75rem 1.5rem rgba(18, 38, 63, 0.08);
            border-radius: 15px;
            margin-bottom: 24px;
        }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
            padding: 1.25rem 1.5rem;
            background: linear-gradient(135deg, #ffb347, #ffcc33);
        }

        /* Form elementleri */
        .form-control-lg {
            padding: 0.75rem 1rem;
            font-size: 1rem;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .form-control-lg:focus {
                border-color: #ffb347;
                box-shadow: 0 0 0 0.25rem rgba(255, 179, 71, 0.25);
                transform: translateY(-2px);
            }

            .form-control-lg.is-valid {
                border-color: #198754;
            }

            .form-control-lg.is-invalid {
                border-color: #dc3545;
            }

        .input-group-text {
            border-radius: 10px 0 0 10px;
            border: 2px solid #e9ecef;
            border-right: none;
            background-color: #f8f9fa;
            transition: all 0.3s ease;
        }

        .input-group:focus-within .input-group-text {
            border-color: #ffb347;
            background-color: #fff3e0;
        }

        .form-label {
            color: #495057;
            margin-bottom: 0.75rem;
            font-weight: 600;
            font-size: 1.05rem;
        }

        /* Bilgi kartları */
        .info-card {
            border-left: 4px solid #ffb347;
            background: linear-gradient(135deg, #fff8e1, #fff3cd);
        }

        .info-item {
            margin-bottom: 0.5rem;
            padding: 0.5rem;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

            .info-item:hover {
                background-color: rgba(255, 255, 255, 0.5);
            }

        .info-label {
            font-weight: 600;
            color: #856404;
            margin-right: 0.5rem;
            min-width: 120px;
            display: inline-block;
        }

        .info-value {
            font-weight: 500;
            color: #212529;
        }

        /* Önizleme kartı */
        .preview-card {
            background: linear-gradient(135deg, #fffde7, #fff9c4);
            animation: slideIn 0.5s ease-out;
        }

        .preview-item {
            margin-bottom: 0.75rem;
            padding: 0.5rem;
            border-radius: 6px;
            background-color: rgba(255, 255, 255, 0.7);
        }

        .preview-label {
            font-weight: 600;
            color: #856404;
            margin-right: 0.5rem;
            min-width: 60px;
            display: inline-block;
        }

        .preview-old {
            color: #dc3545;
            text-decoration: line-through;
            font-weight: 500;
            margin-right: 1rem;
        }

        .preview-new {
            color: #198754;
            font-weight: 600;
        }

        /* Buton stilleri */
        .btn-lg {
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-warning {
            background: linear-gradient(135deg, #ffb347, #ffcc33);
            border: none;
            color: #212529;
        }

            .btn-warning:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 179, 71, 0.3);
            }

            .btn-warning:disabled {
                opacity: 0.6;
                cursor: not-allowed;
            }

        .btn-outline-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.2);
        }

        .btn-outline-danger:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.2);
        }

        .btn-info {
            background: linear-gradient(135deg, #17a2b8, #20c997);
            border: none;
            color: white;
        }

            .btn-info:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(23, 162, 184, 0.3);
            }

        .action-buttons {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            padding: 1.5rem;
            border-radius: 12px;
        }

        /* Breadcrumb */
        .breadcrumb {
            background-color: transparent;
            padding: 0;
            margin-bottom: 0;
        }

        .breadcrumb-item a {
            color: #6c757d;
            text-decoration: none;
            transition: color 0.3s;
        }

            .breadcrumb-item a:hover {
                color: #ffb347;
            }

        .breadcrumb-item.active {
            color: #ffb347;
            font-weight: 500;
        }

        /* Page title */
        .page-title-box {
            padding: 24px 0;
        }

        /* Animasyonlar */
        @@keyframes slideIn {
            from {
                opacity: 0;
                transform: translateX(-20px);
            }

            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Responsive düzenlemeler */
        @@media (max-width: 768px) {
            .form-label, .detail-value {
                text-align: left !important;
                margin-bottom: 0.5rem;
            }

            .btn-lg {
                width: 100%;
                margin-bottom: 10px;
            }

            .d-flex.justify-content-between {
                flex-direction: column;
            }

                .d-flex.justify-content-between > div {
                    width: 100%;
                    margin-bottom: 1rem;
                }

            .info-label, .preview-label {
                min-width: 100px;
                display: block;
                margin-bottom: 0.25rem;
            }

            .info-value, .preview-old, .preview-new {
                display: block;
            }

            .input-group {
                flex-direction: column;
            }

            .input-group-text {
                border-radius: 10px 10px 0 0;
                border-right: 2px solid #e9ecef;
                border-bottom: none;
                width: 100%;
                justify-content: center;
            }

            .form-select {
                border-radius: 0 0 10px 10px;
                border-top: none;
            }
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const userIdSelect = document.getElementById('userIdSelect');
            const roleIdSelect = document.getElementById('roleIdSelect');
            const saveButton = document.getElementById('saveButton');
            const backButton = document.getElementById('backButton');
            const form = document.getElementById('editForm');
            const changePreview = document.getElementById('changePreview');
            const previewNewUser = document.getElementById('previewNewUser');
            const previewNewRole = document.getElementById('previewNewRole');

            const originalUserEmail = '@userEmail';
            const originalRoleName = '@roleName';

            // Sayfa yüklendiğinde seçili değerleri ayarla
            setTimeout(() => {
                updatePreview();
                validateForm();
            }, 100);

            // Select değişikliklerini izle
            userIdSelect.addEventListener('change', function() {
                updatePreview();
                validateForm();
            });

            roleIdSelect.addEventListener('change', function() {
                updatePreview();
                validateForm();
            });

            // Form submit kontrolü
            form.addEventListener('submit', function(event) {
                if (!validateForm()) {
                    event.preventDefault();
                    showAlert('Lütfen tüm alanları doğru şekilde doldurun.', 'danger');
                    return false;
                }

                // Butonu devre dışı bırak ve loading state göster
                saveButton.disabled = true;
                saveButton.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Güncelleniyor...';
                backButton.style.pointerEvents = 'none';
                backButton.style.opacity = '0.6';

                return true;
            });

            // Form reset olayı
            form.addEventListener('reset', function() {
                setTimeout(function() {
                    saveButton.disabled = false;
                    saveButton.innerHTML = '<i class="fas fa-save me-2"></i>Güncelle';
                    backButton.style.pointerEvents = 'auto';
                    backButton.style.opacity = '1';
                    changePreview.style.display = 'none';
                    validateForm();
                }, 100);
            });

            // Yardımcı fonksiyonlar
            function updatePreview() {
                const selectedUserId = userIdSelect.value;
                const selectedRoleId = roleIdSelect.value;
                const selectedUserText = userIdSelect.options[userIdSelect.selectedIndex]?.text || '';
                const selectedRoleText = roleIdSelect.options[roleIdSelect.selectedIndex]?.text || '';

                // Değişiklik yapıldıysa önizlemeyi göster
                if ((selectedUserId && selectedUserId != '@Model.UserId') ||
                    (selectedRoleId && selectedRoleId != '@Model.RoleId')) {

                    previewNewUser.textContent = selectedUserText || '-';
                    previewNewRole.textContent = selectedRoleText || '-';
                    changePreview.style.display = 'block';
                } else {
                    changePreview.style.display = 'none';
                }
            }

            function validateForm() {
                const userId = userIdSelect.value;
                const roleId = roleIdSelect.value;
                let isValid = true;

                // UserId kontrolü
                if (!userId || userId === '') {
                    userIdSelect.classList.add('is-invalid');
                    userIdSelect.classList.remove('is-valid');
                    isValid = false;
                } else {
                    userIdSelect.classList.remove('is-invalid');
                    userIdSelect.classList.add('is-valid');
                }

                // RoleId kontrolü
                if (!roleId || roleId === '') {
                    roleIdSelect.classList.add('is-invalid');
                    roleIdSelect.classList.remove('is-valid');
                    isValid = false;
                } else {
                    roleIdSelect.classList.remove('is-invalid');
                    roleIdSelect.classList.add('is-valid');
                }

                // Aynı değer seçilmişse uyarı
                if (userId == '@Model.UserId' && roleId == '@Model.RoleId') {
                    saveButton.disabled = true;
                    saveButton.title = 'Değişiklik yapmadınız!';
                } else {
                    saveButton.disabled = !isValid;
                    saveButton.title = '';
                }

                return isValid;
            }

            function showAlert(message, type = 'danger') {
                // Mevcut alert'leri temizle
                const existingAlerts = document.querySelectorAll('.alert-dismissible');
                existingAlerts.forEach(alert => {
                    if (!alert.classList.contains('alert-success') && !alert.classList.contains('alert-danger')) {
                        alert.remove();
                    }
                });

                // Yeni alert oluştur
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show mt-3`;
                alertDiv.innerHTML = `
                    <i class="fas fa-${type === 'danger' ? 'exclamation-triangle' : 'info-circle'} me-2"></i>
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                `;

                // Formdan önce ekle
                form.parentNode.insertBefore(alertDiv, form);

                // 5 saniye sonra otomatik kapat
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.remove();
                    }
                }, 5000);
            }

            // Sayfa cache'den yüklendiğinde butonları sıfırla
            window.addEventListener('pageshow', function(event) {
                if (event.persisted) {
                    saveButton.disabled = false;
                    saveButton.innerHTML = '<i class="fas fa-save me-2"></i>Güncelle';
                    backButton.style.pointerEvents = 'auto';
                    backButton.style.opacity = '1';
                }
            });
        });
    </script>
}