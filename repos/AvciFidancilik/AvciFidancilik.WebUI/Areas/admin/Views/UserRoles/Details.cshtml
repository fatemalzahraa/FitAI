@model Eticaret.Core.Entities.UserRole

@{
    ViewData["Title"] = "Kullanıcı Rol Detayları";
    var userEmail = Model.User?.Email ?? "Bilinmeyen Kullanıcı";
    var roleName = Model.Role?.Name ?? "Bilinmeyen Rol";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/admin">Yönetim</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Kullanıcı Rolleri</a></li>
                        <li class="breadcrumb-item active">Detaylar</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-eye me-2"></i>Kullanıcı Rol Detayları
                    </h5>
                </div>
                <div class="card-body">

                    <!-- BAŞARI/HATA MESAJLARI -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle me-2"></i>
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="details-container">
                        <!-- KULLANICI BİLGİLERİ -->
                        <div class="detail-section">
                            <div class="section-header">
                                <i class="fas fa-user-circle me-2"></i>Kullanıcı Bilgileri
                            </div>
                            <div class="section-body">
                                <div class="row detail-row">
                                    <div class="col-md-3 detail-label">
                                        <i class="fas fa-user me-2"></i>Kullanıcı:
                                    </div>
                                    <div class="col-md-9 detail-value">
                                        <span class="value-text">@userEmail</span>
                                        <span class="value-badge bg-primary">Email</span>
                                    </div>
                                </div>
                                <div class="row detail-row">
                                    <div class="col-md-3 detail-label">
                                        <i class="fas fa-id-card me-2"></i>Kullanıcı ID:
                                    </div>
                                    <div class="col-md-9 detail-value">
                                        <span class="value-text">@Model.UserId</span>
                                        <span class="value-badge bg-secondary">ID</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ROL BİLGİLERİ -->
                        <div class="detail-section mt-4">
                            <div class="section-header">
                                <i class="fas fa-user-tag me-2"></i>Rol Bilgileri
                            </div>
                            <div class="section-body">
                                <div class="row detail-row">
                                    <div class="col-md-3 detail-label">
                                        <i class="fas fa-tag me-2"></i>Rol Adı:
                                    </div>
                                    <div class="col-md-9 detail-value">
                                        <span class="value-text">@roleName</span>
                                        <span class="value-badge bg-success">Rol</span>
                                    </div>
                                </div>
                                <div class="row detail-row">
                                    <div class="col-md-3 detail-label">
                                        <i class="fas fa-id-card me-2"></i>Rol ID:
                                    </div>
                                    <div class="col-md-9 detail-value">
                                        <span class="value-text">@Model.RoleId</span>
                                        <span class="value-badge bg-secondary">ID</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- KAYIT BİLGİLERİ -->
                        <div class="detail-section mt-4">
                            <div class="section-header">
                                <i class="fas fa-info-circle me-2"></i>Kayıt Bilgileri
                            </div>
                            <div class="section-body">
                                <div class="row detail-row">
                                    <div class="col-md-3 detail-label">
                                        <i class="fas fa-hashtag me-2"></i>Kayıt ID:
                                    </div>
                                    <div class="col-md-9 detail-value">
                                        <span class="value-text">@Model.Id</span>
                                        <span class="value-badge bg-info">Unique</span>
                                    </div>
                                </div>
                                <div class="row detail-row">
                                    <div class="col-md-3 detail-label">
                                        <i class="fas fa-link me-2"></i>İlişki Türü:
                                    </div>
                                    <div class="col-md-9 detail-value">
                                        <span class="value-text">Many-to-Many</span>
                                        <span class="value-badge bg-warning">Kullanıcı ↔ Rol</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- İSTATİSTİK KARTLARI -->
                        <div class="row mt-4">
                            <div class="col-md-6">
                                <div class="stat-card bg-primary text-white">
                                    <div class="stat-icon">
                                        <i class="fas fa-user-check"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h5 class="stat-title">Kullanıcı Ataması</h5>
                                        <p class="stat-text">@userEmail kullanıcısına @roleName rolü atanmıştır.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="stat-card bg-success text-white">
                                    <div class="stat-icon">
                                        <i class="fas fa-shield-alt"></i>
                                    </div>
                                    <div class="stat-content">
                                        <h5 class="stat-title">Yetki Durumu</h5>
                                        <p class="stat-text">Bu atama ile kullanıcı @roleName yetkilerine sahiptir.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ACTION BUTONLARI -->
                    <div class="action-buttons mt-5 pt-4 border-top">
                        <div class="d-flex justify-content-between">
                            <div>
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                    <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                                </a>
                            </div>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-lg px-4">
                                    <i class="fas fa-edit me-2"></i>Düzenle
                                </a>
                                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-lg px-4 ms-2">
                                    <i class="fas fa-trash-alt me-2"></i>Sil
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        /* Temel kart stil */
        .card {
            border: none;
            box-shadow: 0 0.75rem 1.5rem rgba(18, 38, 63, 0.08);
            border-radius: 15px;
            margin-bottom: 24px;
        }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
            padding: 1.25rem 1.5rem;
        }

        /* Detay bölümleri */
        .detail-section {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            overflow: hidden;
            background: #fff;
            transition: all 0.3s ease;
        }

            .detail-section:hover {
                box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
                transform: translateY(-2px);
            }

        .section-header {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            padding: 1rem 1.5rem;
            font-weight: 600;
            color: #495057;
            border-bottom: 1px solid #dee2e6;
            font-size: 1.1rem;
        }

        .section-body {
            padding: 1.5rem;
        }

        .detail-row {
            padding: 0.75rem 0;
            border-bottom: 1px solid #f8f9fa;
            transition: background-color 0.2s;
        }

            .detail-row:hover {
                background-color: #f8f9fa;
                border-radius: 6px;
            }

            .detail-row:last-child {
                border-bottom: none;
            }

        .detail-label {
            font-weight: 600;
            color: #6c757d;
            display: flex;
            align-items: center;
        }

        .detail-value {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .value-text {
            font-weight: 500;
            color: #212529;
            font-size: 1.05rem;
        }

        .value-badge {
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            color: white;
        }

        /* İstatistik kartları */
        .stat-card {
            border-radius: 12px;
            padding: 1.5rem;
            display: flex;
            align-items: center;
            height: 100%;
            transition: all 0.3s ease;
            border: none;
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            }

        .stat-icon {
            font-size: 2.5rem;
            margin-right: 1.5rem;
            opacity: 0.9;
        }

        .stat-content {
            flex: 1;
        }

        .stat-title {
            font-size: 1.1rem;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .stat-text {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 0;
        }

        /* Buton stilleri */
        .btn-lg {
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea, #764ba2);
            border: none;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(102, 126, 234, 0.3);
            }

        .btn-danger {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            border: none;
        }

            .btn-danger:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 65, 108, 0.3);
            }

        .btn-outline-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.2);
        }

        .action-buttons {
            background: linear-gradient(135deg, #f8f9fa, #e9ecef);
            padding: 1.5rem;
            border-radius: 12px;
        }

        /* Breadcrumb */
        .breadcrumb {
            background-color: transparent;
            padding: 0;
            margin-bottom: 0;
        }

        .breadcrumb-item a {
            color: #6c757d;
            text-decoration: none;
            transition: color 0.3s;
        }

            .breadcrumb-item a:hover {
                color: #667eea;
            }

        .breadcrumb-item.active {
            color: #495057;
            font-weight: 500;
        }

        /* Page title */
        .page-title-box {
            padding: 24px 0;
        }

        /* Responsive düzenlemeler */
        @@media (max-width: 768px) {
            .detail-label, .detail-value {
                text-align: left !important;
                margin-bottom: 0.5rem;
            }

            .btn-lg {
                width: 100%;
                margin-bottom: 10px;
            }

            .d-flex.justify-content-between {
                flex-direction: column;
            }

                .d-flex.justify-content-between > div {
                    width: 100%;
                    margin-bottom: 1rem;
                }

            .btn-group {
                width: 100%;
                display: flex;
                flex-direction: column;
            }

            .stat-card {
                flex-direction: column;
                text-align: center;
                margin-bottom: 1rem;
            }

            .stat-icon {
                margin-right: 0;
                margin-bottom: 1rem;
            }
        }

        /* Animasyonlar */
        .fade-in {
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Sayfa yüklendiğinde fade-in efekti
            const detailsContainer = document.querySelector('.details-container');
            detailsContainer.classList.add('fade-in');

            // Detay satırlarına hover efekti için event listener
            const detailRows = document.querySelectorAll('.detail-row');
            detailRows.forEach(row => {
                row.addEventListener('mouseenter', function() {
                    this.style.backgroundColor = '#f8f9fa';
                });

                row.addEventListener('mouseleave', function() {
                    this.style.backgroundColor = '';
                });
            });

            // Buton hover efektleri
            const buttons = document.querySelectorAll('.btn-lg');
            buttons.forEach(button => {
                button.addEventListener('mouseenter', function() {
                    this.style.transform = 'translateY(-2px)';
                });

                button.addEventListener('mouseleave', function() {
                    this.style.transform = '';
                });
            });

            // Alert'leri otomatik kapat (5 saniye sonra)
            const alerts = document.querySelectorAll('.alert-dismissible');
            alerts.forEach(alert => {
                setTimeout(() => {
                    const closeBtn = alert.querySelector('.btn-close');
                    if (closeBtn) {
                        closeBtn.click();
                    }
                }, 5000);
            });
        });
    </script>
}