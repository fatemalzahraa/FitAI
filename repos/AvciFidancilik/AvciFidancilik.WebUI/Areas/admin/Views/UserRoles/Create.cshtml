@model Eticaret.Core.Entities.UserRole

@{
    ViewData["Title"] = "Kullanıcı Rolü Oluştur";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-title-box d-flex align-items-center justify-content-between">
                <h4 class="mb-0">@ViewData["Title"]</h4>
                <div class="page-title-right">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/admin">Yönetim</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Kullanıcı Rolleri</a></li>
                        <li class="breadcrumb-item active">Oluştur</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">Yeni Kullanıcı Rolü Ekle</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Create" class="needs-validation" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="UserId" class="form-label fw-semibold">
                                        <i class="fas fa-user me-2"></i>Kullanıcı Seçimi
                                    </label>
                                    <select asp-for="UserId" class="form-select form-control-lg" asp-items="ViewBag.UserId" required>
                                        <option value="">Lütfen bir kullanıcı seçin</option>
                                    </select>
                                    <span asp-validation-for="UserId" class="invalid-feedback d-block"></span>
                                    <small class="form-text text-muted mt-1">
                                        <i class="fas fa-info-circle me-1"></i>Rol atamak istediğiniz kullanıcıyı seçin.
                                    </small>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="RoleId" class="form-label fw-semibold">
                                        <i class="fas fa-user-tag me-2"></i>Rol Seçimi
                                    </label>
                                    <select asp-for="RoleId" class="form-select form-control-lg" asp-items="ViewBag.RoleId" required>
                                        <option value="">Lütfen bir rol seçin</option>
                                    </select>
                                    <span asp-validation-for="RoleId" class="invalid-feedback d-block"></span>
                                    <small class="form-text text-muted mt-1">
                                        <i class="fas fa-info-circle me-1"></i>Kullanıcıya atamak istediğiniz rolü seçin.
                                    </small>
                                </div>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4">
                                            <i class="fas fa-arrow-left me-2"></i>Listeye Dön
                                        </a>
                                    </div>
                                    <div>
                                        <button type="submit" class="btn btn-success btn-lg px-5">
                                            <i class="fas fa-save me-2"></i>Oluştur
                                        </button>
                                        <button type="reset" class="btn btn-warning btn-lg px-4 ms-2">
                                            <i class="fas fa-redo me-2"></i>Temizle
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .card {
            border: none;
            box-shadow: 0 0.75rem 1.5rem rgba(18, 38, 63, 0.03);
            border-radius: 15px;
            margin-bottom: 24px;
        }

        .card-header {
            border-radius: 15px 15px 0 0 !important;
            padding: 1.25rem 1.5rem;
        }

        .form-control-lg {
            padding: 0.75rem 1rem;
            font-size: 1rem;
            border: 1px solid #e9ecef;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .form-control-lg:focus {
                border-color: #5c9ded;
                box-shadow: 0 0 0 0.2rem rgba(92, 157, 237, 0.25);
                transform: translateY(-2px);
            }

        .form-label {
            color: #495057;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }

        .btn-lg {
            padding: 0.75rem 1.5rem;
            border-radius: 10px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-success {
            background: linear-gradient(135deg, #00b09b, #96c93d);
            border: none;
        }

            .btn-success:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0, 176, 155, 0.3);
            }

        .btn-outline-secondary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(108, 117, 125, 0.3);
        }

        .btn-warning {
            background: linear-gradient(135deg, #ffb347, #ffcc33);
            border: none;
            color: #fff;
        }

            .btn-warning:hover {
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(255, 179, 71, 0.3);
            }

        .breadcrumb {
            background-color: transparent;
            padding: 0;
            margin-bottom: 0;
        }

        .breadcrumb-item a {
            color: #6c757d;
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color: #5c9ded;
        }

        .page-title-box {
            padding: 24px 0;
        }

        .invalid-feedback {
            display: block;
            margin-top: 0.25rem;
            font-size: 0.875em;
            color: #dc3545;
        }

        .form-text.text-muted {
            font-size: 0.85rem;
        }

        .alert-danger {
            border-radius: 10px;
            border: 1px solid #f5c6cb;
        }
    </style>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Bootstrap validation
        (function () {
            'use strict'
            var forms = document.querySelectorAll('.needs-validation')
            Array.prototype.slice.call(forms)
                .forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!form.checkValidity()) {
                            event.preventDefault()
                            event.stopPropagation()
                        }
                        form.classList.add('was-validated')
                    }, false)
                })
        })()

        // Select2 ile güçlendirilmiş dropdown (isteğe bağlı - select2 kütüphanesi gerektirir)
        document.addEventListener('DOMContentLoaded', function() {
            // Select2 kullanmak isterseniz
            // $('select').select2({
            //     theme: 'bootstrap-5',
            //     width: '100%'
            // });

            // Basit bir arama özelliği ekleyelim
            const selects = document.querySelectorAll('select.form-select');
            selects.forEach(select => {
                const originalOptions = Array.from(select.options);

                // Input için bir wrapper oluştur
                const wrapper = document.createElement('div');
                wrapper.className = 'position-relative';
                select.parentNode.insertBefore(wrapper, select);
                wrapper.appendChild(select);

                // Arama inputu
                const searchInput = document.createElement('input');
                searchInput.type = 'text';
                searchInput.className = 'form-control form-control-sm mb-2';
                searchInput.placeholder = 'Arama...';
                searchInput.style.display = 'none';
                wrapper.insertBefore(searchInput, select);

                // Arama toggle butonu
                const searchBtn = document.createElement('button');
                searchBtn.type = 'button';
                searchBtn.className = 'btn btn-sm btn-outline-secondary position-absolute';
                searchBtn.innerHTML = '<i class="fas fa-search"></i>';
                searchBtn.style.right = '10px';
                searchBtn.style.top = '10px';
                searchBtn.style.zIndex = '10';
                select.parentNode.appendChild(searchBtn);

                searchBtn.addEventListener('click', function() {
                    searchInput.style.display = searchInput.style.display === 'none' ? 'block' : 'none';
                    if (searchInput.style.display === 'block') {
                        searchInput.focus();
                    }
                });

                searchInput.addEventListener('input', function(e) {
                    const searchTerm = e.target.value.toLowerCase();
                    select.innerHTML = '';

                    originalOptions.forEach(option => {
                        if (option.text.toLowerCase().includes(searchTerm) || option.value === '') {
                            select.appendChild(option.cloneNode(true));
                        }
                    });
                });
            });
        });
    </script>
}