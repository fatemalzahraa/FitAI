@model List<Eticaret.Core.Entities.Product>

@{
    ViewData["Title"] = ViewBag.CategoryName ?? "Kategori";
    var categoryId = ViewBag.CategoryId;
}

<!-- Basitleştirilmiş CSS -->
<style>
    .product-card {
        transition: all 0.3s ease;
        border: 1px solid #eaeaea;
        border-radius: 8px;
        overflow: hidden;
        height: 100%;
        margin-bottom: 20px;
    }

    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        border-color: #007bff;
    }

    .product-image-container {
        position: relative;
        overflow: hidden;
        height: 200px;
        background-color: #f8f9fa;
    }

    .product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .product-card:hover .product-image {
        transform: scale(1.05);
    }

    .product-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 48px;
        font-weight: 600;
        color: #333;
        margin-bottom: 10px;
        font-size: 1rem;
    }

    .product-price {
        font-size: 1.1rem;
        font-weight: 700;
        color: #007bff;
        margin-bottom: 15px;
    }

    .btn-detail {
        background-color: #007bff;
        border: none;
        color: white;
        padding: 8px 15px;
        border-radius: 4px;
        font-weight: 500;
        transition: background-color 0.3s ease;
        width: 100%;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }

    .btn-detail:hover {
        background-color: #0056b3;
        color: white;
    }

    .btn-add-cart {
        background-color: #28a745;
        border: none;
        color: white;
        padding: 8px 15px;
        border-radius: 4px;
        font-weight: 500;
        transition: background-color 0.3s ease;
        width: 100%;
        margin-top: 8px;
    }

    .btn-add-cart:hover {
        background-color: #218838;
    }

    .category-header {
        background-color: #f8f9fa;
        padding: 20px 0;
        margin-bottom: 30px;
        border-radius: 8px;
        border-left: 5px solid #007bff;
    }

    @@media (max-width: 768px) {
        .product-card {
            margin-bottom: 15px;
        }
        
        .product-image-container {
            height: 180px;
        }
        
        .product-name {
            font-size: 0.95rem;
        }
    }
</style>

<div class="container py-4">
    <!-- Kategori Başlığı -->
    <div class="category-header mb-4 px-3">
        <h1 class="h3 fw-bold mb-2">@ViewBag.CategoryName</h1>
        <p class="text-muted mb-0">
            <i class="fas fa-box me-1"></i>
            <span id="productCount">@Model.Count</span> ürün bulundu
        </p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <h4 class="mb-3">Bu kategoride henüz ürün bulunmuyor</h4>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-home me-2"></i>Ana Sayfaya Dön
            </a>
        </div>
    }
    else
    {
        <div class="row" id="productsContainer">
            @foreach (var product in Model)
            {
                <div class="col-lg-3 col-md-4 col-sm-6 mb-4 product-item"
                     data-price="@product.Price">
                    
                    <div class="product-card">
                        <!-- Ürün Görseli -->
                        <div class="product-image-container">
                            @{
                                var imageUrl = "";
                                if (product.ProductImages != null && product.ProductImages.Any())
                                {
                                    imageUrl = product.ProductImages.First().ImageUrl;
                                }
                                else if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    imageUrl = product.ImageUrl;
                                }
                            }
                            
                            @if (!string.IsNullOrEmpty(imageUrl))
                            {
                                <img src="@imageUrl"
                                     class="product-image"
                                     alt="@product.Name"
                                     loading="lazy">
                            }
                            else
                            {
                                <div class="d-flex justify-content-center align-items-center h-100 text-muted">
                                    <i class="fas fa-image fa-2x"></i>
                                </div>
                            }
                        </div>

                        <!-- Ürün Bilgileri -->
                        <div class="p-3">
                            <!-- Ürün Adı -->
                            <h6 class="product-name mb-2">
                                @product.Name
                            </h6>

                            <!-- Fiyat -->
                            <div class="product-price mb-3">
                                @product.Price.ToString("C2")
                            </div>

                            <!-- Butonlar -->
                            <a asp-controller="Product"
                               asp-action="Detail"
                               asp-route-id="@product.Id"
                               class="btn-detail">
                                <i class="fas fa-eye me-1"></i>İncele
                            </a>
                            
                            <button class="btn-add-cart add-to-cart-btn"
                                    data-product-id="@product.Id"
                                    data-product-name="@product.Name"
                                    data-product-price="@product.Price">
                                <i class="fas fa-shopping-cart me-1"></i>Sepete Ekle
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <!-- Sıralama Butonları -->
        <div class="d-flex justify-content-end mb-4">
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary btn-sm sort-btn" data-sort="price-asc">
                    <i class="fas fa-sort-amount-up me-1"></i>Fiyat (Artan)
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm sort-btn" data-sort="price-desc">
                    <i class="fas fa-sort-amount-down me-1"></i>Fiyat (Azalan)
                </button>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Sepete ekleme işlemi
            document.querySelectorAll('.add-to-cart-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const productId = this.dataset.productId;
                    const productName = this.dataset.productName;
                    
                    // Loading efekti
                    const originalText = this.innerHTML;
                    this.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Ekleniyor...';
                    this.disabled = true;
                    
                    // Sepete ekleme işlemi (AJAX veya sayfa yenileme)
                    setTimeout(() => {
                        alert(`"${productName}" sepete eklendi!`);
                        
                        // Butonu eski haline getir
                        this.innerHTML = originalText;
                        this.disabled = false;
                        
                        // Sepet sayısını güncelle
                        updateCartCount();
                    }, 500);
                });
            });
            
            // Sıralama işlemi
            document.querySelectorAll('.sort-btn').forEach(button => {
                button.addEventListener('click', function () {
                    const sortType = this.dataset.sort;
                    
                    // Tüm butonlardan aktif class'ını kaldır
                    document.querySelectorAll('.sort-btn').forEach(btn => {
                        btn.classList.remove('active', 'btn-primary');
                        btn.classList.add('btn-outline-secondary');
                    });
                    
                    // Tıklanan butonu aktif yap
                    this.classList.remove('btn-outline-secondary');
                    this.classList.add('active', 'btn-primary');
                    
                    // Ürünleri sırala
                    sortProducts(sortType);
                });
            });
            
            // Ürünleri sırala fonksiyonu
            function sortProducts(sortType) {
                const container = document.getElementById('productsContainer');
                const items = Array.from(container.querySelectorAll('.product-item'));
                
                items.sort((a, b) => {
                    const priceA = parseFloat(a.dataset.price);
                    const priceB = parseFloat(b.dataset.price);
                    
                    if (sortType === 'price-asc') {
                        return priceA - priceB;
                    } else if (sortType === 'price-desc') {
                        return priceB - priceA;
                    }
                    return 0;
                });
                
                // Container'ı temizle ve sıralanmış öğeleri ekle
                container.innerHTML = '';
                items.forEach(item => {
                    container.appendChild(item);
                });
            }
            
            // Sepet sayısını güncelle (örnek fonksiyon)
            function updateCartCount() {
                const cartCountElement = document.querySelector('.cart-count');
                if (cartCountElement) {
                    const currentCount = parseInt(cartCountElement.textContent) || 0;
                    cartCountElement.textContent = currentCount + 1;
                    
                    // Animasyon efekti
                    cartCountElement.style.transform = 'scale(1.3)';
                    setTimeout(() => {
                        cartCountElement.style.transform = 'scale(1)';
                    }, 300);
                }
            }
            
            // Ürün kartına tıklama (detay sayfasına git)
            document.querySelectorAll('.product-card').forEach(card => {
                card.addEventListener('click', function (e) {
                    // Eğer butona tıklanmadıysa
                    if (!e.target.closest('button') && !e.target.closest('a')) {
                        const productId = this.querySelector('.add-to-cart-btn')?.dataset.productId;
                        if (productId) {
                            window.location.href = `/Product/Detail/${productId}`;
                        }
                    }
                });
            });
        });
    </script>
}