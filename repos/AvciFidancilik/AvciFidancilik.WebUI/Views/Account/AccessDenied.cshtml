@{
    ViewData["Title"] = "Erişim Engellendi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-danger text-white">
                    <h4><i class="fas fa-ban me-2"></i>Erişim Engellendi</h4>
                </div>
                <div class="card-body">
                    <i class="fas fa-lock fa-4x text-danger mb-3"></i>
                    <h5 class="card-title">Bu sayfaya erişim izniniz yok</h5>
                    <p class="card-text">
                        Bu sayfayı görüntülemek için gerekli yetkilere sahip değilsiniz.
                        Lütfen sistem yöneticinizle iletişime geçin.
                    </p>
                    <div class="mt-4">
                        <a href="/" class="btn btn-primary me-2">
                            <i class="fas fa-home me-1"></i>Ana Sayfa
                        </a>
                        <a href="/Account/Logout" class="btn btn-outline-secondary">
                            <i class="fas fa-sign-out-alt me-1"></i>Çıkış Yap
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>