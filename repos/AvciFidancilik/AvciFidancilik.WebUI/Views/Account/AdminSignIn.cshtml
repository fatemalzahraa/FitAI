@{
    ViewData["Title"] = "Admin Giriş - Avcı Fidancılık";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-container">
    <div class="auth-wrapper">

        <!-- SOL TARAF GÖRSEL -->
        <div class="auth-image-section">
            <div class="auth-image-overlay"></div>
            <img src="https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=800&q=80"
                 alt="Avcı Fidancılık Bahçe"
                 class="auth-image">

            <div class="auth-image-content">
                <h3>Avcı Fidancılık Yönetim Paneli</h3>
                <p>Sadece yetkili yöneticiler giriş yapabilir</p>

                <div class="auth-features">
                    <div class="feature-item">
                        <i class="fas fa-shield-alt"></i>
                        <span>Güvenli Yönetim</span>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-database"></i>
                        <span>Merkezi Kontrol</span>
                    </div>
                    <div class="feature-item">
                        <i class="fas fa-user-lock"></i>
                        <span>Rol Tabanlı Yetkilendirme</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- SAĞ TARAF FORM -->
        <div class="auth-form-section">
            <div class="auth-form-header">
                <a href="/" class="auth-logo">
                    <img src="~/Img/logo/avciLogo.png"
                         alt="Avcı Fidancılık"
                         height="40">
                </a>
                <h2>Yönetici Girişi</h2>
                <p class="text-muted">
                    Admin paneline erişmek için giriş yapın
                </p>
            </div>

            <!-- 🔐 GERÇEK LOGIN FORM -->
            <form asp-controller="Account"
                  asp-action="Login"
                  method="post"
                  class="auth-form"
                  id="adminLoginForm">

                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Kullanıcı Adı veya E-posta</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-user-shield"></i>
                        </span>
                        <input type="text"
                               name="userNameOrEmail"
                               class="form-control"
                               placeholder="admin veya admin@email.com"
                               required />
                    </div>
                </div>

                <div class="form-group">
                    <label>Şifre</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input type="password"
                               id="adminPassword"
                               name="password"
                               class="form-control"
                               placeholder="Şifrenizi girin"
                               required />

                        <button type="button"
                                class="btn btn-outline-secondary password-toggle"
                                data-target="adminPassword">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <!-- HATA MESAJI -->
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger mt-2">
                        @ViewBag.Error
                    </div>
                }

                <button type="submit"
                        class="btn btn-auth-primary w-100 mt-3"
                        id="adminLoginBtn">
                    <i class="fas fa-sign-in-alt me-2"></i>
                    Giriş Yap
                </button>

                <div class="auth-footer">
                    <p class="text-center mt-3">
                        <a href="/" class="back-home">
                            <i class="fas fa-arrow-left me-1"></i>
                            Ana Sayfaya Dön
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 🌱 FİDAN ANİMASYONU -->
<div id="seedlingAnimation"
     class="seedling-overlay"
     style="display:none;">
    <div class="seedling-container">
        <div class="seedling">
            <div class="pot">
                <div class="pot-top"></div>
                <div class="pot-body"></div>
                <div class="pot-bottom"></div>
            </div>
            <div class="stem"></div>
            <div class="leaf leaf-left"></div>
            <div class="leaf leaf-right"></div>
            <div class="leaf leaf-top"></div>
        </div>

        <div class="loading-message">
            <div class="message-text">
                <span class="text-primary">YÖNETİM PANELİNE</span>
                <span class="text-secondary">YÖNLENDİRİLİYORSUNUZ</span>
            </div>
            <div class="loading-text">
                Lütfen bekleyiniz...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Şifre göster / gizle
        document.querySelectorAll('.password-toggle').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = document.getElementById(this.dataset.target);
                const icon = this.querySelector('i');

                if (input.type === "password") {
                    input.type = "text";
                    icon.classList.replace("fa-eye", "fa-eye-slash");
                } else {
                    input.type = "password";
                    icon.classList.replace("fa-eye-slash", "fa-eye");
                }
            });
        });

        // Submit sırasında animasyon
        document.getElementById("adminLoginForm")
            .addEventListener("submit", function () {
                document.getElementById("seedlingAnimation").style.display = "flex";
            });
    </script>
}
