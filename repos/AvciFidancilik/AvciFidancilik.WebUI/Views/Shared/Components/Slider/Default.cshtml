@model IEnumerable<Eticaret.Core.Entities.Slider>

@if (Model != null && Model.Any())
{
    <!-- SLIDER CONTAINER -->
    <section class="avci-slider-container">
        <div class="avci-slider" id="avciSlider">
            @foreach (var slider in Model)
            {
                <div class="slider-item">
                    <!-- Slider Görseli -->
                    <div class="slider-image">
                        <img src="@slider.ImageUrl"
                             alt="@slider.Title"
                             loading="lazy"
                             onerror="this.src='https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=1200&q=80'">
                    </div>

                    <!-- Slider İçeriği -->
                    <div class="slider-content">
                        <div class="container">
                            <div class="slider-text">
                                @if (!string.IsNullOrEmpty(slider.Title))
                                {
                                    <h1 class="slider-title">@slider.Title</h1>
                                }

                                @if (!string.IsNullOrEmpty(slider.SubTitle))
                                {
                                    <p class="slider-subtitle">@slider.SubTitle</p>
                                }

                                <div class="slider-buttons mt-4">
                                    <a href="/Product" class="btn btn-accent">
                                        <i class="fas fa-shopping-cart me-2"></i>Alışverişe Başla
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Karanlık Overlay -->
                    <div class="slider-overlay"></div>
                </div>
            }
        </div>

        <!-- Slider Kontrolleri -->
        <div class="slider-controls">
            <button class="slider-prev" aria-label="Önceki slider">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="slider-next" aria-label="Sonraki slider">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>

        <!-- Slider Dots (İndikatörler) -->
        <div class="slider-dots">
            @for (int i = 0; i < Model.Count(); i++)
            {
                <button class="slider-dot @(i == 0 ? "active" : "")"
                        data-slide-index="@i"
                        aria-label="@(i + 1). slider'a git"></button>
            }
        </div>

        <!-- Slider Sayacı -->
        <div class="slider-counter">
            <span class="current-slide">1</span> / <span class="total-slides">@Model.Count()</span>
        </div>
    </section>
}
else
{
    <!-- Eğer slider yoksa varsayılan bir banner göster -->
    <section class="default-hero-banner">
        <div class="container">
            <div class="hero-content text-center">
                <h1>Doğanın En Güzel Hali</h1>
                <p class="lead">Kaliteli fidanlar ve bahçe ürünleri için doğru adres</p>
                <a href="/Product" class="btn btn-accent btn-lg mt-3">
                    <i class="fas fa-shopping-cart me-2"></i>Alışverişe Başla
                </a>
            </div>
        </div>
    </section>
}

<!-- Slider CSS -->
<style>
    /* SLIDER ANA YAPISI */
    .avci-slider-container {
        position: relative;
        width: 100%;
        height: 600px;
        overflow: hidden;
        border-radius: 0 0 15px 15px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
        margin-bottom: 40px;
    }

    .avci-slider {
        display: flex;
        height: 100%;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .slider-item {
        position: relative;
        min-width: 100%;
        height: 100%;
        flex-shrink: 0;
    }

    /* SLIDER GÖRSELİ */
    .slider-image {
        position: absolute;
        width: 100%;
        height: 100%;
    }

        .slider-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center;
        }

    /* KARANLIK OVERLAY */
    .slider-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(to right, rgba(26, 26, 26, 0.8) 0%, rgba(26, 26, 26, 0.4) 100%);
        z-index: 1;
    }

    /* SLIDER İÇERİĞİ */
    .slider-content {
        position: relative;
        z-index: 2;
        height: 100%;
        display: flex;
        align-items: center;
        color: white;
    }

    .slider-text {
        max-width: 600px;
        animation: fadeInUp 0.8s ease-out;
    }

    .slider-title {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 1rem;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        color: white;
    }

    .slider-subtitle {
        font-size: 1.3rem;
        opacity: 0.9;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    /* SLIDER KONTROLLERİ */
    .slider-controls {
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        transform: translateY(-50%);
        z-index: 3;
        display: flex;
        justify-content: space-between;
        padding: 0 20px;
    }

    .slider-prev, .slider-next {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.15);
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: white;
        font-size: 1.2rem;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(5px);
    }

        .slider-prev:hover, .slider-next:hover {
            background: var(--primary-yellow);
            color: var(--primary-black);
            border-color: var(--primary-yellow);
            transform: scale(1.1);
        }

    /* SLIDER DOTS (İNDİKATÖRLER) */
    .slider-dots {
        position: absolute;
        bottom: 30px;
        left: 0;
        right: 0;
        display: flex;
        justify-content: center;
        gap: 12px;
        z-index: 3;
    }

    .slider-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.4);
        border: 2px solid transparent;
        cursor: pointer;
        transition: all 0.3s ease;
        padding: 0;
    }

        .slider-dot.active {
            background: var(--primary-yellow);
            transform: scale(1.3);
        }

        .slider-dot:hover {
            background: white;
            transform: scale(1.2);
        }

    /* SLIDER SAYACI */
    .slider-counter {
        position: absolute;
        bottom: 30px;
        right: 30px;
        background: rgba(0, 0, 0, 0.6);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        z-index: 3;
        backdrop-filter: blur(5px);
    }

        .slider-counter .current-slide {
            color: var(--primary-yellow);
        }

    /* VARYANLIYAN HERO BANNER (Slider yoksa) */
    .default-hero-banner {
        background: linear-gradient(135deg, var(--primary-black) 0%, #2c3e50 100%);
        color: white;
        padding: 100px 0;
        text-align: center;
        border-radius: 0 0 15px 15px;
        margin-bottom: 40px;
    }

        .default-hero-banner h1 {
            font-size: 3rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .default-hero-banner .lead {
            font-size: 1.3rem;
            opacity: 0.9;
        }

    /* BUTONLAR */
    .slider-buttons .btn {
        padding: 12px 28px;
        font-weight: 600;
        margin-right: 15px;
        margin-bottom: 10px;
    }

    .btn-accent {
        background: var(--primary-yellow);
        color: var(--primary-black);
        border: 2px solid var(--primary-yellow);
    }

        .btn-accent:hover {
            background: #e0a800;
            border-color: #e0a800;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
        }

    .btn-outline-accent {
        background: transparent;
        color: white;
        border: 2px solid var(--primary-yellow);
    }

        .btn-outline-accent:hover {
            background: var(--primary-yellow);
            color: var(--primary-black);
        }

    /* ANİMASYONLAR */
    @@keyframes fadeInUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* RESPONSIVE TASARIM */
    @@media (max-width: 992px) {
        .avci-slider-container

    {
        height: 500px;
    }

    .slider-title {
        font-size: 2.8rem;
    }

    .slider-subtitle {
        font-size: 1.2rem;
    }

    }

    @@media (max-width: 768px) {
        .avci-slider-container

    {
        height: 450px;
    }

    .slider-title {
        font-size: 2.3rem;
    }

    .slider-subtitle {
        font-size: 1.1rem;
    }

    .slider-controls {
        padding: 0 10px;
    }

    .slider-prev, .slider-next {
        width: 45px;
        height: 45px;
    }

    .slider-buttons .btn {
        display: block;
        width: 100%;
        margin-right: 0;
        margin-bottom: 10px;
    }

    }

    @@media (max-width: 576px) {
        .avci-slider-container

    {
        height: 400px;
    }

    .slider-title {
        font-size: 2rem;
    }

    .slider-subtitle {
        font-size: 1rem;
    }

    .slider-counter {
        bottom: 20px;
        right: 20px;
    }

    .slider-dots {
        bottom: 20px;
    }

    }
</style>

<!-- Slider JavaScript -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const slider = document.getElementById('avciSlider');
        const slides = document.querySelectorAll('.slider-item');
        const dots = document.querySelectorAll('.slider-dot');
        const prevBtn = document.querySelector('.slider-prev');
        const nextBtn = document.querySelector('.slider-next');
        const currentSlideSpan = document.querySelector('.current-slide');
        const totalSlidesSpan = document.querySelector('.total-slides');

        if (!slider || slides.length === 0) return;

        let currentSlide = 0;
        const totalSlides = slides.length;
        let autoSlideInterval;

        // Toplam slide sayısını göster
        if (totalSlidesSpan) {
            totalSlidesSpan.textContent = totalSlides;
        }

        // Slider'ı ilk slide'a getir
        function goToSlide(index) {
            if (index < 0) index = totalSlides - 1;
            if (index >= totalSlides) index = 0;

            currentSlide = index;
            slider.style.transform = `translateX(-${currentSlide * 100}%)`;

            // Dots güncelle
            dots.forEach((dot, i) => {
                dot.classList.toggle('active', i === currentSlide);
            });

            // Sayacı güncelle
            if (currentSlideSpan) {
                currentSlideSpan.textContent = currentSlide + 1;
            }
        }

        // Sonraki slide'a git
        function nextSlide() {
            goToSlide(currentSlide + 1);
        }

        // Önceki slide'a git
        function prevSlide() {
            goToSlide(currentSlide - 1);
        }

        // Otomatik slider değişimi
        function startAutoSlide() {
            clearInterval(autoSlideInterval);
            autoSlideInterval = setInterval(nextSlide, 5000); // 5 saniyede bir
        }

        // Olay dinleyicileri
        if (nextBtn) {
            nextBtn.addEventListener('click', function() {
                nextSlide();
                startAutoSlide(); // Manuel müdahaleden sonra timer'ı resetle
            });
        }

        if (prevBtn) {
            prevBtn.addEventListener('click', function() {
                prevSlide();
                startAutoSlide(); // Manuel müdahaleden sonra timer'ı resetle
            });
        }

        // Dot'lara tıklama
        dots.forEach((dot, index) => {
            dot.addEventListener('click', function() {
                goToSlide(index);
                startAutoSlide(); // Manuel müdahaleden sonra timer'ı resetle
            });
        });

        // Kategori butonuna tıklama
        const categoryBtn = document.querySelector('.slider-category-btn');
        if (categoryBtn) {
            categoryBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const categoriesBtn = document.getElementById('categoriesNavBtn');
                if (categoriesBtn) {
                    categoriesBtn.click();
                }
            });
        }

        // Fare slider üzerindeyken otomatik geçişi durdur
        slider.addEventListener('mouseenter', function() {
            clearInterval(autoSlideInterval);
        });

        // Fare slider'dan çıkınca otomatik geçişi başlat
        slider.addEventListener('mouseleave', startAutoSlide);

        // Touch/swipe desteği (mobil için)
        let touchStartX = 0;
        let touchEndX = 0;

        slider.addEventListener('touchstart', function(e) {
            touchStartX = e.changedTouches[0].screenX;
        });

        slider.addEventListener('touchend', function(e) {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        });

        function handleSwipe() {
            const swipeThreshold = 50;

            if (touchStartX - touchEndX > swipeThreshold) {
                // Sola swipe - sonraki slide
                nextSlide();
            } else if (touchEndX - touchStartX > swipeThreshold) {
                // Sağa swipe - önceki slide
                prevSlide();
            }

            startAutoSlide(); // Swipe'tan sonra timer'ı resetle
        }

        // Keyboard desteği
        document.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowLeft') {
                prevSlide();
                startAutoSlide();
            } else if (e.key === 'ArrowRight') {
                nextSlide();
                startAutoSlide();
            }
        });

        // Slider'ı başlat
        goToSlide(0);
        startAutoSlide();

        console.log('Avcı Fidancılık Slider başlatıldı. Toplam ' + totalSlides + ' slider yüklendi.');
    });
</script>