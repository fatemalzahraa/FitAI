<div id="fidan-asistan-container">

    <div id="asistan-bar" class="asistan-trigger shadow-lg">
        <div class="asistan-icon-circle">
            <i class="fas fa-seedling"></i>
        </div>
        <span class="asistan-text">FİDAN ASİSTANI</span>
    </div>

    <div id="asistan-pencere" class="asistan-window hidden">
        <div class="asistan-header">
            <div class="bot-bilgi">
                <div class="bot-avatar">
                    <i class="fas fa-leaf"></i>
                </div>
                <div class="bot-detay">
                    <strong>Avcı Destek</strong>
                    <small><i class="fas fa-circle online-dot"></i> Çevrimiçi</small>
                </div>
            </div>
            <button id="asistan-kapat" class="btn-kapat">&times;</button>
        </div>

        <div id="asistan-mesajlar" class="asistan-content">
            <div class="mesaj bot">
                Merhaba! Avcı Fidancılık asistanına hoş geldiniz. Size nasıl yardımcı olabilirim? 🌿
            </div>
        </div>

        <div id="asistan-secenekler" class="asistan-options">
        </div>

        <div class="asistan-footer">
            <input type="text" id="asistan-input" placeholder="Bir şeyler yazın..." autocomplete="off">
            <button id="asistan-gonder"><i class="fas fa-paper-plane"></i></button>
        </div>
    </div>
</div>
<!-- Bu kısım mevcut HTML'in sonuna eklenebilir -->
<script>
    // Pencere açıldığında input'a otomatik odaklan
    document.addEventListener('DOMContentLoaded', function() {
        const asistanPencere = document.getElementById('asistan-pencere');
        const asistanInput = document.getElementById('asistan-input');

        if (asistanPencere && asistanInput) {
            const observer = new MutationObserver(function(mutations) {
                mutations.forEach(function(mutation) {
                    if (mutation.attributeName === 'class') {
                        if (!asistanPencere.classList.contains('hidden')) {
                            setTimeout(() => {
                                asistanInput.focus();
                            }, 300);
                        }
                    }
                });
            });

            observer.observe(asistanPencere, { attributes: true });
        }
    });
</script>