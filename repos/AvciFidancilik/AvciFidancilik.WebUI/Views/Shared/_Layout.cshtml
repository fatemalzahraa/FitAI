<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Avcı Fidancılık</title>

    <!-- SEO -->
    <meta name="description" content="Avcı Fidancılık - En kaliteli fidanlar, bahçe bitkileri ve tarım ürünleri" />
    <meta name="keywords" content="fidan, fidancılık, bahçe, bitki, ağaç, meyve fidanı" />
    <meta name="author" content="Avcı Fidancılık" />

    <!-- Favicon -->
    <link rel="icon" href="~/img/favicon.png" type="image/png" />


    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/fidan-asistan.css" asp-append-version="true" />

    <!-- Google Fonts -->


    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- OVERLAY -->
    <div class="sidebar-overlay"></div>

    <!-- HEADER -->
    @await Html.PartialAsync("_Header")

    <!-- CATEGORY SIDEBAR -->
    <div class="categories-sidebar">
        <div class="sidebar-header">
            <h5><i class="fas fa-list me-2"></i> Ürün Kategorileri</h5>
            <button class="close-sidebar"><i class="fas fa-times"></i></button>
        </div>
        <div class="sidebar-content">
            @await Component.InvokeAsync("Categories")
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <main>
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- FOOTER -->
    @await Html.PartialAsync("_Footer")

  

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await Html.PartialAsync("_FidanAsistanPartial")
    <script src="~/js/fidan-chatbot.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // ÜRÜNLER ve İLETİŞİM Link İşleyicileri
        function handleProductsClick(event) {
            const currentPath = window.location.pathname.toLowerCase();
            const isHomePage = currentPath === '/' || currentPath === '/home/index' || currentPath === '/home' || currentPath === '';

            if (isHomePage) {
                event.preventDefault();
                const productsSection = document.getElementById('urunlerimiz') || document.querySelector('.urunler-section');
                if (productsSection) {
                    productsSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            } else {
                window.location.href = '/Home/Index#urunlerimiz';
            }
        }

        function handleContactClick(event) {
            event.preventDefault();
            const footer = document.querySelector('footer');
            if (footer) footer.scrollIntoView({ behavior: 'smooth' });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Kategoriler ve Hesap Butonları
            const categoriesBtn = document.getElementById('categoriesNavBtn');
            if (categoriesBtn) {
                categoriesBtn.addEventListener('click', (e) => { e.preventDefault(); window.location.href = '/Product'; });
            }

            const accountBtn = document.getElementById('accountBtn');
            if (accountBtn) {
                accountBtn.addEventListener('click', () => { window.location.href = '/Account/SıgnIn'; });
            }
        });
    </script>
</body>
</html>