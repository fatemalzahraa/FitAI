        color: #ffc107;
        font-weight: 900;
        font-size: 1.6rem;
        margin-bottom: 45px;
        text-transform: uppercase;
        letter-spacing: 2px;
    }

    .footer-info-section {
        padding: 0 30px;
    }

    .footer-info-text-xl {
        font-size: 1.15rem;
        line-height: 1.8;
        margin-bottom: 25px;
    }

        .footer-info-text-xl i {
            font-size: 1.5rem;
            color: #ffc107;
            margin-right: 15px;
        }

    /* SOSYAL MEDYA İKONLARI */
    .footer-social-xl {
        display: flex;
        flex-wrap: nowrap;
        gap: 35px;
        margin-top: 40px;
        margin-left: 50px;
    }

    .social-icon-xl {
        color: #ffc107;
        font-size: 3.5rem;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        text-decoration: none;
        display: inline-block;
    }

        .social-icon-xl:hover {
            transform: scale(1.15) translateY(-8px);
            color: #ffffff;
        }

    /* HARİTA */

    .footer-map-wrapper {
        width: 100%;
        height: 420px;
        border-radius: 15px;
        overflow: hidden;
        border: 2px solid rgba(255, 193, 7, 0.3);
    }

    .btn-footer-submit {
        background: linear-gradient(135deg, #ffc107, #ff9800);
        color: #000;
        border: none;
        padding: 14px;
        font-weight: 800;
        border-radius: 8px;
        width: 100%;
        cursor: pointer;
        text-transform: uppercase;
        transition: 0.3s;
    }

        .btn-footer-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .form-alert {
        display: none;
        margin-top: 15px;
        padding: 12px;
        border-radius: 10px;
        font-weight: bold;
        text-align: center;
        transition: 0.5s;
    }
    /* YOL TARİFİ BUTONU */
    .btn-get-directions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: #ffc107;
        color: #000;
        text-decoration: none;
        padding: 12px;
        border-radius: 8px;
        font-weight: 800;
        margin-top: 15px;
        transition: all 0.3s ease;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

        .btn-get-directions:hover {
            background: #ffffff;
            color: #000;
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
        }
</style>

