    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const contactForm = document.getElementById('footerContactForm');
            const alertDiv = document.getElementById('formAlert');

            if (contactForm) {
                contactForm.addEventListener('submit', function(e) {
                    e.preventDefault();

                    const btn = document.getElementById('submitContactBtn');
                    const originalBtnText = btn.textContent;

                    btn.disabled = true;
                    btn.textContent = 'GÖNDERİLİYOR...';

                    // Az önce Controller'da düzenlediğimiz modele tam uygun JSON objesi
                    const formData = {
                        Name: document.getElementById('contactName').value,
                        Email: document.getElementById('contactEmail').value,
                        Subject: document.getElementById('contactSubject').value,
                        Message: document.getElementById('contactMessage').value,
                        // CreatedDate ve UserId Controller tarafında null/now olarak set edildiği için göndermiyoruz,
                        // hata riskini sıfıra indiriyoruz.
                    };

                    fetch('/Home/SendContactMessage', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(formData)
                    })
                    .then(response => {
                        if (!response.ok) throw new Error('Sunucu hatası');
                        return response.json();
                    })
                    .then(data => {
                        btn.disabled = false;
                        btn.textContent = originalBtnText;
                        alertDiv.style.display = 'block';

                        if(data.success) {
                            // BAŞARI DURUMU
                            alertDiv.style.backgroundColor = 'rgba(40, 167, 69, 0.2)';
                            alertDiv.style.color = '#71dd8a';
                            alertDiv.style.border = '1px solid #28a745';
                            alertDiv.innerHTML = '<i class="fas fa-check-circle"></i> Mesajınız başarıyla iletilmiştir.';

                            contactForm.reset(); // Formu temizle

                            // 5 saniye sonra mesajı gizle
                            setTimeout(() => {
                                alertDiv.style.display = 'none';
                            }, 5000);
                        } else {
                            // HATA DURUMU
                            alertDiv.style.backgroundColor = 'rgba(220, 53, 69, 0.2)';
                            alertDiv.style.color = '#ff818c';
                            alertDiv.style.border = '1px solid #dc3545';
                            alertDiv.textContent = data.message || "Mesaj kaydedilirken bir hata oluştu.";
                        }
                    })
                    .catch(error => {
                        btn.disabled = false;
                        btn.textContent = originalBtnText;
                        alertDiv.style.display = 'block';
                        alertDiv.style.backgroundColor = 'rgba(220, 53, 69, 0.2)';
                        alertDiv.style.color = '#ff818c';
                        alertDiv.textContent = "Bağlantı hatası: Sunucuya ulaşılamadı.";
                        console.error('Fetch Hatası:', error);
                    });
                });
            }
        });

        // CRUD İşlemleri için yardımcı fonksiyonlar (İhtiyaç duyarsan MyMessages sayfasında kullanabilirsin)
        function deleteMessage(messageId) {
            if(confirm('Bu mesajı veritabanından tamamen silmek istediğinize emin misiniz?')) {
                fetch('/Home/DeleteContactMessage?id=' + messageId, { method: 'POST' })
                .then(r => r.json())
                .then(d => { if(d.success) location.reload(); });
            }
        }
    </script>
</footer>