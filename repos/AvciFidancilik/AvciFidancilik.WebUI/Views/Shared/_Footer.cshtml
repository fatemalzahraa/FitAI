                            width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                </div>
                <a href="https://www.google.com/maps/place/Malatya+Avc%C4%B1+Fidanc%C4%B1l%C4%B1k/@@38.383393,38.284366,17z/data=!3m1!4b1!4m6!3m5!1s0x407635aff6e6ef25:0x68aaea240181db1b!8m2!3d38.383393!4d38.284366!16s%2Fg%2F11ts08xn6f?entry=ttu&g_ep=EgoyMDI2MDEyOC4wIKXMDSoKLDEwMDc5MjA2OUgBUAM%3D" target="_blank" class="btn-get-directions">
