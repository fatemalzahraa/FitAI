<!-- JavaScript -->
<script>
        // ÜRÜNLER Linki için özel işleyici
    function handleProductsClick(event) {
        // Anasayfa olup olmadığını kontrol et
        const currentPath = window.location.pathname;
        const isHomePage = currentPath === '/' ||
                         currentPath === '/Home/Index' ||
                         currentPath === '/Home' ||
                         currentPath === '';

        if (isHomePage) {
            // Anasayfadaysa, scroll yap
            event.preventDefault();
            event.stopPropagation();

            // URL'yi güncelle (geri butonu için)
            history.pushState(null, null, '#urunler');

            // Ürünler bölümünü bul (ID ile)
            let productsSection = document.getElementById('urunlerimiz');

            // Eğer ID ile bulamazsak, class ile dene
            if (!productsSection) {
                productsSection = document.querySelector('.urunler-section, .products-section, .product-list, .urunler');
            }

            // Eğer ürünler bölümü bulunduysa, scroll yap
            if (productsSection) {
                // Modern tarayıcılar için scrollIntoView
                productsSection.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });

                console.log('Ürünler bölümüne scroll yapıldı:', productsSection);
            } else {
                // Ürünler bölümü bulunamazsa Product sayfasına git
                console.log('Ürünler bölümü bulunamadı, Product sayfasına yönlendiriliyor...');
                window.location.href = '/Product';
            }
        }
        // Anasayfada değilse, normal şekilde Product sayfasına gider
    }

    // İLETİŞİM Linki için yeni işleyici - FOOTER'a scroll yapacak
    function handleContactClick(event) {
        // TÜM sayfalarda çalışacak - her sayfanın footer'ına scroll yap
        event.preventDefault();
        event.stopPropagation();

        // URL'yi güncelle (geri butonu için)
        history.pushState(null, null, '#footer-iletisim');

        // Footer'ı bul (farklı ID'ler deneyelim)
        let footerSection = document.getElementById('site-footer');
        if (!footerSection) footerSection = document.getElementById('footer-iletisim');
        if (!footerSection) footerSection = document.querySelector('.premium-footer, footer');

        // Footer bulunduysa, scroll yap
        if (footerSection) {
            footerSection.scrollIntoView({
                behavior: 'smooth',
                block: 'end'  // Footer'ın tamamını göster
            });

            console.log('Footer iletişim bölümüne scroll yapıldı:', footerSection);
        } else {
            // Footer bulunamazsa sayfanın en altına scroll yap
            window.scrollTo({
                top: document.body.scrollHeight,
                behavior: 'smooth'
            });
            console.log('Footer bulunamadı, sayfa sonuna scroll yapıldı');
        }
    }
        // Hesabım butonu işlevselliği
    document.addEventListener('DOMContentLoaded', function () {
        // Kategori butonu işlevselliği
        const categoriesBtn = document.getElementById('categoriesNavBtn');
        const categoriesBtn2 = document.getElementById('categoriesNavBtn2');

        if (categoriesBtn) {
            categoriesBtn.addEventListener('click', function (e) {
                e.preventDefault();
                window.location.href = '/Product';
            });
        }

        // HESABIM BUTONU - BU KISMI EKLEYİN
        const accountBtn = document.getElementById('accountBtn');
        if (accountBtn) {
            accountBtn.addEventListener('click', function () {
                window.location.href = '/Account/SıgnIn';
            });
        }

        // Arama formu validasyonu
        const searchForm = document.querySelector('.premium-search-form');
        if (searchForm) {
            searchForm.addEventListener('submit', function (e) {
                const searchInput = this.querySelector('.premium-search-input');
                if (searchInput && searchInput.value.trim().length < 2) {
                    e.preventDefault();
                    alert('Lütfen en az 2 karakter giriniz');
                    searchInput.focus();
                }
            });
        }
    });
    // Sayfa yüklendiğinde URL'de hash varsa scroll yap
    window.addEventListener('load', function() {
        // #urunler hash'i varsa
        if (window.location.hash === '#urunler') {
            setTimeout(() => {
                const productsSection = document.getElementById('urunlerimiz');
                if (productsSection) {
                    productsSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                    console.log('Sayfa yüklendi, #urunler hash\'i algılandı');
                }
            }, 500);
        }

        // #footer-iletisim hash'i varsa
        if (window.location.hash === '#footer-iletisim') {
            setTimeout(() => {
                let footerSection = document.getElementById('site-footer');
                if (!footerSection) footerSection = document.getElementById('footer-iletisim');
                if (!footerSection) footerSection = document.querySelector('.premium-footer, footer');

                if (footerSection) {
                    footerSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'end'
                    });
                    console.log('Sayfa yüklendi, #footer-iletisim hash\'i algılandı');
                }
            }, 500);
        }
    });

    // Geri/ileri butonları için
    window.addEventListener('hashchange', function() {
        // #urunler için
        if (window.location.hash === '#urunler') {
            const productsSection = document.getElementById('urunlerimiz');
            if (productsSection) {
                productsSection.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
                console.log('Hash değişti, #urunler hash\'i algılandı');
            }
        }

        // #footer-iletisim için
        if (window.location.hash === '#footer-iletisim') {
            let footerSection = document.getElementById('site-footer');
            if (!footerSection) footerSection = document.getElementById('footer-iletisim');
            if (!footerSection) footerSection = document.querySelector('.premium-footer, footer');

            if (footerSection) {
                footerSection.scrollIntoView({
                    behavior: 'smooth',
                    block: 'end'
                });
                console.log('Hash değişti, #footer-iletisim hash\'i algılandı');
            }
        }

            document.addEventListener('DOMContentLoaded', function () {
        // Kategori butonu
        const categoriesBtn = document.getElementById('categoriesNavBtn');
        if (categoriesBtn) { // <-- BU KONTROL ŞART
            categoriesBtn.addEventListener('click', function (e) {
                e.preventDefault();
                window.location.href = '/Product';
            });
        }

        // Hesap butonu
        const accountBtn = document.getElementById('accountBtn');
        if (accountBtn) { // <-- BU KONTROL ŞART
            accountBtn.addEventListener('click', function () {
                window.location.href = '/Account/SıgnIn';
            });
        }
        window.addEventListener('load', function() {
        // Eğer URL'de hash #urunler varsa scroll yap
        if (window.location.hash === '#urunler') {
            const section = document.getElementById('urunler');
            if (section) section.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Arama parametresi varsa inputu doldur
        const urlParams = new URLSearchParams(window.location.search);
        const searchTerm = urlParams.get('searchTerm');
        if (searchTerm) {
            const searchInput = document.querySelector('.premium-search-input');
            if (searchInput) searchInput.value = searchTerm;
        }
       document.addEventListener('DOMContentLoaded', function() {
        const searchForm = document.getElementById('premiumSearchForm');

        searchForm.addEventListener('submit', function(e) {
            e.preventDefault(); // sayfa reload’u durdur

            const searchInput = this.querySelector('.premium-search-input');
            const searchTerm = searchInput.value.trim();

            if (searchTerm.length < 2) {
                alert('Lütfen en az 2 karakter giriniz');
                searchInput.focus();
                return;
            }

            // 🔹 Filtreleme fonksiyonunu çağır
            filterAndSortProducts(searchTerm);

            // 🔹 #urunlerimiz bölümüne scroll
            const section = document.getElementById('urunlerimiz');
            if (section) {
                section.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        });

            // Footer'a smooth scroll fonksiyonu
    function scrollToFooter(event) {
        // Sadece aynı sayfadaysak scroll yapalım
        event.preventDefault();

        const footer = document.getElementById('site-footer');
        if (footer) {
            // Smooth scroll efekti
            footer.scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });

            // URL'yi güncelle (geri/ileri butonu için)
            history.pushState(null, null, '#site-footer');
        } else {
            // Footer bulunamazsa ana sayfaya yönlendir
            window.location.href = '/#site-footer';
        }
    }

    // Sayfa yüklendiğinde URL'de #site-footer varsa scroll yap
    window.addEventListener('DOMContentLoaded', function() {
        if (window.location.hash === '#site-footer') {
            const footer = document.getElementById('site-footer');
            if (footer) {
                setTimeout(() => {
                    footer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 300);
            }
        }
    });

    });
</script>