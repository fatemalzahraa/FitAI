<!-- JAVASCRIPT -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        console.log('Ürün Detay JavaScript başlatıldı');

        // Elementler
        const mainImage = document.getElementById('mainProductImage');
        const zoomBtn = document.getElementById('zoomBtn');
        const thumbnails = document.querySelectorAll('.thumbnail-item');
        const decreaseBtn = document.getElementById('decreaseQty');
        const increaseBtn = document.getElementById('increaseQty');
        const quantityInput = document.getElementById('productQuantity');
        const addToCartBtn = document.getElementById('addToCartBtn');
        const addToWishlistBtn = document.getElementById('addToWishlist');

        let isZoomed = false;

        // Görsel hata yönetimi
        function handleImageError(img) {
            img.src = 'https://images.unsplash.com/photo-1416879595882-3373a0480b5b?auto=format&fit=crop&w=800&q=80';
            console.error('Görsel yüklenemedi:', img.alt);
        }

        // Zoom fonksiyonu
        zoomBtn.addEventListener('click', function(e) {
            e.preventDefault();
            isZoomed = !isZoomed;
            mainImage.classList.toggle('zoomed', isZoomed);

            const icon = this.querySelector('i');
            if (isZoomed) {
                icon.classList.remove('fa-search-plus');
                icon.classList.add('fa-search-minus');
                this.title = 'Uzaklaştır';
            } else {
                icon.classList.remove('fa-search-minus');
                icon.classList.add('fa-search-plus');
                this.title = 'Yakınlaştır';
            }
        });

        // Küçük görsel tıklama
        thumbnails.forEach(thumbnail => {
            thumbnail.addEventListener('click', function() {
                const imageUrl = this.getAttribute('data-image');
                mainImage.src = imageUrl;

                // Aktif sınıfını güncelle
                thumbnails.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
            });
        });

        // Miktar kontrolü
        function updateQuantity(change) {
            let current = parseInt(quantityInput.value);
            let max = parseInt(quantityInput.max);
            let newValue = current + change;

            if (newValue >= 1 && newValue <= max) {
                quantityInput.value = newValue;
            } else if (newValue > max) {
                showNotification('Maksimum stok miktarına ulaştınız!', 'warning');
            }
        }

        decreaseBtn.addEventListener('click', () => updateQuantity(-1));
        increaseBtn.addEventListener('click', () => updateQuantity(1));

        // Input değerini kontrol et
        quantityInput.addEventListener('change', function() {
            let value = parseInt(this.value);
            let max = parseInt(this.max);

            if (isNaN(value) || value < 1) {
                this.value = 1;
            } else if (value > max) {
                this.value = max;
                showNotification('Maksimum stok miktarına ulaştınız!', 'warning');
            }
        });

        // Sepete ekle
        addToCartBtn.addEventListener('click', function() {
            if (this.classList.contains('disabled')) return;

            const quantity = parseInt(quantityInput.value);
            const productName = '@Model.Name';
            const productId = @Model.Id;

            console.log('Sepete ekle:', { productId, quantity });

            // Buton animasyonu
            const originalHTML = this.innerHTML;
            this.innerHTML = '<i class="fas fa-check me-2"></i> SEPETE EKLENDİ';
            this.style.background = 'linear-gradient(135deg, #28a745 0%, #218838 100%)';
            this.disabled = true;

            // Sepet sayısını güncelle
            updateCartCount(quantity);

            // Bildirim göster
            showNotification(`${productName} sepete eklendi!`, 'success');

            // 3 saniye sonra eski haline dön
            setTimeout(() => {
                this.innerHTML = originalHTML;
                this.style.background = 'linear-gradient(135deg, #ffc107 0%, #ff9800 100%)';
                this.disabled = false;
            }, 3000);
        });

        // Favorilere ekle
        addToWishlistBtn.addEventListener('click', function() {
            const icon = this.querySelector('i');

            if (icon.classList.contains('far')) {
                icon.classList.remove('far');
                icon.classList.add('fas', 'text-danger');
                showNotification('Ürün favorilere eklendi!', 'info');
            } else {
                icon.classList.remove('fas', 'text-danger');
                icon.classList.add('far');
                showNotification('Ürün favorilerden kaldırıldı!', 'info');
            }
        });

        // Sepet sayısını güncelle
        function updateCartCount(increment) {
            const cartBadge = document.querySelector('.cart-badge');
            if (cartBadge) {
                let current = parseInt(cartBadge.textContent) || 0;
                cartBadge.textContent = current + increment;

                // Animasyon
                cartBadge.style.transform = 'scale(1.4)';
                setTimeout(() => {
                    cartBadge.style.transform = 'scale(1)';
                }, 300);
            }
        }

        // Bildirim fonksiyonu
        function showNotification(message, type) {
            // Mevcut bildirimleri temizle
            const existing = document.querySelector('.custom-toast');
            if (existing) existing.remove();

            // Yeni bildirim oluştur
            const toast = document.createElement('div');
            toast.className = `custom-toast toast-${type}`;
            toast.innerHTML = `
                <div class="toast-content">
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'info-circle'} me-2"></i>
                    <span>${message}</span>
                </div>
            `;

            // Stil ekle
            toast.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: ${type === 'success' ? '#28a745' : type === 'warning' ? '#ffc107' : '#17a2b8'};
                color: white;
                padding: 12px 20px;
                border-radius: 8px;
                box-shadow: 0 4px 15px rgba(0,0,0,0.15);
                z-index: 9999;
                animation: slideIn 0.3s ease;
                display: flex;
                align-items: center;
                font-size: 14px;
            `;

            document.body.appendChild(toast);

            // 3 saniye sonra kaldır
            setTimeout(() => {
                toast.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => {
                    if (toast.parentNode) toast.remove();
                }, 300);
            }, 3000);
        }

        // Slide animasyonları için CSS ekle
        const style = document.createElement('style');
        style.textContent = `
            @@keyframes slideIn {
                from { transform: translateX(100%); opacity: 0; }
                to { transform: translateX(0); opacity: 1; }
            }
            @@keyframes slideOut {
                from { transform: translateX(0); opacity: 1; }
                to { transform: translateX(100%); opacity: 0; }
            }
        `;
        document.head.appendChild(style);

        console.log('JavaScript yüklendi');
    });
</script>