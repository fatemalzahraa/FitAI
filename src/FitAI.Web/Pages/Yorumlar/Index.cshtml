@page
@using FitAI.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FitAIResource> L
@model FitAI.Web.Pages.Yorumlar.IndexModel

<div class="fitai-page">

    <!-- Başlık -->
    <div class="page-header mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h2 class="page-title mb-1">
                    <i class="fas fa-comments me-2 text-primary"></i>Yorum Yönetimi
                </h2>
                <p class="text-muted mb-0 small">Tüm ürün yorumları ve NLP analiz sonuçları</p>
            </div>
        </div>
    </div>

    <!-- KPI Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="yorum-kpi-card">
                <div class="yorum-kpi-icon bg-primary-soft text-primary">
                    <i class="fas fa-comments"></i>
                </div>
                <div>
                    <div class="yorum-kpi-value" id="toplamYorum">—</div>
                    <div class="yorum-kpi-label">Toplam Yorum</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="yorum-kpi-card">
                <div class="yorum-kpi-icon bg-success-soft text-success">
                    <i class="fas fa-robot"></i>
                </div>
                <div>
                    <div class="yorum-kpi-value" id="nlpIslendi">—</div>
                    <div class="yorum-kpi-label">NLP Analiz Edildi</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="yorum-kpi-card">
                <div class="yorum-kpi-icon bg-warning-soft text-warning">
                    <i class="fas fa-clock"></i>
                </div>
                <div>
                    <div class="yorum-kpi-value" id="nlpBekliyor">—</div>
                    <div class="yorum-kpi-label">NLP Bekliyor</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="yorum-kpi-card">
                <div class="yorum-kpi-icon bg-info-soft text-info">
                    <i class="fas fa-star"></i>
                </div>
                <div>
                    <div class="yorum-kpi-value" id="ortPuan">—</div>
                    <div class="yorum-kpi-label">Ort. Puan</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sekmeler -->
    <ul class="nav nav-tabs mb-3" id="yorumTabs">
        <li class="nav-item">
            <button class="nav-link active" data-tab="yorumlar">
                <i class="fas fa-comment me-1"></i>Yorumlar
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" data-tab="nlp">
                <i class="fas fa-brain me-1"></i>NLP Bulgular
            </button>
        </li>
    </ul>

    <!-- SEKME 1: Yorumlar -->
    <div id="tab-yorumlar">
        <div class="card mb-3">
            <div class="card-body py-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" id="yorumArama" class="form-control border-start-0"
                                   placeholder="Yorum metni ara..." />
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select id="magazaFiltre" class="form-select">
                            <option value="">Tüm Mağazalar</option>
                            <option value="1">SportZone TR</option>
                            <option value="2">FashionHub</option>
                            <option value="3">ActiveWear</option>
                            <option value="4">FitStyle</option>
                            <option value="5">RunnerShop</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="puanFiltre" class="form-select">
                            <option value="">Tüm Puanlar</option>
                            <option value="5">★★★★★ (5)</option>
                            <option value="4">★★★★ (4)</option>
                            <option value="3">★★★ (3)</option>
                            <option value="2">★★ (2)</option>
                            <option value="1">★ (1)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="nlpFiltre" class="form-select">
                            <option value="">NLP Durumu</option>
                            <option value="islendi">Analiz Edildi</option>
                            <option value="bekliyor">Bekliyor</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <select id="yorumSirala" class="form-select">
                            <option value="yeni">En Yeni</option>
                            <option value="puan_yuksek">En Yüksek Puan</option>
                            <option value="puan_dusuk">En Düşük Puan</option>
                        </select>
                        <button class="btn btn-outline-secondary btn-sm px-3" id="filtreTemizle">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover yorum-table mb-0">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Ürün</th>
                                <th>Mağaza</th>
                                <th>Yorum</th>
                                <th>Puan</th>
                                <th>NLP</th>
                                <th class="text-center">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="yorumTablosu">
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="fas fa-spinner fa-spin me-2"></i>Yükleniyor...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer py-2">
                <span class="text-muted small" id="yorumKayitYazi">—</span>
            </div>
        </div>
    </div>

    <!-- SEKME 2: NLP Bulgular -->
    <div id="tab-nlp" style="display:none">

        <div class="card mb-3">
            <div class="card-body py-3">
                <div class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <select id="nlpMagazaFiltre" class="form-select">
                            <option value="">Tüm Mağazalar</option>
                            <option value="1">SportZone TR</option>
                            <option value="2">FashionHub</option>
                            <option value="3">ActiveWear</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="nlpDuyguFiltre" class="form-select">
                            <option value="">Tüm Duygular</option>
                            <option value="Pozitif">Pozitif</option>
                            <option value="Negatif">Negatif</option>
                            <option value="Notr">Nötr</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select id="nlpDurumFiltre" class="form-select">
                            <option value="">Tüm Durumlar</option>
                            <option value="Acik">Açık</option>
                            <option value="Kapali">Kapalı</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-outline-secondary btn-sm" id="nlpFiltreTemizle">
                            <i class="fas fa-times me-1"></i>Temizle
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3" id="nlpBulgularGrid">
            <div class="col-12 text-center py-4 text-muted">
                <i class="fas fa-spinner fa-spin me-2"></i>Yükleniyor...
            </div>
        </div>

    </div>

</div>

<!-- Yorum Detay Modal -->
<div class="modal fade" id="yorumDetayModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-comment me-2 text-primary"></i>Yorum Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="yorumDetayIcerik"></div>
        </div>
    </div>
</div>
