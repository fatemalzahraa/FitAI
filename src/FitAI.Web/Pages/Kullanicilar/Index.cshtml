@page
@using FitAI.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FitAIResource> L
@model FitAI.Web.Pages.Kullanicilar.IndexModel

@section styles {
    <abp-style src="/Pages/Kullanicilar/Index.css" />
}

@section scripts {
    <abp-script src="/Pages/Kullanicilar/Index.js" />
}
<div class="fitai-page">
    <div class="page-header mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h2 class="page-title mb-1">
                    <i class="fas fa-users me-2 text-primary"></i>Kullanıcı Yönetimi
                </h2>
                <p class="text-muted mb-0 small">Sisteme kayıtlı tüm kullanıcılar</p>
            </div>
        </div>
    </div>
    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" id="aramaInput" class="form-control border-start-0" placeholder="İsim veya e-posta ara..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="rolFiltre" class="form-select">
                        <option value="">Tüm Roller</option>
                        <option value="Admin">Admin</option>
                        <option value="MagazaSahibi">Mağaza Sahibi</option>
                        <option value="Kullanici">Kullanıcı</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="durumFiltre" class="form-select">
                        <option value="">Tüm Durumlar</option>
                        <option value="aktif">Aktif</option>
                        <option value="pasif">Pasif</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-outline-secondary btn-sm" id="filtreTemizle">
                        <i class="fas fa-times me-1"></i>Temizle
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover kullanici-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th><th>Kullanıcı</th><th>E-posta</th><th>Rol</th>
                            <th>Mağaza</th><th>Son Giriş</th><th>Durum</th><th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="kullaniciTablosu">
                        <tr><td colspan="8" class="text-center py-4 text-muted"><i class="fas fa-spinner fa-spin me-2"></i>Yükleniyor...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between py-2">
            <span class="text-muted small" id="toplamKayitYazi">—</span>
        </div>
    </div>
</div>

<div class="modal fade" id="kullaniciDetayModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-user-circle me-2 text-primary"></i>Kullanıcı Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="kullaniciDetayIcerik"></div>
        </div>
    </div>
</div>
