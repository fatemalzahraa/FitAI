@page
@using FitAI.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FitAIResource> L
@model FitAI.Web.Pages.IndexModel

@section styles {
    <abp-style src="/Pages/Index.css" />
}

@section scripts {
    <abp-script src="/Pages/Index.js" />
}

<div class="fitai-dashboard">

    <!-- Üst Başlık -->
<!-- Üst Başlık - Güncellenmiş -->
<div class="dashboard-header mb-4">
    <div class="d-flex align-items-center justify-content-between flex-wrap">
        <div>
            <div class="welcome-badge mb-2">
                <i class="fas fa-smile-wink me-1"></i> Hoş geldiniz, Admin
            </div>
            <h2 class="dashboard-title mb-1">
                📊 FitAI Kontrol Paneli
                <span class="sistem-durum-badge ms-2">
                    <span class="durum-nokta"></span> Sistem Aktif
                </span>
            </h2>
            <p class="dashboard-subtitle text-muted mb-0">
                Platformunuzun genel görünümü ve performans metrikleri
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="dashboard-date text-muted">
                <i class="fas fa-calendar-alt me-1"></i>
                <span id="currentDate"></span>
            </div>
            <div class="action-buttons">
                <button class="action-btn" id="refreshDashboardBtn" title="Yenile">
                    <i class="fas fa-sync-alt"></i>
                </button>
                <button class="action-btn" id="exportDashboardBtn" title="Rapor İndir">
                    <i class="fas fa-download"></i>
                </button>
            </div>
        </div>
    </div>
</div>
    <!-- KPI Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-magaza">
                <div class="kpi-icon"><i class="fas fa-store"></i></div>
                <div class="kpi-content">
                    <div class="kpi-value" id="toplamMagaza">—</div>
                    <div class="kpi-label">Toplam Mağaza</div>
                </div>
                <div class="kpi-trend">
                    <span class="badge bg-success-soft text-success"><i class="fas fa-arrow-up"></i> Aktif</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-kullanici">
                <div class="kpi-icon"><i class="fas fa-users"></i></div>
                <div class="kpi-content">
                    <div class="kpi-value" id="toplamKullanici">—</div>
                    <div class="kpi-label">Toplam Kullanıcı</div>
                </div>
                <div class="kpi-trend">
                    <span class="badge bg-info-soft text-info"><i class="fas fa-user-check"></i> Kayıtlı</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-urun">
                <div class="kpi-icon"><i class="fas fa-tshirt"></i></div>
                <div class="kpi-content">
                    <div class="kpi-value" id="toplamUrun">—</div>
                    <div class="kpi-label">Toplam Ürün</div>
                </div>
                <div class="kpi-trend">
                    <span class="badge bg-warning-soft text-warning"><i class="fas fa-box"></i> Listelenen</span>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card kpi-komisyon">
                <div class="kpi-icon"><i class="fas fa-lira-sign"></i></div>
                <div class="kpi-content">
                    <div class="kpi-value" id="toplamKomisyon">—</div>
                    <div class="kpi-label">Bu Ay Komisyon</div>
                </div>
                <div class="kpi-trend">
                    <span class="badge bg-success-soft text-success"><i class="fas fa-chart-line"></i> Gelir</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Orta Alan -->
    <div class="row g-3 mb-4">
        <div class="col-xl-8">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-bar me-2 text-primary"></i>Aylık Komisyon Geliri
                    </h5>
                    <span class="text-muted small">Son 6 Ay</span>
                </div>
                <div class="card-body">
                    <canvas id="komisyonChart" height="100"></canvas>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="row g-3 h-100">
                <div class="col-12">
                    <div class="card stat-card">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-3">
                                <div class="stat-icon bg-primary-soft text-primary me-3"><i class="fas fa-brain"></i></div>
                                <div>
                                    <div class="stat-label">Ort. Vücut Uyum Skoru</div>
                                    <div class="stat-value text-primary" id="ortalamaUyumSkoru">—</div>
                                </div>
                            </div>
                            <div class="progress" style="height:6px;">
                                <div class="progress-bar bg-primary" id="uyumSkoruBar" role="progressbar" style="width:0%"></div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card stat-card">
                        <div class="card-body">
                            <div class="d-flex align-items-center mb-2">
                                <div class="stat-icon bg-success-soft text-success me-3"><i class="fas fa-mouse-pointer"></i></div>
                                <div>
                                    <div class="stat-label">Widget Sorguları</div>
                                    <div class="stat-value text-success" id="widgetSorguSayisi">—</div>
                                </div>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex align-items-center">
                                <div class="stat-icon bg-warning-soft text-warning me-3"><i class="fas fa-shopping-cart"></i></div>
                                <div>
                                    <div class="stat-label">Satın Alma Dönüşümü</div>
                                    <div class="stat-value text-warning" id="satinAlmaOrani">—</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="card stat-card">
                        <div class="card-body d-flex align-items-center">
                            <div class="stat-icon bg-info-soft text-info me-3"><i class="fas fa-robot"></i></div>
                            <div>
                                <div class="stat-label">AI Attribution Satışlar</div>
                                <div class="stat-value text-info" id="aiAttributionSayi">—</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Alt Alan -->
    <div class="row g-3">
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-bell me-2 text-warning"></i>Son Bildirimler
                    </h5>
                    <a href="/Bildirimler" class="btn btn-sm btn-outline-secondary">Tümü</a>
                </div>
                <div class="card-body p-0">
                    <ul class="bildirim-listesi" id="bildirimListesi">
                        <li class="bildirim-item">
                            <div class="bildirim-icon bg-info-soft text-info"><i class="fas fa-robot"></i></div>
                            <div class="bildirim-icerik">
                                <div class="bildirim-baslik">Yükleniyor...</div>
                                <div class="bildirim-zaman text-muted small">—</div>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-store-alt me-2 text-success"></i>Aktif Mağazalar
                    </h5>
                    <a href="/Magazalar" class="btn btn-sm btn-outline-secondary">Tümü</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover dashboard-table mb-0">
                            <thead>
                                <tr>
                                    <th>Mağaza Adı</th>
                                    <th>Paket</th>
                                    <th>Komisyon</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody id="magazaTablosu">
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">
                                        <i class="fas fa-spinner fa-spin me-1"></i> Yükleniyor...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
