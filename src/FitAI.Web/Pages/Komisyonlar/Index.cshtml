@page
@using FitAI.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FitAIResource> L
@model FitAI.Web.Pages.Komisyonlar.IndexModel

<div class="fitai-page">

    <!-- Sayfa Başlığı -->
    <div class="page-header mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <div class="page-icon">
                        <i class="fas fa-lira-sign"></i>
                    </div>
                    <h2 class="page-title mb-0">Komisyon Yönetimi</h2>
                    <span class="badge bg-success-soft text-success">
                        <i class="fas fa-chart-line me-1"></i>Gelir Takibi
                    </span>
                </div>
                <p class="text-muted mb-0 small">Mağaza komisyonlarını görüntüleyin, ödemeleri takip edin ve raporlayın.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary" id="raporIndirBtn">
                    <i class="fas fa-file-excel me-1"></i>Excel Raporu
                </button>
                <button class="btn btn-primary" id="odemeYapBtn">
                    <i class="fas fa-money-bill-wave me-1"></i>Ödeme Yap
                </button>
            </div>
        </div>
    </div>

    <!-- Komisyon Özet Kartları -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="komisyon-kpi-card" data-card="total">
                <div class="komisyon-kpi-ust">
                    <span class="komisyon-kpi-ikon">
                        <i class="fas fa-chart-pie"></i>
                    </span>
                    <span class="komisyon-kpi-degisim degisim-yukari">
                        <i class="fas fa-arrow-up"></i> +12%
                    </span>
                </div>
                <div class="komisyon-kpi-deger" id="toplamKomisyon">₺ —</div>
                <div class="komisyon-kpi-etiket">Toplam Komisyon</div>
                <div class="komisyon-kpi-alt">Geçen aya göre artış</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="komisyon-kpi-card" data-card="monthly">
                <div class="komisyon-kpi-ust">
                    <span class="komisyon-kpi-ikon">
                        <i class="fas fa-calendar-alt"></i>
                    </span>
                    <span class="komisyon-kpi-degisim degisim-yukari">
                        <i class="fas fa-arrow-up"></i> +8%
                    </span>
                </div>
                <div class="komisyon-kpi-deger" id="aylikKomisyon">₺ —</div>
                <div class="komisyon-kpi-etiket">Bu Ay Komisyon</div>
                <div class="komisyon-kpi-alt">Geçen aya göre +₺4.200</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="komisyon-kpi-card" data-card="pending">
                <div class="komisyon-kpi-ust">
                    <span class="komisyon-kpi-ikon">
                        <i class="fas fa-clock"></i>
                    </span>
                    <span class="komisyon-kpi-degisim degisim-yukari">
                        <i class="fas fa-arrow-up"></i> +3%
                    </span>
                </div>
                <div class="komisyon-kpi-deger" id="bekleyenOdeme">₺ —</div>
                <div class="komisyon-kpi-etiket">Bekleyen Ödeme</div>
                <div class="komisyon-kpi-alt">3 mağaza bekliyor</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="komisyon-kpi-card" data-card="paid">
                <div class="komisyon-kpi-ust">
                    <span class="komisyon-kpi-ikon">
                        <i class="fas fa-check-circle"></i>
                    </span>
                </div>
                <div class="komisyon-kpi-deger" id="odendiKomisyon">₺ —</div>
                <div class="komisyon-kpi-etiket">Ödenen Komisyon</div>
                <div class="komisyon-kpi-alt">Bu ay 4 ödeme</div>
            </div>
        </div>
    </div>

    <!-- Aylık Komisyon Grafiği -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex align-items-center justify-content-between">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-chart-line me-2 text-primary"></i>Aylık Komisyon Trendi
                    </h5>
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn btn-outline-secondary active" onclick="komisyonGrafikTipiDegistir('line', this)">
                            <i class="fas fa-chart-line"></i>
                        </button>
                        <button class="btn btn-outline-secondary" onclick="komisyonGrafikTipiDegistir('bar', this)">
                            <i class="fas fa-chart-bar"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body pt-3">
                    <canvas id="komisyonTrendChart" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Mağaza Komisyon Listesi -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-header bg-transparent border-0 pt-3 d-flex align-items-center justify-content-between flex-wrap gap-3">
            <h5 class="card-title mb-0">
                <i class="fas fa-store me-2 text-primary"></i>Mağaza Komisyon Listesi
            </h5>
            <div class="d-flex gap-2">
                <div class="search-input-group">
                    <i class="fas fa-search"></i>
                    <input type="text" class="form-control" id="magazaAra" placeholder="Mağaza ara...">
                </div>
                <select id="odemeDurumuFiltre" class="form-select">
                    <option value="all">Tüm Durumlar</option>
                    <option value="odendi">Ödendi</option>
                    <option value="beklemede">Beklemede</option>
                    <option value="iptal">İptal</option>
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table komisyon-tablo mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Mağaza Adı</th>
                            <th>Paket</th>
                            <th>Komisyon Oranı</th>
                            <th>Bu Ay Komisyon</th>
                            <th>Toplam Komisyon</th>
                            <th>Durum</th>
                            <th>Son Ödeme</th>
                            <th style="width: 110px;">İşlem</th>
                        </tr>
                    </thead>
                    <tbody id="komisyonListesiTablosu">
                        <tr class="loading-row">
                            <td colspan="9">
                                <div class="d-flex justify-content-center py-5">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Yükleniyor...</span>
                                    </div>
                                    <span class="ms-2 text-muted">Veriler yükleniyor...</span>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-transparent d-flex justify-content-between align-items-center pt-3 pb-3">
            <span class="text-muted small" id="komisyonSayac">0 mağaza gösteriliyor</span>
            <nav>
                <ul class="pagination pagination-sm mb-0" id="komisyonPagination"></ul>
            </nav>
        </div>
    </div>
</div>

<!-- ÖDEME MODAL -->
<div class="modal fade" id="odemeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 pt-4">
                <h5 class="modal-title">
                    <div class="modal-icon me-2">
                        <i class="fas fa-money-bill-wave text-success"></i>
                    </div>
                    Ödeme Yap
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-0">
                <form id="odemeForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mağaza</label>
                        <input type="text" class="form-control" id="odemeMagazaAd" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ödenecek Tutar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">₺</span>
                            <input type="number" class="form-control" id="odemeTutar" step="0.01" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ödeme Tarihi</label>
                        <input type="date" class="form-control" id="odemeTarih">
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Açıklama</label>
                        <textarea class="form-control" id="odemeAciklama" rows="2" placeholder="İsteğe bağlı"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pb-4">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success" id="odemeOnaylaBtn">
                    <i class="fas fa-check me-1"></i>Ödemeyi Onayla
                </button>
            </div>
        </div>
    </div>
</div>