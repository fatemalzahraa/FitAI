@page
@using FitAI.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FitAIResource> L
@model FitAI.Web.Pages.Urunler.IndexModel

<div class="fitai-page">

    <!-- Sayfa Başlığı -->
    <div class="page-header mb-4">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h2 class="page-title mb-1">
                    <i class="fas fa-tshirt me-2 text-primary"></i>Ürün Yönetimi
                </h2>
                <p class="text-muted mb-0 small">Platforma kayıtlı tüm ürünler</p>
            </div>
            <button class="btn btn-primary" id="yeniUrunBtn">
                <i class="fas fa-plus me-2"></i>Yeni Ürün Ekle
            </button>
        </div>
    </div>

    <!-- KPI Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="urun-kpi-card">
                <div class="urun-kpi-icon bg-primary-soft text-primary">
                    <i class="fas fa-tshirt"></i>
                </div>
                <div>
                    <div class="urun-kpi-value" id="toplamUrun">—</div>
                    <div class="urun-kpi-label">Toplam Ürün</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="urun-kpi-card">
                <div class="urun-kpi-icon bg-success-soft text-success">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div>
                    <div class="urun-kpi-value" id="aktifUrun">—</div>
                    <div class="urun-kpi-label">Aktif Ürün</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="urun-kpi-card">
                <div class="urun-kpi-icon bg-warning-soft text-warning">
                    <i class="fas fa-expand-arrows-alt"></i>
                </div>
                <div>
                    <div class="urun-kpi-value" id="eskekUrun">—</div>
                    <div class="urun-kpi-label">Esnek Kumaş</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="urun-kpi-card">
                <div class="urun-kpi-icon bg-info-soft text-info">
                    <i class="fas fa-cut"></i>
                </div>
                <div>
                    <div class="urun-kpi-value" id="kesimSayisi">—</div>
                    <div class="urun-kpi-label">Farklı Kesim Türü</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtre -->
    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0">
                            <i class="fas fa-search text-muted"></i>
                        </span>
                        <input type="text" id="aramaInput" class="form-control border-start-0"
                               placeholder="Ürün adı ara..." />
                    </div>
                </div>
                <div class="col-md-2">
                    <select id="kesimFiltre" class="form-select">
                        <option value="">Tüm Kesimler</option>
                        <option value="Regular">Regular</option>
                        <option value="Slim">Slim</option>
                        <option value="Oversize">Oversize</option>
                        <option value="Athletic">Athletic</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select id="kumasFiltre" class="form-select">
                        <option value="">Kumaş Tipi</option>
                        <option value="esnek">Esnek</option>
                        <option value="esnek_degil">Esnek Değil</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <select id="durumFiltre" class="form-select">
                        <option value="">Tüm Durumlar</option>
                        <option value="aktif">Aktif</option>
                        <option value="silindi">Silinmiş</option>
                    </select>
                </div>
                <div class="col-md-2 text-end">
                    <button class="btn btn-outline-secondary btn-sm" id="filtreTemizle">
                        <i class="fas fa-times me-1"></i>Temizle
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Ürün Tablosu -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover urun-table mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Ürün Adı</th>
                            <th>Mağaza</th>
                            <th>Kesim Türü</th>
                            <th>Kumaş</th>
                            <th>Açıklama</th>
                            <th>Durum</th>
                            <th class="text-center">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="urunTablosu">
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fas fa-spinner fa-spin me-2"></i>Yükleniyor...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer d-flex align-items-center justify-content-between py-2">
            <span class="text-muted small" id="toplamKayitYazi">—</span>
        </div>
    </div>

</div>

<!-- Ürün Ekle / Düzenle Modal -->
<div class="modal fade" id="urunModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="urunModalBaslik">
                    <i class="fas fa-tshirt me-2 text-primary"></i>Yeni Ürün Ekle
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">

                    <!-- Ürün Adı -->
                    <div class="col-md-6">
                        <label class="form-label-sm">Ürün Adı <span class="text-danger">*</span></label>
                        <input type="text" id="f_ad" class="form-control" placeholder="örn. Slim Fit Spor Tayt" />
                        <div class="invalid-feedback" id="err_ad"></div>
                    </div>

                    <!-- Mağaza -->
                    <div class="col-md-6">
                        <label class="form-label-sm">Mağaza <span class="text-danger">*</span></label>
                        <select id="f_magazaId" class="form-select">
                            <option value="">Mağaza Seçiniz</option>
                            <option value="1">SportZone TR</option>
                            <option value="2">FashionHub</option>
                            <option value="3">ActiveWear</option>
                            <option value="4">FitStyle</option>
                            <option value="5">RunnerShop</option>
                        </select>
                        <div class="invalid-feedback" id="err_magazaId"></div>
                    </div>

                    <!-- Kesim Türü -->
                    <div class="col-md-6">
                        <label class="form-label-sm">Kesim Türü</label>
                        <select id="f_kesimTuru" class="form-select">
                            <option value="">Seçiniz</option>
                            <option value="Regular">Regular Fit</option>
                            <option value="Slim">Slim Fit</option>
                            <option value="Oversize">Oversize</option>
                            <option value="Athletic">Athletic Fit</option>
                        </select>
                    </div>

                    <!-- Kumaş Esnek Mi -->
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="w-100">
                            <label class="form-label-sm d-block">Kumaş Özellikleri</label>
                            <div class="kumas-toggle-group">
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="f_kumasEsnek" />
                                    <label class="form-check-label" for="f_kumasEsnek">
                                        <i class="fas fa-expand-arrows-alt me-1 text-warning"></i>
                                        Esnek Kumaş
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Açıklama -->
                    <div class="col-12">
                        <label class="form-label-sm">Açıklama</label>
                        <textarea id="f_aciklama" class="form-control" rows="3"
                                  placeholder="Ürün hakkında kısa açıklama girin..."></textarea>
                        <div class="d-flex justify-content-end mt-1">
                            <span class="text-muted small" id="aciklamaKarakter">0 karakter</span>
                        </div>
                    </div>

                    <!-- Kesim Bilgi Kartı -->
                    <div class="col-12" id="kesimBilgiKarti" style="display:none">
                        <div class="kesim-bilgi-alert alert mb-0">
                            <i class="fas fa-info-circle me-2"></i>
                            <span id="kesimBilgiText"></span>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>İptal
                </button>
                <button type="button" class="btn btn-primary" id="urunKaydetBtn">
                    <i class="fas fa-save me-1"></i>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Silme Onay Modal -->
<div class="modal fade" id="silOnayModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-danger">
                    <i class="fas fa-exclamation-triangle me-2"></i>Ürünü Sil
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-0">
                <p class="text-muted">
                    <strong id="silUrunAdi"></strong> ürününü silmek istediğinize emin misiniz?
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-danger btn-sm" id="silOnayBtn">
                    <i class="fas fa-trash me-1"></i>Evet, Sil
                </button>
            </div>
        </div>
    </div>
</div>
