@page
@using FitAI.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<FitAIResource> L
@model FitAI.Web.Pages.Urunler.ListeModel

<div class="fitai-page">

    <!-- Sayfa Başlığı -->
    <div class="page-header mb-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h2 class="page-title mb-1">
                    <i class="fas fa-th-large me-2 text-primary"></i>Ürün Kataloğu
                </h2>
                <p class="text-muted mb-0 small">Tüm ürünleri görüntüleyin ve filtreleyin</p>
            </div>
            <div class="d-flex gap-2">
                <!-- Görünüm Değiştir -->
                <div class="btn-group" role="group">
                    <button class="btn btn-outline-secondary btn-sm active" id="kartGorunumBtn" title="Kart Görünümü">
                        <i class="fas fa-th-large"></i>
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" id="listeGorunumBtn" title="Liste Görünümü">
                        <i class="fas fa-list"></i>
                    </button>
                </div>
                <a href="/Urunler" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus me-1"></i>Yeni Ürün
                </a>
            </div>
        </div>
    </div>

    <div class="row g-3">

        <!-- Sol: Filtre Paneli -->
        <div class="col-xl-3 col-lg-4">
            <div class="card filtre-panel">
                <div class="card-header">
                    <h6 class="mb-0 fw-600">
                        <i class="fas fa-filter me-2 text-primary"></i>Filtrele
                    </h6>
                </div>
                <div class="card-body">

                    <!-- Arama -->
                    <div class="mb-3">
                        <label class="filtre-label">Ürün Ara</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-transparent border-end-0">
                                <i class="fas fa-search text-muted"></i>
                            </span>
                            <input type="text" id="aramaInput" class="form-control border-start-0"
                                   placeholder="Ürün adı..." />
                        </div>
                    </div>

                    <!-- Mağaza -->
                    <div class="mb-3">
                        <label class="filtre-label">Mağaza</label>
                        <select id="magazaFiltre" class="form-select form-select-sm">
                            <option value="">Tümü</option>
                            <option value="1">SportZone TR</option>
                            <option value="2">FashionHub</option>
                            <option value="3">ActiveWear</option>
                            <option value="4">FitStyle</option>
                            <option value="5">RunnerShop</option>
                        </select>
                    </div>

                    <!-- Kesim Türü -->
                    <div class="mb-3">
                        <label class="filtre-label">Kesim Türü</label>
                        <div class="d-flex flex-column gap-1" id="kesimCheckboxlar">
                            <div class="form-check">
                                <input class="form-check-input kesim-check" type="checkbox" value="Regular" id="kRegular">
                                <label class="form-check-label small" for="kRegular">Regular Fit</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input kesim-check" type="checkbox" value="Slim" id="kSlim">
                                <label class="form-check-label small" for="kSlim">Slim Fit</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input kesim-check" type="checkbox" value="Oversize" id="kOversize">
                                <label class="form-check-label small" for="kOversize">Oversize</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input kesim-check" type="checkbox" value="Athletic" id="kAthletic">
                                <label class="form-check-label small" for="kAthletic">Athletic Fit</label>
                            </div>
                        </div>
                    </div>

                    <!-- Kumaş -->
                    <div class="mb-3">
                        <label class="filtre-label">Kumaş Tipi</label>
                        <div class="d-flex flex-column gap-1">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="kumasRadio" id="kumasTumu" value="" checked>
                                <label class="form-check-label small" for="kumasTumu">Tümü</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="kumasRadio" id="kumasEsnek" value="esnek">
                                <label class="form-check-label small" for="kumasEsnek">
                                    <i class="fas fa-expand-arrows-alt text-success me-1"></i>Esnek
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="kumasRadio" id="kumasStandart" value="standart">
                                <label class="form-check-label small" for="kumasStandart">Standart</label>
                            </div>
                        </div>
                    </div>

                    <!-- NLP Durumu (Yorum entity'sinden) -->
                    <div class="mb-3">
                        <label class="filtre-label">NLP Analizi</label>
                        <select id="nlpFiltre" class="form-select form-select-sm">
                            <option value="">Tümü</option>
                            <option value="islendi">Analiz Edildi</option>
                            <option value="islenmedi">Analiz Bekliyor</option>
                        </select>
                    </div>

                    <button class="btn btn-outline-secondary btn-sm w-100" id="filtreTemizle">
                        <i class="fas fa-times me-1"></i>Filtreleri Temizle
                    </button>
                </div>
            </div>
        </div>

        <!-- Sağ: Ürün Listesi -->
        <div class="col-xl-9 col-lg-8">

            <!-- Sıralama & Sonuç Sayısı -->
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="text-muted small" id="sonucYazi">Yükleniyor...</span>
                <select id="siralamaSelect" class="form-select form-select-sm w-auto">
                    <option value="id">Varsayılan</option>
                    <option value="ad">Ada Göre (A-Z)</option>
                    <option value="puan">Puana Göre</option>
                    <option value="kesim">Kesim Türüne Göre</option>
                </select>
            </div>

            <!-- Kart Görünümü -->
            <div id="kartGorunum">
                <div class="row g-3" id="urunKartlari">
                    <div class="col-12 text-center py-5 text-muted">
                        <i class="fas fa-spinner fa-spin fa-2x mb-2"></i>
                        <div>Yükleniyor...</div>
                    </div>
                </div>
            </div>

            <!-- Liste Görünümü -->
            <div id="listeGorunum" style="display:none">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover urun-liste-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Ürün</th>
                                        <th>Mağaza</th>
                                        <th>Kesim</th>
                                        <th>Kumaş</th>
                                        <th>Ort. Puan</th>
                                        <th>Yorum</th>
                                        <th>NLP</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="urunListeTablosu"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

<!-- Ürün Detay Modal -->
<div class="modal fade" id="urunDetayModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detayModalBaslik">
                    <i class="fas fa-tshirt me-2 text-primary"></i>Ürün Detayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-4">

                    <!-- Sol: Ürün Bilgileri -->
                    <div class="col-md-5">
                        <div class="urun-detay-kart">
                            <div class="urun-detay-ikon mb-3" id="detayIkon"></div>
                            <h4 class="fw-700 mb-1" id="detayAd"></h4>
                            <div class="text-muted small mb-3" id="detayMagaza"></div>
                            <div class="d-flex flex-wrap gap-2 mb-3" id="detayBadgeler"></div>
                            <div class="urun-detay-aciklama" id="detayAciklama"></div>
                        </div>

                        <!-- Ürün İstatistikleri -->
                        <div class="row g-2 mt-2">
                            <div class="col-6">
                                <div class="detay-stat-kart text-center">
                                    <div class="detay-stat-value text-warning" id="detayOrtPuan">—</div>
                                    <div class="detay-stat-label">Ort. Puan</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="detay-stat-kart text-center">
                                    <div class="detay-stat-value text-primary" id="detayYorumSayisi">—</div>
                                    <div class="detay-stat-label">Toplam Yorum</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="detay-stat-kart text-center">
                                    <div class="detay-stat-value text-success" id="detayNlpSayisi">—</div>
                                    <div class="detay-stat-label">NLP Analiz</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="detay-stat-kart text-center">
                                    <div class="detay-stat-value text-info" id="detayBekleyenNlp">—</div>
                                    <div class="detay-stat-label">Bekleyen NLP</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sağ: Yorumlar -->
                    <div class="col-md-7">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h6 class="fw-700 mb-0">
                                <i class="fas fa-comments me-2 text-info"></i>Kullanıcı Yorumları
                            </h6>
                            <div class="d-flex gap-2">
                                <select id="yorumSirala" class="form-select form-select-sm w-auto">
                                    <option value="yeni">En Yeni</option>
                                    <option value="puan_yuksek">En Yüksek Puan</option>
                                    <option value="puan_dusuk">En Düşük Puan</option>
                                    <option value="nlp">NLP Bekleyenler</option>
                                </select>
                            </div>
                        </div>
                        <div id="yorumListesi" class="yorum-listesi">
                            <!-- JS ile doldurulacak -->
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <a id="detayDuzenleBtn" href="#" class="btn btn-warning btn-sm">
                    <i class="fas fa-pencil-alt me-1"></i>Düzenle
                </a>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
